        $query = 'select MAX(KMAT_ID) as KMAT_ID, KMTG_KATEGORIJAS_KODS as KMAT_KATEGORIJAS_KODS, 
        KMTG_KATEGORIJAS_NOSAUKUNS as KMAT_KATEGORIJAS_NOSAUKUNS
        from `kl_materialu_grupas`
        INNER JOIN `KL_MATERIALI` ON KMTG_KATEGORIJAS_KODS = KMAT_KATEGORIJAS_KODS
        WHERE `KMAT_KATEGORIJAS_KLASE` NOT IN ("' .CAT_CLASE_1 .'", "' .CAT_CLASE_2 .'")  
        AND `KMTG_KATEGORIJAS_KODS` LIKE "'.dbLayer::quote_smart($category).'%" 
        group by KMTG_KATEGORIJAS_KODS, KMTG_KATEGORIJAS_NOSAUKUNS
        order by `KMTG_KATEGORIJAS_KODS` asc';

        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

