    function saveMMSWork($ID, $code, $workTime, $materialPrice, $quarter, $year, $priority, $edAreaCode, $isActive, $finalize, $worker, $contract, $trase, $isMain = true,
	       $designation, $workTitle, $toidn, $toid,
                        $z1,$z2,$z3,$z4,$z5,$z6,$z7,$z8,$z9,
                        $v1,$v2,$v3,$v4,$v5,$v6,$v7,$v8,$v9,$v10,$v11)
	{
	    $tableName  = (($isMain)? 'KL_MMS_DARBI' : 'KL_MMS_DARBI_TEMP');
		if ($ID)
		{
			$query = 'update `'.$tableName.'`
				set `KMSD_CILVEKSTUNDAS` = "'.dbLayer::quote_smart($workTime).'",
                    `KMSD_MATR_IZMAKSAS` = "'.dbLayer::quote_smart($materialPrice).'",
                    `KMSD_CETUKSNIS` = "'.dbLayer::quote_smart($quarter).'",
                    `KMSD_GADS` = "'.dbLayer::quote_smart($year).'",
                    `KMSD_PRIORITATE` = "'.dbLayer::quote_smart($priority).'",
                    `KMSD_KEDI_KODS` = "'.dbLayer::quote_smart($edAreaCode).'",
