    function getProjectMaterialGroup(){
        
        $query = "SELECT DISTINCT `KMTG_GRUPAS_NOSAUKUNS`, KMTG_GRUPAS_KODS AS GRUPAS_KODS,
                        CONCAT(KMTG_GRUPAS_KODS, 
                                        '*', 
                                        CASE WHEN  KMTG_GRUPAS_KODS = '09' THEN '1' ELSE '0' END ) as KMTG_GRUPAS_KODS 
			FROM `kl_materialu_grupas`
            LEFT JOIN `kl_komplektacijas` ON `KMTG_KATEGORIJAS_KODS` = `KMTK_KATEGORIJAS_KODS`
            WHERE `KMTG_PIEGADES_VEIDS` NOT IN ('Aprīkojums', 'Neprojektēt')
			ORDER BY KMTG_GRUPAS_KODS";


        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

    

    function getProjectMaterialSubGroup($group){
        
        $query = "SELECT CONCAT(KMTG_APAKSGRUPAS_KODS, '*', CASE WHEN SUM(a) = 0 THEN '0' ELSE '1' END, '*', CASE WHEN SUM(b) = 0 THEN '0' ELSE '1' END) as KMTG_APAKSGRUPAS_KODS, 
                    `KMTG_APAKSGRUPAS_NOSAUKUNS`, APAKSGRUPAS_KODS, `KMTG_GRUPAS_KODS` 
                    FROM  (SELECT CASE WHEN KMTK_KOMPLEKTACIJA IS NOT NULL THEN '1' ELSE '0' END AS a,
                                    CASE WHEN  KMTG_GRUPAS_KODS = '09' THEN '1' ELSE '0' END  as b, 
                            `KMTG_APAKSGRUPAS_NOSAUKUNS`,
                            LPAD(KMTG_APAKSGRUPAS_KODS, 4, 0) as APAKSGRUPAS_KODS, 
                            `KMTG_GRUPAS_KODS`,
                            `KMTG_APAKSGRUPAS_KODS`
                            FROM `kl_materialu_grupas`
                            LEFT JOIN `kl_komplektacijas` ON `KMTG_KATEGORIJAS_KODS` = `KMTK_KATEGORIJAS_KODS`
                    WHERE `KMTG_GRUPAS_KODS` = '".dbLayer::quote_smart($group)."'
                    AND `KMTG_PIEGADES_VEIDS` NOT IN ('Aprīkojums', 'Neprojektēt')
