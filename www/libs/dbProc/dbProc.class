    function updateMaterialSumms($actId, $tame = false){

        $table_name = ($tame == 1) ? '`TAME_MATERIALI`' : '`MATERIALI`';

        $query = "SELECT SUM(MATR_CENA_KOPA) as CENA_KOPA, `MATR_WORK_APROVE_DATE`
                    FROM ".$table_name." 
                    WHERE `MATR_RAKT_ID` = " . dbLayer::quote_smart($actId) . "
                    GROUP BY `MATR_WORK_APROVE_DATE`";

        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);

        if ($result !== false)
        {
            foreach($result as $i => $row)
            {
                if(empty($row['MATR_WORK_APROVE_DATE'])) {
                    $query = 'UPDATE ' . $table_name .' SET `MATR_CENA_KOPA` = '.$row['CENA_KOPA'].'
                    WHERE `MATR_RAKT_ID` = ' . dbLayer::quote_smart($actId);

                } else {
                    $query = 'UPDATE ' . $table_name .' SET `MATR_CENA_KOPA` = '.$row['CENA_KOPA'].'
                    WHERE `MATR_RAKT_ID` = ' . dbLayer::quote_smart($actId) . '
                    AND  `MATR_WORK_APROVE_DATE` = "' . $row['MATR_WORK_APROVE_DATE']. '"';

                }
               
                
                $result = $oDB -> makeQuery($query);
            }
        }

    }

