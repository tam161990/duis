	// -----------------------------------------------------------------------------
	// Change user password
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function changeUserPassword($userId, $pass)
	{
		$oSQL=new dbLayer();
		$sql = 'update `LIETOTAJI`
				set `RLTT_PAROLE`=md5("'.dbLayer::quote_smart($pass).'")
				where `RLTT_ID` =  "'.dbLayer::quote_smart($userId).'"';
		$res=$oSQL->makeQuery($sql);
		if ($res!==false)
		{
			return true;
		}
		else
		{
			return false;
		}
	}

    // -----------------------------------------------------------------------------
	// Check is user password correct
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function isUserPassword($login, $password)
	{
		$oSQL=new dbLayer();
        $sql = 'select * from `LIETOTAJI`
					where '.
					' `RLTT_ID` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")';

		$res=$oSQL->makeQuery($sql);

		if (is_array($res) && count($res)==1)
		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
    // -----------------------------------------------------------------------------
	// Set user last login date
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function setUserActionDate($userId, $action)
	{
		$oSQL=new dbLayer();
		$sql = 'update `LIETOTAJI`
				set `RLTT_DATUMS`=now(), `RLTT_DARBIBA` = "'.dbLayer::quote_smart($action).'"
				where `RLTT_ID` =  "'.dbLayer::quote_smart($userId).'"';
		$res=$oSQL->makeQuery($sql);
		if ($res!==false)
		{
			return true;
		}
		else
		{
			return false;
		}
	}
	// -----------------------------------------------------------------------------
	// Get list of users
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

	function getUsersList($ID = false, $isRltt = true, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
	    $oSQL=new dbLayer();
      	if ($ID)
		{
			$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `ROLE`, w.KWOI_NOSAUKUMS as `WORK`
    				from`LIETOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID  = k.KEDI_ID)
                  LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
                  LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'" )
                  where `RLTT_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
          if($column === false)
          {
             $column = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
          }
          if($orderColumn === false)
          {
             $orderColumn = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
          }
          if($column == 'ROLE')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }
          if($column == 'WORK')
          {
               $column = 'w.KWOI_NOSAUKUMS';
          }
          if($orderColumn == 'ROLE')
          {
             $orderColumn = 'l.KRFK_NOZIME';
          }
          if($orderColumn == 'AREA')
          {
               $orderColumn = 'k.KEDI_NOSAUKUMS';
          }
          if($orderColumn  == 'WORK')
          {
               $orderColumn  = 'w.KWOI_NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
    		$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `ROLE` , w.KWOI_NOSAUKUMS as `WORK`
    				from`LIETOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID = k.KEDI_ID)
                  LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
                  LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'"  )
                    where '. $searchString .
                    (($isRltt) ? ' AND (`RLTT_KWOI_KODS` IS NULL OR  `RLTT_KWOI_KODS` = "") ' : ' AND (`RLTT_KWOI_KODS` IS NOT NULL AND  `RLTT_KWOI_KODS` <> "")' ).
                    ' order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order);
            if (($offset !== false) && $limit)
			{
				$sql .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
    		//		'.($amount>0 ? 'limit '.($start==0?'':dbLayer::quote_smart($start).', ').dbLayer::quote_smart($amount):'') ;
        }

		$res=$oSQL->makeQuery($sql);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Get list of users aktions
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

	function getUsersActionsList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
	    $oSQL=new dbLayer();

          if($column === false)
          {
             $column = 'RLTT_UZVARDS';
          }
          if($orderColumn === false)
          {
             $orderColumn = $column = 'RLTT_UZVARDS';
          }
          if($column == 'NOSAUKUMS')
          {
             $column = 'd.NOSAUKUMS';
          }

          if($orderColumn == 'NOSAUKUMS')
          {
             $orderColumn = 'd.NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
    		$sql = 'select *, d.NOSAUKUMS as `NOSAUKUMS`
    				from`LIETOTAJI` l
                  LEFT JOIN `LIETOTAJA_DARBIBAS` d ON (d.KODS = l.RLTT_DARBIBA)
                    where '. $searchString .'
                    order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order);
            if (($offset !== false) && $limit)
			{
				$sql .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}

		$res=$oSQL->makeQuery($sql);
		return $res;
	}

	// -----------------------------------------------------------------------------
	// Get total user count in the users table
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function getUsersCount($search = false, $column = false, $isRltt = true)
	{
		$oSQL=new dbLayer();
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
        }

          if($column == 'ROLE')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }
	    if($column == 'WORK')
          {
               $column = 'w.KWOI_NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
		$sql = 'select count(`RLTT_ID`) as `amount` from`LIETOTAJI`
        LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID  = k.KEDI_ID)
        LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
        LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'"  )
        where '. $searchString . (($isRltt) ? ' AND (`RLTT_KWOI_KODS` IS NULL OR  `RLTT_KWOI_KODS` = "") ' : ' AND (`RLTT_KWOI_KODS` IS NOT NULL AND `RLTT_KWOI_KODS` <> "")' );
		$res=$oSQL->makeQuery($sql);

		if($res)
		{
			return $res[0]['amount'];
		}
		else
		{
			return false;
		}
	}

	// -----------------------------------------------------------------------------
	// Check is user with defined login name already exist
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isHasUserWithThisLogin($login, $userId=false)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`RLTT_ID`) as `amount` from `LIETOTAJI`
			where `RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'" ';
		if($userId)
		{
			$sql .= 'and `RLTT_ID`<>"'.dbLayer::quote_smart($userId).'" ';
		}
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']))
		{
			return true;
		}
		return false;
	}
	// -----------------------------------------------------------------------------
	// Check is aktiv user with defined login name already exist
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isHasActiveUserWithThisLogin($login)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`RLTT_ID`) as `amount` from `LIETOTAJI`
			where `RLTT_IR_AKTIVS`=1 AND `RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'" ';	
		
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']))
		{
			return true;
		}
		return false;
	}

	// -----------------------------------------------------------------------------
	// saglaba lietotaja datus
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveUser($userId,$login,$name,$surname,$isAdmin,$dvArea,$password=false, 
                        $isActive,$role, $worker = '', $section = '', 
                        $trase = 0, $contract = 0, $projector = 0)
	{
		$oSQL=new dbLayer();
		if ($userId==false)
		{
			$sql = 'insert into `LIETOTAJI`
                        (`RLTT_USER_NAME`, 
                        `RLTT_PAROLE`,
                        `RLTT_VARDS`,
                        `RLTT_UZVARDS`,
                        `RLTT_IR_ADMINS`,
                        `RLTT_KEDI_ID`,
                        `RLTT_IR_AKTIVS`, 
                        `RLTT_ROLE`, 
                        `RLTT_KWOI_KODS`, 
                        `RLTT_KEDI_SECTION`, 
                        `RLTT_IR_TRASE`, 
                        `RLTT_IR_LIGUMS`,
                        `RLTT_PROJECTOR`
                        ) 
                    values
						("'.dbLayer::quote_smart($login).'",
						 md5("'.dbLayer::quote_smart($password).'"),
						 "'.dbLayer::quote_smart($name).'",
						 "'.dbLayer::quote_smart($surname).'",
						 "'.dbLayer::quote_smart($isAdmin).'",
						 "'.dbLayer::quote_smart($dvArea).'",
						 "'.dbLayer::quote_smart($isActive).'",					
                         "'.dbLayer::quote_smart($role).'",
                         "'.dbLayer::quote_smart($worker).'",
                         "'.dbLayer::quote_smart($section).'",
                         "'.dbLayer::quote_smart($trase).'",
                         "'.dbLayer::quote_smart($contract).'",
                         "'.dbLayer::quote_smart($projector).'"
                         
                         )';

		}
		else
		{
			$sql = 'update `LIETOTAJI` set
						`RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'",
						`RLTT_VARDS`="'.dbLayer::quote_smart($name).'",
						'.(($password !==false)?'`RLTT_PAROLE`=md5("'.dbLayer::quote_smart($password).'"),':'').'
						`RLTT_UZVARDS`="'.dbLayer::quote_smart($surname).'",
						`RLTT_IR_ADMINS`="'.dbLayer::quote_smart($isAdmin).'",
						`RLTT_KEDI_ID`="'.dbLayer::quote_smart($dvArea).'",
						`RLTT_IR_AKTIVS`="'.dbLayer::quote_smart($isActive).'",						
                        `RLTT_ROLE`="'.dbLayer::quote_smart($role).'",
                        `RLTT_KWOI_KODS`="'.dbLayer::quote_smart($worker).'",
                        `RLTT_KEDI_SECTION` = "'.dbLayer::quote_smart($section).'",
                        `RLTT_IR_TRASE` = "'.dbLayer::quote_smart($trase).'",
                        `RLTT_IR_LIGUMS` = "'.dbLayer::quote_smart($contract).'",
                        `RLTT_PROJECTOR` = "'.dbLayer::quote_smart($projector).'"
                        
						where RLTT_ID="'.dbLayer::quote_smart($userId).'"';

		}

		$res=$oSQL->makeQuery($sql);

		if ($res!==false)
		{
			return true;
		}

		return false;
    }
    
    function saveUserFromCsv($data, $user){
        $isActive = 1;
        $isAdmin = 0;
        $password = '4c165f53a910a6a605c470bb2bd1debe';       
        $oSQL=new dbLayer();       
        $sql = 'INSERT into `LIETOTAJI`
                    (`RLTT_USER_NAME`, 
                    `RLTT_PAROLE`,
                    `RLTT_VARDS`,
                    `RLTT_UZVARDS`,
                    `RLTT_IR_ADMINS`,
                    `RLTT_IR_AKTIVS`, 
                    `RLTT_KWOI_KODS`, 
                    `RLTT_IR_TRASE`, 
                    `RLTT_IR_LIGUMS`,
                    `RLTT_PROJECTOR`)
                SELECT
                        "'.dbLayer::quote_smart($data[0]).'",
                        "'.$password.'",
						 "'.dbLayer::quote_smart($data[1]).'",
                         "'.dbLayer::quote_smart($data[2]).'",
                         '.$isAdmin.',
                         '.$isActive.',
						 "'.dbLayer::quote_smart($data[3]).'",
                         '.dbLayer::quote_smart($data[4]).',
                         '.dbLayer::quote_smart($data[5]).',
                         '.dbLayer::quote_smart($data[6]).' FROM DUAL
                         WHERE NOT EXISTS(SELECT 1 FROM `LIETOTAJI` 
                         WHERE `RLTT_USER_NAME` = "'.dbLayer::quote_smart($data[0]).'") 
                LIMIT 1';
        
		$res=$oSQL->makeQuery($sql);
        if ($res!==false)
		{
			return true;
		}
		return false;
    }




	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserInfo($id='', $login='', $password='')
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *, '.dbLayer::sqlParseDateTime('RLTT_DATUMS').'
                    from `LIETOTAJI` l
                    LEFT JOIN `LIETOTAJA_DARBIBAS` d ON (d.KODS = l.RLTT_DARBIBA)
					where 1	'.
					(empty($id)?'':' and l.`RLTT_ID` = "'.dbLayer::quote_smart($id).'"').
					(empty($login)?'':' and l.`RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"').
					(empty($password)?'':' and l.`RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")').
					' '
				);
		return $res;
	}

	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActiveUserList()
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
					where  `RLTT_IR_AKTIVS`=1
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserEdList($edId, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 ' : '').
                    (($edId != -1)? ' and `RLTT_KEDI_ID` = "'.dbLayer::quote_smart($edId).'" ' : ''.                  
					'order by RLTT_VARDS, RLTT_UZVARDS')
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserSectionList($section, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($section != -1)? '`RLTT_KEDI_SECTION` = "'.dbLayer::quote_smart($section).'"
                    or `RLTT_KEDI_ID` IN (select `KEDI_ID` from `KL_ED_IECIRKNI` where `KEDI_SECTION` = "'.$section.'")' : 1).'
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserWorkerList($worker, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($worker != -1)? '`RLTT_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'"' : 1).'
                    AND (`RLTT_IR_LIGUMS` = 1 OR `RLTT_IR_TRASE` = 1  )      
					GROUP by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem  kam ir tiesības veidot projektus, pēc konkrēta DU
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getProjectorWorkerList($worker = -1, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  1=1 and '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($worker != -1)? '`RLTT_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'"' : 1).'
					GROUP by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta DV iecirk�a ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserDVAreaList($area, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
					where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($area != -1)? '`RLTT_KEDI_ID` = "'.dbLayer::quote_smart($area).'"' : 1).'
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isActiveUser($userId)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select count(RLTT_ID) as `amount`
					from `LIETOTAJI`
					where  `RLTT_IR_AKTIVS`=1 ');

		return (isset($res[0]['amount']) && $res[0]['amount']>0) ? $res[0]['amount'] : false;
	}

	// -----------------------------------------------------------------------------
	// Parbauda - vai lieotajs ar tadu lietotaju vardu un parole var ienakt sistemaa vai ne
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function checkUserForLogin($login, $password='')
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
                    (empty($password)?'':' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")').
					' and `RLTT_IR_AKTIVS`=1 '  .
                    ' and ( `RLTT_IR_ADMINS` = 1 or ( `RLTT_ROLE` IS NOT NULL and  `RLTT_ROLE` <> "")
                    or ( `RLTT_KWOI_KODS` IS NOT NULL and  `RLTT_KWOI_KODS` <> "")) '
				);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}

	// -----------------------------------------------------------------------------
	// Parbauda - vai eksiste lieotajs ar tadu lietotaju vardu un parole
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isExistsUserLoginAndPassword($login, $password)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")'
				);	

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajs ar tadu lietotajam vardu un parole ir loma sist�m�
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isUserNotInRole($login, $password)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select `RLTT_ID` from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")'.
					' and `RLTT_IR_AKTIVS`=1 and `RLTT_IR_ADMINS` = 0 ' .
                    ' and ( `RLTT_ROLE` IS NULL or  `RLTT_ROLE` = "") '
				);

		if (isset($res[0]['RLTT_ID']))
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajam ir piesaist�ta loma sist�m�
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isExistsUserRole($userId)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
					' `RLTT_ID` = "'.dbLayer::quote_smart($userId).'"'.
					' and ( `RLTT_ROLE` IS NOT NULL and  `RLTT_ROLE` <> "") '
				);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
    }
    
    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajam ir piesaistita loma sistemā un lietotājs ir atzimēts ka "projektētajs"
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isExistsUserRoleWithProject($userId)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
                    ' `RLTT_ID` = "'.dbLayer::quote_smart($userId).'"'.
                    ' '					
				);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}


    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajam ir piesaist�ta loma
	// Ja jaa - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isUserInRole($userId, $role)
	{
		$oSQL=new dbLayer();
		$q = 'select * from `LIETOTAJI`
					where '.
					' `RLTT_ID` = "'.dbLayer::quote_smart($userId).'"'.
					' and `RLTT_ROLE`   = "'.dbLayer::quote_smart($role).'"';
		
		$res=$oSQL->makeQuery($q);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
	// -----------------------------------------------------------------------------
	// Noraadiito lietotaaju vaardi un uzvaardi (sagatavoti izmantoshanai atskaitees)
	// -----------------------------------------------------------------------------
	function getUserNameSurnameList($aUserScope)
	{
		$cUserString=dbLayer::parseArray($aUserScope);
		$cQuery="SELECT RLTT_ID id,CONCAT(RLTT_VARDS,' ',RLTT_UZVARDS) nosaukums
            FROM LIETOTAJI "
			.(($cUserString)?" WHERE RLTT_ID IN ".$cUserString."":"")
			." ORDER BY RLTT_UZVARDS ASC, RLTT_VARDS ASC";
		$oSQL=new dbLayer();
		$aRes=$oSQL->makeQuery($cQuery);
		return (is_array($aRes)?$aRes:array());
	}

