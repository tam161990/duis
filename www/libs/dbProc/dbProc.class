	function updateMMSWorkActive($ID, $isFinish)
	{
           $query = 'UPDATE `KL_MMS_DARBI` SET `KMSD_IR_PABEIGTS` = '.dbLayer::quote_smart($isFinish) .'
            where `KMSD_ID` = '.dbLayer::quote_smart($ID);

        $oDB = new dbLayer;
