	function getUserName($Id)
	{
		$query = 'select CONCAT(RLTT_VARDS, " ",RLTT_UZVARDS) as `NOSAUKUMS`
        from `LIETOTAJI`
        where `RLTT_ID` = "'.dbLayer::quote_smart($Id).'"';

