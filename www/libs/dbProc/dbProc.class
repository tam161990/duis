	function getActSectionName($actId) {
		$query = 'select `KEDI_SECTION`
                from KL_ED_IECIRKNI e
                inner join AKTI a ON a.RAKT_KEDI_ID = e.KEDI_ID
                        where `RAKT_ID` = "'.dbLayer::quote_smart($actId).'"
                limit 1';

            
            $oSQL = new dbLayer;
            $result = $oSQL -> makeQuery($query);
            if (isset($result[0]['KEDI_SECTION']))
            {
                return $result[0]['KEDI_SECTION'];
            }
		return false;

    }
    
    function getActEDCode($actId) {
