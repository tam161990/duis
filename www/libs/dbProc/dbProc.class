	// -----------------------------------------------------------------------------
	// Atgriezh materi�la(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false
                            )
	{
		if ($ID)
		{
            $query = 'select *,  ' .dbLayer::sqlParseDateTime('KMAT_CREATED') .',  
            ' .dbLayer::sqlParseDateTime('KMAT_EDITED') .'
				from `KL_MATERIALI`
                where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_MATERIALS);
            }

            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            
            //, SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as `KMAT_NOSAUKUMS`
            $query = 'select *, ' .dbLayer::sqlParseDateTime('KMAT_CREATED') .',
            ' .dbLayer::sqlParseDateTime('KMAT_EDITED') ."
            from `KL_MATERIALI`
            where `KMAT_KATEGORIJAS_KLASE` NOT IN ('" .CAT_CLASE_1 ."', '" .CAT_CLASE_2 ."') 
            AND ".$searchString.'
            order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh aktivus vai neaktivus materi�lus.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialActivList($activ = true)
	{       // , SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as `KMAT_NOSAUKUMS`
            $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
			$query = 'select *
            from `KL_MATERIALI`
            WHERE `KMAT_KATEGORIJAS_KLASE` NOT IN ("' .CAT_CLASE_1 .'", "' .CAT_CLASE_2 .'")  
			AND`KMAT_IR_AKTIVS` = '.(($activ) ? 1 : 0).'
            order by `'.dbLayer::quote_smart($column).'` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

	// -----------------------------------------------------------------------------
	// Saglabaa materi�lu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveMaterial($ID, $category, $code, $title, $measure, $amount, $price, $kalase, $category_measure,
        $category_descr, $is_default, $user  )
	{
        
        $query = 'SELECT `KMAT_KATEGORIJAS_NOSAUKUNS` FROM 
        `KL_MATERIALI` WHERE `KMAT_KATEGORIJAS_KODS` = "'.dbLayer::quote_smart($category).'"
        GROUP BY `KMAT_KATEGORIJAS_KODS`';
		
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);
        $category_title = isset($result[0]['KMAT_KATEGORIJAS_NOSAUKUNS']);
        
		if ($ID)
		{
			$query = 'update `KL_MATERIALI` 
				set `KMAT_KATEGORIJAS_KODS` =  "'.dbLayer::quote_smart($category).'",
                    `KMAT_KATEGORIJAS_NOSAUKUNS` = '.$category_title.',
                    `KMAT_KODS` = "'.dbLayer::quote_smart($code).'",
                    `KMAT_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KMAT_MERVIENIBA` = "'.dbLayer::quote_smart($measure).'",
                    `KMAT_DAUDZUMS` = "'.dbLayer::quote_smart($amount).'",
                    `KMAT_CENA` = "'.dbLayer::quote_smart($price).'",
                    `KMAT_KATEGORIJAS_KLASE` = "'.dbLayer::quote_smart($kalase).'",
                    `KMAT_KATEGORIJAS_MERVIENIBA` = "'.dbLayer::quote_smart($category_measure).'",
                    `KMAT_PRECIZEJUMS` = "'.dbLayer::quote_smart($category_descr).'",
                    `KMAT_NOKLUSETAIS` = "'.dbLayer::quote_smart($is_default).'",
                    `KMAT_EDITOR` = "'.dbLayer::quote_smart($user).'",
                    `KMAT_EDITED` = now()
				where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'INSERT INTO `KL_MATERIALI` 
                    (   
                            `KMAT_GRUPAS_KODS`,
                            `KMAT_GRUPAS_NOSAUKUNS`,
                            `KMAT_APAKSGRUPAS_KODS`,
                            `KMAT_APAKSGRUPAS_NOSAUKUNS`,             
                            `KMAT_KATEGORIJAS_KODS`,
                            `KMAT_KATEGORIJAS_NOSAUKUNS`,
                            `KMAT_KODS`,
                            `KMAT_NOSAUKUMS`,
                            `KMAT_MERVIENIBA`,
                            `KMAT_DAUDZUMS`,
                            `KMAT_CENA`,
                            `KMAT_KATEGORIJAS_KLASE`,
                            `KMAT_KATEGORIJAS_MERVIENIBA`,
                            `KMAT_PRECIZEJUMS`,
                            `KMAT_NOKLUSETAIS`,
                            `KMAT_EDITOR`
                    )
                    VALUES
                    (       NULL, NULL, NULL, NULL,
                            "'.dbLayer::quote_smart($category).'",
                            '.$category_title.',
                            "'.dbLayer::quote_smart($code).'",
                            "'.dbLayer::quote_smart($title).'",
                            "'.dbLayer::quote_smart($measure).'",
                            "'.dbLayer::quote_smart($amount).'",
                            "'.dbLayer::quote_smart($price).'",
                            "'.dbLayer::quote_smart($kalase).'",
                            "'.dbLayer::quote_smart($category_measure).'",
                            "'.dbLayer::quote_smart($category_descr).'",
                            "'.dbLayer::quote_smart($is_default).'",
                            "'.dbLayer::quote_smart($user).'"
                        )';
		}
        //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}
	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai materi�ls doto kodu
	// eksistee. Ja dota materi�la ID, shii materi�lam netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function materialWithCodeExists($code, $ID = false)
	{
		$query = 'select `KMAT_ID` from `KL_MATERIALI`
            where `KMAT_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KMAT_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KMAT_ID']);
    }
    
    function getMaterialCategory(){
        
        $query = 'select `KMAT_KATEGORIJAS_KODS`, `KMAT_KATEGORIJAS_NOSAUKUNS` from `KL_MATERIALI`
		WHERE `KMAT_KATEGORIJAS_KLASE` NOT IN ("' .CAT_CLASE_1 .'", "' .CAT_CLASE_2 .'")  
        order by `KMAT_KATEGORIJAS_NOSAUKUNS` asc';

        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }
	
	function getMaterialByCategory($category){
        
        $query = 'select MAX(KMAT_ID) as KMAT_ID, KMAT_KATEGORIJAS_KODS, KMAT_KATEGORIJAS_NOSAUKUNS
        from `KL_MATERIALI`
        WHERE `KMAT_KATEGORIJAS_KLASE` NOT IN ("' .CAT_CLASE_1 .'", "' .CAT_CLASE_2 .'")  
		AND `KMAT_KATEGORIJAS_KODS` LIKE "'.dbLayer::quote_smart($category).'%" 
        group by KMAT_KATEGORIJAS_KODS, KMAT_KATEGORIJAS_NOSAUKUNS
        order by `KMAT_KATEGORIJAS_NOSAUKUNS` asc';        

        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

    function getMaterialByText($text){
        
        $query = 'select MAX(KMAT_ID) as KMAT_ID, KMAT_KATEGORIJAS_KODS, KMAT_KATEGORIJAS_NOSAUKUNS
        from `KL_MATERIALI`
        WHERE `KMAT_KATEGORIJAS_KLASE` NOT IN ("' .CAT_CLASE_1 .'", "' .CAT_CLASE_2 .'")  
		AND UPPER(KMAT_KATEGORIJAS_NOSAUKUNS) LIKE UPPER("%'.dbLayer::quote_smart($text).'%")
        group by KMAT_KATEGORIJAS_KODS, KMAT_KATEGORIJAS_NOSAUKUNS
        order by `KMAT_KATEGORIJAS_NOSAUKUNS` asc';        

        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

