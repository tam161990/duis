	// -----------------------------------------------------------------------------
	// Atgriezh infomaciju par failu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFileInfo($id, $type = 'PDF' )
	{
		$oSQL=new dbLayer();
        if($type == "PDF")
        {
              $res=$oSQL->makeQuery('select RFLS_NOSAUKUMS AS NOSAUKUMS, RFLS_META_INFO AS META_INFO
               from `FAILI` where RFLS_ID="'.dbLayer::quote_smart($id).'"');
        }
        else
        {
          $res=$oSQL->makeQuery('select EFLS_NOSAUKUMS  AS NOSAUKUMS, EFLS_META_INFO AS META_INFO
               from `EXCEL_FAILI` where EFLS_ID="'.dbLayer::quote_smart($id).'"');
            }

            if (isset($res[0]))
            {
                return $res[0];
            }
            return false;
        }
        
        // funkcija kas dzēš visi akta pielikumi izņemot pēdējo
        function deleteFilesFromAct($actId, $fileId, $type = false){
            $oSQL=new dbLayer();
            $ok = true;
            $res=$oSQL->makeQuery('select RFLS_ID from `FAILI`
                                    where RFLS_RAKT_ID = '.dbLayer::quote_smart($actId).'
                                    '.(($type !== false) ? ' and RFLS_TYPE = '.dbLayer::quote_smart($fileId) : '' ) .'
                                    and RFLS_ID <>'.dbLayer::quote_smart($fileId).'');
            if(isset($res) && is_array($res)) {
                foreach($res as $r){
                    $ok = files::deleteFile($r['RFLS_ID']);                
            }
        }
        return true;
       
    }

	// -----------------------------------------------------------------------------
	// atgriezh failes datus peec acta ID
	// author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFilesInfo($actId, $type)
	{
		$oSQL=new dbLayer();
		$sql = 'select f.*,'.dbLayer::sqlParseDateTime('RFLS_DATUMS').',
                     CONCAT(lt.RLTT_VARDS," ", lt.RLTT_UZVARDS) `AUTORS`
					from `FAILI` f, `LIETOTAJI` lt
					where f.RFLS_RLTT_ID=lt.RLTT_ID
					and f.RFLS_RAKT_ID='.dbLayer::quote_smart($actId).'
                    and f.RFLS_TYPE="'.dbLayer::quote_smart($type).'"
					order by f.RFLS_ID desc';

		return $oSQL -> makeQuery($sql);
    }
    
    // dzēst visus akta failus 
    function deleteAllActFiles($actId)
	{
        $oSQL=new dbLayer();

        $res=$oSQL->makeQuery('delete from `FAILI` where RFLS_RAKT_ID = '.dbLayer::quote_smart($actId));
        if ($res!==false)
		{
			return $oSQL->makeQuery('delete from `EXCEL_FAILI` where EFLS_RAKT_ID = '.dbLayer::quote_smart($actId));
		}
    }


