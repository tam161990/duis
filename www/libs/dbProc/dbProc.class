	// -----------------------------------------------------------------------------
	// atgriezh failu skaits lietotajam
	// author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getGpsFilesCount()
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`GFLS_ID`) as `amount` from `GPS_FAILI` ';
		$res = $oSQL->makeQuery($sql);

		if (isset($res[0]['amount']))
		{
			return $res[0]['amount'];
		}
		return false;
	}

	// -----------------------------------------------------------------------------
	// Pievienoja vai maina fauli ierakstu
	// Author: Sergejs Denisovs
	// -----------------------------------------------------------------------------
	function replaceGpsFile($filename, $region='', $metaInfo='', $id=false)
	{
		$oSQL=new dbLayer();

		if (!empty($id))
		{
			$res=$oSQL->makeQuery('select * from `GPS_FAILI` where GFLS_ID="'.dbLayer::quote_smart($id).'"');
			if ($res==false)
			{
				return false;
            }
		}

		if ($id==false)
		{
			$res=$oSQL->makeQuery('insert into `GPS_FAILI`
						(`GFLS_NOSAUKUMS`,`GFLS_REGION`,`GFLS_DATUMS`,`GFLS_META_INFO`) values
						("'.dbLayer::quote_smart($filename).'",
						 "'.dbLayer::quote_smart($region).'",
						 now(),
						 "'.dbLayer::quote_smart($metaInfo).'");');

			if ($res!==false)
			{
				return true;
			}
		}
		else
		{
			$res=$oSQL->makeQuery('update `GPS_FAILI` set
						`GFLS_NOSAUKUMS`="'.dbLayer::quote_smart($filename).'",
						`GFLS_REGION`="'.dbLayer::quote_smart($region).'",
						`GFLS_DATUMS`=now(),
						`GFLS_META_INFO`="'.dbLayer::quote_smart($metaInfo).'"
						where GFLS_ID="'.dbLayer::quote_smart($id).'"');

			if ($res!==false)
			{
				return true;
			}
		}


		return false;
	}


	// -----------------------------------------------------------------------------
	// Atgriezh infomaciju par failu
	// Author: Sergejs Denisovs
	// -----------------------------------------------------------------------------
	function getGpsFileInfo($id)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `GPS_FAILI` where GFLS_ID="'.dbLayer::quote_smart($id).'"');
		if (isset($res[0]))
		{
			return $res[0];
		}
		return false;
	}

