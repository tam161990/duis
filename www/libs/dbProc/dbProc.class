                $searchString .= ' and `KEDI_IR_AKTIVS` =1 ';
            }
            $query = 'select * ,  ' .dbLayer::sqlParseDateTime('KEDI_CREATED') .',  
                    ' .dbLayer::sqlParseDateTime('KEDI_EDITED') .'
            from `KL_ED_IECIRKNI`
            where '.$searchString.'
            order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
