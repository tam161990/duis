    // -----------------------------------------------------------------------------
	// Atgriezh aktivus vai neaktivus kalkul�cijas.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationByGroupList($calc_group, $activ = true)
	{
            $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION);
            $query = 'SELECT KKAL_SHIFRS, KKAL_NOSAUKUMS, KKAL_ID
            from `KL_KALKULACIJA` a
            where `KKAL_GRUPAS_KODS` = '.dbLayer::quote_smart($calc_group).
            ' AND `KKAL_ID` IN (SELECT MAX(KKAL_ID) FROM `KL_KALKULACIJA` b WHERE b.KKAL_SHIFRS = a.KKAL_SHIFRS) '.
            ' AND `KKAL_IR_AKTIVS` = '.(($activ) ? 1 : 0).
            ' AND `KKAL_TRASE` = 0 '.
            ' order by  KKAL_SHIFRS ASC';
	        //echo $query;
	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    function getCalculationByText($text, $calc_group){
        
        $query = 'SELECT KKAL_SHIFRS, KKAL_NOSAUKUMS, MAX(KKAL_ID) as KKAL_ID
        from `KL_KALKULACIJA` a
        WHERE UPPER(KKAL_NOSAUKUMS) LIKE UPPER("%'.dbLayer::quote_smart($text).'%")'.
        ((empty($calc_group)) ? '' :  ' AND `KKAL_GRUPAS_KODS` = '.dbLayer::quote_smart($calc_group)) .
         ' AND `KKAL_IR_AKTIVS` = 1'.
         ' AND `KKAL_TRASE` = 0  '.
		 ' GROUP BY KKAL_SHIFRS, KKAL_NOSAUKUMS '.
		 ' order by  KKAL_SHIFRS ASC'; 
		//echo $query;
        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

	// -----------------------------------------------------------------------------
	// Saglabaa kalkul�cijas. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveCalculation($ID, $chipher, $code, $title, $description, $standart, $standart_np,
    $measure, $isActive, $trase, $fizRadijums = '', $koeficent = 1, $edArea, $worker, $contract, $element, $user)
    {
    
        if ($ID)
        {
            $query = 'UPDATE `KL_KALKULACIJA`
                SET `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($code).'",
                    `KKAL_SHIFRS` = "'.dbLayer::quote_smart($chipher).'",
                    `KKAL_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KKAL_MERVIENIBA` = "'.dbLayer::quote_smart($measure).'",
                    `KKAL_APRAKSTS` = "'.dbLayer::quote_smart($description).'",
                    `KKAL_FIZ_RADIJUMS` = "'.dbLayer::quote_smart($fizRadijums).'",
                    `KKAL_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'",
                    `KKAL_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'",
                    `KKAL_KEDI_KODS` = "'.dbLayer::quote_smart($edArea).'",
                    `KKAL_PLANA` = "'.dbLayer::quote_smart($standart).'",
                    `KKAL_NEPLANA` = "'.dbLayer::quote_smart($standart_np).'",
                    `KKAL_KOEFICENT` = "'.dbLayer::quote_smart($koeficent).'",
                    `KKAL_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `KKAL_IS_ELEMENT` = "'.dbLayer::quote_smart($element).'",
                    `KKAL_TRASE` = "'.dbLayer::quote_smart($trase).'",
                    `KKAL_EDITOR` = "'.dbLayer::quote_smart($user).'",
                    `KKAL_EDITED` = now()
                where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'"';

        }
        elseif ($title)
        {
            $query = 'INSERT INTO `KL_KALKULACIJA` 
            (                       
                `KKAL_GRUPAS_KODS`,
                `KKAL_SHIFRS`,
                `KKAL_NOSAUKUMS`,
                `KKAL_MERVIENIBA`,
                `KKAL_APRAKSTS`,
                `KKAL_FIZ_RADIJUMS`,
                `KKAL_KWOI_KODS`,
                `KKAL_VV_NUMBER`,
                `KKAL_KEDI_KODS`,
                `KKAL_PLANA`,
                `KKAL_NEPLANA`,
                `KKAL_KOEFICENT`,
                `KKAL_IS_ELEMENT`,
                `KKAL_TRASE`,
                `KKAL_IR_AKTIVS`,
                `KKAL_EDITOR`
            )
            VALUES
            (
                    "'.dbLayer::quote_smart($code).'",
                    "'.dbLayer::quote_smart($chipher).'",
                    "'.dbLayer::quote_smart($title).'",
                    "'.dbLayer::quote_smart($measure).'",
                    "'.dbLayer::quote_smart($description).'",
                    "'.dbLayer::quote_smart($fizRadijums).'",
                    "'.dbLayer::quote_smart($worker).'",
                    "'.dbLayer::quote_smart($contract).'",
                    "'.dbLayer::quote_smart($edArea).'",
                    "'.dbLayer::quote_smart($standart).'",
                    "'.dbLayer::quote_smart($standart_np).'",
                    "'.dbLayer::quote_smart($koeficent).'",
                    "'.dbLayer::quote_smart($element).'",
                    "'.dbLayer::quote_smart($trase).'",
                    "'.dbLayer::quote_smart($isActive).'",
                    "'.dbLayer::quote_smart( $user).'"
            )';
        }
        //echo $query;
        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);

        return ($result !== false);
    }

    

	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai kaklkul�cijas doto  �ifru
	// eksistee. Ja dota kalkul�cija ID, shii kalkul�cija netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function calculationWithChipherExists($code,  $trase = 0, $edarea, $worker, $contract, $ID = false)
	{
		$query = 'select `KKAL_ID` from `KL_KALKULACIJA`
            where `KKAL_SHIFRS` = "'.dbLayer::quote_smart($code).'"
            AND `KKAL_TRASE` = "'.dbLayer::quote_smart($trase).'"
            AND `KKAL_KEDI_KODS` = "'.dbLayer::quote_smart($edarea).'"
            AND `KKAL_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'"
            AND `KKAL_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'"';	
		if ($ID)
		{
			$query .= ' and `KKAL_ID` != '.dbLayer::quote_smart($ID).'';
		}
        //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KKAL_ID']);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo kalkul�cijas skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationCount($search = false, $column = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION);
        }
        if($column == 'GROUP')
        {
           $column = 'g.KKLG_NOSAUKUMS';
        }
        if($column == 'WORKER')
                                                               {
            $column = 'w.KWOI_NOSAUKUMS';
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'SELECT count(a.KKAL_ID) as `RECORDCOUNT` FROM (
                    select `KKAL_ID` from `KL_KALKULACIJA`
                    LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KKAL_KWOI_KODS)
                    LEFT JOIN `KL_KALKULACIJAS_GRUPAS` g ON (KKAL_GRUPAS_KODS = g.KKLG_KODS)
                    where '.$searchString.' GROUP BY `KKAL_ID`)a';
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
	}

    function saveCalculationFromCsv($data, $user){
        $query = 'INSERT INTO `KL_KALKULACIJA` 
                    (                       
                        `KKAL_GRUPAS_KODS`,
                        `KKAL_SHIFRS`,
                        `KKAL_NOSAUKUMS`,
                        `KKAL_MERVIENIBA`,
                        `KKAL_APRAKSTS`,
                        `KKAL_FIZ_RADIJUMS`,
                        `KKAL_KWOI_KODS`,
                        `KKAL_VV_NUMBER`,
                        `KKAL_KEDI_KODS`,
                        `KKAL_PLANA`,
                        `KKAL_NEPLANA`,
                        `KKAL_KOEFICENT`,
                        `KKAL_IS_ELEMENT`,
                        `KKAL_TRASE`,
                        `KKAL_IR_AKTIVS`,
                        `KKAL_CREATOR`
                    )
                    VALUES
                    (
                            "'.dbLayer::quote_smart($data[0]).'",
                            "'.dbLayer::quote_smart($data[1]).'",
                            "'.dbLayer::quote_smart($data[2]).'",
                            "'.dbLayer::quote_smart($data[3]).'",
                            "'.dbLayer::quote_smart($data[4]).'",
                            "'.dbLayer::quote_smart($data[5]).'",
                            "'.dbLayer::quote_smart($data[6]).'",
                            "'.dbLayer::quote_smart($data[7]).'",
                            "'.dbLayer::quote_smart($data[8]).'",
                            "'.dbLayer::quote_smart($data[9]).'",
                            "'.dbLayer::quote_smart($data[10]).'",
                            "'.dbLayer::quote_smart($data[11]).'",
                            "'.dbLayer::quote_smart($data[12]).'",
                            "'.dbLayer::quote_smart($data[13]).'",
                            "'.dbLayer::quote_smart($data[14]).'",
                            "'.dbLayer::quote_smart( $user).'"
                        )
                    ON DUPLICATE KEY UPDATE
                            `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($data[0]).'",
                            `KKAL_NOSAUKUMS` = "'.dbLayer::quote_smart($data[2]).'",
                            `KKAL_MERVIENIBA` = "'.dbLayer::quote_smart($data[3]).'",
                            `KKAL_APRAKSTS` = "'.dbLayer::quote_smart($data[4]).'",
                            `KKAL_FIZ_RADIJUMS` = "'.dbLayer::quote_smart($data[5]).'",
                            `KKAL_KWOI_KODS` = "'.dbLayer::quote_smart($data[6]).'",
                            `KKAL_VV_NUMBER` = "'.dbLayer::quote_smart($data[7]).'",
                            `KKAL_KEDI_KODS` = "'.dbLayer::quote_smart($data[8]).'",
                            `KKAL_PLANA` = "'.dbLayer::quote_smart($data[9]).'",
                            `KKAL_NEPLANA` = "'.dbLayer::quote_smart($data[10]).'",
                            `KKAL_KOEFICENT` = "'.dbLayer::quote_smart($data[11]).'",
                            `KKAL_IS_ELEMENT` = "'.dbLayer::quote_smart($data[12]).'",
                            `KKAL_TRASE` = "'.dbLayer::quote_smart($data[13]).'",
                            `KKAL_IR_AKTIVS` = "'.dbLayer::quote_smart($data[14]).'",
                            `KKAL_EDITOR` = "'.dbLayer::quote_smart($user).'",
                            `KKAL_EDITED` = now()
                    ';
                    //echo $query;
                    $oDB = new dbLayer;
                    $result = $oDB -> makeQuery($query);
            
                    return ($result !== false);
    }

