	function getUserWorkerList($worker, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($worker != -1)? '`RLTT_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'"' : 1).'
					GROUP by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta DV iecirk�a ietvaros
