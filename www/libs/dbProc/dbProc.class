	// -----------------------------------------------------------------------------
	function saveWorkOwner($ID, $title, $title2,  $isActive, $code, $number, $trase_number)
	{
		if ($ID)
		{
			$query = 'update `KL_WORK_OWNERS`
				set `KWOI_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KWOI_NOSAUKUMS2` = "'.dbLayer::quote_smart($title2).'",
                    `KWOI_KODS` = "'.dbLayer::quote_smart($code).'",
                    `KWOI_VV_NUMBER` = "'.dbLayer::quote_smart($number).'",
                    `KWOI_TRASE_VV_NUMBER` = "'.dbLayer::quote_smart($trase_number).'",
                    `KWOI_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"
				where `KWOI_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `KL_WORK_OWNERS`
                ( `KWOI_NOSAUKUMS`, `KWOI_NOSAUKUMS2`, `KWOI_IR_AKTIVS`, `KWOI_VV_NUMBER`, 
                `KWOI_TRASE_VV_NUMBER`, `KWOI_KODS`)
			values
                (
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($title2).'",
                "'.dbLayer::quote_smart($isActive).'",
               "'.dbLayer::quote_smart($number).'",
               "'.dbLayer::quote_smart($trasenumber).'",
                "'.dbLayer::quote_smart($code).'")';
		}
        // echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

