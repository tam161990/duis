	// -----------------------------------------------------------------------------
	// Saglabaa akta veidu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveActType($ID, $code, $title, $isActive, $isPlans, $trase, $textTpl)
	{
		if ($ID)
		{
			$query = 'update `KL_AKTA_VEIDS`
				set `KAKV_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KAKV_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `KAKV_IR_PLANS` = "'.dbLayer::quote_smart($isPlans).'",
                    `KAKV_TEXT_TMPL` = "'.dbLayer::quote_smart($textTpl).'",
                    `KAKV_TRASE` = "'.dbLayer::quote_smart($trase).'"
				where `KAKV_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `KL_AKTA_VEIDS`
                (`KAKV_KODS`, `KAKV_NOSAUKUMS`, `KAKV_IR_AKTIVS`, `KAKV_IR_PLANS`, `KAKV_TEXT_TMPL`, `KAKV_TRASE`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($isActive).'",
                "'.dbLayer::quote_smart($isPlans).'",
               "'.dbLayer::quote_smart($textTpl).'",
                "'.dbLayer::quote_smart($trase).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}



	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai akta veids ar doto  kodu
	// eksistee. Ja dots akta veida ID, shiim akta veidam netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function actTypeWithCodeExists($code, $ID = false)
	{
		$query = 'select `KAKV_ID` from `KL_AKTA_VEIDS`
            where `KAKV_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KAKV_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KAKV_ID']);
	}

