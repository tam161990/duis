                from KL_ED_IECIRKNI e
                inner join AKTI a ON a.RAKT_KEDI_ID = e.KEDI_ID
                        where `RAKT_ID` = "'.dbLayer::quote_smart($actId).'"
                limit 1';

            
            $oSQL = new dbLayer;
            $result = $oSQL -> makeQuery($query);
            if (isset($result[0]['KEDI_KODS']))
            {
                return $result[0]['KEDI_KODS'];
            }
		return false;

	}

        function processAutoActWorks($actId, $mms_code, $trase) {

            $mmsList = dbProc::getMmsWorksByCodeList($mms_code);
	        $section = dbProc::getActEDCode($actId);
            if ($mmsList!==false)
            {
                $oDB = new dbLayer;
                $aWorks = array();
                $j = 0;  
                foreach ($mmsList as $mms)
                {	
                    $query = 'SELECT '.dbLayer::quote_smart($actId).' as `AKT_ID`, `KKAL_ID`, `KKAL_SHIFRS`, 
                                `KKAL_NOSAUKUMS`, `KKAL_PLANA`, `KKAL_MERVIENIBA`, `KKAL_KEDI_KODS`,
                            CASE WHEN `KMKL_IZMANTOT_LINIJU` = 1 
                                THEN 
                                    CASE WHEN `KMKL_IZMANTOT_VADU` = 1 
                                        THEN '.$mms['KMSD_DAUDZUMS'].' * `KMKL_KOEFICENTS` * '. $mms['KMSD_VADU_SKAITS'] .'
                                    ELSE  
                                        '.$mms['KMSD_DAUDZUMS'].' * `KMKL_KOEFICENTS` 
                                    END 
                            ELSE
                                CASE WHEN `KMKL_IZMANTOT_VADU` = 1 
                                    THEN '.$mms['KMSD_VADU_SKAITS'].' 
                                ELSE
                                    `KMKL_DAUDZUMS` 
                                END 
                            END  AS `DAUDZUMS`
                            FROM `kl_mms_kalkulacija` 
                            INNER JOIN `kl_kalkulacija` ON `KKAL_SHIFRS` = `KMKL_KKAL_SHIFRS`
                            INNER JOIN  `kl_ed_iecirkni` ON `KEDI_KODS` = `KKAL_KEDI_KODS`
                            WHERE `KMKL_IR_AKTIVS` = 1 
                            AND `KKAL_KWOI_KODS` = "'.$mms['KMSD_IZPILDITAJA_KODS'].'"
			                AND `KKAL_VV_NUMBER` = "'.$mms['KMSD_VV_NUMURS'].'"
                            AND `KEDI_KODS` = "'.$mms['KMSD_KEDI_KODS'].'"
                            AND `KKAL_TRASE` = '.dbLayer::quote_smart($trase).'
                            AND (
                                ('.$mms['KMSD_KSRG_KODS'].' = 10 AND `KMKL_NOKL_SPRIEGUMS_10` = 1) OR
                                ('.$mms['KMSD_KSRG_KODS'].' <> 10 AND `KMKL_NOKL_SPRIEGUMS_NE_10` = 1)
                            )
                            AND `KMKL_KMSD_NOSACIJUMA_KODS` = "'.$mms['KMSD_NOSACIJUMA_KODS'].'"
                            ';
                   // echo $query;    
                    $res = $oDB -> makeQuery($query);
                    // print_r($res);
                        
                    foreach ($res as $work)
                    {
                        if($work['KKAL_KEDI_KODS'] != $section) {
                            continue;
                        }
                                                
                        if(isset($aWorks[$work['KKAL_SHIFRS']]) && is_array($aWorks[$work['KKAL_SHIFRS']]) )
                        {   
                                                   
                                $aWorks[$work['KKAL_SHIFRS']]['DAUDZUMS'] += $work['DAUDZUMS'];
                            
                        } else {
                           $aWorks[$work['KKAL_SHIFRS']]  = array (
                               'AKT_ID' => $work['AKT_ID'],
                               'KKAL_ID' => $work['KKAL_ID'],
                               'KKAL_SHIFRS' => $work['KKAL_SHIFRS'],
                               'KKAL_NOSAUKUMS' => $work['KKAL_NOSAUKUMS'],
                               'KKAL_PLANA' => $work['KKAL_PLANA'],
                               'KKAL_MERVIENIBA' => $work['KKAL_MERVIENIBA'],
                               'DAUDZUMS' => $work['DAUDZUMS'],
                               'CILVEKSTUNDAS' => $work['DAUDZUMS'] * $work['KKAL_PLANA']
                            );
                        }                                            
                    }                       
                }
                
                foreach ($aWorks as $row)
                { 
                   
                      
                    $query = 'INSERT into `TAME_DARBI`
                            (`DRBI_RAKT_ID`, 
                            `DRBI_KKAL_ID`, 
                            `DRBI_KKAL_SHIFRS`, 
                            `DRBI_KKAL_NOSAUKUMS`,
                            `DRBI_KKAL_NORMATIVS`, 
                            `DRBI_MERVIENIBA`, 
                            `DRBI_DAUDZUMS`, 
                            `DRBI_DAUDZUMS_KOR`,
                            `DRBI_CILVEKSTUNDAS`,
                            `DRBI_PLAN_DATE` )
                         VALUES ('.$row['AKT_ID'].','.
                               $row['KKAL_ID'].',"'.
                               $row['KKAL_SHIFRS'].'","'.
                               $row['KKAL_NOSAUKUMS'].'",'.
                               $row['KKAL_PLANA'].',"'.
                               $row['KKAL_MERVIENIBA'].'",'.
                               $row['DAUDZUMS'].','.
                               $row['DAUDZUMS'].', 
							   `DRBI_DAUDZUMS`*`DRBI_KKAL_NORMATIVS`,'.
                               '"'.DEFAULT_DATE.'"
                        )';    
                                    
                    $res = $oDB -> makeQuery($query);
                }

                dbProc::updateWorkSumms($actId, true);
            }
            return true;
        }
  
        function processAutoActMaterial($actId, $mms_code, $trase) {
           
            $calcList = dbProc::getCalcByMmsCodeList($actId, $mms_code, $trase);
            
            if ($calcList!==false)
            {
                $oDB = new dbLayer;
                $aMaterials = array();
                foreach ($calcList as $i => $mms)
                {	
                    $query = 'SELECT '.dbLayer::quote_smart($actId).' as `AKT_ID`, `KMAT_KODS`,
                                    `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, 
                                CASE WHEN `KKMT_IZMANTOT_LINIJU` = 1 AND `KKMT_NOKLUSETAIS` = 1
                                    THEN '.$mms['DAUDZUMS'].' * `KKMT_KOEFICENTS`                                       
                                    ELSE`KKMT_DAUDZUMS` 
                                END  AS `DAUDZUMS`
                                FROM `kl_kalkulacija_materiali` 
                                INNER JOIN `kl_materiali`  ON `KMAT_KODS` = `KKMT_KMAT_KODS`
                                WHERE `KKMT_IR_AKTIVS` = 1 
                                AND `KMAT_IR_AKTIVS` = 1
                                AND `KKMT_IZMANTOT_NOMENKLATURU` = 1                                
                                AND `KKMT_KKAL_SHIFRS` = "'.$mms['KMKL_KKAL_SHIFRS'].'"
                            UNION
                            SELECT y.* FROM (
                                SELECT '.dbLayer::quote_smart($actId).' as `AKT_ID`, `KMAT_KODS`,
                                    `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, 
                                    CASE WHEN `KKMT_IZMANTOT_LINIJU` = 1 
                                    THEN '.$mms['DAUDZUMS'].' * `KKMT_KOEFICENTS`                                       
                                    ELSE`KKMT_DAUDZUMS` 
                                END  AS `DAUDZUMS`
                                    FROM `kl_kalkulacija_materiali` 
                                    INNER JOIN `kl_materiali`  ON `KMAT_KATEGORIJAS_KODS` = `KKMT_KMAT_APAKSGRUPA`
                                    WHERE `KKMT_IR_AKTIVS` = 1 
                                    AND `KMAT_IR_AKTIVS` = 1
                                    AND `KKMT_IZMANTOT_NOMENKLATURU` = 0
                                    AND `KMAT_NOKLUSETAIS` = 1
                                    AND `KKMT_KKAL_SHIFRS` = "'.$mms['KMKL_KKAL_SHIFRS'].'"
                                    LIMIT 1 
                                    ) y';
                                    //echo $query;  
                    $res = $oDB -> makeQuery($query);

                    foreach ($res as $i => $mat)
                    {
                        if(isset($aMaterials[$mat['KMAT_KODS']]) && is_array($aMaterials[$mat['KMAT_KODS']])){
                            $aMaterials[$mat['KMAT_KODS']]['DAUDZUMS'] += $mat['DAUDZUMS'];
                            $aMaterials[$mat['KMAT_KODS']]['TOTAL'] += $mat['DAUDZUMS'] * $mat['KMAT_CENA'];
                        } else {
                           $aMaterials[$mat['KMAT_KODS']]  = array (
                               'AKT_ID' => $mat['AKT_ID'],
                               'KMAT_KODS' => $mat['KMAT_KODS'],
                               'KMAT_NOSAUKUMS' => $mat['KMAT_NOSAUKUMS'],
                               'KMAT_CENA' => $mat['KMAT_CENA'],
                               'KMAT_MERVIENIBA' => $mat['KMAT_MERVIENIBA'],
                               'DAUDZUMS' => $mat['DAUDZUMS'],
                               'TOTAL' => $mat['DAUDZUMS'] * $mat['KMAT_CENA']
                            );
                        }  
                    }
                }
                
                foreach ($aMaterials as $row)
                {
                        $query = 'INSERT into `TAME_MATERIALI`
                                (`MATR_RAKT_ID`, 
                                `MATR_KODS`, 
                                `MATR_NOSAUKUMS`, 
                                `MATR_MERVIENIBA`, 
                                `MATR_CENA`, 
                                `MATR_DAUDZUMS`, 
                                `MATR_DAUDZUMS_KOR`, 
                                `MATR_CENA_KOPA`)
                         VALUES ('.$row['AKT_ID'].',"'.
                               $row['KMAT_KODS'].'","'.
                               $row['KMAT_NOSAUKUMS'].'","'.
                               $row['KMAT_MERVIENIBA'].'",'.
                               $row['KMAT_CENA'].','.
                               $row['DAUDZUMS'].','.
                               $row['DAUDZUMS'].', 
			       `MATR_DAUDZUMS`*`MATR_CENA` )';     
                    $res = $oDB -> makeQuery($query);
                }
            }
            return true;
        }

        function setUnsetActItemsDate($actId, $set = false)
        {
            $oDB = new dbLayer;
            if($set) {
                $query = 'UPDATE `DARBI` SET `DRBI_APPROVE_DATE` = now() 
                        WHERE `DRBI_RAKT_ID` = ' .$actId. '
                        AND `DRBI_APPROVE_DATE` IS NULL';
                $result1 = $oDB -> makeQuery($query);
                $query = 'UPDATE `MATERIALI` SET `MATR_APPROVE_DATE` = now() 
                        WHERE `MATR_RAKT_ID` = ' .$actId. '
                        AND `MATR_APPROVE_DATE` IS NULL';
                $result1 = $oDB -> makeQuery($query);
                
            } else {
                $query = 'UPDATE `DARBI` SET `DRBI_APPROVE_DATE` = "NULL"
                        WHERE `DRBI_RAKT_ID` = ' .$actId. '
                        AND `DRBI_APPROVE_DATE` IS NOT NULL
                        AND `DRBI_APPROVE_DATE` = (SELECT MAX(d.DRBI_APPROVE_DATE) FROM darbi d 
                                                                WHERE d.DRBI_RAKT_ID ='. $actId.')';
                $result = $oDB -> makeQuery($query);
                $query = 'UPDATE `MATERIALI` SET `MATR_APPROVE_DATE` = "NULL"
                WHERE `MATR_RAKT_ID` = ' .$actId. '
                AND `MATR_APPROVE_DATE` IS NOT NULL
                AND `MATR_APPROVE_DATE` = (SELECT MAX(m.MATR_APPROVE_DATE) FROM MATERIALI m 
                                                        WHERE m.MATR_RAKT_ID ='. $actId.')';
                $result = $oDB -> makeQuery($query);
                
            }
           
            return ($result !== false);
        }

