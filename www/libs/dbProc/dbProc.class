    // -----------------------------------------------------------------------------
	// Atgriezh kopeejo mms-kalkul�cijas skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationMaterialCount($search = false, $column = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION_MATERIAL);
        }
        if($column == 'KMAT_GRUPA' && !($search === false || $search == '')) 
        {
                $cat = explode(".", $search);
                if (count($cat) == 1) {
                    $searchString = '(`KKMT_KMAT_GRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%" OR 
                                `KKMT_KMAT_APAKSGRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%") ';
                }
                else {
                    $searchString = '(`KKMT_KMAT_GRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%" AND 
                                `KKMT_KMAT_APAKSGRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[1])).'%") ';
                }
        }
        else {
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        }
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'select count(`KKMT_ID`) as `RECORDCOUNT` from `KL_KALKULACIJA_MATERIALI`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cija(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationMaterialList($ID = false, $offset = false, $limit = false,
                                    $search =  false,
                                    $column = false,
                                    $order =  'ASC',
                                    $orderColumn = false)
    {
        if ($ID)
        {
            $query = 'select *,  CONCAT(`KKMT_KMAT_GRUPA`, ".", `KKMT_KMAT_APAKSGRUPA`) as `KMAT_GRUPA`, 
                ' .dbLayer::sqlParseDateTime('KKMT_CREATED') .',  
                ' .dbLayer::sqlParseDateTime('KKMT_EDITED') .', `KKAL_NOSAUKUMS`, `KMAT_KATEGORIJAS_NOSAUKUNS`
                from `KL_KALKULACIJA_MATERIALI`
                LEFT JOIN `kl_kalkulacija` ON `KKAL_SHIFRS` = 	`KKMT_KKAL_SHIFRS`
                LEFT JOIN `kl_materiali` ON KMAT_KATEGORIJAS_KODS = `KKMT_KMAT_GRUPA`
                where `KKMT_ID` = "'.dbLayer::quote_smart($ID).'"';

                
                
        }
        else
        {
            if($column === false)
            {
                $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION_MATERIAL);
            }
           
            if($orderColumn === false)
            {
                $orderColumn = dbProc::getKlklDefaultColumn(KL_CALCULALATION_MATERIAL);
            }
            if($orderColumn == 'KMAT_GRUPA')
            {
                $orderColumn = 'KKMT_KMAT_GRUPA';
            }
            
            
            if($column == 'KMAT_GRUPA' && !($search === false || $search == '')) 
            {
                $cat = explode(".", $search);
                if (count($cat) == 1) {
                    $searchString = '(`KKMT_KMAT_GRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%" OR 
                                `KKMT_KMAT_APAKSGRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%") ';
                }
                else {
                    $searchString = '(`KKMT_KMAT_GRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[0])).'%" AND 
                                `KKMT_KMAT_APAKSGRUPA` LIKE "%'.dbLayer::quote_smart(text::toUpper($cat[1])).'%") ';
                }
            }
            else {
                $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            }

            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }

           
            $query = 'select DISTINCT *,  CONCAT(`KKMT_KMAT_GRUPA`, ".", `KKMT_KMAT_APAKSGRUPA`) as `KMAT_GRUPA`, 
                ' .dbLayer::sqlParseDateTime('KKMT_CREATED') .',  
                ' .dbLayer::sqlParseDateTime('KKMT_EDITED') .', 
                (SELECT DISTINCT `KKAL_NOSAUKUMS` FROM `kl_kalkulacija` WHERE `KKAL_SHIFRS` = `KKMT_KKAL_SHIFRS` LIMIT 1) as `KKAL_NOSAUKUMS`, 
                (SELECT DISTINCT `KMAT_KATEGORIJAS_NOSAUKUNS` FROM `kl_materiali` WHERE KMAT_KATEGORIJAS_KODS = `KKMT_KMAT_GRUPA` LIMIT 1) as `KMAT_KATEGORIJAS_NOSAUKUNS`
                    from `KL_KALKULACIJA_MATERIALI`
                    where '.$searchString.'
                    order by  '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
            if (($offset !== false) && $limit)
            {
                $query .= ' limit '.
                ($offset ? (int)$offset.', ' : '').
                (int)$limit;
            }
        }
        //echo $query;
        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
        
    }

    // -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai kaklkulācijas-materiāls ar doto  grupu, šifru un materiāla kodu
	// eksistee. Ja dota kaklkulācijas-materiāla ID, shī kaklkulācijas-materiāls netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function calcMaterialWithChipherExists($group, $subgroup, $code, $mater_code, $ID = false)
	{
		$query = 'select `KKMT_ID` from `KL_KALKULACIJA_MATERIALI`
            where `KKMT_KMAT_GRUPA` = "'.dbLayer::quote_smart($group).'"
            AND `KKMT_KMAT_APAKSGRUPA` = "'.dbLayer::quote_smart($subgroup).'"
            AND `KKMT_KKAL_SHIFRS` = "'.dbLayer::quote_smart($code).'"
            AND `KKMT_KMAT_KODS` = "'.dbLayer::quote_smart($mater_code).'"';
		if ($ID)
		{
			$query .= ' and `KKMT_ID` != "'.dbLayer::quote_smart($ID).'"';
		}
        //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KKMT_ID']);
    }

    // -----------------------------------------------------------------------------
	// Saglabaa kaklkulācijas-materiāls. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveCalcMaterial($ID, 
                                $chipher,
                                $group,
                                $subgroup,
                                $matr_code,
                                $useMaterial=1,
                                $isDefault=1,
                                $amount=1,
                                $useLine=0,
                                $koeficent=1,
                                $useCord=0,
                                $isActive=1,
                                $user)
    {
        
            if ($ID)
            {
                $query = 'UPDATE `KL_KALKULACIJA_MATERIALI`
                    SET `KKMT_KKAL_SHIFRS` = "'.dbLayer::quote_smart($chipher).'",
                        `KKMT_KMAT_GRUPA` = "'.dbLayer::quote_smart($group).'",
                        `KKMT_KMAT_APAKSGRUPA` = "'.dbLayer::quote_smart($subgroup).'",
                        `KKMT_KMAT_KODS` = "'.dbLayer::quote_smart($matr_code).'",
                        `KKMT_IZMANTOT_NOMENKLATURU` = "'.dbLayer::quote_smart($useMaterial).'",
                        `KKMT_NOKLUSETAIS` = "'.dbLayer::quote_smart($isDefault).'",
                        `KKMT_DAUDZUMS` = "'.dbLayer::quote_smart($amount).'",
                        `KKMT_IZMANTOT_LINIJU` = "'.dbLayer::quote_smart($useLine).'",
                        `KKMT_KOEFICENTS` = "'.dbLayer::quote_smart($koeficent).'",
                        `KKMT_IZMANTOT_VADU` = "'.dbLayer::quote_smart($useCord).'",
                        `KKMT_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                        `KKMT_EDITOR` = "'.dbLayer::quote_smart($user).'",
                        `KKMT_EDITED` = now()
                    where `KKMT_ID` = "'.dbLayer::quote_smart($ID).'"';

            }
            elseif ($chipher)
            {
                $query = 'INSERT INTO `KL_KALKULACIJA_MATERIALI` 
                (                       
                    `KKMT_KKAL_SHIFRS`,
                    `KKMT_KMAT_GRUPA`,
                    `KKMT_KMAT_APAKSGRUPA`,
                    `KKMT_KMAT_KODS`,
                    `KKMT_IZMANTOT_NOMENKLATURU`,
                    `KKMT_NOKLUSETAIS`,
                    `KKMT_DAUDZUMS`,
                    `KKMT_IZMANTOT_LINIJU`,
                    `KKMT_KOEFICENTS`,
                    `KKMT_IZMANTOT_VADU`,
                    `KKMT_IR_AKTIVS`,
                    `KKMT_CREATOR`
                )
                VALUES
                (
                        "'.dbLayer::quote_smart($chipher).'",
                        "'.dbLayer::quote_smart($group).'",
                        "'.dbLayer::quote_smart($subgroup).'",
                        "'.dbLayer::quote_smart($matr_code).'",
                        "'.dbLayer::quote_smart($useMaterial).'",
                        "'.dbLayer::quote_smart($isDefault).'",
                        "'.dbLayer::quote_smart($amount).'",
                        "'.dbLayer::quote_smart($useLine).'",
                        "'.dbLayer::quote_smart($koeficent).'",
                        "'.dbLayer::quote_smart($useCord).'",
                        "'.dbLayer::quote_smart($isActive).'",
                        "'.dbLayer::quote_smart( $user).'"
                    )';
            }
            //echo $query;
            $oDB = new dbLayer;
            $result = $oDB -> makeQuery($query);

            return ($result !== false);
        }

        //////////////////////////
        // AUTO ACT//////////////
        // -----------------------------------------------------------------------------
        // Saglabaa akta statusu, saņemtu no KWIKSEP
        // Author: Tatjana Fedorkova
        // -----------------------------------------------------------------------------
        function saveKvikStepActStatus($code, 
                                        $status = false, 
                                        $user_name = false, 
                                        $end_date = false,
                                        $accept_date = false
                                        )
        { 
            $descr = $code .'/'.$status.'/'.$user_name.'/'.$end_date.'/'.$accept_date;
           
            $oDB = new dbLayer;
            $query = 'insert into `AUTO_ACT_STATUS`
                        (
                            `AAST_KODS`,                            
                            `AAST_DESCRIPTION`,
							`AAST_STATUS`,
                            `USER_NAME`,
                            `END_DATE`,
                            `ACCEPT_DATE`
                        )
                        values ( "'.$code.'",
                        "'.$descr.'",
                        '.(($status !== false) ? '"' .$status .'"' : '"NULL"') .',
						 '.(($user_name !== false) ? '"' .$user_name .'"' : '"NULL"') .',
                          '.(($end_date !== false) ? '"' .$end_date .'"' : '"NULL"') .',
                          '.(($accept_date !== false) ? '"' .$accept_date .'"' : '"NULL"') .'
                        ) ';
                            
				//echo $query;
                $result = $oDB -> makeQuery($query);

                $query = 'insert into `AUTO_ACT_STATUS_LOG`
                        (
                            `AAST_KODS`,                            
                            `AAST_DESCRIPTION`,
							`AAST_STATUS`,
                            `USER_NAME`,
                            `END_DATE`,
                            `ACCEPT_DATE`
                        )
                        values ( "'.$code.'",
                        "'.$descr.'",
                        '.(($status !== false) ? '"' .$status .'"' : '"NULL"') .',
						 '.(($user_name !== false) ? '"' .$user_name .'"' : '"NULL"') .',
                          '.(($end_date !== false) ? '"' .$end_date .'"' : '"NULL"') .',
                          '.(($accept_date !== false) ? '"' .$accept_date .'"' : '"NULL"') .'
                        ) ';
                            
				//echo $query;
                $result = $oDB -> makeQuery($query);


                return ($result !== false);
        }

        function updateActStatusFromKvikStep()
        { 
            
            $query = 'SELECT `AAST_KODS`, `AAST_STATUS`, `RAKT_ID`, `USER_NAME`, `END_DATE`, `RAKT_STATUS`,
                                 `AAST_ID`, `RAKT_TRASE`, `ACCEPT_DATE`, `RAKT_PROJECT`, `RAKT_RLTT_ID`
                                FROM `AUTO_ACT_STATUS` 
                                INNER JOIN  `AKTI` ON `RAKT_NUM_POSTFIX` = `AAST_KODS`
                                WHERE  `AAST_KODS` IS NOT NULL 
                                AND `AAST_STATUS` IS NOT NULL
                                AND `RAKT_STATUS` IN ( "'.STAT_AUTO.'", "'.STAT_ACCEPT.'", "'.STAT_INSERT.'", 
                                "'.STAT_WRETEDOFF.'", "'.STAT_CLOSE.'" )
                                ORDER BY AAST_CREATED';
            //echo $query;
           // files::wh_log('Update act status: ' .date("d.m.Y H:i:s").PHP_EOL. $query);						
            $oSQL = new dbLayer;
            $res = $oSQL -> makeQuery($query);
            $r= false;
			$r1= false;
			$r2= false;
            if ($res!==false)
            {
              //files::wh_log('Update act status $res!==false ' .date("d.m.Y H:i:s").PHP_EOL);
              $status = '';
              foreach ($res as $i => $act)
              {	    
                files::wh_log('Update act status AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                                    'AAST_ID:' .$act['AAST_ID'].PHP_EOL  );		
                                    
                $user_id = false;
                $place = false;
                $end_date = false;
                $accept_date = false;
				$actId = $act['RAKT_ID'];
                $cur_user_id = $act['RAKT_RLTT_ID'];

                if(isset($act['USER_NAME'])){
                    $userInfo = dbProc::getUserInfo('', $act['USER_NAME']);
                    if(count($userInfo) >0 )
                    {
                        $user_id = $userInfo[0]['RLTT_ID'];
						if(isset($userInfo[0]['RLTT_MSTK_ID']))
							$place = $userInfo[0]['RLTT_MSTK_ID'];		
						
                    }
                }
                if(isset($act['END_DATE']))
                {
                    $end_date = $act['END_DATE'];
                }
                if(isset($act['ACCEPT_DATE']))
                {
                    $accept_date = $act['ACCEPT_DATE'];
                }
               

                switch ($act['AAST_STATUS']) {
                    /*Ja Akts ir statusā  “Saskaņošana” un no KS atnāks “Ievads” + cits lietotājs  tad uz Ievadu nepāriet un nomainās tikai lietotājs
                    Ja Akts ir statusā  “Saskaņošana” un no KS atnāks “Ievads” + tas pats lietotājs  tad uz Ievadu pāriet;
                    KS statusi ir primāri, ja atnāk no KS statuss ar datumu un DUISā jau manuāli ir šis statuss, tad jāpārraksta 
                    tukšajām rindiņām datumu (tikai CLOSE)
                    */
                    case 'INSERT':
                        $status = (($act['RAKT_STATUS'] == STAT_ACCEPT && $user_id !== false && $user_id != $cur_user_id) ? 
                            $act['RAKT_STATUS'] : STAT_INSERT );
                        break;
                    case 'RETURN':
                        $status = STAT_RETURN;
                        break;                   
                    case 'CLOSE':
                        $status = (($act['RAKT_STATUS'] == STAT_ACCEPT || $act['RAKT_STATUS'] == STAT_CLOSE ) ? STAT_CLOSE : $act['RAKT_STATUS']);
                        break;       
                    case 'AUTO':
                        $status = $act['RAKT_STATUS'];
                        break;                               
                }

                if($status == STAT_CLOSE && !isset($act['ACCEPT_DATE']) )
                {
                    $accept_date = dbLayer::parseDate(dtime::now());
                }

                files::wh_log('Update act status: ' .date("d.m.Y H:i:s").PHP_EOL. 
									'AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
									'RAKT_STATUS: '.$status.PHP_EOL.
									'RAKT_RLTT_ID: '.$user_id.PHP_EOL.
									'RAKT_MSTK_ID: '.$place.PHP_EOL.
                                    					'RAKT_IZPILDES_DATUMS:' .$end_date.PHP_EOL.
                                    					'AAST_ID:' .$act['AAST_ID'].PHP_EOL
							);						

                				
                $query = 'UPDATE `AKTI` SET `RAKT_STATUS`  = "' .$status .'"
						'.(($user_id !== false ) ? ',`RAKT_RLTT_ID`  = ' .$user_id : '' ) .'						
                        '.(($place !== false ) ? ',`RAKT_MSTK_ID`  = ' .$place : '' ) .'
						'.(($end_date !== false ) ? ',`RAKT_IZPILDES_DATUMS`  = "' .$end_date .'"' : '' ) .'
                        WHERE `RAKT_ID` = '.$actId;  
				
               
                $r1 = $oSQL -> makeQuery($query);
               
		if ($r1!==false) {				

                    
                    if($status == STAT_RETURN) {
                        $r2 = dbProc::setUnsetActItemsDate($actId, false);
                        if ($r2===false)    {        
                            files::wh_log('ERROR setUnsetActItemsDate: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                                'AAST_ID:' .$act['AAST_ID'].PHP_EOL
                            );	
                        }
                    }

                    if(($act['RAKT_STATUS'] == STAT_ACCEPT || $act['RAKT_STATUS'] == STAT_WRETEDOFF || $act['RAKT_STATUS'] == STAT_CLOSE ||
                         $act['RAKT_STATUS'] == STAT_INSERT ) && $accept_date !== false) {
                        $r2 = dbProc::setApproveDate($actId, $accept_date);
                        if ($r2===false)    {        
                            files::wh_log('ERROR setApproveDate: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                                'AAST_ID:' .$act['AAST_ID'].PHP_EOL.
                                'accept_date:' .$accept_date.PHP_EOL
                            );						

                        }
                    }

                    if($status == STAT_CLOSE && $act['RAKT_TRASE'] = 1 ) {
                        toPdf::approvedTrasePdf($actId, MAIN_ADMIN_ID, FILE_ESTIMATE);
                    }
                    if($status == STAT_CLOSE && $act['RAKT_PROJECT'] = 1 ) {
                        $fileId = dbProc::getExcelId($actId);
                        if($fileId !== false && !TEST_MODE) {
                            // sūta file link uz KvikStep                            
                            RequestHandler::sentExcelToKvikStep($act['AAST_KODS'], $fileId);
                        }
                    }

                    // save status changed time
                    $query = 'INSERT INTO `AKTA_STATUSA_MAINA` (AAUD_RAKT_ID, AAUD_RLTT_ID, AAUD_STATUS) 	
                    VALUES 	('.$actId.', '.MAIN_ADMIN_ID.', "'.$status.'" )';

                    $r = $oSQL -> makeQuery($query);
                    if ($r===false)    {        
                        files::wh_log('ERROR INSERT INTO `AKTA_STATUSA_MAINA`: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                            'AAST_ID:' .$act['AAST_ID'].PHP_EOL.$query
                        );

                    }
                    
                    $query = 'UPDATE `AUTO_ACT_STATUS`   SET 
                    `AAST_STATUS` = "NULL",  `USER_NAME` = "NULL", `END_DATE` = "NULL"
                    WHERE `AAST_ID` = ' . $act['AAST_ID'];

                    //echo $query;
                    $r = $oSQL -> makeQuery($query);
                    if ($r===false)    {        
                        files::wh_log('ERROR UPDATE `AUTO_ACT_STATUS`: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                            'AAST_ID:' .$act['AAST_ID'].PHP_EOL.$query
                        );						

                    }      
                    
                } else {
                    files::wh_log('ERROR Update act: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                                    'AAST_ID:' .$act['AAST_ID'].PHP_EOL.$query
							);						

                }               
              }
            }
			return true;
            
        }
        
        function processAutoActs($user) {

            $query = 'SELECT `KMSD_ID`,
							`KMSD_KODS`,
							`KMSD_OPERATIVAS_APZIM`,
                            `KMSD_WORK_TITLE`, 
                            '. dbLayer::sqlParseDate('KMSD_IZPILDES_DATUMS') .',                        
                            `KEDI_ID`,
                            `KMSD_VV_NUMURS`,
							`KMSD_IR_EPLA`,
							`KMSD_TO_ID`,                      
							`KSRG_ID`,
							`KOBJ_ID`,
                            `KMSD_IZPILDITAJA_KODS`
					FROM (
							SELECT MAX(`KMSD_ID`) as KMSD_ID,
							`KMSD_KODS`,
							MAX(`KMSD_OPERATIVAS_APZIM`) as KMSD_OPERATIVAS_APZIM,
							MAX(`KMSD_WORK_TITLE`) as KMSD_WORK_TITLE,
							MAX(`KMSD_IZPILDES_DATUMS`) as `KMSD_IZPILDES_DATUMS`,                        
                            MAX(IFNULL(`KEDI_ID`, 0)) as `KEDI_ID`,
                            MAX(`KMSD_VV_NUMURS`) as `KMSD_VV_NUMURS`,
							MAX(`KMSD_IR_EPLA`) as KMSD_IR_EPLA,
							MAX(`KMSD_TO_ID`) as KMSD_TO_ID,                      
							MAX(IFNULL(`KSRG_ID`, false)) as `KSRG_ID`,
                            MAX(IFNULL(`KOBJ_ID`, false)) as `KOBJ_ID`,
                            MAX(`KMSD_IZPILDITAJA_KODS`) as `KMSD_IZPILDITAJA_KODS`
						FROM  `KL_MMS_DARBI`
						LEFT JOIN `kl_ed_iecirkni` ON `KEDI_KODS` = `KMSD_KEDI_KODS`
						LEFT JOIN  `kl_objekti` ON `KOBJ_KODS`= `KMSD_KOBJ_KODS`
						LEFT JOIN  `kl_spriegums` ON `KSRG_KODS` = `KMSD_KSRG_KODS`
						WHERE NOT EXISTS (SELECT 1 FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = `KMSD_KODS`)
						GROUP BY `KMSD_KODS`
					) y ';
            //AND `KMSD_KODS` = "REM-100004"

            $oDB = new dbLayer;
            $res = $oDB -> makeQuery($query);

            if ($res!==false)
            {
              foreach ($res as $i => $mms)
              {	
                  if($mms['KEDI_ID'] == 0) continue;
                  $r = false;
                  $r1 = false;
                 
                  $r = dbProc::saveAct(false,
                                       false,
                                       0,
                                       $mms['KMSD_IZPILDES_DATUMS'],
                                       false,
                                       false,
                                       $mms['KMSD_OPERATIVAS_APZIM'],
                                       false,
                                       STAT_AUTO,
                                       $user,                                      
                                       $mms['KOBJ_ID'],
                                       $mms['KSRG_ID'],
                                       (($mms['KMSD_IR_EPLA'] == 1) ? ACT_TYPE_PLAN_TR_ID: ACT_TYPE_PLAN_ID),
                                       $mms['KMSD_IZPILDITAJA_KODS'],
                                        $mms['KEDI_ID'],
                                        1,
                                        $mms['KMSD_IR_EPLA'], 
                                        $mms['KMSD_KODS'],
                                        $mms['KMSD_WORK_TITLE'],
                                        $mms['KMSD_VV_NUMURS'],
                                        false,
                                        $mms['KMSD_TO_ID'],
                                        (($mms['KMSD_IR_EPLA'] == 1) ? 'E': 'K'),                                        
                                        1
                                );
                    
                    if($r) {
                        $actId=dbLayer::getInsertId();
                        
                        if(isset($actId)) {
                            $r1 = dbProc::processAutoActWorks($actId, $mms['KMSD_KODS'], $mms['KMSD_IR_EPLA']);
                        }

                        if($r1) {
                            $r1 = dbProc::processAutoActMaterial($actId, $mms['KMSD_KODS'], $mms['KMSD_IR_EPLA']);
                        }

                        if($r1) {
                            // sūta statusu uz KvikStep                            
                            $r1 = dbProc::sentDataToKvikStep($actId, $mms['KMSD_KODS'], $mms['KMSD_IR_EPLA']);
                        }
                    }
                }
            return true;
            
            }
        }

        function sentDataToKvikStep($actId, $mms_kods, $trase = 0) {
            $oDB = new dbLayer;

            $query = 'SELECT SUM(DRBI_CILVEKSTUNDAS) as CILVEKSTUNDAS FROM 
             `TAME_DARBI` WHERE `DRBI_RAKT_ID` = ' .dbLayer::quote_smart($actId);
            $result = $oDB -> makeQuery($query);
            $workTotal = isset($result[0]['CILVEKSTUNDAS']) ? $result[0]['CILVEKSTUNDAS'] : 0;

            $query = 'SELECT SUM(MATR_CENA_KOPA) as TOTAL FROM 
             `TAME_MATERIALI` WHERE `MATR_RAKT_ID` = ' .dbLayer::quote_smart($actId);
            $result = $oDB -> makeQuery($query);			
            $materialTotal = isset($result[0]['TOTAL']) ? $result[0]['TOTAL'] : 0;
            //echo $mms_kods.' '.$workTotal.' '.$materialTotal;
            
            $aWorkSums = dbProc::getActWorkSumms($actId, 1);
                           
            RequestHandler::sentDataToKvikStep ($mms_kods, 
                                                $trase,
                                                $workTotal, 
                                                $materialTotal, 
                                                $aWorkSums[0]['m3'],
                                                $aWorkSums[0]['ha'],
                                                $aWorkSums[0]['km'],
                                                $aWorkSums[0]['gab']
                                                );
           
        }

        // -----------------------------------------------------------------------------
        // Atgriezh kalkulacijas pēc nomenklatūras koda
        // Author: Tatjana Fedorkova
        // -----------------------------------------------------------------------------
        function getCalcByMmsCodeList($actId, $mms_code, $trase)
        {
                
            $query = 'select DISTINCT `KMKL_KKAL_SHIFRS` ,  `KMSD_DAUDZUMS`, `KMSD_VADU_SKAITS`, `DRBI_DAUDZUMS_KOR` as `DAUDZUMS`
                from `kl_mms_darbi`
                INNER JOIN `kl_mms_kalkulacija` ON `KMKL_KMSD_NOSACIJUMA_KODS` = `KMSD_NOSACIJUMA_KODS`  
                INNER JOIN `TAME_DARBI` ON `DRBI_KKAL_SHIFRS` = `KMKL_KKAL_SHIFRS`              
                where `KMSD_KODS` = "'.dbLayer::quote_smart($mms_code).'"
		AND `DRBI_RAKT_ID` = '.dbLayer::quote_smart($actId).'
                AND EXISTS (SELECT 1 FROM  `kl_kalkulacija_materiali` WHERE `KKMT_KKAL_SHIFRS` = `KMKL_KKAL_SHIFRS`)
				AND (
                                (`KMSD_KSRG_KODS` = 10 AND `KMKL_NOKL_SPRIEGUMS_10` = 1) OR
                                (`KMSD_KSRG_KODS` <> 10 AND `KMKL_NOKL_SPRIEGUMS_NE_10` = 1)
                 )
                AND `KMKL_TRASE` = '.dbLayer::quote_smart($trase).'
                AND `KMKL_IR_AKTIVS` = 1';
            
            $oSQL = new dbLayer;
            return $oSQL -> makeQuery($query);
        }

        // -----------------------------------------------------------------------------
        // Atgriezh mms darbus pēc noteikta koda
