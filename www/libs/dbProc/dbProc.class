	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveCalculationTr($ID, $chipher, $code, $title, $description,
        $measure, $isActive, $fizRadijums = '',  $worker, $edArea,
        $planPrice, $notPlanPrice, $element, $contract, $isMain = true)
	{
        $tableName  = (($isMain)? 'KL_KALKULACIJA_TRASE' : 'KL_KALKULACIJA_TRASE_TEMP');
