                    `KMSD_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'",
                    `KMSD_TRASE` = "'.dbLayer::quote_smart($trase).'",
                     `KMSD_OPERATIVAS_APZIM` = "'.dbLayer::quote_smart($designation).'",
	    `KMSD_WORK_TITLE` = "'.dbLayer::quote_smart($workTitle).'",  
		`KMSD_TO_IDN` = "'.dbLayer::quote_smart($toidn).'",
		`KMSD_TO_ID` = "'.dbLayer::quote_smart($toid).'",
                    `KMSD_1Z` = "'.dbLayer::quote_smart($z1).'",
                    `KMSD_2Z` = "'.dbLayer::quote_smart($z2).'",
                    `KMSD_3Z` = "'.dbLayer::quote_smart($z3).'",
                    `KMSD_4Z` = "'.dbLayer::quote_smart($z4).'",
                    `KMSD_5Z` = "'.dbLayer::quote_smart($z5).'",
                    `KMSD_6Z` = "'.dbLayer::quote_smart($z6).'",
                    `KMSD_7Z` = "'.dbLayer::quote_smart($z7).'",
                    `KMSD_8Z` = "'.dbLayer::quote_smart($z8).'",
                    `KMSD_9Z` = "'.dbLayer::quote_smart($z9).'",
                    `KMSD_1V` = "'.dbLayer::quote_smart($v1).'",
                    `KMSD_2V` = "'.dbLayer::quote_smart($v2).'",
                    `KMSD_3V` = "'.dbLayer::quote_smart($v3).'",
                    `KMSD_4V` = "'.dbLayer::quote_smart($v4).'",
                    `KMSD_5V` = "'.dbLayer::quote_smart($v5).'",
