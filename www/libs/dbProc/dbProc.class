	function getKlklName($cCatalogName)
	{
		$cQuery="SELECT KLKL_ID id, KLKL_COLUMN kolonna, KLKL_TITLE nosaukums, KLKL_IS_DEFAULT def
        FROM KL_REF_KOLONNAS
        WHERE KLKL_CATALOG='".$cCatalogName."' ORDER BY KLKL_ID ASC";

		$oSQL=new dbLayer();
		$aRes=$oSQL->makeQuery($cQuery);
		return (is_array($aRes)?$aRes:array());
	}
// =============================================================================
// KL_REGIONI
// =============================================================================
// -----------------------------------------------------------------------------
	// Atgriezh regionus. Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getRegionList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false,
                            $showOnlyActiv = false)
	{
		if ($ID)
		{
			$query = 'select *
				from `KL_REGIONI`
				where `REGI_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_REGIONS);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_REGIONS);
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            if($showOnlyActiv !== false)
            {
                $searchString .= ' and `REGI_IR_AKTIVS` =1 ';
            }
			$query = 'select * from `KL_REGIONI`
            where '.$searchString.'
            order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa ED iecirk�u. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveRegion($ID, $code, $title, $isActive, $isMain = true)
	{
	    $tableName  = 'KL_REGIONI' ;
		if ($ID)
		{
			$query = 'update `'.$tableName.'`
				set `REGI_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `REGI_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `REGI_KODS` = "'.dbLayer::quote_smart($code).'"
				where `REGI_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into  `'.$tableName.'`
                (`REGI_KODS`, `REGI_NOSAUKUMS`, `REGI_IR_AKTIVS`)
			values
                (
                "'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($isActive).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}


	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo ED iecirk�u skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getRegionCount($search = false, $column = false, $showOnlyActiv = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_REGIONS);
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        if($showOnlyActiv !== false)
        {
           $searchString .= ' and `REGI_IR_AKTIVS` =1 ';
        }
        $query =  'select count(`REGI_ID`) as `REGI_COUNT` from `KL_REGIONI`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['REGI_COUNT']) ? $result[0]['REGI_COUNT'] : false;
	}

// =============================================================================
// KL_ED_IECIRKNI
// =============================================================================
    // -----------------------------------------------------------------------------
	// Atgriezh EV iecirkna pilnu nosaukumu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getEDAreaName($Id)
	{
		$query = 'select CONCAT(KEDI_REGIONS," : ", KEDI_KODS," : ", KEDI_NOSAUKUMS ) `NOSAUKUMS`
        from `KL_ED_IECIRKNI`
        where `KEDI_ID` = "'.dbLayer::quote_smart($Id).'"';

		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
		if (isset($result[0]['NOSAUKUMS']))
		{
			return $result[0]['NOSAUKUMS'];
		}
		return false;
	}



	// -----------------------------------------------------------------------------
	// Atgriezh ED iecik�u(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getEDAreaList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false,
                            $showOnlyActiv = false)
	{
		if ($ID)
		{
			$query = 'select *
				from `KL_ED_IECIRKNI`
				where `KEDI_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_ED_AREA);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_ED_AREA);
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            if($showOnlyActiv !== false)
            {
                $searchString .= ' and `KEDI_IR_AKTIVS` =1 ';
            }
			$query = 'select * from `KL_ED_IECIRKNI`
            where '.$searchString.'
            order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

