	function getKlklDefaultColumn($cCatalogName)
	{
		$query = 'select KLKL_COLUMN kolonna from `KL_REF_KOLONNAS`
        WHERE KLKL_CATALOG="'.$cCatalogName.'" and KLKL_IS_DEFAULT = 1';

