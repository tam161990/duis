	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")'
				);	

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajs ar tadu lietotajam vardu un parole ir loma sist�m�
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isUserNotInRole($login, $password)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select `RLTT_ID` from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")'.
					' and `RLTT_IR_AKTIVS`=1 and `RLTT_IR_ADMINS` = 0 ' .
                    ' and ( `RLTT_ROLE` IS NULL or  `RLTT_ROLE` = "") '
				);

		if (isset($res[0]['RLTT_ID']))
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
