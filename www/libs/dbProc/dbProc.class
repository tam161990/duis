	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo materi�la skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialCount($search = false, $column = false, $showOnlyActiv = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
        }

        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        if($showOnlyActiv !== false)
        {
            $searchString .= ' and `KMAT_IR_AKTIVS` =1 ';
        }
        $query =  "select count(`KMAT_ID`) as `RECORDCOUNT` from `KL_MATERIALI`
        where `KMAT_KATEGORIJAS_KLASE` NOT IN ('" .CAT_CLASE_1 ."', '" .CAT_CLASE_2 ."') 
        AND ".$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
    }
    
    

    function saveMaterialFromCsv($data, $user){
        $material_kagegory = explode('.', $data[4]);      
        $query = 'INSERT INTO `KL_MATERIALI` 
                    (
                            `KMAT_GRUPAS_KODS`,
                            `KMAT_GRUPAS_NOSAUKUNS`,
                            `KMAT_APAKSGRUPAS_KODS`,
                            `KMAT_APAKSGRUPAS_NOSAUKUNS`,
                            `KMAT_KATEGORIJAS_KODS`,
                            `KMAT_KATEGORIJAS_NOSAUKUNS`,
                            `KMAT_KODS`,
                            `KMAT_NOSAUKUMS`,
                            `KMAT_MERVIENIBA`,
                            `KMAT_DAUDZUMS`,
                            `KMAT_CENA`,
                            `KMAT_KATEGORIJAS_KLASE`,
                            `KMAT_KATEGORIJAS_MERVIENIBA`,
                            `KMAT_PRECIZEJUMS`,
                            `KMAT_NOKLUSETAIS`,
                            `KMAT_CREATOR`
                    )
                    VALUES
                    (
                            "'.dbLayer::quote_smart($data[0]).'",
                            "'.dbLayer::quote_smart($data[1]).'",
                            "'.dbLayer::quote_smart($data[2]).'",
                            "'.dbLayer::quote_smart($data[3]).'",
                            "'.dbLayer::quote_smart($data[4]).'",
                            "'.dbLayer::quote_smart($data[5]).'",
                            "'.dbLayer::quote_smart($data[6]).'",
                            "'.dbLayer::quote_smart($data[7]).'",
                            "'.dbLayer::quote_smart($data[8]).'",
                            "'.dbLayer::quote_smart($data[9]).'",
                            "'.dbLayer::quote_smart($data[10]).'",
                            "'.dbLayer::quote_smart($data[11]).'",
                            "'.dbLayer::quote_smart($data[12]).'",
                            "'.dbLayer::quote_smart($data[13]).'",
                            "'.dbLayer::quote_smart($data[14]).'",
                            "'.dbLayer::quote_smart( $user).'"
                        )
                    ON DUPLICATE KEY UPDATE
                            `KMAT_GRUPAS_KODS` = "'.dbLayer::quote_smart($data[0]).'",
                            `KMAT_GRUPAS_NOSAUKUNS` = "'.dbLayer::quote_smart($data[1]).'",
                            `KMAT_APAKSGRUPAS_KODS` = "'.dbLayer::quote_smart($data[2]).'",
                            `KMAT_APAKSGRUPAS_NOSAUKUNS` = "'.dbLayer::quote_smart($data[3]).'",
                            `KMAT_KATEGORIJAS_KODS` = "'.dbLayer::quote_smart($data[4]).'",
                            `KMAT_KATEGORIJAS_NOSAUKUNS` = "'.dbLayer::quote_smart($data[5]).'",
                            `KMAT_NOSAUKUMS` = "'.dbLayer::quote_smart($data[7]).'",
                            `KMAT_MERVIENIBA` = "'.dbLayer::quote_smart($data[8]).'",
                            `KMAT_DAUDZUMS` = "'.dbLayer::quote_smart($data[9]).'",
                            `KMAT_CENA` = "'.dbLayer::quote_smart($data[10]).'",
                            `KMAT_KATEGORIJAS_KLASE` = "'.dbLayer::quote_smart($data[11]).'",
                            `KMAT_KATEGORIJAS_MERVIENIBA` = "'.dbLayer::quote_smart($data[12]).'",
                            `KMAT_PRECIZEJUMS` = "'.dbLayer::quote_smart($data[13]).'",                            
                            `KMAT_CREATOR` = "'.dbLayer::quote_smart($user).'"
                    ';

                    $oDB = new dbLayer;
                    $result = $oDB -> makeQuery($query);
            
                    return ($result !== false);
    }



// =============================================================================
// KL_MMS_DARBI
// =============================================================================

	// -----------------------------------------------------------------------------
	// Atgriezh MMS darbaa(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
		if ($ID)
		{
            $query = 'select *, '.dbLayer::sqlParseDate('KMSD_IZPILDES_DATUMS').', 
            ' .dbLayer::sqlParseDateTime('KMSD_EXPORT_DATUMS') .',
            ' .dbLayer::sqlParseDateTime('KMSD_CREATED') .',
            ' .dbLayer::sqlParseDateTime('KMSD_EDITED') .',
            w.KWOI_NOSAUKUMS as `WORKER`,
            (SELECT COUNT(*) FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = `KMSD_KODS` AND `RAKT_STATUS` NOT IN ("'.STAT_AUTO.'")) as `IS_ACT`,
            (SELECT COUNT(*) FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = `KMSD_KODS` 
                    AND `RAKT_STATUS` NOT IN ("'.STAT_AUTO.'", "'.STAT_INSERT.'", "'.STAT_RETURN.'")) as `IS_APPROVED_ACT`
                from `KL_MMS_DARBI`
                LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KMSD_IZPILDITAJA_KODS)
				where `KMSD_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
            }
            if($column == 'WORKER')
            {
                $column = 'w.KWOI_NOSAUKUMS';
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
            }
            if($orderColumn == 'WORKER')
            {
                $orderColumn = 'w.KWOI_NOSAUKUMS';
            }         
            
            // date
            if($column == 'KMSD_IZPILDES_DATUMS')
            {
                $searchString = " `KMSD_IZPILDES_DATUMS` = '" .  dbLayer::parseDate($search) . "' ";
            }
            else {
                $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            }
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            $query = 'select *, '.dbLayer::sqlParseDate('KMSD_IZPILDES_DATUMS').', 
            ' .dbLayer::sqlParseDateTime('KMSD_EXPORT_DATUMS') .',
            ' .dbLayer::sqlParseDateTime('KMSD_CREATED') .',
            ' .dbLayer::sqlParseDateTime('KMSD_EDITED') .',
            w.KWOI_NOSAUKUMS as `WORKER`
            from `KL_MMS_DARBI`
            LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KMSD_IZPILDITAJA_KODS)
            where '.$searchString.'
            order by  KMSD_IZPILDES_DATUMS DESC, `'.dbLayer::quote_smart($orderColumn).'` '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}
        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

