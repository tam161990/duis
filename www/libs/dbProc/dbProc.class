//                '.(($isOtherPayment !='')?',`isOtherPayment`="'.dbLayer::quote_smart($isOtherPayment).'"':'').'
//                '.(($overTime !='')?',`overTime`="'.dbLayer::quote_smart($overTime).'"':'').'
//                '.(($code !='')?',`code`="'.dbLayer::quote_smart($code).'"':'').'
//                '.(($favoritMaterial !='')?',`favoritMaterial`="'.dbLayer::quote_smart($favoritMaterial).'"':'').'
