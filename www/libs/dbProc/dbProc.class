        $query = 'select MAX(KMAT_ID) as KMAT_ID, KMTG_KATEGORIJAS_KODS as KMAT_KATEGORIJAS_KODS, 
        KMTG_KATEGORIJAS_NOSAUKUNS as KMAT_KATEGORIJAS_NOSAUKUNS
