        $res=$oSQL->makeQuery('insert into `FAILI`
						(`RFLS_NOSAUKUMS`,`RFLS_RLTT_ID`,`RFLS_RAKT_ID`,`RFLS_DATUMS`,`RFLS_TYPE`,`RFLS_META_INFO`) values
						("'.dbLayer::quote_smart($filename).'",
