                                `section`, `contract`, `report`, `searchDate`
                                )
			            values ("'.dbLayer::quote_smart($userId).'",
                                "'.dbLayer::quote_smart($yearFrom).'",
                                "'.dbLayer::quote_smart($yearUntil).'",
                                "'.dbLayer::quote_smart($monthFrom).'",
                                "'.dbLayer::quote_smart($monthUntil).'",

                                "'.dbLayer::quote_smart($worker).'",
                                "'.dbLayer::quote_smart($edRegion).'",
                                "'.dbLayer::quote_smart($edArea).'",

                                "'.dbLayer::quote_smart($voltage).'",
                                "'.dbLayer::quote_smart($ouner).'",
                                "'.dbLayer::quote_smart($type).'",
                                "'.dbLayer::quote_smart($isFinished).'",
                                "'.dbLayer::quote_smart($status1).'",
                                "'.dbLayer::quote_smart($trLocation).'",
                                "'.dbLayer::quote_smart($object).'",
                                "'.dbLayer::quote_smart($isOtherPayment).'",
                                "'.dbLayer::quote_smart($overTime).'",
                                "'.dbLayer::quote_smart($code).'",
