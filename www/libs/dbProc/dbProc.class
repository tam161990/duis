    $oSQL = new dbLayer;
    return $oSQL -> makeQuery($query);
    }

    // -----------------------------------------------------------------------------
    // Saglabaa darba veidu. Ja dots ID, izmaina esosho ierakstu, ja ne -
    // izveido jaunu.
    // Author: Tatjana Fedorkova
    // -----------------------------------------------------------------------------
    function saveWorkType($ID, $title, $type, $isActive)
    {

        if ($ID)
        {
            $query = 'update `kl_darba_veidi`
            set `KLDV_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
            `KLDV_VEIDS` = "'.dbLayer::quote_smart($type).'",
            `KLDV_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"
            where `KLDV_ID` = "'.dbLayer::quote_smart($ID).'"';

        }
        elseif ($title)
        {
            $query = 'insert into `kl_darba_veidi`
            (`KLDV_NOSAUKUMS`, `KLDV_VEIDS`, `KLDV_IR_AKTIVS`)
            values
            ("'.dbLayer::quote_smart($title).'",
            "'.dbLayer::quote_smart($type).'",
            "'.dbLayer::quote_smart($isActive).'")';
        }

        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);

        return ($result !== false);
    }

    // -----------------------------------------------------------------------------
    // Atgriezh kopeejo kalkul�cijas grupas skaitu.
    // Author: Tatjana Fedorkova
    // -----------------------------------------------------------------------------
    function getWorkTypeCount($search = false, $column = false)
    {
        $oDB = new dbLayer;
        if($column === false)
        {
            $column = dbProc::getKlklDefaultColumn(KL_WORK_TYPS);
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'select count(`KLDV_ID`) as `RECORDCOUNT` from `kl_darba_veidi`
            where '.$searchString;
        $result = $oDB -> makeQuery($query);

        return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
    }

    function createProject($key, $year, $worker_title, $ed_kods, $work_title, $work_type) {
        files::wh_log('Act status from KS 2: ' .date("d.m.Y H:i:s").PHP_EOL. 
                        'key: '.$key.PHP_EOL.
                        'year: '. $year.PHP_EOL.
                        'worker_title: '.$worker_title.PHP_EOL.
                        'ed_kods:' .$ed_kods.PHP_EOL.
                        'work_title:' .$work_title.PHP_EOL.
                        'work_type:' .$work_type.PHP_EOL.PHP_EOL										
                );						
        $oDB = new dbLayer;

        // pārbaude vai projects ar atbilstošu KvikStep kodu neeksitē
        $query = 'SELECT `RAKT_ID` FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = "'.dbLayer::quote_smart($key).'"  
                    AND `RAKT_PROJECT` = 1 AND `RAKT_STATUS` NOT  IN ("'.STAT_DELETE.'")';
        $result = $oDB -> makeQuery($query);        
        $actId = isset($result[0]['RAKT_ID']) ? $result[0]['RAKT_ID'] : false;
        
        // ja akts eksistē, pārbaudam vai nevajag atjaunot tammes, un ja vajag, tad atjaunojam            
        if($actId !== false) {
            return false;
        }
        $query = 'select `KRFK_VERTIBA` from `KL_REF_KODI` where `KRFK_NOSAUKUMS` = "PROJECT_TYPE" AND `KRFK_NOZIME` LIKE "%'.stripslashes($work_type).'%"';
        $result = $oDB -> makeQuery($query);
        $type = isset($result[0]['KRFK_VERTIBA']) ? $result[0]['KRFK_VERTIBA'] : false;
    
            files::wh_log('KL_REF_KODI: '.$query );
    
    
        $query = 'SELECT `KEDI_ID` FROM `KL_ED_IECIRKNI` WHERE `KEDI_IR_AKTIVS` = 1 AND `KEDI_KODS` = "'.dbLayer::quote_smart($ed_kods).'"';
        $result = $oDB -> makeQuery($query);
        $ed_id = isset($result[0]['KEDI_ID']) ? $result[0]['KEDI_ID'] : false;
    
        $query = 'SELECT `KWOI_KODS` FROM `kl_work_owners` WHERE `KWOI_IR_AKTIVS` = 1 AND `KWOI_NOSAUKUMS2` LIKE "%'.dbLayer::quote_smart($worker_title).'%"';
        $result = $oDB -> makeQuery($query);
        $worker_code = isset($result[0]['KWOI_KODS']) ? $result[0]['KWOI_KODS'] : false;
    
        files::wh_log('Act status from KS: ' .date("d.m.Y H:i:s").PHP_EOL. 
                        'key: '.$key.PHP_EOL.
                        'year: '. $year.PHP_EOL.
                        'worker_title: '.$worker_title.PHP_EOL.
                        'ed_kods:' .$ed_kods.PHP_EOL.
                        'work_title:' .$work_title.PHP_EOL.
                        'work_type:' .$work_type.PHP_EOL.
                        'type:' .$type .PHP_EOL.
                        'ed_id:' .$ed_id.PHP_EOL.
                        'worker_code:' .$worker_code.PHP_EOL										
                );						
    
        $r=dbProc::saveAct(false,
                false,
                0,
                date_create($year.'-01-01')->format('d.m.Y'), 
                0,
                false,
                false,
                false,
                STAT_AUTO,
                MAIN_ADMIN_ID,
                false,
                false,
                false,
                $worker_code,
                $ed_id,
                1 ,
                0,
                $key,
                $work_title,
                false,
                false,
                false,
                false,
                1,
                1,
                'PT_EL'//$type
              );
    
             $actId=dbLayer::getInsertId();	
    
            // save status changed time
             $query = 'INSERT INTO `AKTA_STATUSA_MAINA` (AAUD_RAKT_ID, AAUD_RLTT_ID, AAUD_STATUS) 	
             VALUES 	('.$actId.', '.MAIN_ADMIN_ID.', "'.STAT_AUTO.'" )';
    
             $r = $oDB -> makeQuery($query);
             if ($r===false)    
             {        
                files::wh_log('ERROR INSERT INTO `AKTA_STATUSA_MAINA`: AAST_KODS: '.$act['AAST_KODS'].PHP_EOL.
                    'AAST_ID:' .$act['AAST_ID'].PHP_EOL.$query
                );
    
            }
        }

        function getSTworkerCode() {
            $oDB = new dbLayer;
            $query =  'SELECT `KWOI_KODS`  FROM `kl_work_owners` WHERE `KWOI_ID` = '. ST;
            $result = $oDB -> makeQuery($query);

            return isset($result[0]['KWOI_KODS']) ? $result[0]['KWOI_KODS'] : true;
        }

        function getProjectImportList($actId, $worker) {

            $st_code = dbProc::getSTworkerCode();
            $query = 'SELECT `RAKT_ID`, `RAKT_NUM_POSTFIX`, `RAKT_WORK_TITLE`, `KWOI_NOSAUKUMS`
                        FROM `AKTI`
                        INNER JOIN `kl_work_owners` ON `RAKT_KWOI_KODS` = `KWOI_KODS`
                        WHERE `RAKT_PROJECT` = 1
                        AND `RAKT_KWOI_KODS` IN ("'.$worker.'", "'.(($st_code !== false) ? $st_code : $worker).'")
                        AND `RAKT_STATUS` = "' . STAT_CLOSE . '"
                         ';
                         /*
                         AND NOT EXISTS (SELECT 1 FROM `darbi` WHERE 
                            `DRBI_RAKT_ID` = '.dbLayer::quote_smart($actId) .'
                            AND `DRBI_IMPORT_NO` = `RAKT_ID`)
                        AND NOT EXISTS (SELECT 1 FROM `materiali` WHERE 
                        `MATR_RAKT_ID` = '.dbLayer::quote_smart($actId) .'
                        AND `MATR_IMPORT_NO` = `RAKT_ID`)
                        */
            //echo $query;
            $oDB = new dbLayer;
            $result = $oDB -> makeQuery($query);
    
            return $result;
        }

        function importProjectWorkMaterial($actId, $acts) {
            $actString = "";
            if (is_array($acts) && count($acts) > 0)
            {
                foreach ($acts as $i => $act)
                {
                        $actString .= "'". $act ."',";
                }
                $actString  = substr($actString, 0, -1);
                //echo $actString;
            }

            $query = "INSERT INTO `darbi` (
                                            `DRBI_KKAL_SHIFRS`,
                                            `DRBI_KKAL_NOSAUKUMS`,
                                            `DRBI_KKAL_NORMATIVS`,
                                            `DRBI_RAKT_ID`,
                                            `DRBI_MERVIENIBA`,
                                            `DRBI_KKAL_ID`,
                                            `DRBI_IS_WORKER`,
                                            `DRBI_APPROVE_DATE`,
                                            `DRBI_PLAN_DATE`,
                                            `DRBI_DAY_TOTAL`,
                                            `DRBI_PIEZIMES`,
                                            `DRBI_WORK_APROVE_DATE`,
                                            `DRBI_WORK_TYPE_ID`,
                                            `DRBI_WORK_TYPE_TEXT`,
                                            `DRBI_PROJECT_EXPORT`,
                                            `DRBI_IMPORT_NO` )  
                    SELECT 
                            `DRBI_KKAL_SHIFRS`,
                            `DRBI_KKAL_NOSAUKUMS`,
                            `DRBI_KKAL_NORMATIVS`,
                            ".dbLayer::quote_smart($actId) .",
                            `DRBI_MERVIENIBA`,
                            `DRBI_KKAL_ID`,
                            `DRBI_IS_WORKER`,
                            `DRBI_APPROVE_DATE`,
                            `DRBI_PLAN_DATE`,
                            `DRBI_DAY_TOTAL`,
                            `DRBI_PIEZIMES`,
                            `DRBI_WORK_APROVE_DATE`,
                            `DRBI_WORK_TYPE_ID`,
                            `DRBI_WORK_TYPE_TEXT`,
                            `DRBI_PROJECT_EXPORT`, 
                            `DRBI_RAKT_ID`
                    FROM `darbi` WHERE `DRBI_RAKT_ID` IN (".$actString.")";
            //echo $query;
            $oDB = new dbLayer;
            $result = $oDB -> makeQuery($query);

            $query = "INSERT INTO `materiali` (
                                    `MATR_RAKT_ID`,
                                    `MATR_KODS`,
                                    `MATR_NOSAUKUMS`,
                                    `MATR_MERVIENIBA`,
                                    `MATR_CENA`,
                                    `MATR_IS_WORKER`,
                                    `MATR_IS_WRITEDOFF`,
                                    `MATR_PIEZIMES`,
                                    `MATR_WORK_TYPE_ID`,
                                    `MATR_WORK_TYPE_TEXT`,
                                    `MATR_PROJECT_EXPORT`,
                                    `MATR_WORK_APROVE_DATE`,
                                    `MATR_APPROVE_DATE`,
                                    `MATR_IMPORT_NO`)  
                        SELECT 
                                    ".dbLayer::quote_smart($actId) .",
                                    `MATR_KODS`,
                                    `MATR_NOSAUKUMS`,
                                    `MATR_MERVIENIBA`,
                                    `MATR_CENA`,
                                    `MATR_IS_WORKER`,
                                    `MATR_IS_WRITEDOFF`,
                                    `MATR_PIEZIMES`,
                                    `MATR_WORK_TYPE_ID`,
                                    `MATR_WORK_TYPE_TEXT`,
                                    `MATR_PROJECT_EXPORT`,
                                    `MATR_WORK_APROVE_DATE`,
                                    `MATR_APPROVE_DATE`,
                                    `MATR_RAKT_ID`
                                FROM `materiali` WHERE `MATR_RAKT_ID` IN (".$actString.")";
                //echo $query;
                $oDB = new dbLayer;
                $result = $oDB -> makeQuery($query);
				return true;
        }

