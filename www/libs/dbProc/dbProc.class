                            `KMSD_KFNA_KODS` = "'.dbLayer::quote_smart($data[22]).'",
                            `KMSD_CREATOR` = "'.dbLayer::quote_smart($user).'"
                    ';

                    $oDB = new dbLayer;
                    $result = $oDB -> makeQuery($query);
            
                    return ($result !== false);
    }


    // AKTI
    // -----------------------------------------------------------------------------
	// Saglabaa aktu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveAct($ID = false,
                    $number = false,
                    $objNumber = false,
                    $proces_date  = false,
                    $isObjectFinished = false,
                    $decription = false,
                    $designation = false,
                    $date = false,
                    $status = false,
                    $user = false,
                    $object = false,
                    $voltage = false,
                    $type = false,
                    $worker = false,
                    $EDarea = false,
                    $koeficent = false,
                    $trase = false,
                    $actNumPostfix = false,
                    $worktitle = false,
                    $contract = false,
                    $acceptDate = false,
                    $toid = false,
                    $signature = false,
                    $auto = false,
                    $project = false,
                    $project_type = false
                    )
	{
        
		if ($ID)
		{
          $query = 'update `AKTI` set
          '.(($ID !==false)?'`RAKT_ID`="'.dbLayer::quote_smart($ID).'"':'').'
          '.(($number !==false)?',`RAKT_NUMURS`="'.dbLayer::quote_smart($numurs).'"':'').'
          '.(($objNumber !==false)?',`RAKT_NUMURS_OBJEKTA` = "'.dbLayer::quote_smart($objNumber).'"':'').'
          '.(($proces_date !==false)?',`RAKT_IZPILDES_DATUMS` = "'.dbLayer::parseDate($proces_date).'"':'').'
          '.(($isObjectFinished !==false)?',`RAKT_IR_OBJEKTS_PABEIGTS` = "'.dbLayer::quote_smart($isObjectFinished).'"':'').'
          '.(($decription !==false)?',`RAKT_PIEZIMES` = "'.dbLayer::quote_smart($decription).'"':'').'
          '.(($designation !==false)?',`RAKT_OPERATIVAS_APZIM` = "'.dbLayer::quote_smart($designation).'"':'').'
          '.(($worktitle !==false)?',`RAKT_WORK_TITLE` = "'.dbLayer::quote_smart($worktitle).'"':'').'
          '.(($date !==false)?',`RAKT_DATUMS` = now()':'').'
          '.(($status !==false)?',`RAKT_STATUS` = "'.dbLayer::quote_smart($status).'"':'').'
	  '.(($status == STAT_CLOSE)?(($trase)?',`RAKT_ACCEPT_DATE` = "'.dbLayer::quote_smart($acceptDate).'"' : ',`RAKT_ACCEPT_DATE` = now()' ):', `RAKT_ACCEPT_DATE` = NULL').'  
          '.(($user !==false)?',`RAKT_RLTT_ID` = "'.dbLayer::quote_smart($user).'"':'').'
          '.(($object !==false)?',`RAKT_KOBJ_ID` = "'.dbLayer::quote_smart($object).'"':'').'
          '.(($voltage !==false)?',`RAKT_KSRG_ID` = "'.dbLayer::quote_smart($voltage).'"':'').'
          '.(($signature !==false)?',`RAKT_SIGNATURE` = "'.dbLayer::quote_smart($signature).'"':'').'
          '.(($type !==false)?',`RAKT_KAKV_ID` = "'.dbLayer::quote_smart($type).'"':'').'
          '.(($worker !==false)?',`RAKT_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'"':'').'	     
	  '.(($toid !==false)?',`RAKT_TO_ID` = "'.dbLayer::quote_smart($toid).'"':'').'
          '.(($contract !==false)?',`RAKT_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'"':'').'
	  '.(($object !==false && $type !==false)?',`RAKT_KWRC_ID` = (SELECT `KWRC_ID` FROM `KL_WRITEOFF_CODE` WHERE
          `KWRC_KAKV_ID`  = "'.(($trase==1) ? 1 : dbLayer::quote_smart($type)).'"
          	 AND `KWRC_KOBJ_ID` =  "'.(($trase==1) ? 99 : dbLayer::quote_smart($object)).'") ':'').'
          '.(($EDarea !==false)?',`RAKT_KEDI_ID` = "'.dbLayer::quote_smart($EDarea).'"':'').'
          '.(($koeficent !==false)?',`RAKT_KOEFICENT` = "'.dbLayer::quote_smart($koeficent).'"':'').'
          '.(($trase !==false)?',`RAKT_TRASE` = "'.dbLayer::quote_smart($trase).'"':'').'     
            '.(($project!==false)?',`RAKT_PROJECT` = "'.dbLayer::quote_smart($project).'"':'').'
            '.(($project!==false && $project_type !== false)?',`RAKT_PROJECT_TYPE` = "'.dbLayer::quote_smart($project_type).'"':'').'                     
          '.(($actNumPostfix !==false)?',`RAKT_NUM_POSTFIX` = "'.dbLayer::quote_smart($actNumPostfix).'"':'').'
          '.(($EDarea !==false && $actNumPostfix !==false)?',`RAKT_FULL_NUMBER` = CONCAT('.(($trase==1)?'2':'""').',
            (SELECT `KEDI_KODS`  FROM `KL_ED_IECIRKNI` WHERE `KEDI_ID` = "'.dbLayer::quote_smart($EDarea).'" ),
            RAKT_NUMURS, RAKT_NUMURS_OBJEKTA, "/'.dbLayer::quote_smart($actNumPostfix).'" )':'').'
          where `RAKT_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		else
		{
          	$query = 'INSERT INTO `AKTI` (
                `RAKT_NUMURS`,
                `RAKT_NUMURS_OBJEKTA`,                
                `RAKT_IZPILDES_DATUMS`,
                `RAKT_MENESIS`,
                `RAKT_GADS`,
                `RAKT_PIEZIMES`,
                `RAKT_OPERATIVAS_APZIM`,
                `RAKT_STATUS`,
                `RAKT_RLTT_ID`,
                `RAKT_KOBJ_ID`,
                `RAKT_KSRG_ID`,
                `RAKT_KAKV_ID`,
                `RAKT_KWOI_KODS`,
                `RAKT_VV_NUMBER`,    
                `RAKT_TO_ID`,
                `RAKT_KEDI_ID`,
                `RAKT_WORK_TITLE`,
                `RAKT_KOEFICENT`,
                `RAKT_NUM_POSTFIX`,
                `RAKT_FULL_NUMBER`,
                `RAKT_KWRC_ID`,
                `RAKT_TRASE`,
                `RAKT_SIGNATURE`,
                `RAKT_IR_OBJEKTS_PABEIGTS`,
                `RAKT_IS_AUTO`,
		        `RAKT_PROJECT`,
                `RAKT_PROJECT_TYPE`
                )
			values
                ('.(( !$number ) ? dbProc::getNextActNumber(dbLayer::quote_smart($EDarea), $trase) : dbLayer::quote_smart($number)) .',
                "'.dbLayer::quote_smart($objNumber).'",
                '.(($proces_date) ? '"'.dbLayer::parseDate($proces_date).'"' : '"NULL"').',
                '.(($proces_date) ? ' EXTRACT(MONTH FROM RAKT_IZPILDES_DATUMS) ' : '"NULL"').',
                '.(($proces_date) ? ' EXTRACT(YEAR FROM RAKT_IZPILDES_DATUMS) ' : '"NULL"').',    
                "'.dbLayer::quote_smart($decription).'",
                "'.dbLayer::quote_smart($designation).'",
                "'.dbLayer::quote_smart($status).'",
                "'.dbLayer::quote_smart($user).'",
				'.(($object) ? '"'.dbLayer::quote_smart($object).'"' : '0').',
				'.(($voltage) ? '"'.dbLayer::quote_smart($voltage).'"' : '0').',
				'.(($type) ? '"'.dbLayer::quote_smart($type).'"' : '0').',
                "'.dbLayer::quote_smart($worker).'",
                "'.dbLayer::quote_smart($contract).'",       
                "'.dbLayer::quote_smart($toid).'",
                "'.dbLayer::quote_smart($EDarea).'",
                "'.dbLayer::quote_smart($worktitle).'",
                "'.dbLayer::quote_smart($koeficent).'",
                "'.dbLayer::quote_smart($actNumPostfix).'",
                CONCAT('.(($trase==1)?'2':'""').',
				(SELECT `KEDI_KODS`  FROM `KL_ED_IECIRKNI` WHERE `KEDI_ID` = "'.dbLayer::quote_smart($EDarea).'" ),
				RAKT_NUMURS, RAKT_NUMURS_OBJEKTA, "/'.dbLayer::quote_smart($actNumPostfix).'" ),
				'.(($type) ? '(SELECT `KWRC_ID` FROM `KL_WRITEOFF_CODE` WHERE
                `KWRC_KAKV_ID`  = "'.(($trase==1) ? 1 : dbLayer::quote_smart($type)).'"
                AND `KWRC_KOBJ_ID` =  "'.(($trase==1) ? 99 : dbLayer::quote_smart($object)).'")' : '0').',
                '.dbLayer::quote_smart($trase).',
                "'.dbLayer::quote_smart($signature).'",                
                '.(($isObjectFinished) ? '"'.dbLayer::quote_smart($isObjectFinished).'"' : '0').',
                '.(($auto) ? '"'.dbLayer::quote_smart($auto).'"' : '0').',
                '.(($project) ? '"'.dbLayer::quote_smart($project).'"' : '0').',  
                '.(($project && $project_type !== false) ? '"'.dbLayer::quote_smart($project_type).'"' : '"NULL"').'                     
                )';
		}
       //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
    }
    
    function updateActStatus($actId, $status)
    {    
        $query = 'UPDATE `AKTI` SET `RAKT_STATUS`  = "' .$status .'" WHERE `RAKT_ID` = '.$actId; 
        //echo $query;       
        $oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
        
    }

    function deleteAct($actId)
    {    
        $query = 'DELETE FROM `AKTI`  WHERE `RAKT_ID` = '.$actId; 
        //echo $query;       
        $oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
        
    }

     // dzēst visus akta no importēta XLS faila 
     function deleteActXLS($data)
     {
         foreach ($data as $code) {

            $res = false;
            $actId = 0;
            $sql = 'SELECT `RAKT_ID` FROM `AKTI`
            where `RAKT_NUM_POSTFIX`="'.dbLayer::quote_smart($code).'"
            AND `RAKT_STATUS` IN ( "'.STAT_DELETE.'", "'.STAT_INSERT.'", "'.STAT_AUTO.'")
            AND `RAKT_IS_AUTO` = 1
            AND `RAKT_KAKV_ID` IN ( '.ACT_TYPE_PLAN_ID.', '.ACT_TYPE_PLAN_TR_ID.')';	

            $oSQL=new dbLayer();
            $res=$oSQL->makeQuery($sql);            
            if (count($res) == 0 || empty($res[0]['RAKT_ID']) ) {
                continue;
            }
            
            $actId = $res[0]['RAKT_ID'];

            // darbi
            dbProc::deleteActWorks($actId);
            dbProc::deleteActWorks($actId, true);

            // materiali
            dbProc::deleteActMaterials($actId);
            dbProc::deleteActMaterials($actId, true);

            // status
            dbProc::deleteAuditInfo($actId);

            // faili
            dbProc::deleteAllActFiles($actId);

            // pats akts
            dbProc::deleteAct($actId);

            // MMS
            dbProc::deleteMMSWork($code);
         }
     }
    

    function CheckQuiqStepUnique($code)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`RAKT_ID`) as `amount` from `AKTI`
            where `RAKT_NUM_POSTFIX`="'.dbLayer::quote_smart($code).'"
            AND `RAKT_STATUS` <> "'.STAT_DELETE.'"';	
		
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']) && $res[0]['amount'] > 0)
		{
			return false;
		}
		return true;
	}
    

    // -----------------------------------------------------------------------------
	// Atgriezh akta(-as). Ja dots ID, atdod to
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActInfo($ID)
	{

			$query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_KODS `TYPE_CODE`, v.KAKV_IR_PLANS `PLAN`, v.KAKV_NOSAUKUMS `TYPE`, 
             v.KAKV_TEXT_TMPL `TEXT_TMPL`, e.KEDI_KODS `ED_KODS`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            CONCAT(e.KEDI_SECTION,'/', e.KEDI_NOSAUKUMS) `STRUKTURVIENIBA`,
            m.KMSD_KODS `MMS`, s.KSRG_NOSAUKUMS `SPRIEGUMS`, o.KOBJ_NOSAUKUMS `OBJECT`,  w.KWOI_NOSAUKUMS `WORKER`,
            CONCAT(l.RLTT_VARDS,' ', l.RLTT_UZVARDS) `AUTORS` ,
            ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`,
            a.RAKT_WORK_TITLE AS `WORK_TITLE`, ".dbLayer::sqlParseDate('RAKT_IZPILDES_DATUMS')."
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `KL_MMS_DARBI` m ON (a.RAKT_NUM_POSTFIX = m.KMSD_KODS)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID)
            LEFT JOIN `KL_OBJEKTI` o ON (a.RAKT_KOBJ_ID = o.KOBJ_ID)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
				where `RAKT_ID` = '".dbLayer::quote_smart($ID)."'";

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh akta(-as) peec numura.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActByNumberList($offset = false, $limit = false, $searchString, $worker = false)
	{

        $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,
            CONCAT(e.KEDI_KODS, ': ', e.KEDI_NOSAUKUMS) `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            CONCAT(l.RLTT_VARDS,' ', l.RLTT_UZVARDS) `AUTORS`
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            where `RAKT_FULL_NUMBER` LIKE '%".dbLayer::quote_smart($searchString)."%'
            ".(($worker !== false) ? " AND `RAKT_KWOI_KODS` = '" .dbLayer::quote_smart($worker). "'" : "")."
            GROUP BY `RAKT_FULL_NUMBER` ORDER BY `RAKT_FULL_NUMBER`";
            //echo $query;
        	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }

    // -----------------------------------------------------------------------------
	// Atgriezh kopeejo aktus skaitu peec numura.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActByNumberCount($searchString, $worker = false)
	{
         $query = "select count(`RAKT_ID`) as `ACT_COUNT` from `AKTI` a
         where `RAKT_FULL_NUMBER` LIKE '%".dbLayer::quote_smart($searchString)."%' 
         ".(($worker !== false) ? " AND `RAKT_KWOI_KODS` = '" .dbLayer::quote_smart($worker). "'" : "");
        // $query .= " GROUP BY `RAKT_FULL_NUMBER`  ";

        $oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);

		return isset($result[0]['ACT_COUNT']) ? $result[0]['ACT_COUNT'] : false;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActList($offset = false, $limit = false, $searchString)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['yearFrom'] = $sCriteria[0];
             $searcCriteria['yearUntil'] = $sCriteria[1];
             $searcCriteria['monthFrom'] = $sCriteria[2];
             $searcCriteria['monthUntil'] = $sCriteria[3];
             $searcCriteria['worker'] = $sCriteria[4];
             $searcCriteria['edCode'] = $sCriteria[5];
             $searcCriteria['voltage'] = $sCriteria[6];
             $searcCriteria['ouner'] = $sCriteria[7];
             $searcCriteria['type'] = $sCriteria[8];

             $statusString = '';
             $status = explode("*", $sCriteria[10]);
             if($status[0] == -1)
             {
                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                 	  if($row['nosaukums'] != STAT_DELETE ||
                      ($row['nosaukums'] == STAT_DELETE &&
                      userAuthorization::isAdmin() && !dbProc::isUserInRole(userAuthorization::getUserId(), ROLE_ED_USER)))
                      {
                        $statusString .= "'".$row['nosaukums']."',";
                      }
                 	}
                    $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             $searcCriteria['designation'] = $sCriteria[11];
             $searcCriteria['section'] = urldecode($sCriteria[12]);

		    $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,
            CONCAT(e.KEDI_KODS, ': ', e.KEDI_NOSAUKUMS) `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            CONCAT(l.RLTT_VARDS,' ', l.RLTT_UZVARDS) `AUTORS`
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID)
            where 1 AND `RAKT_PROJECT` = '0' ";

            $userInfo = dbProc::getUserInfo(userAuthorization::getUserId());
      	    if(count($userInfo) >0 )
      	    {
      		    $user = $userInfo[0];
       	    }
            if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1  &&
                isset($searcCriteria['yearUntil']) && $searcCriteria['yearUntil'] != -1)
            {
              if ($searcCriteria['yearFrom'] == $searcCriteria['yearUntil'])
              {
                $query .= " and a.RAKT_GADS = '".$searcCriteria['yearFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_GADS >= '".$searcCriteria['yearFrom']."' and a.RAKT_GADS <= '".$searcCriteria['yearUntil']."') ";
              }
            }
            if(isset($searcCriteria['monthFrom']) && $searcCriteria['monthFrom'] != -1  &&
                isset($searcCriteria['monthUntil']) && $searcCriteria['monthUntil'] != -1)
            {
              if ($searcCriteria['monthFrom'] == $searcCriteria['monthUntil'])
              {
                $query .= " and a.RAKT_MENESIS = '".$searcCriteria['monthFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_MENESIS >= '".$searcCriteria['monthFrom']."' and a.RAKT_MENESIS <= '".$searcCriteria['monthUntil']."') ";
              }
            }

            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }

            if(isset($searcCriteria['edCode']) && $searcCriteria['edCode'] != -1)
            {
                $query .= " and e.KEDI_KODS = '".$searcCriteria['edCode']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }


            if(isset($searcCriteria['voltage']) && $searcCriteria['voltage'] != -1)
            {
                $query .= " and a.RAKT_KSRG_ID = '".$searcCriteria['voltage']."' ";
            }
            if(isset($searcCriteria['ouner']) && $searcCriteria['ouner'] != -1)
            {
                $query .= " and a.RAKT_RLTT_ID = '".$searcCriteria['ouner']."' ";
            }

            if(isset($searcCriteria['type']) && $searcCriteria['type'] != -1)
            {
                $query .= " and a.RAKT_KAKV_ID = '".$searcCriteria['type']."' ";
            }

            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $query .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
            }
            if(isset($searcCriteria['designation']) && $searcCriteria['designation'] != '')
            {
                $query .= " and a.RAKT_OPERATIVAS_APZIM LIKE  '%".$searcCriteria['designation']."%' ";
            }
            $query .= " GROUP BY `RAKT_FULL_NUMBER` ORDER BY `RAKT_FULL_NUMBER` ";

			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}

        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh projektus(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getProjectList($offset = false, $limit = false, $searchString)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['yearFrom'] = $sCriteria[0];            
             $searcCriteria['worker'] = $sCriteria[1];
             $searcCriteria['edCode'] = $sCriteria[2];             
             $searcCriteria['ouner'] = $sCriteria[3];

             $statusString = '';
             $status = explode("*", $sCriteria[5]);
             if($status[0] == -1)
             {
                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                 	  if($row['nosaukums'] != STAT_DELETE ||
                      ($row['nosaukums'] == STAT_DELETE &&
                      userAuthorization::isAdmin() && !dbProc::isUserInRole(userAuthorization::getUserId(), ROLE_ED_USER)))
                      {
                        $statusString .= "'".$row['nosaukums']."',";
                      }
                 	}
                    $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             

		    $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,
            CONCAT(e.KEDI_KODS, ': ', e.KEDI_NOSAUKUMS) `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            CONCAT(l.RLTT_VARDS,' ', l.RLTT_UZVARDS) `AUTORS`
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID)
            where `RAKT_PROJECT` = '1' ";

            $userInfo = dbProc::getUserInfo(userAuthorization::getUserId());
      	    if(count($userInfo) >0 )
      	    {
      		    $user = $userInfo[0];
       	    }
            if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1  )
            {
                $query .= " and a.RAKT_GADS = '".$searcCriteria['yearFrom']."' ";
            }            
            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }
            if(isset($searcCriteria['edCode']) && $searcCriteria['edCode'] != -1)
            {
                $query .= " and e.KEDI_KODS = ".$searcCriteria['edCode']." ";
            }
            if(isset($searcCriteria['ouner']) && $searcCriteria['ouner'] != -1)
            {
                $query .= " and a.RAKT_RLTT_ID = '".$searcCriteria['ouner']."' ";
            }
            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $query .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
            }
           
            $query .= " GROUP BY `RAKT_FULL_NUMBER` ORDER BY `RAKT_FULL_NUMBER` ";

			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}

        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    function getActWriteOffCode($act)
    {

        $query = "select  a.RAKT_FULL_NUMBER `NUMURS`, ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`  from `AKTI` a
        LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
         where `RAKT_ID` = '".dbLayer::quote_smart($act)."'";

        $oSQL = new dbLayer;
	return	$result = $oSQL -> makeQuery($query);
	
	//	return isset($result[0]['WRITE_OFF_ACCOUNT']) ? $result[0]['WRITE_OFF_ACCOUNT'] : '';
    }

    // -----------------------------------------------------------------------------
	// Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActWriteOffList($searchString)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['yearFrom'] = $sCriteria[0];
             $searcCriteria['yearUntil'] = $sCriteria[1];
             $searcCriteria['monthFrom'] = $sCriteria[2];
             $searcCriteria['monthUntil'] = $sCriteria[3];
             $searcCriteria['worker'] = $sCriteria[4];
             $searcCriteria['writeoff'] = $sCriteria[5];
             $searcCriteria['edRegion'] = $sCriteria[6];   
	              $searcCriteria['section'] = $sCriteria[7];

		    $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,
            e.KEDI_SECTION `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            CONCAT(l.RLTT_VARDS,' ', l.RLTT_UZVARDS) `AUTORS`  ,
            ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
            LEFT JOIN `AKTA_STATUSA_MAINA` s ON (a.RAKT_ID = s.AAUD_RAKT_ID)
            where 1 ";


            /*if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1  &&
                isset($searcCriteria['yearUntil']) && $searcCriteria['yearUntil'] != -1)
            {
              if ($searcCriteria['yearFrom'] == $searcCriteria['yearUntil'])
              {
                $query .= " and a.RAKT_GADS = '".$searcCriteria['yearFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_GADS >= '".$searcCriteria['yearFrom']."' and a.RAKT_GADS <= '".$searcCriteria['yearUntil']."') ";
              }
            }
            if(isset($searcCriteria['monthFrom']) && $searcCriteria['monthFrom'] != -1  &&
                isset($searcCriteria['monthUntil']) && $searcCriteria['monthUntil'] != -1)
            {
              if ($searcCriteria['monthFrom'] == $searcCriteria['monthUntil'])
              {
                $query .= " and a.RAKT_MENESIS = '".$searcCriteria['monthFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_MENESIS >= '".$searcCriteria['monthFrom']."' and a.RAKT_MENESIS <= '".$searcCriteria['monthUntil']."') ";
              }
            }*/
             if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1  &&
                isset($searcCriteria['yearUntil']) && $searcCriteria['yearUntil'] != -1 &&
                isset($searcCriteria['monthFrom']) && $searcCriteria['monthFrom'] != -1  &&
                isset($searcCriteria['monthUntil']) && $searcCriteria['monthUntil'] != -1)
            {
             $query .= " AND s.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['monthFrom'], $searcCriteria['yearFrom'])."' AND s.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['monthUntil'], $searcCriteria['yearUntil'])."'";
            }
            $query .= " and s.AAUD_STATUS = 'CLOSE' ";
	       if(isset($searcCriteria['edRegion']) && $searcCriteria['edRegion'] != -1)
 		{
      		     $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
     		}
                            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
       		{
		                $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
	            }
            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }

            if(isset($searcCriteria['writeoff']) && $searcCriteria['writeoff'] != -1)
            {
                $query .= " and a.RAKT_KWRC_ID IN (SELECT c.KWRC_ID FROM `KL_WRITEOFF_CODE` c
                WHERE c.KWRC_TITLE = (SELECT g.KWRC_TITLE FROM `KL_WRITEOFF_CODE` g WHERE  g.KWRC_ID = '".$searcCriteria['writeoff']."')) ";
            }

            $query .= " and a.RAKT_STATUS  = 'CLOSE' ";

            $query .= " GROUP BY `RAKT_FULL_NUMBER` ORDER BY `RAKT_FULL_NUMBER` ";



        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    function getMMSPlanColumnValue($fr, $code)
    {
      // define column name

     /* if(  $fr == "1z" || $fr == "2z" || $fr == "3z" || $fr == "4z" || $fr == "5z" ||
      $fr == "6z" || $fr == "7z" || $fr == "8z" || $fr == "9z"  ||
      $fr == "1v" || $fr == "2v" || $fr == "3v" || $fr == "4v" || $fr == "5v" || $fr == "6v" ||
      $fr == "7v" || $fr == "8v" || $fr == "9v" || $fr == "10v" || $fr == "10v" )*/
      if(preg_match('([1-9]{1}(z){1})', $fr) || preg_match('((v){1}([1-9]{1}|((10)|(11)){1}))', $fr))
      {
           $col = "KMSD_".$fr;
           $query = "select ".$col." from `KL_MMS_DARBI` where `KMSD_ID` = '".$code."'";
           $oSQL = new dbLayer;
    	   $res = $oSQL -> makeQuery($query);
           if (is_array($res) && count($res)>0)
           {
              return  $res[0][$col] ;
           }
      }
       else
       {
         return -1;
       }

	}
    // -----------------------------------------------------------------------------
	// Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActMMSCalcList($searchString, $trase)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['month'] = $sCriteria[1];
             $searcCriteria['worker'] = $sCriteria[2];
             $searcCriteria['edRegion'] = $sCriteria[3];
             $searcCriteria['section'] = $sCriteria[4];

             $colFr = 'KKAL_FIZ_RADIJUMS';
             $colMmsId = 'RAKT_NUM_POSTFIX';

		    $query = "
            select mms.KMSD_KODS, a.RAKT_OPERATIVAS_APZIM,
            d.DRBI_DAUDZUMS, d.DRBI_CILVEKSTUNDAS,  d.DRBI_MERVIENIBA,
            d.DRBI_KKAL_NOSAUKUMS,  k.KKAL_FIZ_RADIJUMS,  k.KKAL_PLAN_PRICE,
            a.RAKT_NUM_POSTFIX, 0 as planAmount, 0 as planPrice
            from `AKTI` a
            INNER JOIN `DARBI` d  ON (a.RAKT_ID = d.DRBI_RAKT_ID  )
            INNER JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            INNER JOIN `KL_KALKULACIJA_TRASE` k ON ( d.DRBI_KKAL_ID = k.KKAL_ID)
            INNER JOIN `KL_MMS_DARBI` mms ON (a.RAKT_NUM_POSTFIX = mms.KMSD_KODS)
            where 1 ";
            $query .= " and a.RAKT_GADS = '".$searcCriteria['year']."' ";
            $query .= " and a.RAKT_MENESIS = '".$searcCriteria['month']."' ";
           // $query .= " and a.RAKT_STATUS  = 'CLOSE' ";
            $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
            $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            $query .= " AND a.RAKT_TRASE = ".$trase;

            $query .= " GROUP BY a.RAKT_NUM_POSTFIX, d.DRBI_ID  ";


        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActTotalWorkList($searchString, $trase = 0, $sign = 'P')
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['month'] = $sCriteria[1];
             $searcCriteria['worker'] = $sCriteria[2];
             $searcCriteria['edRegion'] = $sCriteria[3];
             $searcCriteria['section'] = $sCriteria[4];
	          $searcCriteria['contract'] = $sCriteria[5];

		    $query = "select *,
            e.KEDI_SECTION `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            ww.KWRC_ID AS `WRITE_OFF_ID`,
            ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`,
            e.KEDI_REGIONS AS `REGION`
            from `DARBI` d
            LEFT JOIN `AKTI` a ON (d.DRBI_RAKT_ID = a.RAKT_ID )
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
		LEFT JOIN 
		(SELECT MAX(AAUD_STATUS) AAUD_STATUS, MAX(AAUD_DATUMS) AAUD_DATUMS, AAUD_RAKT_ID FROM `AKTA_STATUSA_MAINA` GROUP BY AAUD_RAKT_ID, AAUD_STATUS)  s ON (a.RAKT_ID = s.AAUD_RAKT_ID) 
     
            where 1 AND `RAKT_PROJECT` = '0' ";


            //$query .= " and a.RAKT_GADS = '".$searcCriteria['year']."' ";

            //$query .= " and a.RAKT_MENESIS = '".$searcCriteria['month']."' ";

            $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
	        $query .= " and a.RAKT_VV_NUMBER = '".$searcCriteria['contract']."' ";
            $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";

            $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            $query .= " and a.RAKT_STATUS IN ('ACCEPT', 'CLOSE', 'CLOSEWRITEOFF') ";
           // $query .= " AND s.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."' AND s.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."'";
           // $query .= " and s.AAUD_STATUS = 'CLOSE' ";
           $query .= " AND (  (  a.RAKT_IS_AUTO = 0 and s.AAUD_STATUS = 'CLOSE'
                    AND s.AAUD_DATUMS BETWEEN '" . dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                    AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."')
                OR ( a.RAKT_IS_AUTO = 1  
                        AND d.DRBI_WORK_APROVE_DATE BETWEEN '" . dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                    AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."' )
            
            )";
            $query .= " AND a.RAKT_TRASE = ".$trase;
            $query .= " and a.RAKT_SIGNATURE  = '".$sign."'";
            $query .= " GROUP BY d.DRBI_ID ORDER BY ww.KWRC_ID, d.DRBI_KKAL_SHIFRS";


        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActTotalMaterialList($searchString, $trase = 0, $sign = 'P', $st = '')
{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['month'] = $sCriteria[1];
             $searcCriteria['worker'] = $sCriteria[2];
             $searcCriteria['edRegion'] = $sCriteria[3];
             $searcCriteria['section'] = $sCriteria[4];
             $searcCriteria['contract'] = $sCriteria[5];

            $query = "select *,
             m.MATR_DAUDZUMS `DAUDZUMS`, 
             IF (m.MATR_CENA_KOPA IS NULL, m.MATR_DAUDZUMS*m.MATR_CENA, m.MATR_CENA_KOPA)  `CENA_KOPA`,
            e.KEDI_SECTION `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            ww.KWRC_TITLE AS `WRITE_OFF_ID`,
            ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`,
            e.KEDI_REGIONS AS `REGION`
            from `MATERIALI` m
            LEFT JOIN `AKTI` a ON (m.MATR_RAKT_ID = a.RAKT_ID )
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
            LEFT JOIN (SELECT AAUD_STATUS, AAUD_DATUMS, AAUD_RAKT_ID FROM `AKTA_STATUSA_MAINA`
					WHERE AAUD_ID IN (SELECT MAX(AAUD_ID) AAUD_ID FROM `AKTA_STATUSA_MAINA` GROUP BY AAUD_RAKT_ID) ) s 
				ON (a.RAKT_ID = s.AAUD_RAKT_ID)     
            where 1 AND `RAKT_PROJECT` = '0'";

           // $query .= " and a.RAKT_GADS = '".$searcCriteria['year']."' ";

           // $query .= " and a.RAKT_MENESIS = '".$searcCriteria['month']."' ";

            $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            $query .= " and a.RAKT_VV_NUMBER = '".$searcCriteria['contract']."' ";
            $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";

            $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            //$query .= " and a.RAKT_STATUS IN ('ACCEPT', 'CLOSE', 'CLOSEWRITEOFF') ";
            $query .= " and a.RAKT_STATUS NOT IN ('DELETE') ";

            $query .= " AND (  (  a.RAKT_IS_AUTO = 0 and s.AAUD_STATUS = 'CLOSE'
                                AND s.AAUD_DATUMS BETWEEN '" . dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."')
                            OR ( a.RAKT_IS_AUTO = 1  
                                    AND m.MATR_WORK_APROVE_DATE BETWEEN '" . dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."' )
                       
                        )";
            if($sign == 'E') {
                $query .= " and a.RAKT_SIGNATURE  IN ('E', 'K') ";
            } else {
                $query .= " and a.RAKT_SIGNATURE  IN ('P') ";
            }

            if($st == 1) {
                $query .= " and m.MATR_IS_WORKER ='0' ";
            } elseif($st == 0 ) {
                $query .= " and m.MATR_IS_WORKER ='1' ";
            }elseif($trase == 1) {
                $query .= " and m.MATR_IS_WORKER ='0' ";
            }

            //$query .= " GROUP BY ww.KWRC_TITLE, m.MATR_NOSAUKUMS, m.MATR_IS_WORKER ";
            $query .= " ORDER BY ww.KWRC_TITLE, m.MATR_IS_WORKER DESC, m.MATR_KODS";


            //echo $query;
            $oSQL = new dbLayer;
            return $oSQL -> makeQuery($query);
        }

   function getActDateFrom($month, $year)
  {
	if($month == 1)
	{
		return dblayer::parseDate(date("d.m.Y", strtotime("26.12.".($year-1))));
	}
	else
	{
		return dblayer::parseDate(date("d.m.Y", strtotime("26.".($month-1).".".$year)));
	}
  }
  function getActDateTo($month, $year)
  {
	return dblayer::parseDateWithTime(date("d.m.Y", strtotime("25.".$month.".".$year)), "23:59:59");
  }


  // -----------------------------------------------------------------------------
	// Atgriezh kalkulacijas saraksts prieks phisical list.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function getPhisicalMMSPlanList($s)
    {
        $query = "select `KKAL_SHIFRS` from `KL_KALKULACIJA` where `KKAL_FIZ_RADIJUMS` = '".$s."' AND KKAL_IR_AKTIVS = 1";
        $oSQL = new dbLayer;
		$res = $oSQL -> makeQuery($query);
        $result = '';
        if (is_array($res) && count($res)>0)
		{
       	    foreach ($res as $i=>$row)
		    {
              $result .= "'".$row['KKAL_SHIFRS']."',";
            }
            $result  = substr($result, 0, -1);
        }
        else
        {
           $result = "'"."empty"."'";
        }
        return $result;
	}
  // -----------------------------------------------------------------------------
	// Atgriezh phisical swowing report list.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getPhisicalShowingList($searchString, $i, $trase = 0)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['monthFrom'] = $sCriteria[1];
             $searcCriteria['monthUntil'] = $sCriteria[2];
             $searcCriteria['worker'] = $sCriteria[3];
             $searcCriteria['edRegion'] = $sCriteria[4];
             $searcCriteria['voltage'] = $sCriteria[5];
             $searcCriteria['ouner'] = $sCriteria[6];

             $statusString = '';
             $status = explode("*", $sCriteria[8]);
             if($status[0] == -1)
             {

                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                      if($row['nosaukums'] != STAT_DELETE ||
                      ($row['nosaukums'] == STAT_DELETE &&
                      userAuthorization::isAdmin() && !dbProc::isUserInRole(userAuthorization::getUserId(), ROLE_ED_USER)))
                      {
                        $statusString .= "'".$row['nosaukums']."',";
                      }
                 	}
                    $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             $searcCriteria['object'] = $sCriteria[9];
             $searcCriteria['section'] = $sCriteria[10];

            $where = '';
            $userInfo = dbProc::getUserInfo(userAuthorization::getUserId());
      	    if(count($userInfo) >0 )
      	    {
      		    $user = $userInfo[0];
       	    }

             $where .= " AND sm.AAUD_STATUS = 'ACCEPT'  AND sm.AAUD_DATUMS IS NOT NULL
             AND sm.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['monthFrom'], $searcCriteria['year'])."' AND sm.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['monthUntil'], $searcCriteria['year'])."' ";

            if(isset($searcCriteria['edRegion']) && $searcCriteria['edRegion'] != -1)
            {
                $where .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $where .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }

            if(isset($searcCriteria['voltage']) && $searcCriteria['voltage'] != -1)
            {
                $where .= " and a.RAKT_KSRG_ID = '".$searcCriteria['voltage']."' ";
            }
            if(isset($searcCriteria['ouner']) && $searcCriteria['ouner'] != -1)
            {
                $where .= " and a.RAKT_RLTT_ID = '".$searcCriteria['ouner']."' ";
            }

            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
               $where .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }
            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $where .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
            }
             $where .= " AND a.RAKT_TRASE = ".$trase;

            $whereM = " AND sm.AAUD_STATUS = 'ACCEPT'  AND sm.AAUD_DATUMS IS NOT NULL
             AND sm.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['monthFrom'], $searcCriteria['year'])."' AND sm.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['monthUntil'], $searcCriteria['year'])."' ";

            $joinSection = " LEFT JOIN `AKTI` a ON (a.RAKT_ID = dr.DRBI_RAKT_ID)
                    LEFT JOIN `AKTA_STATUSA_MAINA` sm ON (a.RAKT_ID = sm.AAUD_RAKT_ID)
                    LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
                    LEFT JOIN `KL_MMS_DARBI` mms ON (a.RAKT_NUM_POSTFIX = mms.KMSD_KODS)
                    LEFT JOIN `KL_KALKULACIJA` k ON (dr.DRBI_KKAL_SHIFRS = k.KKAL_SHIFRS)
                    LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
                    LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID AND v.KAKV_TRASE = ".$trase.")  ";

            $where1 = " and mms.KMSD_GADS = '".$searcCriteria['year']."' ";

            $query = "select ";
            $query .= "CONCAT(kedi.KEDI_REGIONS,' : ', kedi.KEDI_KODS, ' : ', kedi.KEDI_NOSAUKUMS) `ED`,
            kedi.KEDI_REGIONS, kedi.KEDI_KODS, kedi.KEDI_NOSAUKUMS,
            IFNULL(s1.sum,0)  `VOLTAGE_CALC".$i."_PLAN1` , IFNULL(s2.sum,0)  `VOLTAGE_CALC".$i."_PLAN2`,
            IFNULL(s3.sum,0)  `VOLTAGE_CALC".$i."_PLAN3` , IFNULL(s4.sum,0)  `VOLTAGE_CALC".$i."_PLAN4`,
            IFNULL(z1.sum,0)  `VOLTAGE_CALC".$i."_NOT_PLAN1` , IFNULL(z2.sum,0)  `VOLTAGE_CALC".$i."_NOT_PLAN2`,
            IFNULL(z3.sum,0)  `VOLTAGE_CALC".$i."_NOT_PLAN3` , IFNULL(z4.sum,0)  `VOLTAGE_CALC".$i."_NOT_PLAN4`,
            IFNULL(y1.sum,0)  `MMS_VOLTAGE_CALC".$i."_PLAN1` , IFNULL(y2.sum,0)  `MMS_VOLTAGE_CALC".$i."_PLAN2`,
            IFNULL(y3.sum,0)  `MMS_VOLTAGE_CALC".$i."_PLAN3` , IFNULL(y4.sum,0)  `MMS_VOLTAGE_CALC".$i."_PLAN4`,
            IFNULL(x1.sum,0)  `VOLTAGE_CALC".$i."_PLAN` , IFNULL(x2.sum,0)  `VOLTAGE_CALC".$i."_NOT_PLAN`,
            IFNULL(x4.sum,0)  `MMS_VOLTAGE_CALC".$i."_PLAN`,
            ";

            $z = (($searcCriteria['object'] == 1) ?
                                    dbProc::getPhisicalMMSPlanList(($i+1).'z') :
                                    dbProc::getPhisicalMMSPlanList(($i+1).'v'));

            $query .= " (SELECT dr.DRBI_MERVIENIBA  FROM `DARBI` dr where dr.DRBI_KKAL_SHIFRS in( ".$z." )
                        LIMIT 1) `VOLTAGE_CALC".$i."_MEASURE`"  ;

            $query .= " from `KL_ED_IECIRKNI` kedi ";

            $query .= " LEFT JOIN (SELECT SUM(dr.DRBI_DAUDZUMS*k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                FROM `DARBI` dr ".$joinSection."  WHERE v.KAKV_IR_PLANS = 1  ".$where." ".$whereM."
                and dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  x1   ON (x1.KEDI_ID = kedi.KEDI_ID)
                LEFT JOIN (SELECT SUM(dr.DRBI_DAUDZUMS*k.KKAL_KOEFICENT)as `sum`, e.KEDI_ID
                FROM `DARBI` dr ".$joinSection."  WHERE v.KAKV_IR_PLANS <> 1  ".$where." ".$whereM."
                and dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  x2   ON (x2.KEDI_ID = kedi.KEDI_ID)
                LEFT JOIN (SELECT SUM(mms.KMSD_".($i+1).(($searcCriteria['object'] == 1)?"Z":"V").") as `sum`, mms.KMSD_KEDI_KODS
                FROM `KL_MMS_DARBI` mms WHERE 1  ".$where1." GROUP BY mms.KMSD_KEDI_KODS) x4 ON (x4.KMSD_KEDI_KODS = kedi.KEDI_KODS)  ";

            $query .= " LEFT JOIN (SELECT SUM(mms.KMSD_".($i+1).(($searcCriteria['object'] == 1)?"Z":"V").") as `sum`, mms.KMSD_KEDI_KODS
                        FROM `KL_MMS_DARBI` mms WHERE KMSD_CETUKSNIS = 1  ".$where1."
                        GROUP BY mms.KMSD_KEDI_KODS)  y1   ON (y1.KMSD_KEDI_KODS = kedi.KEDI_KODS)
                        LEFT JOIN (SELECT SUM(mms.KMSD_".($i+1).(($searcCriteria['object'] == 1)?"Z":"V").") as `sum`, mms.KMSD_KEDI_KODS
                        FROM `KL_MMS_DARBI` mms WHERE KMSD_CETUKSNIS = 2  ".$where1."
                        GROUP BY mms.KMSD_KEDI_KODS)  y2   ON (y2.KMSD_KEDI_KODS = kedi.KEDI_KODS)
                        LEFT JOIN (SELECT SUM(mms.KMSD_".($i+1).(($searcCriteria['object'] == 1)?"Z":"V").") as `sum`, mms.KMSD_KEDI_KODS
                        FROM `KL_MMS_DARBI` mms WHERE KMSD_CETUKSNIS = 3  ".$where1."
                        GROUP BY mms.KMSD_KEDI_KODS)  y3   ON (y3.KMSD_KEDI_KODS = kedi.KEDI_KODS)
                        LEFT JOIN (SELECT SUM(mms.KMSD_".($i+1).(($searcCriteria['object'] == 1)?"Z":"V").") as `sum`, mms.KMSD_KEDI_KODS
                        FROM `KL_MMS_DARBI` mms WHERE KMSD_CETUKSNIS = 4  ".$where1."
                        GROUP BY mms.KMSD_KEDI_KODS)  y4   ON (y4.KMSD_KEDI_KODS = kedi.KEDI_KODS)";

            $query .= " LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (1,2,3) ".$where." and v.KAKV_IR_PLANS = 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  s1   ON (s1.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (4,5,6) ".$where." and v.KAKV_IR_PLANS = 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  s2   ON (s2.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (7,8,9) ".$where." and v.KAKV_IR_PLANS = 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  s3   ON (s3.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (10,11,12) ".$where." and v.KAKV_IR_PLANS = 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  s4   ON (s4.KEDI_ID = kedi.KEDI_ID)";

            $query .= " LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (1,2,3) ".$where." and v.KAKV_IR_PLANS <> 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  z1   ON (z1.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (4,5,6) ".$where." and v.KAKV_IR_PLANS <> 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  z2   ON (z2.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (7,8,9) ".$where." and v.KAKV_IR_PLANS <> 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  z3   ON (z3.KEDI_ID = kedi.KEDI_ID)
                    LEFT JOIN (SELECT sum(dr.DRBI_DAUDZUMS * k.KKAL_KOEFICENT) as `sum`, e.KEDI_ID
                    FROM `DARBI` dr  ".$joinSection." WHERE  a.RAKT_MENESIS IN (10,11,12) ".$where." and v.KAKV_IR_PLANS <> 1 and
                    dr.DRBI_KKAL_SHIFRS in( ".$z." ) GROUP BY e.KEDI_ID)  z4   ON (z4.KEDI_ID = kedi.KEDI_ID)";

            $query .= " where 1 ";

            if(isset($searcCriteria['edRegion']) && $searcCriteria['edRegion'] != -1)
            {
                $query .= " and kedi.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $query .= " and kedi.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }



            $query .= " GROUP BY kedi.KEDI_ID";
            $query .= " ORDER BY kedi.KEDI_KODS asc";
        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

  // -----------------------------------------------------------------------------
	// Atgriezh akta(-as). atgriezh visas.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActFullList($searchString, $orderString, $trase = 0)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['monthFrom'] = $sCriteria[1];
             $searcCriteria['monthUntil'] = $sCriteria[2];
             $searcCriteria['worker'] = $sCriteria[3];
             $searcCriteria['edRegion'] = $sCriteria[4];
             $searcCriteria['voltage'] = $sCriteria[5];
             $searcCriteria['type'] = $sCriteria[6];
             $statusString = '';
             $status = explode("*", $sCriteria[8]);
             if($status[0] == -1)
             {
                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                 	  if($row['nosaukums'] != STAT_DELETE ||
                      ($row['nosaukums'] == STAT_DELETE &&
                      userAuthorization::isAdmin() && !dbProc::isUserInRole(userAuthorization::getUserId(), ROLE_ED_USER)))
                      {
                        $statusString .= "'".$row['nosaukums']."',";
                      }
                 	}
                    $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             $searcCriteria['section'] = urldecode($sCriteria[9]);

		    $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,

            a.RAKT_FULL_NUMBER `NUMURS`, " . dbLayer::sqlParseDate('AAUD_DATUMS') .",
            s.KSRG_NOSAUKUMS, o.KOBJ_NOSAUKUMS,
            w.KWOI_NOSAUKUMS `WORKER`,
            (SELECT SUM(d.DRBI_CILVEKSTUNDAS) from `DARBI` d  WHERE d.DRBI_RAKT_ID = a.RAKT_ID)  AS `WORK_TOTAL`,
            (SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER = 1)  AS `ST_MATER_TOTAL` ,
            (SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER <> 1)  AS `DU_MATER_TOTAL` ,
             e.KEDI_REGIONS, e.KEDI_SECTION,
             (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'INSERT') as `IN_AAUD_DATUMS` ,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'ACCEPT') as `AC_AAUD_DATUMS`,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'CLOSE') as `CL_AAUD_DATUMS`,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'CLOSEWRITEOFF') as `WO_AAUD_DATUMS`

            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID AND v.KAKV_TRASE = ".$trase.")
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `AKTA_STATUSA_MAINA` sm ON (a.RAKT_ID = sm.AAUD_RAKT_ID AND a.RAKT_STATUS = sm.AAUD_STATUS)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID AND s.KSRG_TRASE  = ".$trase.")
            LEFT JOIN `KL_OBJEKTI` o ON (a.RAKT_KOBJ_ID = o.KOBJ_ID AND o.KOBJ_TRASE  = ".$trase.")


            where 1 ";

           /* $query .= " AND AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."' AND AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."'";   */


            if(isset($searcCriteria['edRegion']) && $searcCriteria['edRegion'] != -1)
            {
                $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }


            if(isset($searcCriteria['voltage']) && $searcCriteria['voltage'] != -1)
            {
                $query .= " and a.RAKT_KSRG_ID = '".$searcCriteria['voltage']."' ";
            }

            if(isset($searcCriteria['type']) && $searcCriteria['type'] != -1)
            {
                $query .= " and a.RAKT_KAKV_ID = '".$searcCriteria['type']."' ";
            }
            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }

            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $query .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
                //$query .= " and (sm.AAUD_STATUS in  (".$searcCriteria['status'].") ";
                
            }
            
            $query .= " AND sm.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['monthFrom'], $searcCriteria['year'])."' AND sm.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['monthUntil'], $searcCriteria['year'])."' ";
            $query .= " AND a.RAKT_TRASE = ".$trase;
            $query .= " GROUP BY a.RAKT_ID";

            if($orderString != '')
            {
              $query .= " ORDER BY ".$orderString;
            }
            else
            {
              $query .= " ORDER BY `NUMURS` asc";
            }
        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}
// -----------------------------------------------------------------------------
	// Atgriezh akta(-as). atgriezh visas ar visiem statusiem.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActFullListStatuss($searchString, $orderString, $trase = 0)
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['monthFrom'] = $sCriteria[1];
             $searcCriteria['monthUntil'] = $sCriteria[2];
             $searcCriteria['worker'] = $sCriteria[3];
             $searcCriteria['edRegion'] = $sCriteria[4];
             $searcCriteria['voltage'] = $sCriteria[5];
             $searcCriteria['type'] = $sCriteria[6];
             $statusString = '';
             $status = explode("*", $sCriteria[8]);
             if($status[0] == -1)
             {
                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                 	   $statusString .= "'".$row['nosaukums']."',";
                 	}
                               $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             $searcCriteria['section'] = urldecode($sCriteria[9]);
            $query = "select *, k.KRFK_NOZIME `STATUS_NAME`, v.KAKV_NOSAUKUMS `TYPE`,
            a.RAKT_FULL_NUMBER `NUMURS`, " . dbLayer::sqlParseDate('AAUD_DATUMS') . ",
            s.KSRG_NOSAUKUMS, o.KOBJ_NOSAUKUMS,
            w.KWOI_NOSAUKUMS `WORKER`,
            (SELECT SUM(d.DRBI_CILVEKSTUNDAS) from `DARBI` d  WHERE d.DRBI_RAKT_ID = a.RAKT_ID)  AS `WORK_TOTAL`,
            (SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER = 1)  AS `ST_MATER_TOTAL` ,
            (SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER <> 1)  AS `DU_MATER_TOTAL` ,
             e.KEDI_REGIONS, e.KEDI_SECTION,
             (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'INSERT') as `IN_AAUD_DATUMS` ,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'ACCEPT') as `AC_AAUD_DATUMS`,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'CLOSE') as `CL_AAUD_DATUMS`,
            (SELECT DATE_FORMAT(MAX(`AAUD_DATUMS`), '%d.%m.%Y')  FROM `AKTA_STATUSA_MAINA` WHERE  a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'CLOSEWRITEOFF') as `WO_AAUD_DATUMS`

            from `AKTI` a
            LEFT JOIN `AKTA_STATUSA_MAINA` sm ON (a.RAKT_ID = sm.AAUD_RAKT_ID  AND a.RAKT_STATUS = sm.AAUD_STATUS)
            LEFT JOIN `KL_REF_KODI` k ON (sm.AAUD_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID)
            LEFT JOIN `KL_OBJEKTI` o ON (a.RAKT_KOBJ_ID = o.KOBJ_ID)


            where 1 ";

             if(isset($searcCriteria['edRegion']) && $searcCriteria['edRegion'] != -1)
            {
                $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }


            if(isset($searcCriteria['voltage']) && $searcCriteria['voltage'] != -1)
            {
                $query .= " and a.RAKT_KSRG_ID = '".$searcCriteria['voltage']."' ";
            }

            if(isset($searcCriteria['type']) && $searcCriteria['type'] != -1)
            {
                $query .= " and a.RAKT_KAKV_ID = '".$searcCriteria['type']."' ";
            }
            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }

            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                   $query .= " and  sm.AAUD_STATUS in  (".$searcCriteria['status'].") ";
           }

            $query .= " AND sm.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['monthFrom'], $searcCriteria['year'])."' AND sm.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['monthUntil'], $searcCriteria['year'])."' ";

             $query .= " AND a.RAKT_TRASE = ".$trase;
            if($orderString != '')
            {
              $query .= " ORDER BY ".$orderString;
            }
            else
            {
              $query .= " GROUP BY RAKT_FULL_NUMBER ORDER BY `RAKT_FULL_NUMBER` asc,  sm.AAUD_DATUMS asc";
            }
        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}
    // Atgriezh akta(-as). atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActTotalReportList($searchString, $trase = 0, $sign= 'P')
	{
            $sCriteria = explode("^", $searchString);

             $searcCriteria['year'] = $sCriteria[0];
             $searcCriteria['month'] = $sCriteria[1];
             $searcCriteria['worker'] = $sCriteria[2];
             $searcCriteria['edRegion'] = $sCriteria[3];
             $searcCriteria['section'] = $sCriteria[4];
             $searcCriteria['contract'] = $sCriteria[5];
          //(SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER <> 1)  AS `MATER_TOTAL` ,  
          //(SELECT ".dbLayer::sqlParseDate('AAUD_DATUMS')." FROM `AKTA_STATUSA_MAINA`  WHERE a.RAKT_ID = AAUD_RAKT_ID AND AAUD_STATUS = 'CLOSE' ORDER BY AAUD_DATUMS DESC LIMIT 1) AS `AAUD_DATUMS`
          $query = " SELECT * FROM ( select *,
            e.KEDI_SECTION `ED`,
            w.KWOI_NOSAUKUMS `WORKER`,
            a.RAKT_FULL_NUMBER `NUMURS`,
            ww.KWRC_ID AS `WRITE_OFF_ID`,
            ww.KWRC_TITLE  AS `WRITE_OFF_ACCOUNT`,
            e.KEDI_REGIONS AS `REGION` ,
             NVL((SELECT SUM(m.MATR_DAUDZUMS * m.MATR_CENA) from `MATERIALI` m WHERE m.MATR_RAKT_ID = a.RAKT_ID AND m.MATR_IS_WORKER = 1
		AND ((a.RAKT_IS_AUTO = 1 and ( MATR_WORK_APROVE_DATE BETWEEN 
        '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."' ) 
		) or ( a.RAKT_IS_AUTO = 0 ) ) ) , 0) AS `MATER_TOTAL`,        
	    (SELECT SUM(d.DRBI_CILVEKSTUNDAS) from `DARBI` d WHERE d.DRBI_RAKT_ID = a.RAKT_ID
		AND ((a.RAKT_IS_AUTO = 1 and ( DRBI_WORK_APROVE_DATE BETWEEN 
        '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."' ) 
		) or ( a.RAKT_IS_AUTO = 0 ) ) )  AS `WORK_TOTAL`,              
            (SELECT MAX(DRBI_WORK_APROVE_DATE) FROM `DARBI` WHERE DRBI_RAKT_ID = a.RAKT_ID ) as `DRBI_APPROVE_DATE`
            from `AKTI` a
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `KL_WRITEOFF_CODE` ww  ON (a.RAKT_KWRC_ID = ww.KWRC_ID)
            LEFT JOIN 
(SELECT MAX(AAUD_STATUS) AAUD_STATUS, MAX(AAUD_DATUMS) AAUD_DATUMS, AAUD_RAKT_ID FROM `AKTA_STATUSA_MAINA` GROUP BY AAUD_RAKT_ID, AAUD_STATUS)  s ON (a.RAKT_ID = s.AAUD_RAKT_ID)             LEFT JOIN `KL_CONTRACT` k ON (a.RAKT_VV_NUMBER = k.KCNT_VV_NUMBER AND a.RAKT_KWOI_KODS = k.KCNT_KWOI_KODS)
            where 1 AND `RAKT_PROJECT` = '0' ";
              //

            //$query .= " and a.RAKT_GADS = '".$searcCriteria['year']."' ";

            //$query .= " and a.RAKT_MENESIS = '".$searcCriteria['month']."' ";

            $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";

            $query .= " and a.RAKT_VV_NUMBER = '".$searcCriteria['contract']."' ";

            $query .= " and e.KEDI_REGIONS = '".$searcCriteria['edRegion']."' ";

            $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            //$query .= " and k.KCNT_SECTION = '".$searcCriteria['section']."' ";

            //$query .= " and a.RAKT_STATUS IN ('ACCEPT', 'CLOSE', 'CLOSEWRITEOFF') ";

            //$query .= " and s.AAUD_STATUS = 'CLOSE' "; 

            //$query .= " AND s.AAUD_DATUMS >= '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."' AND s.AAUD_DATUMS  <= '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."'";
                        
            $query .= " AND a.RAKT_TRASE = ".$trase;
			if($sign == 'E') {
				$query .= " and a.RAKT_SIGNATURE  IN ('E', 'K') ";
			} else {
				$query .= " and a.RAKT_SIGNATURE  IN ('P') ";
            }
            
            $query .= ") y ";
            $query .= " WHERE (y.RAKT_IS_AUTO = 1            
            AND y.DRBI_APPROVE_DATE BETWEEN '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."'            
        )
        or ( y.RAKT_IS_AUTO = 0
                and y.AAUD_STATUS = 'CLOSE'
                AND y.AAUD_DATUMS BETWEEN '" .  dbProc::getActDateFrom($searcCriteria['month'], $searcCriteria['year'])."'
                AND '".dbProc::getActDateTo($searcCriteria['month'], $searcCriteria['year'])."' )";
        $query .= " GROUP BY  RAKT_ID ORDER BY WRITE_OFF_ID, RAKT_FULL_NUMBER";

       // echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}




    // -----------------------------------------------------------------------------
	// Atgriezh kopeejo aktus skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActCount($searchString)
	{
           $sCriteria = explode("^", $searchString);

             $searcCriteria['yearFrom'] = $sCriteria[0];
             $searcCriteria['yearUntil'] = $sCriteria[1];
             $searcCriteria['monthFrom'] = $sCriteria[2];
             $searcCriteria['monthUntil'] = $sCriteria[3];
             $searcCriteria['worker'] = $sCriteria[4];
             $searcCriteria['edCode'] = $sCriteria[5];
             $searcCriteria['voltage'] = $sCriteria[6];
             $searcCriteria['ouner'] = $sCriteria[7];
             $searcCriteria['type'] = $sCriteria[8];

             $statusString = '';
             $status = explode("*", $sCriteria[10]);
             if($status[0] == -1)
             {
                $res=dbProc::getKrfkName(KRFK_STATUS);
                 if (is_array($res))
                 {
                 	foreach ($res as $row)
                 	{
                 	  if($row['nosaukums'] != STAT_DELETE ||
                      ($row['nosaukums'] == STAT_DELETE &&
                      userAuthorization::isAdmin() && !dbProc::isUserInRole(userAuthorization::getUserId(), ROLE_ED_USER)))
                      {
                        $statusString .= "'".$row['nosaukums']."',";
                      }
                 	}
                    $searcCriteria['status']  = substr($statusString, 0, -1);
                 }
                 unset($res);
             }
             else
             {
                foreach($status as $s)
                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             $searcCriteria['designation'] = $sCriteria[11];
             $searcCriteria['section'] = urldecode($sCriteria[12]);

		    $query = "SELECT COUNT(1) as `ACT_COUNT` FROM (select 1
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_AKTA_VEIDS` v ON (a.RAKT_KAKV_ID = v.KAKV_ID)
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            LEFT JOIN `KL_SPRIEGUMS` s ON (a.RAKT_KSRG_ID = s.KSRG_ID)
            where 1 AND `RAKT_PROJECT` = '0' ";

            $userInfo = dbProc::getUserInfo(userAuthorization::getUserId());
      	    if(count($userInfo) >0 )
      	    {
      		    $user = $userInfo[0];
       	    }
            if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1  &&
                isset($searcCriteria['yearUntil']) && $searcCriteria['yearUntil'] != -1)
            {
              if ($searcCriteria['yearFrom'] == $searcCriteria['yearUntil'])
              {
                $query .= " and a.RAKT_GADS = '".$searcCriteria['yearFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_GADS >= '".$searcCriteria['yearFrom']."' and a.RAKT_GADS <= '".$searcCriteria['yearUntil']."') ";
              }
            }
            if(isset($searcCriteria['monthFrom']) && $searcCriteria['monthFrom'] != -1  &&
                isset($searcCriteria['monthUntil']) && $searcCriteria['monthUntil'] != -1)
            {
              if ($searcCriteria['monthFrom'] == $searcCriteria['monthUntil'])
              {
                $query .= " and a.RAKT_MENESIS = '".$searcCriteria['monthFrom']."' ";
              }
              else
              {
                 $query .= " and (a.RAKT_MENESIS >= '".$searcCriteria['monthFrom']."' and a.RAKT_MENESIS <= '".$searcCriteria['monthUntil']."') ";
              }
            }

            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }

            if(isset($searcCriteria['edCode']) && $searcCriteria['edCode'] != -1)
            {
                $query .= " and e.KEDI_KODS = '".$searcCriteria['edCode']."' ";
            }
            if(isset($searcCriteria['section']) && $searcCriteria['section'] != -1)
            {
                $query .= " and e.KEDI_SECTION = '".$searcCriteria['section']."' ";
            }


            if(isset($searcCriteria['voltage']) && $searcCriteria['voltage'] != -1)
            {
                $query .= " and a.RAKT_KSRG_ID = '".$searcCriteria['voltage']."' ";
            }
            if(isset($searcCriteria['ouner']) && $searcCriteria['ouner'] != -1)
            {
                $query .= " and a.RAKT_RLTT_ID = '".$searcCriteria['ouner']."' ";
            }

            if(isset($searcCriteria['type']) && $searcCriteria['type'] != -1)
            {
                $query .= " and a.RAKT_KAKV_ID = '".$searcCriteria['type']."' ";
            }

            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $query .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
            }
            if(isset($searcCriteria['designation']) && $searcCriteria['designation'] != '')
            {
                $query .= " and a.RAKT_OPERATIVAS_APZIM LIKE  '%".$searcCriteria['designation']."%' ";
            }
            $query .= " GROUP BY `RAKT_FULL_NUMBER`)q ";
        //echo $query;
		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);

		return isset($result[0]['ACT_COUNT']) ? $result[0]['ACT_COUNT'] : false;
	}



