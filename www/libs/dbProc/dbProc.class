	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isActiveUser($userId)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select count(RLTT_ID) as `amount`
					from `LIETOTAJI`
					where  `RLTT_IR_AKTIVS`=1 ');

		return (isset($res[0]['amount']) && $res[0]['amount']>0) ? $res[0]['amount'] : false;
	}

	// -----------------------------------------------------------------------------
	// Parbauda - vai lieotajs ar tadu lietotaju vardu un parole var ienakt sistemaa vai ne
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function checkUserForLogin($login, $password='')
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select * from `LIETOTAJI`
					where '.
					' `RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"'.
                    (empty($password)?'':' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")').
					' and `RLTT_IR_AKTIVS`=1 '  .
                    ' and ( `RLTT_IR_ADMINS` = 1 or ( `RLTT_ROLE` IS NOT NULL and  `RLTT_ROLE` <> "")
                    or ( `RLTT_KWOI_KODS` IS NOT NULL and  `RLTT_KWOI_KODS` <> "")) '
				);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}

	// -----------------------------------------------------------------------------
	// Parbauda - vai eksiste lieotajs ar tadu lietotaju vardu un parole
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
