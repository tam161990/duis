                                $yearUntil = '',
                                $monthFrom = '',
                                $monthUntil = '',
                                $worker = '',
                                $edRegion = '',
                                $edArea = '',
                                $voltage = '',
                                $ouner = '',
                                $type = '',
                                $isFinished = '',
                                $status1 = '',
                                $trLocation = '',
                                $object = '',
                                $isOtherPayment = '',
                                $overTime = '',
                                $code = '',
                                $favoritMaterial = '',
                                $favoritCalc = '',
                                $priority = '',
                                $objectVoltage = '',
                                $designation  = -1 ,
                                $section = '',
                                $contract = ''
                            )
	{

			$query = 'insert into `SEARCH_CRITERIA` (
                                `user`,
