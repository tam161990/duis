	// -----------------------------------------------------------------------------
	function getExcelInfo($actId)
	{
		$oSQL=new dbLayer();
		$sql = 'select f.*,'.dbLayer::sqlParseDateTime('EFLS_DATUMS').',
                     CONCAT(lt.RLTT_VARDS," ", lt.RLTT_UZVARDS) `AUTORS`
					from `EXCEL_FAILI` f, `LIETOTAJI` lt
					where f.EFLS_RLTT_ID=lt.RLTT_ID
