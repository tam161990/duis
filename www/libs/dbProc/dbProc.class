    function getExcelId($actId)
	{
		$oSQL=new dbLayer();
		$sql = 'select MAX(f.EFLS_ID) as FILE_ID
					from `EXCEL_FAILI` f
					where  f.EFLS_RAKT_ID='.dbLayer::quote_smart($actId);

        $res = $oSQL->makeQuery($sql);
        if (isset($res[0]['FILE_ID']))
        {
            return $res[0]['FILE_ID'];
        }
        return false;
    }

// STATUSA MAINA
    // -----------------------------------------------------------------------------
	// atgriezh audita datus peec acta ID
	// author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getAuditInfo($actId)
	{
		$oSQL=new dbLayer();
		$sql = 'select a.*,'.dbLayer::sqlParseDateTime('AAUD_DATUMS').',
                     CONCAT(lt.RLTT_VARDS," ", lt.RLTT_UZVARDS) `AUTORS`,
                     k.KRFK_NOZIME `STATUS`
					from `AKTA_STATUSA_MAINA` a
                    LEFT JOIN `KL_REF_KODI` k ON (a.AAUD_STATUS = k.KRFK_VERTIBA AND k.KRFK_NOSAUKUMS = "STATUS" )
                    LEFT JOIN `LIETOTAJI` lt ON (a.AAUD_RLTT_ID=lt.RLTT_ID )
					where   a.AAUD_RAKT_ID='.dbLayer::quote_smart($actId).'
                    order by a.AAUD_ID desc';

		return $oSQL -> makeQuery($sql);
    }
    
    function deleteAuditInfo($actId)
	{
		$oSQL=new dbLayer();
		$sql = 'DELETE from `AKTA_STATUSA_MAINA` where AAUD_RAKT_ID='.dbLayer::quote_smart($actId);

		return $oSQL -> makeQuery($sql);
	}

