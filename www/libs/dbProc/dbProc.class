    // -----------------------------------------------------------------------------
    // Atgriezh aktiva darba veida sarakstu
    // Author: Tatjana Fedorkova
    // -----------------------------------------------------------------------------
    function getWorkTypeListByWork($actId)
    {
    $query = 'select DISTINCT `KLDV_ID`,`KLDV_NOSAUKUMS`, `DRBI_WORK_TYPE_TEXT` 
            from `kl_darba_veidi`
            INNER JOIN `darbi` ON DRBI_WORK_TYPE_ID = KLDV_ID
            where `KLDV_IR_AKTIVS` = 1
            AND `DRBI_RAKT_ID` = '.dbLayer::quote_smart($actId).'
