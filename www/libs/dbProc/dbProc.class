        function getMmsWorksByCodeList($code)
        {
                
            $query = 'select `KMSD_DAUDZUMS`, `KMSD_VADU_SKAITS`,  `KMSD_KSRG_KODS`, `KMSD_NOSACIJUMA_KODS`,
                `KMSD_IZPILDITAJA_KODS`, `KMSD_KEDI_KODS`, `KMSD_VV_NUMURS`
                from `KL_MMS_DARBI`
                where `KMSD_KODS` = "'.dbLayer::quote_smart($code).'"';

            $oSQL = new dbLayer;
            return $oSQL -> makeQuery($query);
        }

