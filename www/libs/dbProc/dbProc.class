    function getMMSWorkListByEd($edId, $trase = 0, $contract = false, $activ = true)
	{ 
            $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
			$query = 'select * from `KL_MMS_DARBI` d
            INNER JOIN `KL_ED_IECIRKNI` ed ON (d.KMSD_KEDI_KODS = ed.KEDI_KODS
                and ed.KEDI_ID = '.dbLayer::quote_smart($edId).')
            where d.KMSD_IR_EPLA = '.$trase.
            (($contract == false)?'' : ' AND `KMSD_VV_NUMURS`="'.dbLayer::quote_smart($contract).'"'). '
            order by `'.$column.'` asc';

	   	$oSQL = new dbLayer;
        //echo $query;
		return $oSQL -> makeQuery($query);
	}

