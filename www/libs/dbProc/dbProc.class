// =============================================================================
// KL_KALKULACIJA
// =============================================================================

	// -----------------------------------------------------------------------------
	// Atgriezh kalkul�cija(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
		if ($ID)
		{
            $query = 'select *, g.KKLG_NOSAUKUMS as `GROUP` , w.KWOI_NOSAUKUMS as `WORKER`,
                ' .dbLayer::sqlParseDateTime('KKAL_CREATED') .',  
                ' .dbLayer::sqlParseDateTime('KKAL_EDITED') .'
				from `KL_KALKULACIJA`
                LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KKAL_KWOI_KODS)
                LEFT JOIN `KL_KALKULACIJAS_GRUPAS` g ON (KKAL_GRUPAS_KODS = g.KKLG_KODS)
				where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION);
            }
            if($column == 'GROUP')
            {
                $column = 'g.KKLG_NOSAUKUMS';
            }
            if($column == 'WORKER')
            {
                $column = 'w.KWOI_NOSAUKUMS';
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_CALCULALATION);
            }
            if($orderColumn == 'GROUP')
            {
                $orderColumn = 'g.KKLG_NOSAUKUMS';
            }
            if($orderColumn == 'WORKER')
            {
                $orderColumn = 'w.KWOI_NOSAUKUMS';
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            $query = 'select *, g.KKLG_NOSAUKUMS as `GROUP`, w.KWOI_NOSAUKUMS as `WORKER`,
                ' .dbLayer::sqlParseDateTime('KKAL_CREATED') .',  
                ' .dbLayer::sqlParseDateTime('KKAL_EDITED') .'
            from `KL_KALKULACIJA`
            LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KKAL_KWOI_KODS)
            LEFT JOIN `KL_KALKULACIJAS_GRUPAS` g ON (KKAL_GRUPAS_KODS = g.KKLG_KODS)
            where '.$searchString.'
            GROUP BY `KKAL_ID` order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);

	}

