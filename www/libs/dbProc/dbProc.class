				set `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($code).'",
                    `KKAL_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KKAL_APRAKSTS` = "'.dbLayer::quote_smart($description).'",

                    `KKAL_MERVIENIBA` = "'.dbLayer::quote_smart($measure).'",
                    `KKAL_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `KKAL_FIZ_RADIJUMS` = "'.dbLayer::quote_smart($fizRadijums).'",

                    `KKAL_KWOI_KODS` = "'.dbLayer::quote_smart($worker).'",
                    `KKAL_KEDI_SECTION` = "'.dbLayer::quote_smart($edArea).'",
                    `KKAL_PLAN_PRICE` = "'.dbLayer::quote_smart($planPrice).'",
                    `KKAL_NOT_PLAN_PRICE` = "'.dbLayer::quote_smart($notPlanPrice).'",
                    `KKAL_IS_ELEMENT` = "'.dbLayer::quote_smart($element).'",
                    `KKAL_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'"
				where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `'.$tableName.'`
                (`KKAL_GRUPAS_KODS`, `KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_APRAKSTS`,
                 `KKAL_MERVIENIBA`, `KKAL_IR_AKTIVS`, `KKAL_FIZ_RADIJUMS`,
                 `KKAL_KWOI_KODS`, `KKAL_KEDI_SECTION`, `KKAL_PLAN_PRICE`, `KKAL_NOT_PLAN_PRICE`,
                 `KKAL_IS_ELEMENT`, `KKAL_VV_NUMBER`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($chipher).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($description).'",
                "'.dbLayer::quote_smart($measure).'",
                "'.dbLayer::quote_smart($isActive).'",
                "'.dbLayer::quote_smart($fizRadijums).'",

                "'.dbLayer::quote_smart($worker).'",
                "'.dbLayer::quote_smart($edArea).'",
                "'.dbLayer::quote_smart($planPrice).'",
                "'.dbLayer::quote_smart($notPlanPrice).'",
                "'.dbLayer::quote_smart($element).'",
                "'.dbLayer::quote_smart($contract).'")';
		}
        //    echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa kalkul�cijas. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveCalculationTr2($chipher, $code, $title, $description, $measure, $isActive, $fizRadijums, $worker, $edArea, $planPrice, $notPlanPrice, $element, $contract, $isMain = true)
	{
        $tableName  = (($isMain)? 'KL_KALKULACIJA_TRASE' : 'KL_KALKULACIJA_TRASE_TEMP');

		$query = 'insert into `'.$tableName.'`
                (`KKAL_GRUPAS_KODS`, `KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_APRAKSTS`,
                 `KKAL_MERVIENIBA`, `KKAL_IR_AKTIVS`,   `KKAL_FIZ_RADIJUMS`, `KKAL_KWOI_KODS`, `KKAL_KEDI_SECTION`, `KKAL_PLAN_PRICE`, `KKAL_NOT_PLAN_PRICE`, `KKAL_IS_ELEMENT`, `KKAL_VV_NUMBER`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($chipher).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($description).'",

                "'.dbLayer::quote_smart($measure).'",
                "'.dbLayer::quote_smart($isActive).'",
                "'.dbLayer::quote_smart($fizRadijums).'",


                "'.dbLayer::quote_smart($worker).'",
                "'.dbLayer::quote_smart($edArea).'",
                "'.dbLayer::quote_smart($planPrice).'",
                "'.dbLayer::quote_smart($notPlanPrice).'",
                "'.dbLayer::quote_smart($element).'",
                "'.dbLayer::quote_smart($contract).'"
                )';

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai kaklkul�cijas doto  �ifru
	// eksistee. Ja dota kalkul�cija ID, shii kalkul�cija netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function calculationTrWithChipherExists($code, $ID = false)
	{
		$query = 'select `KKAL_ID` from `KL_KALKULACIJA_TRASE`
            where `KKAL_SHIFRS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KKAL_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KKAL_ID']);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo kalkul�cijas skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationTrCount($search = false, $column = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION_TR);
        }
        if($column == 'GROUP')
        {
           $column = 'g.KKLG_NOSAUKUMS';
        }
        if($column == 'WORKER')
                                                               {
            $column = 'w.KWOI_NOSAUKUMS';
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'SELECT count(a.KKAL_ID) as `RECORDCOUNT` from 
       (select `KKAL_ID` from `KL_KALKULACIJA_TRASE`
        LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KKAL_KWOI_KODS)
        LEFT JOIN `KL_KALKULACIJAS_GRUPAS` g ON (KKAL_GRUPAS_KODS = g.KKLG_KODS)
        where '.$searchString.' GROUP BY `KKAL_ID`) a ';
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
	}

     // -----------------------------------------------------------------------------
	// nodzes kaklkul�cijas sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function deleteCalculationTrTable($isMain = true)
	{
		$oSQL=new dbLayer();
        $tableName  = (($isMain)? 'KL_KALKULACIJA_TRASE' : 'KL_KALKULACIJA_TRASE_TEMP');
		return $oSQL->makeQuery('DROP TABLE IF EXISTS `'.$tableName.'`');
	}

    // -----------------------------------------------------------------------------
	// izveidot tmp kalkul�cijas sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function createCalculationTrTempTable()
	{
		$oSQL=new dbLayer();
        $sql =   'DROP TABLE IF EXISTS `KL_KALKULACIJA_TRASE_TEMP`';
        $oSQL->makeQuery($sql);
        $sql =   'CREATE TABLE `KL_KALKULACIJA_TRASE_TEMP` (
          `KKAL_ID` INT( 11 ) NOT NULL AUTO_INCREMENT ,
          `KKAL_GRUPAS_KODS` CHAR( 5 ) NOT NULL ,
          `KKAL_SHIFRS` CHAR( 5 ) NOT NULL ,
          `KKAL_NOSAUKUMS` VARCHAR( 150 ) CHARACTER SET utf8 COLLATE utf8_latvian_ci NOT NULL ,
          `KKAL_APRAKSTS` TEXT CHARACTER SET utf8 COLLATE utf8_latvian_ci NULL ,
          `KKAL_MERVIENIBA` VARCHAR( 15 ) CHARACTER SET utf8 COLLATE utf8_latvian_ci NOT NULL ,
          `KKAL_IR_AKTIVS` TINYINT( 1 ) DEFAULT 1 NOT NULL ,
          `KKAL_FIZ_RADIJUMS` VARCHAR( 4 ) NULL,
          `KKAL_KEDI_SECTION` VARCHAR( 250 ) NULL,
          `KKAL_KWOI_KODS` VARCHAR( 13 )  NULL,
          `KKAL_PLAN_PRICE` FLOAT( 7, 2 )  NULL,
          `KKAL_NOT_PLAN_PRICE` FLOAT( 7, 2 )  NULL,

          `KKAL_IS_ELEMENT`  tinyint(1) DEFAULT 0 NOT NULL ,
          `KKAL_KOEFICENT`   float(5,2) DEFAULT 1 NOT NULL ,
          `KKAL_VV_NUMBER` VARCHAR( 20 )  NOT NULL,
          PRIMARY KEY ( `KKAL_ID` ) ,
          INDEX ( `KKAL_GRUPAS_KODS` )
          ) TYPE = MYISAM CHARACTER SET utf8 COLLATE utf8_latvian_ci;';

		return $oSQL->makeQuery($sql);
	}

    // -----------------------------------------------------------------------------
	// parsaukt kalkul�cijas temp sql tabulu uz  KL_KALKULACIJA
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function renameCalculationTrTable()
	{
		$oSQL=new dbLayer();
		return $oSQL->makeQuery('ALTER TABLE `KL_KALKULACIJA_TRASE_TEMP` RENAME `KL_KALKULACIJA_TRASE`');
	}

