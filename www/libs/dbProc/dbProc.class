                                "'.dbLayer::quote_smart($report).'",
                                now() )';
               //ON DUPLICATE KEY UPDATE
//                '.(($yearFrom !='')?'`yearFrom`="'.dbLayer::quote_smart($yearFrom).'"':'').'
//                '.(($yearUntil !='')?',`yearUntil`="'.dbLayer::quote_smart($yearUntil).'"':'').'
