	// eksistee. Ja dota mms ID, shii mms netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function mmsWithCodeExists($code, $ID = false)
	{
		$query = 'select `KMSD_ID` from `KL_MMS_DARBI`
            where `KMSD_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KMSD_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KMSD_ID']);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh pabeigtus vai nepabeigtus MMS darbus.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkCode($ID)
	{
           $query = 'select `KMSD_KODS` from `KL_MMS_DARBI`
            where `KMSD_ID` = '.dbLayer::quote_smart($ID);

	   	$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
        return isset($result[0]['KMSD_KODS']) ? $result[0]['KMSD_KODS'] : false;
	}

