                    `KMSD_1Z`,`KMSD_2Z`,`KMSD_3Z`,`KMSD_4Z`,`KMSD_5Z`,`KMSD_6Z`,`KMSD_7Z`,`KMSD_8Z`,`KMSD_9Z`,
                    `KMSD_1V`,`KMSD_2V`,`KMSD_3V`,`KMSD_4V`,`KMSD_5V`,`KMSD_6V`,`KMSD_7V`,`KMSD_8V`,`KMSD_9V`,`KMSD_10V`,`KMSD_11V`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($workTime).'",
                "'.dbLayer::quote_smart($materialPrice).'",
