                    `KMSD_7V` = "'.dbLayer::quote_smart($v7).'",
                    `KMSD_8V` = "'.dbLayer::quote_smart($v8).'",
                    `KMSD_9V` = "'.dbLayer::quote_smart($v9).'",
                    `KMSD_10V` = "'.dbLayer::quote_smart($v10).'",
                    `KMSD_11V` = "'.dbLayer::quote_smart($v11).'"

				where `KMSD_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($code)
		{
			$query = 'insert into `'.$tableName.'`
                (`KMSD_KODS`,
                    `KMSD_CILVEKSTUNDAS`,
                    `KMSD_MATR_IZMAKSAS`,
                    `KMSD_CETUKSNIS`,
