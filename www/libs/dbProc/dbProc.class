	function saveSystemInfo($warning = '', $link_tmpl = '', $superadmin_name  = '')
	{
		if($link_tmpl != '')
		{
			$query = 'update `SYSTEM_INFO` SET `SNFO_LINK_TMPL`="'.dbLayer::quote_smart($link_tmpl).'" where `SNFO_ID` = 1';
        }
        else if($superadmin_name != '')
		{
