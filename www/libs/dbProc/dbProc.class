	// -----------------------------------------------------------------------------
	// Saglabaa Kalkul�cijas grupu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveCalculationGroup($ID, $code, $title, $isActive)
	{

		if ($ID)
		{
			$query = 'update `KL_KALKULACIJAS_GRUPAS`
				set `KKLG_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KKLG_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"
				where `KKLG_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `KL_KALKULACIJAS_GRUPAS`
                (`KKLG_KODS`, `KKLG_NOSAUKUMS`, `KKLG_IR_AKTIVS`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($isActive).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}



	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai kaklkul�cijas grupa ar doto  kodu
	// eksistee. Ja dota kalkul�cijas grupas ID, shii kalkul�cijas grupai netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function calculationGroupWithCodeExists($code, $ID = false)
	{
		$query = 'select `KKLG_ID` from `KL_KALKULACIJAS_GRUPAS`
            where `KKLG_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KKLG_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KKLG_ID']);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo kalkul�cijas grupas skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getCalculationGroupCount($search = false, $column = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_CALCULALATION_GROUP);
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'select count(`KKLG_ID`) as `RECORDCOUNT` from `KL_KALKULACIJAS_GRUPAS`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
	}

