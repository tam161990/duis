	// -----------------------------------------------------------------------------
	// Atgriezh dara uznemej(-us). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getWorkOwnerList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
		if ($ID)
		{
			$query = 'select *
				from `KL_WORK_OWNERS`
				where `KWOI_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_WORK_OWNERS);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_WORK_OWNERS);
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
			$query = 'select * from `KL_WORK_OWNERS`
            where '.$searchString.'
            order by `'.dbLayer::quote_smart($orderColumn).'` '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;

        $result = $oSQL -> makeQuery($query);
        // inicialize array for data

        if (is_array($result) && count($result)>0)
        {
             // counter
        	$i=0;
        	// filling $daa array with values from Array
        	foreach ($result as $row)
        	{
        		$result[$i]['CONTRACT_NO'] = dbProc::getContractNoStr($row['KWOI_KODS'], 0);
        		$result[$i]['CONTRACT_NO_TR'] = dbProc::getContractNoStr($row['KWOI_KODS'], 1);
        		// increment counter
        		$i++;
        	}
        }
        return $result;

	}

