        $sql =   'CREATE TABLE `KL_MATERIALI_TEMP` (
            `KMAT_ID` INT( 11 ) NOT NULL AUTO_INCREMENT ,
            `KMAT_KODS` CHAR( 7 ) NOT NULL ,
            `KMAT_NOSAUKUMS` VARCHAR( 160 ) CHARACTER SET utf8 COLLATE utf8_latvian_ci NOT NULL ,
            `KMAT_MERVIENIBA` VARCHAR( 15 ) CHARACTER SET utf8 COLLATE utf8_latvian_ci NOT NULL ,
            `KMAT_CENA` FLOAT(7,2) NOT NULL ,
            `KMAT_DAUDZUMS` FLOAT(7,2) NULL ,
            `KMAT_IR_AKTIVS` TINYINT( 1 ) DEFAULT 1 NOT NULL ,
            PRIMARY KEY ( `KMAT_ID` ) ,
            INDEX ( `KMAT_NOSAUKUMS` ) ,
            UNIQUE `KMAT_KODS` ( `KMAT_KODS` )
            ) TYPE = MYISAM CHARACTER SET utf8 COLLATE utf8_latvian_ci;';

