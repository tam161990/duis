    // save MMS from CSV import    
    function saveMmsCalculationFromCsv($data, $user)
	{       
        $query = 'INSERT INTO `KL_MMS_KALKULACIJA` 
                    (                       
                        `KMKL_KMSD_NOSACIJUMA_KODS`,
                        `KMKL_KKAL_SHIFRS`,
                        `KMKL_NOKL_SPRIEGUMS_10`,
                        `KMKL_NOKL_SPRIEGUMS_NE_10`,
                        `KMKL_DAUDZUMS`,
                        `KMKL_IZMANTOT_LINIJU`,
                        `KMKL_KOEFICENTS`,
                        `KMKL_IZMANTOT_VADU`,
                        `KMKL_IR_AKTIVS`,
                        `KMKL_TRASE`,
                       
                        `KMKL_CREATOR`
                    )
                    VALUES
                    (
                            "'.dbLayer::quote_smart($data[0]).'",
                            "'.dbLayer::quote_smart($data[1]).'",
                            "'.dbLayer::quote_smart($data[2]).'",
                            "'.dbLayer::quote_smart($data[3]).'",
                            "'.dbLayer::quote_smart($data[4]).'",
                            "'.dbLayer::quote_smart($data[5]).'",
                            "'.dbLayer::quote_smart($data[6]).'",
                            "'.dbLayer::quote_smart($data[7]).'",
                            "'.dbLayer::quote_smart($data[8]).'",
                            "'.dbLayer::quote_smart($data[9]).'",
                           
                            "'.dbLayer::quote_smart( $user).'"
                        )
                    ON DUPLICATE KEY UPDATE
                            `KMKL_NOKL_SPRIEGUMS_10` = "'.dbLayer::quote_smart($data[2]).'",
                            `KMKL_NOKL_SPRIEGUMS_NE_10` = "'.dbLayer::quote_smart($data[3]).'",
                            `KMKL_DAUDZUMS` = "'.dbLayer::quote_smart($data[4]).'",
                            `KMKL_IZMANTOT_LINIJU` = "'.dbLayer::quote_smart($data[5]).'",
                            `KMKL_KOEFICENTS` = "'.dbLayer::quote_smart($data[6]).'",
                            `KMKL_IZMANTOT_VADU` = "'.dbLayer::quote_smart($data[7]).'",
                            `KMKL_IR_AKTIVS` = "'.dbLayer::quote_smart($data[8]).'",
                            
                            `KMKL_EDITOR` = "'.dbLayer::quote_smart($user).'",
                            `KMKL_EDITED` = now()
                    ';
                    //echo $query;
                    $oDB = new dbLayer;
                    $result = $oDB -> makeQuery($query);
            
                    return ($result !== false);
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh kopeejo mms-kalkul�cijas skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMmsCalculationCount($search = false, $column = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_MMS_WORK_CALCULALATION);
        }
        
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        $query =  'select count(`KMKL_ID`) as `RECORDCOUNT` from `KL_MMS_KALKULACIJA`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cija(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMmsCalculationList($ID = false, $offset = false, $limit = false,
                                    $search =  false,
                                    $column = false,
                                    $order =  'ASC',
                                    $orderColumn = false)
    {
        if ($ID)
        {
            $query = 'select *, ' .dbLayer::sqlParseDateTime('KMKL_CREATED') .',  
                ' .dbLayer::sqlParseDateTime('KMKL_EDITED') .', `KKAL_NOSAUKUMS`
                from `KL_MMS_KALKULACIJA`
                LEFT JOIN `kl_kalkulacija` ON `KKAL_SHIFRS` = 	`KMKL_KKAL_SHIFRS`
                where `KMKL_ID` = "'.dbLayer::quote_smart($ID).'"';
        }
        else
        {
            if($column === false)
            {
                $column = dbProc::getKlklDefaultColumn(KL_MMS_WORK_CALCULALATION);
            }
           
            if($orderColumn === false)
            {
                $orderColumn = dbProc::getKlklDefaultColumn(KL_MMS_WORK_CALCULALATION);
            }
            
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }

           
            $query = 'select *, ' .dbLayer::sqlParseDateTime('KMKL_CREATED') .',
                    ' .dbLayer::sqlParseDateTime('KMKL_EDITED') .', 
                    (SELECT DISTINCT `KKAL_NOSAUKUMS` FROM `kl_kalkulacija` WHERE `KKAL_SHIFRS` = 	`KMKL_KKAL_SHIFRS` LIMIT 1) as `KKAL_NOSAUKUMS`
                    from `KL_MMS_KALKULACIJA`
                    where '.$searchString.'
                    order by  '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
            if (($offset !== false) && $limit)
            {
                $query .= ' limit '.
                ($offset ? (int)$offset.', ' : '').
                (int)$limit;
            }
        }

        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
        //echo $query;
    }

    // -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai mms-kaklkulācijas doto  nosacījumu, šifru un trases pazīmi
	// eksistee. Ja dota mms-kalkulācija ID, shī kalkulācija netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function mmsCalculationWithChipherExists($requirement, $code, $is_epla,  $ID = false)
	{
		$query = 'select `KMKL_ID` from `KL_MMS_KALKULACIJA`
            where `KMKL_KMSD_NOSACIJUMA_KODS` = "'.dbLayer::quote_smart($requirement).'"
            AND `KMKL_KKAL_SHIFRS` = "'.dbLayer::quote_smart($code).'"
            AND `KMKL_TRASE` = '.dbLayer::quote_smart($is_epla).'';
		if ($ID)
		{
			$query .= ' and `KMKL_ID` != "'.dbLayer::quote_smart($ID).'"';
		}
        //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KMKL_ID']);
    }
    
    // -----------------------------------------------------------------------------
	// Saglabaa mms-kalkulācijas. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveMmsCalculation($ID, 
                                $requirement,
                                $chipher,
                                $isDefault10=1,
                                $isDefaultNot10=1,
                                $amount=1,
                                $useLine=0,
                                $koeficent=1,
                                $useCord=0,
                                $isActive=1,
                                $isEpla=0,
                                $user)
    {
        
            if ($ID)
            {
                $query = 'UPDATE `KL_MMS_KALKULACIJA`
                    SET `KMKL_KMSD_NOSACIJUMA_KODS` = "'.dbLayer::quote_smart($requirement).'",
                        `KMKL_KKAL_SHIFRS` = "'.dbLayer::quote_smart($chipher).'",
                        `KMKL_NOKL_SPRIEGUMS_10` = "'.dbLayer::quote_smart($isDefault10).'",
                        `KMKL_NOKL_SPRIEGUMS_NE_10` = "'.dbLayer::quote_smart($isDefaultNot10).'",
                        `KMKL_DAUDZUMS` = "'.dbLayer::quote_smart($amount).'",
                        `KMKL_IZMANTOT_LINIJU` = "'.dbLayer::quote_smart($useLine).'",
                        `KMKL_KOEFICENTS` = "'.dbLayer::quote_smart($koeficent).'",
                        `KMKL_IZMANTOT_VADU` = "'.dbLayer::quote_smart($useCord).'",
                        `KMKL_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                        `KMKL_TRASE` = "'.dbLayer::quote_smart($isEpla).'",                        
                        `KMKL_EDITOR` = "'.dbLayer::quote_smart($user).'",
                        `KMKL_EDITED` = now()
                    where `KMKL_ID` = "'.dbLayer::quote_smart($ID).'"';

            }
            elseif ($requirement)
            {
                $query = 'INSERT INTO `KL_MMS_KALKULACIJA` 
                (                       
                    `KMKL_KMSD_NOSACIJUMA_KODS`,
                    `KMKL_KKAL_SHIFRS`,
                    `KMKL_NOKL_SPRIEGUMS_10`,
                    `KMKL_NOKL_SPRIEGUMS_NE_10`,
                    `KMKL_DAUDZUMS`,
                    `KMKL_IZMANTOT_LINIJU`,
                    `KMKL_KOEFICENTS`,
                    `KMKL_IZMANTOT_VADU`,
                    `KMKL_IR_AKTIVS`,
                    `KMKL_TRASE`,
                    `KMKL_CREATOR`
                )
                VALUES
                (
                        "'.dbLayer::quote_smart($requirement).'",
                        "'.dbLayer::quote_smart($chipher).'",
                        "'.dbLayer::quote_smart($isDefault10).'",
                        "'.dbLayer::quote_smart($isDefaultNot10).'",
                        "'.dbLayer::quote_smart($amount).'",
                        "'.dbLayer::quote_smart($useLine).'",
                        "'.dbLayer::quote_smart($koeficent).'",
                        "'.dbLayer::quote_smart($useCord).'",
                        "'.dbLayer::quote_smart($isActive).'",
                        "'.dbLayer::quote_smart($isEpla).'",
                       
                        "'.dbLayer::quote_smart( $user).'"
                    )';
            }
            //echo $query;
            $oDB = new dbLayer;
            $result = $oDB -> makeQuery($query);

            return ($result !== false);
        }

