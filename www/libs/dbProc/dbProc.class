	function getEDAreaName($Id)
	{
		$query = 'select CONCAT(KEDI_REGIONS," : ", KEDI_KODS," : ", KEDI_NOSAUKUMS ) `NOSAUKUMS`
        from `KL_ED_IECIRKNI`
        where `KEDI_ID` = "'.dbLayer::quote_smart($Id).'"';

		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
		if (isset($result[0]['NOSAUKUMS']))
		{
			return $result[0]['NOSAUKUMS'];
		}
		return false;
	}



