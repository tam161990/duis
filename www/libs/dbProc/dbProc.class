    // -----------------------------------------------------------------------------
	// Atgriezh favorita ierakstus konkr�ta lietot�ja favor�ta,
    // kurie nav piesaist�ti akta materi�lam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeMatFavoritList($favoritId, $actId)
	{   //SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as
        $query = 'select `KMAT_ID`, `KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, `KMAT_DAUDZUMS`
            from `KL_MATERIALI`
            JOIN `FAVORITI` ON (FAVR_KATALOG_KODS = KMAT_KODS and FAVR_LTFV_ID = "'.dbLayer::quote_smart($favoritId).'")
            where `KMAT_KODS` not in
            (select `MATR_KODS` from `MATERIALI` where `MATR_RAKT_ID` = '.dbLayer::quote_smart($actId).')
            order by `KMAT_KODS` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh atrasto materi�la ierakslu
    // kura nav piesaist�ti akta materi�lam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeMatByCode($code = '', $actId, $title = '')
	{   //SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as
        // `KMAT_ID`, `KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, `KMAT_DAUDZUMS`
        $query = "select *
            from `KL_MATERIALI`
            where 1
            ".(($code != '') ? " AND `KMAT_KODS` = '".dbLayer::quote_smart($code)."' "  : "") ."
            ".(($title != '') ? " AND `KMAT_NOSAUKUMS` LIKE '%".dbLayer::quote_smart($title)."%' " : "" )."            and (`KMAT_KODS` not in
            (select `MATR_KODS` from `MATERIALI` where `MATR_RAKT_ID` = ".dbLayer::quote_smart($actId).")
             OR 1)";
        //echo $query;
	   	$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
        //print_r($result);
        return $result;
	}

    // -----------------------------------------------------------------------------
	// Saglabaa akta materi�la ierakstu.
    // V�rtibas tiek nemtas no kl_materiali tabula p�c materi�la koda
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveActMaterialRecord($actId, $ID, $amount = false, $price = false, $tame = false, 
                                    $st = 0, 
                                    $title = '', 
                                    $mervieniba = '',
                                    $work_type = false)
	{
        $table_name = ($tame) ? '`TAME_MATERIALI`' : '`MATERIALI`';
        $r_work_type = explode('^', $work_type);
        if($ID == false)
        { 
            $query = 'insert into '.$table_name.'
                (`MATR_RAKT_ID`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`,
                '.(($price !== false)? '`MATR_CENA`,': '').'       
                `MATR_DAUDZUMS`, 
                `MATR_IS_WORKER`'.(($tame)? ', `MATR_DAUDZUMS_KOR` ' : '' ).
                (($work_type!== false)? ', `MATR_WORK_TYPE_ID` ' : '' ).
                (($work_type!== false)? ', `MATR_WORK_TYPE_TEXT` ' : '' ).')
                values ('.dbLayer::quote_smart($actId).',
                    "'.dbLayer::quote_smart($title).'",
                    "'.dbLayer::quote_smart($mervieniba).'",
                    '.(($price !== false)? dbLayer::quote_smart($price).',': '').'  
                    '.dbLayer::quote_smart($amount).',
                    '.dbLayer::quote_smart($st).'
                    '.(($tame)? ','.dbLayer::quote_smart($amount) : '' ).
                    (($work_type !== false)? ','.dbLayer::quote_smart($r_work_type[0]) : '' ).
                    (($work_type !== false)? ',"'. (isset($r_work_type[1]) ? dbLayer::quote_smart(str_replace('\'', '"', $r_work_type[1])) : '').'"': '' ).
                    ' )' ;

        }
        elseif($amount === false && $price === false)
        { 
            $query = 'insert into '.$table_name.'
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, 
                `MATR_CENA`, `MATR_IS_WORKER`'
                .(($work_type!== false)? ', `MATR_WORK_TYPE_ID` ' : '' ).
                (($work_type!== false)? ', `MATR_WORK_TYPE_TEXT` ' : '' ).')
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, 
                `KMAT_CENA`,'.dbLayer::quote_smart($st).
                (($work_type !== false)? ','.dbLayer::quote_smart($r_work_type[0]) : '' ).
                (($work_type !== false)? ',"'.(isset($r_work_type[1]) ? dbLayer::quote_smart($r_work_type[1]).'"' : ""): '' ).
                 '   from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
        elseif($price === false || $st == 1)
        { 
           $query = 'insert into '.$table_name.'
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, `MATR_CENA`, 
                `MATR_DAUDZUMS`,
                 `MATR_IS_WORKER`'.(($tame)? ', `MATR_DAUDZUMS_KOR` ' : '' ).
                 (($work_type!== false)? ', `MATR_WORK_TYPE_ID` ' : '' ).
                 (($work_type!== false)? ', `MATR_WORK_TYPE_TEXT` ' : '' ).')
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, 
                '.dbLayer::quote_smart($amount).', 
                '.dbLayer::quote_smart($st).' 
                '.(($tame)? ','.dbLayer::quote_smart($amount) : '' ).
                (($work_type !== false)? ','.dbLayer::quote_smart($r_work_type[0]) : '' ).
                (($work_type !== false)? ',"'.(isset($r_work_type[1]) ? dbLayer::quote_smart($r_work_type[1]).'"' : ""): '' ).
                ' from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
        else
        { 
           $query = 'insert into '.$table_name.'
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, `MATR_CENA`, `MATR_DAUDZUMS`, 
                `MATR_IS_WORKER`'.(($tame)? ', `MATR_DAUDZUMS_KOR` ' : '' ).
                (($work_type!== false)? ', `MATR_WORK_TYPE_ID` ' : '' ).
                (($work_type!== false)? ', `MATR_WORK_TYPE_TEXT` ' : '' ).')
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, '.dbLayer::quote_smart($price).' , 
                '.dbLayer::quote_smart($amount).', 
                '.dbLayer::quote_smart($st).' 
                 '.(($tame)? ','.dbLayer::quote_smart($amount) : '' ).
                 (($work_type !== false)? ','.dbLayer::quote_smart($r_work_type[0]) : '' ).
                 (($work_type !== false)? ',"'.(isset($r_work_type[1]) ? dbLayer::quote_smart($r_work_type[1]).'"' : ""): '' ).
                ' from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
        //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
    }
    
    function getDefaultMaterial($actId) {
        $query = 'select CONCAT(MATR_WORK_TYPE_ID, \'^\', MATR_WORK_TYPE_TEXT) as MATR_WORK_TYPE
             from `MATERIALI` 
            where `MATR_RAKT_ID` = '.dbLayer::quote_smart($actId).'
            order by `MATR_ID` desc
            limit 1';
        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);
        return isset($result[0]['MATR_WORK_TYPE']) ? $result[0]['MATR_WORK_TYPE'] : '';
    }

    // -----------------------------------------------------------------------------
	// Saglabaa akta materiala ierakstu.
    // Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function writeActMaterial($actId, $code, $title, $unit, $price = false, $amount, 
                                $total = false, $st = 0, $amount_kor = false, $notes = false,
                                $work_type = false, $work_approve_date = false, $edited = false, 
                                $export_type = false, $import_no = false, $crossection = false,
                                $complectation = false)
	{
        $amount = (empty($amount)) ? false : $amount;
        $r_work_type = explode('^', $work_type);

        if($amount_kor !== false) {
            $query = 'insert into `TAME_MATERIALI`
                            (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`,
                            `MATR_CENA`, `MATR_DAUDZUMS`, `MATR_DAUDZUMS_KOR`, `MATR_CENA_KOPA`, 
                            `MATR_IS_WORKER`, `MATR_PIEZIMES`,  `MATR_APPROVE_DATE`,
                            `MATR_WORK_APROVE_DATE`, `MATR_WORK_TYPE_ID`,
                             `MATR_WORK_TYPE_TEXT`, `MATR_PROJECT_EXPORT` )                           
                            values ( '.dbLayer::quote_smart($actId).',
                            "'.dbLayer::quote_smart($code).'",
                            "'.dbLayer::quote_smart($title).'",
                            "'.dbLayer::quote_smart($unit).'",
                            "'.dbLayer::quote_smart($price).'",
                            "'.dbLayer::quote_smart($amount).'",
                            "'.dbLayer::quote_smart($amount_kor).'",
                            "'.dbLayer::quote_smart($total).'",
                            "'.dbLayer::quote_smart($st).'",
                            '.((!$notes ) ? '"NULL"' : '"'.dbLayer::quote_smart($notes).'"').',
                            '.((!$edited) ? '"NULL",' : '"'.dbLayer::parseDate($edited).'",').'
                            '.(($work_approve_date === false ) ? '"NULL"' : ( ($work_approve_date == DEFAULT_DATE ) ? '"NULL"' : '"'.dbLayer::parseDate($work_approve_date).'"')).',
                            '.(($work_type !== false) ? dbLayer::quote_smart($r_work_type[0]) : '"NULL"').',
                            '.(($work_type !== false) ? '"'.(isset($r_work_type[1]) ? dbLayer::quote_smart($r_work_type[1]) .'"': '') : '"NULL"').',
                            '.(($export_type !== false) ? '"'.dbLayer::quote_smart($export_type).'"' : '"NULL"').'                           
                            )';
        } else {
            $query = 'insert into `MATERIALI`
                    (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`,
                    `MATR_CENA`, `MATR_DAUDZUMS`,  `MATR_CENA_KOPA`, 
                    `MATR_IS_WORKER`, `MATR_PIEZIMES`,  `MATR_APPROVE_DATE`,
                    `MATR_WORK_APROVE_DATE`, `MATR_WORK_TYPE_ID`,
                    `MATR_WORK_TYPE_TEXT`, `MATR_PROJECT_EXPORT`,
                    `MATR_IMPORT_NO`, `MATR_CROSSECTION`, `MATR_COMPLECTATION` )          
                    values ( '.dbLayer::quote_smart($actId).',
                    "'.dbLayer::quote_smart($code).'",
                    "'.dbLayer::quote_smart($title).'",
                    "'.dbLayer::quote_smart($unit).'",
                    '.((!$price) ? '"NULL",' : '"'.dbLayer::quote_smart($price).'",').'
                    '.((!$amount) ? '"NULL",' : '"'.dbLayer::quote_smart($amount).'",').'
		            '.((!$total) ? '"NULL",' : '"'.dbLayer::quote_smart($total).'",').'
                    "'.dbLayer::quote_smart($st).'",
                    '.((!$notes ) ? '"NULL"' : '"'.dbLayer::quote_smart($notes).'"').',
                    '.((!$edited) ? '"NULL",' : '"'.dbLayer::parseDate($edited).'",').'
                    '.(($work_approve_date === false ) ? '"NULL"' : ( ($work_approve_date == DEFAULT_DATE ) ? '"NULL"' : '"'.dbLayer::parseDate($work_approve_date).'"')).',
                    '.(($work_type !== false) ? dbLayer::quote_smart($r_work_type[0]) : '"NULL"').',
                    '.(($work_type !== false) ? '"'.(isset($r_work_type[1]) ? dbLayer::quote_smart($r_work_type[1]) .'"': '') : '"NULL"').',
                    '.(($export_type !== false) ? '"'.dbLayer::quote_smart($export_type).'"' : '"NULL"').',
                    '.(($import_no !== false) ? '"'.dbLayer::quote_smart($import_no).'"' : '"NULL"').',
                    '.(($crossection !== false) ? '"'.dbLayer::quote_smart($crossection).'"' : '"NULL"').',
                    '.(($complectation !== false) ? '"'.dbLayer::quote_smart($complectation).'"' : '"NULL"').'
                    )';
        }
        //echo  $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

    

    return ($result !== false);
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh akta materialus. atgriezh visas p�c akta ID.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActsFreeMaterialList($acts)
	{
            $actString = "";
             if (is_array($acts) && count($acts) > 0)
        	{
        		foreach ($acts as $i => $act)
        		{
                     $actString .= "'". $i ."',";
                }
                $actString  = substr($actString, 0, -1);
            }
		    $query = "select MATR_KODS, MATR_NOSAUKUMS, MATR_MERVIENIBA, MATR_CENA,
                    SUM(MATR_DAUDZUMS) AS `MATR_DAUDZUMS`,
                    SUM(  MATR_CENA *   MATR_DAUDZUMS) AS `MATR_CENA_KOPA`
                from `MATERIALI`
                INNER JOIN `AKTI` ON (`RAKT_ID`  = `MATR_RAKT_ID`)
                WHERE `RAKT_ID` IN (".$actString.")
                AND `MATR_IS_WORKER` = 1
                AND `MATR_IS_WRITEDOFF` <> 1
                GROUP BY  MATR_KODS
                ORDER BY `MATR_KODS`";

                //ORDER BY `MATR_IS_WORKER` DESC

        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

