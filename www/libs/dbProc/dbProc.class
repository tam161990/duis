	// -----------------------------------------------------------------------------
	function getWorkTypeList($ID = false, $offset = false, $limit = false,
                    $search =  false,
                    $column = false,
                    $order =  'ASC',
                    $orderColumn = false)
    {
        if ($ID)
        {
            $query = 'select *
            from `kl_darba_veidi`
            where `KLDV_ID` = "'.dbLayer::quote_smart($ID).'"';
        }
        else
        {
            if($column === false)
            {
                $column = dbProc::getKlklDefaultColumn(KL_WORK_TYPS);
            }
            if($orderColumn === false)
            {
                $orderColumn = dbProc::getKlklDefaultColumn(KL_WORK_TYPS);
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            $query = 'select * from `kl_darba_veidi`
                where '.$searchString.'
                order by `'.dbLayer::quote_smart($orderColumn).'` '.dbLayer::quote_smart($order).'';
            if (($offset !== false) && $limit)
            {
                $query .= ' limit '.
                ($offset ? (int)$offset.', ' : '').
                (int)$limit;
            }
        }
//echo $query;
        $oSQL = new dbLayer;
        return $oSQL -> makeQuery($query);
    }

    
    // -----------------------------------------------------------------------------
