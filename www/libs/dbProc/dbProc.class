		$sql = 'select *, '.dbLayer::sqlParseDateTime('GFLS_DATUMS').'
         	from `GPS_FAILI`
			order by GFLS_REGION, GFLS_DATUMS desc';

		return $oSQL -> makeQuery($sql);
	}


