	// -----------------------------------------------------------------------------
	// Saglabaa ED iecirk�u. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveEDArea($ID, $region, $code, $title, $isActive, $section, $element, $isMain = true)
	{
	    $tableName  = (($isMain)? 'KL_ED_IECIRKNI' : 'KL_ED_IECIRKNI_TEMP');
		if ($ID)
		{
			$query = 'update `'.$tableName.'`
				set `KEDI_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KEDI_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `KEDI_SECTION` = "'.dbLayer::quote_smart($section).'" ,
                    `KEDI_IS_ELEMENT` = "'.dbLayer::quote_smart($element).'"
				where `KEDI_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into  `'.$tableName.'`
                (`KEDI_REGIONS`, `KEDI_KODS`, `KEDI_NOSAUKUMS`, `KEDI_IR_AKTIVS`, `KEDI_SECTION`, `KEDI_IS_ELEMENT`)
			values
                ("'.dbLayer::quote_smart($region).'",
                "'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($isActive).'",
                "'.dbLayer::quote_smart($section).'",
                "'.dbLayer::quote_smart($element).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}



	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai DV iecirk�is ar doto re�ionu un kodu
	// eksistee. Ja dots ED iecirk�a ID, shii organizaacija netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function edAreaWithRegionCodeExists($region, $code, $dvAId = false)
	{
		$query = 'select `KEDI_ID` from `KL_ED_IECIRKNI`
            where `KEDI_REGIONS` = "'.dbLayer::quote_smart($region).'"
		and `KEDI_IR_AKTIVS` = 1 
            and `KEDI_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($dvAId)
		{
			$query .= ' and `KEDI_ID` != "'.dbLayer::quote_smart($dvAId).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KEDI_ID']);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo ED iecirk�u skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getEDAreaCount($search = false, $column = false, $showOnlyActiv = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_ED_AREA);
        }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        if($showOnlyActiv !== false)
        {
           $searchString .= ' and `KEDI_IR_AKTIVS` =1 ';
        }
        $query =  'select count(`KEDI_ID`) as `EDA_COUNT` from `KL_ED_IECIRKNI`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['EDA_COUNT']) ? $result[0]['EDA_COUNT'] : false;
	}

     // -----------------------------------------------------------------------------
	// izveidot tmp ED sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function createEDAreaTempTable()
	{
		$oSQL=new dbLayer();
        $sql =   'DROP TABLE IF EXISTS `KL_ED_IECIRKNI_TEMP`';
        $oSQL->makeQuery($sql);
        $sql =   'CREATE TABLE `KL_ED_IECIRKNI_TEMP` (
        `KEDI_ID` int(11) NOT NULL auto_increment,
        `KEDI_REGIONS` char(3) collate utf8_latvian_ci NOT NULL,
        `KEDI_KODS` char(5) collate utf8_latvian_ci NOT NULL,
        `KEDI_NOSAUKUMS` varchar(30) collate utf8_latvian_ci NOT NULL,
        `KEDI_IR_AKTIVS` tinyint(1) default 1,
        `KEDI_SECTION` varchar(250) collate utf8_latvian_ci default NULL,
        `KEDI_IS_ELEMENT` TINYINT( 1 ) default 0,
         PRIMARY KEY ( `KEDI_ID` )
      )  TYPE = MYISAM CHARACTER SET utf8 COLLATE utf8_latvian_ci;';

		return $oSQL->makeQuery($sql);
	}

    // -----------------------------------------------------------------------------
	// nodzes ED sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function deleteEDAreaTable($isMain = true)
	{
		$oSQL=new dbLayer();
        $tableName  = (($isMain)? 'KL_ED_IECIRKNI' : 'KL_ED_IECIRKNI_TEMP');
		return $oSQL->makeQuery('DROP TABLE IF EXISTS `'.$tableName.'`');
	}

     // -----------------------------------------------------------------------------
	// parsaukt ED temp sql tabulu uz  KL_ED_IECIRKNI
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function renameEDAreaTable()
	{
		$oSQL=new dbLayer();
		return $oSQL->makeQuery('ALTER TABLE `KL_ED_IECIRKNI_TEMP` RENAME `KL_ED_IECIRKNI`');
	}


