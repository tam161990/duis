//                '.(($objectVoltage !='')?',`objectVoltage`="'.dbLayer::quote_smart($objectVoltage).'"':'').'
//                '.(($designation !=-1)?',`designation`="'.dbLayer::quote_smart($designation).'"':'').'
//                '.(($section !='')?',`section`="'.dbLayer::quote_smart($section).'"':'').'
//                ';

    	$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

