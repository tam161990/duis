    function getWorkTyps()
    {
    $query = 'select `KLDV_VEIDS`  from `kl_darba_veidi`
            where `KLDV_IR_AKTIVS` = 1
            GROUP BY  `KLDV_VEIDS` ';

    $oSQL = new dbLayer;
