        // -----------------------------------------------------------------------------
        // Atgriezh kopeejo procesus skaitu.
        // Author: Tatjana Fedorkova
        // -----------------------------------------------------------------------------
        function getJobCount($search = false, $column = false)
        {
            $oDB = new dbLayer;
            if($column === false)
            {
            $column = dbProc::getKlklDefaultColumn(KL_SYSTEM_PROCESS);
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            $query =  'select count(`PROC_KODS`) as `RECORDCOUNT` from `SISTEMAS_PROCESI`
            where '.$searchString;
            $result = $oDB -> makeQuery($query);

            return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
        }

        // -----------------------------------------------------------------------------
        // Atgriezh finans��anas avota(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
        // Ja doti, njem veeraa nobiidi un daudzumu.
        // Author: Tatjana Fedorkova
        // -----------------------------------------------------------------------------
        function getJobList($ID = false, $offset = false, $limit = false,
                                        $search =  false,
                                        $column = false,
                                        $order =  'ASC',
                                        $orderColumn = false)
        {
            if ($ID)
            {
                $query = 'select *, ' .dbLayer::sqlParseDateTime('PROC_START_DATUMS') .',
                  ' .dbLayer::sqlParseDateTime('PROC_STOP_DATUMS') .'
                    from `SISTEMAS_PROCESI`
                    where `PROC_KODS` = "'.$ID.'"';
            }
            else
            {
                if($column === false)
                {
                    $column = dbProc::getKlklDefaultColumn(KL_SYSTEM_PROCESS);
                }
                if($orderColumn === false)
                {
                    $orderColumn = dbProc::getKlklDefaultColumn(KL_SYSTEM_PROCESS);
                }
                $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
                if($search === false || $search == '')
                {
                    $searchString = '1 ';
                }
                $query = 'select *, ' .dbLayer::sqlParseDateTime('PROC_START_DATUMS') .',
                    ' .dbLayer::sqlParseDateTime('PROC_STOP_DATUMS') .'
                    from `SISTEMAS_PROCESI`
                    where '.$searchString.'
                    order by `'.dbLayer::quote_smart($orderColumn).'` '.dbLayer::quote_smart($order).'';
                if (($offset !== false) && $limit)
                {
                    $query .= ' limit '.
                    ($offset ? (int)$offset.', ' : '').
                    (int)$limit;
                }
            }

            $oSQL = new dbLayer;
            return $oSQL -> makeQuery($query);
        }

        function saveJob($code, $pid, $isActive, $interval = 60) {

            $query = 'UPDATE `SISTEMAS_PROCESI`
                      SET `PROC_IR_AKTIVS` = '.$isActive.',
                        ' .(($pid == false) ? ' `PROC_PID` = null ' :'`PROC_PID` = '.$pid ).' ,   
                        `PROC_INTERVAL` = '.$interval.',
                        '.(($isActive==1)? '`PROC_START_DATUMS` = now(), `PROC_STOP_DATUMS` = "NULL" ' : '`PROC_STOP_DATUMS` = now()').' 
                      WHERE `PROC_KODS` = "'.$code.'"';
            
            $oSQL = new dbLayer;
            $result = $oSQL -> makeQuery($query);

            return ($result !== false);

        }

        function getJobInterval($code)
        {
            $oDB = new dbLayer;
            $query =  'SELECT `PROC_INTERVAL`  FROM `SISTEMAS_PROCESI` WHERE `PROC_KODS` = "'.$code.'"';
            $result = $oDB -> makeQuery($query);

            return isset($result[0]['PROC_INTERVAL']) ? $result[0]['PROC_INTERVAL'] : 600;
        }

        function isJobStoped($code)
        {
            $oDB = new dbLayer;
            $query =  'SELECT `PROC_IR_AKTIVS`  FROM `SISTEMAS_PROCESI` WHERE `PROC_KODS` = "'.$code.'"';
            $result = $oDB -> makeQuery($query);

            return isset($result[0]['PROC_IR_AKTIVS']) ? (($result[0]['PROC_IR_AKTIVS'] == 0) ? true  : false ) : true;
        }

