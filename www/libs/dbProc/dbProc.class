	function getKlklName($cCatalogName)
	{
		$cQuery="SELECT KLKL_ID id, KLKL_COLUMN kolonna, KLKL_TITLE nosaukums, KLKL_IS_DEFAULT def
        FROM KL_REF_KOLONNAS
        WHERE KLKL_CATALOG='".$cCatalogName."' ORDER BY KLKL_ID ASC";

		$oSQL=new dbLayer();
