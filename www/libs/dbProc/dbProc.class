<?

class dbProc extends dbLayer
{
// =============================================================================
// RCD_LIETOTAJI
// =============================================================================

	// -----------------------------------------------------------------------------
	// Change user password
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function changeUserPassword($userId, $pass)
	{
		$oSQL=new dbLayer();
		$sql = 'update `LIETOTAJI`
				set `RLTT_PAROLE`=md5("'.dbLayer::quote_smart($pass).'")
				where `RLTT_ID` =  "'.dbLayer::quote_smart($userId).'"';
		$res=$oSQL->makeQuery($sql);
		if ($res!==false)
		{
			return true;
		}
		else
		{
			return false;
		}
	}

    // -----------------------------------------------------------------------------
	// Check is user password correct
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function isUserPassword($login, $password)
	{
		$oSQL=new dbLayer();
        $sql = 'select * from `LIETOTAJI`
					where '.
					' `RLTT_ID` = "'.dbLayer::quote_smart($login).'"'.
					' and `RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")';

		$res=$oSQL->makeQuery($sql);

		if (is_array($res) && count($res)==1)
		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
    // -----------------------------------------------------------------------------
	// Set user last login date
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function setUserActionDate($userId, $action)
	{
		$oSQL=new dbLayer();
		$sql = 'update `LIETOTAJI`
				set `RLTT_DATUMS`=now(), `RLTT_DARBIBA` = "'.dbLayer::quote_smart($action).'"
				where `RLTT_ID` =  "'.dbLayer::quote_smart($userId).'"';
		$res=$oSQL->makeQuery($sql);
		if ($res!==false)
		{
			return true;
		}
		else
		{
			return false;
		}
	}
	// -----------------------------------------------------------------------------
	// Get list of users
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

	function getUsersList($ID = false, $isRltt = true, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
	    $oSQL=new dbLayer();
      	if ($ID)
		{
			$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `ROLE`, w.KWOI_NOSAUKUMS as `WORK`
    				from`LIETOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID  = k.KEDI_ID)
                  LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
                  LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'" )
                  where `RLTT_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
          if($column === false)
          {
             $column = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
          }
          if($orderColumn === false)
          {
             $orderColumn = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
          }
          if($column == 'ROLE')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }
          if($column == 'WORK')
          {
               $column = 'w.KWOI_NOSAUKUMS';
          }
          if($orderColumn == 'ROLE')
          {
             $orderColumn = 'l.KRFK_NOZIME';
          }
          if($orderColumn == 'AREA')
          {
               $orderColumn = 'k.KEDI_NOSAUKUMS';
          }
          if($orderColumn  == 'WORK')
          {
               $orderColumn  = 'w.KWOI_NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
    		$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `ROLE` , w.KWOI_NOSAUKUMS as `WORK`
    				from`LIETOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID = k.KEDI_ID)
                  LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
                  LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'"  )
                    where '. $searchString .
                    (($isRltt) ? ' AND (`RLTT_KWOI_KODS` IS NULL OR  `RLTT_KWOI_KODS` = "") ' : ' AND (`RLTT_KWOI_KODS` IS NOT NULL AND  `RLTT_KWOI_KODS` <> "")' ).
                    ' order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order);
            if (($offset !== false) && $limit)
			{
				$sql .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
    		//		'.($amount>0 ? 'limit '.($start==0?'':dbLayer::quote_smart($start).', ').dbLayer::quote_smart($amount):'') ;
        }

		$res=$oSQL->makeQuery($sql);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Get list of users aktions
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

	function getUsersActionsList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
	    $oSQL=new dbLayer();

          if($column === false)
          {
             $column = 'RLTT_UZVARDS';
          }
          if($orderColumn === false)
          {
             $orderColumn = $column = 'RLTT_UZVARDS';
          }
          if($column == 'NOSAUKUMS')
          {
             $column = 'd.NOSAUKUMS';
          }

          if($orderColumn == 'NOSAUKUMS')
          {
             $orderColumn = 'd.NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
    		$sql = 'select *, d.NOSAUKUMS as `NOSAUKUMS`
    				from`LIETOTAJI` l
                  LEFT JOIN `LIETOTAJA_DARBIBAS` d ON (d.KODS = l.RLTT_DARBIBA)
                    where '. $searchString .'
                    order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order);
            if (($offset !== false) && $limit)
			{
				$sql .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}

		$res=$oSQL->makeQuery($sql);
		return $res;
	}

	// -----------------------------------------------------------------------------
	// Get total user count in the users table
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function getUsersCount($search = false, $column = false, $isRltt = true)
	{
		$oSQL=new dbLayer();
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(($isRltt) ? KL_USERS : KL_USERS_DU);
        }

          if($column == 'ROLE')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }
	    if($column == 'WORK')
          {
               $column = 'w.KWOI_NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
		$sql = 'select count(`RLTT_ID`) as `amount` from`LIETOTAJI`
        LEFT JOIN `KL_ED_IECIRKNI` k ON (RLTT_KEDI_ID  = k.KEDI_ID)
        LEFT JOIN `KL_WORK_OWNERS` w ON (RLTT_KWOI_KODS  = w.KWOI_KODS)
        LEFT JOIN `KL_REF_KODI` l ON (RLTT_ROLE = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_ROLE.'"  )
        where '. $searchString . (($isRltt) ? ' AND (`RLTT_KWOI_KODS` IS NULL OR  `RLTT_KWOI_KODS` = "") ' : ' AND (`RLTT_KWOI_KODS` IS NOT NULL AND `RLTT_KWOI_KODS` <> "")' );
		$res=$oSQL->makeQuery($sql);

		if($res)
		{
			return $res[0]['amount'];
		}
		else
		{
			return false;
		}
	}

	// -----------------------------------------------------------------------------
	// Check is user with defined login name already exist
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isHasUserWithThisLogin($login, $userId=false)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`RLTT_ID`) as `amount` from `LIETOTAJI`
			where `RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'" ';
		if($userId)
		{
			$sql .= 'and `RLTT_ID`<>"'.dbLayer::quote_smart($userId).'" ';
		}
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']))
		{
			return true;
		}
		return false;
	}
	// -----------------------------------------------------------------------------
	// Check is aktiv user with defined login name already exist
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isHasActiveUserWithThisLogin($login)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`RLTT_ID`) as `amount` from `LIETOTAJI`
			where `RLTT_IR_AKTIVS`=1 AND `RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'" ';	
		
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']))
		{
			return true;
		}
		return false;
	}

	// -----------------------------------------------------------------------------
	// saglaba lietotaja datus
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveUser($userId,$login,$name,$surname,$isAdmin,$dvArea,$password=false, $isActive,$region,$role, $worker = '', $section = '', $trase = 0, $contract = 0)
	{
		$oSQL=new dbLayer();
		if ($userId==false)
		{
			$sql = 'insert into `LIETOTAJI`
						(`RLTT_USER_NAME`, `RLTT_PAROLE`,`RLTT_VARDS`,`RLTT_UZVARDS`,`RLTT_IR_ADMINS`,`RLTT_KEDI_ID`,`RLTT_IR_AKTIVS`, `RLTT_REGIONS`, `RLTT_ROLE`, `RLTT_KWOI_KODS`, `RLTT_KEDI_SECTION`, `RLTT_IR_TRASE`, `RLTT_IR_LIGUMS`) values
						("'.dbLayer::quote_smart($login).'",
						 md5("'.dbLayer::quote_smart($password).'"),
						 "'.dbLayer::quote_smart($name).'",
						 "'.dbLayer::quote_smart($surname).'",
						 "'.dbLayer::quote_smart($isAdmin).'",
						 "'.dbLayer::quote_smart($dvArea).'",
						 "'.dbLayer::quote_smart($isActive).'",
						 "'.dbLayer::quote_smart($region).'",
                         "'.dbLayer::quote_smart($role).'",
                         "'.dbLayer::quote_smart($worker).'",
                         "'.dbLayer::quote_smart($section).'",
                         "'.dbLayer::quote_smart($trase).'",
                         "'.dbLayer::quote_smart($contract).'")';

		}
		else
		{
			$sql = 'update `LIETOTAJI` set
						`RLTT_USER_NAME`="'.dbLayer::quote_smart($login).'",
						`RLTT_VARDS`="'.dbLayer::quote_smart($name).'",
						'.(($password !==false)?'`RLTT_PAROLE`=md5("'.dbLayer::quote_smart($password).'"),':'').'
						`RLTT_UZVARDS`="'.dbLayer::quote_smart($surname).'",
						`RLTT_IR_ADMINS`="'.dbLayer::quote_smart($isAdmin).'",
						`RLTT_KEDI_ID`="'.dbLayer::quote_smart($dvArea).'",
						`RLTT_IR_AKTIVS`="'.dbLayer::quote_smart($isActive).'",
						`RLTT_REGIONS`="'.dbLayer::quote_smart($region).'",
                        `RLTT_ROLE`="'.dbLayer::quote_smart($role).'",
                        `RLTT_KWOI_KODS`="'.dbLayer::quote_smart($worker).'",
                        `RLTT_KEDI_SECTION` = "'.dbLayer::quote_smart($section).'",
                        `RLTT_IR_TRASE` = "'.dbLayer::quote_smart($trase).'",
                        `RLTT_IR_LIGUMS` = "'.dbLayer::quote_smart($contract).'"
						where RLTT_ID="'.dbLayer::quote_smart($userId).'"';

		}

		$res=$oSQL->makeQuery($sql);

		if ($res!==false)
		{
			return true;
		}

		return false;
	}



	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserInfo($id='', $login='', $password='')
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *, '.dbLayer::sqlParseDateTime('RLTT_DATUMS').'
                    from `LIETOTAJI` l
                    LEFT JOIN `LIETOTAJA_DARBIBAS` d ON (d.KODS = l.RLTT_DARBIBA)
					where 1	'.
					(empty($id)?'':' and l.`RLTT_ID` = "'.dbLayer::quote_smart($id).'"').
					(empty($login)?'':' and l.`RLTT_USER_NAME` = "'.dbLayer::quote_smart($login).'"').
					(empty($password)?'':' and l.`RLTT_PAROLE` = md5("'.dbLayer::quote_smart($password).'")').
					' '
				);
		return $res;
	}

	// -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem
	// Ja eksiste - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActiveUserList()
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
					where  `RLTT_IR_AKTIVS`=1
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserRegionList($region, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($region != -1)? '`RLTT_REGIONS` = "'.dbLayer::quote_smart($region).'"
                    or `RLTT_KEDI_ID` IN (select `KEDI_ID` from `KL_ED_IECIRKNI` where `KEDI_REGIONS` = "'.$region.'")' : 1).'
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserSectionList($section, $isActive = true)
	{
		$oSQL=new dbLayer();
		$res=$oSQL->makeQuery('select *  from `LIETOTAJI`
                    where  '.
                    (($isActive) ? '`RLTT_IR_AKTIVS`=1 and ' : '').
                    (($section != -1)? '`RLTT_KEDI_SECTION` = "'.dbLayer::quote_smart($section).'"
                    or `RLTT_KEDI_ID` IN (select `KEDI_ID` from `KL_ED_IECIRKNI` where `KEDI_SECTION` = "'.$section.'")' : 1).'
					order by RLTT_VARDS, RLTT_UZVARDS'
				);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh informaciju par lietotaju/lietotajiem   konkreta regiona ietvaros
	// Author: Tatjana Fedorkova
