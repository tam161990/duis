    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cijas ierakstus konkr�ta kalkul�cija grupp�,
    // kurie nav piesaist�ti akta darbam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeCalculationList($calcGroup, $actId, $trase = 0, $searchText = '')
	{
    	  $query = 'select e.KEDI_SECTION as `SEC`, av.KAKV_IR_PLANS as `PLAN`, a.RAKT_KAKV_ID  as `TYPE` ,
          RAKT_KWOI_KODS as `WORKER`, RAKT_VV_NUMBER as `CONTRACT`
          FROM `AKTI` a
          LEFT JOIN `KL_AKTA_VEIDS` av ON (a.RAKT_KAKV_ID = av.KAKV_ID)
          LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
          WHERE a.RAKT_ID = ' . $actId;


        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        $section = $result[0]['SEC'];
        $plan = $result[0]['PLAN'];
        $stihija = (($result[0]['TYPE'] == ACT_TYPE_STIHIJA_ID || $result[0]['TYPE'] == ACT_TYPE_STIHIJA_TR_ID  ) ? true : false);
        $defect = (($result[0]['TYPE'] == ACT_TYPE_DEFECT_ID || $result[0]['TYPE'] == ACT_TYPE_DEFECT_TR_ID  ) ? true : false);

        $worker = $result[0]['WORKER'];
        $contract = $result[0]['CONTRACT'];
        if($plan == 1)
        {

            $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
            where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
            and `KKAL_KWOI_KODS` =  "'.$worker.'"
            and `KKAL_VV_NUMBER` =  "'.$contract.'"
            and `KKAL_KEDI_SECTION` =  "'.$section.'"
            and  `KKAL_PLAN_PRICE` IS NOT NULL
            and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
            order by `KKAL_SHIFRS` asc';

        }
        else
        {
          if($stihija)
          {
            if($trase==1)
            {
                 $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NOT_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_SECTION` =  "'.$section.'"
              and  `KKAL_NOT_PLAN_PRICE` IS NOT NULL
              and `KKAL_IR_AKTIVS` = 1
              AND  KKAL_IS_ELEMENT = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }
            else
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`,

                 IFNULL(
                 (SELECT MAX(kk.KKAL_NOT_PLAN_PRICE) FROM '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').' kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 and kk.KKAL_KEDI_SECTION =  "'.$section.'"
                  AND  kk.KKAL_IS_ELEMENT = 1
                 ),
                 (SELECT MAX(kk.KKAL_NOT_PLAN_PRICE) FROM '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').' kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 AND  kk.KKAL_IS_ELEMENT = 1
                 ) )  as `KKAL_NORMATIVS`

            from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'  k
            where k.KKAL_GRUPAS_KODS = "'.dbLayer::quote_smart($calcGroup).'"
            and k.KKAL_KWOI_KODS = "'.$worker.'"
            and k.KKAL_VV_NUMBER =  "'.$contract.'"
            and k.KKAL_NOT_PLAN_PRICE IS NOT NULL
            and k.KKAL_IR_AKTIVS = 1
             AND  k.KKAL_IS_ELEMENT = 1  ' . (($searchText == '')? '' : ' AND k.KKAL_NOSAUKUMS LIKE "%'.$searchText.'%"') .' 
            GROUP BY `KKAL_SHIFRS`            
            order by `KKAL_SHIFRS` asc';           // and k.KKAL_KEDI_SECTION =  "'.$section.'"
           }
          }
          else
          {
            if($defect)
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_PLAN_PRICE` as `KKAL_NORMATIVS` from'.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_SECTION` =  "'.$section.'"
              and  `KKAL_PLAN_PRICE` IS NOT NULL
              and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }
            else     // defects
            {
                  $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NOT_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_SECTION` =  "'.$section.'"
              and  `KKAL_NOT_PLAN_PRICE` IS NOT NULL
              and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }

          }

        }
        // echo $query;

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cijas ierakstus konkr�ta kalkul�cija grupp�,
    // kurie nav piesaist�ti akta darbam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getAllCalculationList( $actId, $trase = 0, $searchText = '')
	{
    	  $query = 'select e.KEDI_SECTION as `SEC`, av.KAKV_IR_PLANS as `PLAN`, a.RAKT_KAKV_ID  as `TYPE` ,
          RAKT_KWOI_KODS as `WORKER`, RAKT_VV_NUMBER as `CONTRACT`
          FROM `AKTI` a
          LEFT JOIN `KL_AKTA_VEIDS` av ON (a.RAKT_KAKV_ID = av.KAKV_ID)
          LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
          WHERE a.RAKT_ID = ' . $actId;


        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        $section = $result[0]['SEC'];
        $plan = $result[0]['PLAN'];
        $stihija = (($result[0]['TYPE'] == ACT_TYPE_STIHIJA_ID || $result[0]['TYPE'] == ACT_TYPE_STIHIJA_TR_ID  ) ? true : false);
        $defect = (($result[0]['TYPE'] == ACT_TYPE_DEFECT_ID || $result[0]['TYPE'] == ACT_TYPE_DEFECT_TR_ID  ) ? true : false);
        $worker = $result[0]['WORKER'];
        $contract = $result[0]['CONTRACT'];


        if($plan == 1)
        {

            $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
            where `KKAL_KWOI_KODS` = "'.$worker.'"
            and `KKAL_VV_NUMBER` =  "'.$contract.'"
            and `KKAL_KEDI_SECTION` =  "'.$section.'"
            and  `KKAL_PLAN_PRICE` IS NOT NULL 
            and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                        order by `KKAL_SHIFRS` asc';

        }
        else
        {
          if($stihija)
          {
            if($trase == 1)
            {
              $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NOT_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_SECTION` =  "'.$section.'"
                and  `KKAL_NOT_PLAN_PRICE` IS NOT NULL
                and `KKAL_IR_AKTIVS` = 1
                AND  KKAL_IS_ELEMENT = 1   ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }
            else
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`,
                 IFNULL(
                 (SELECT MAX(kk.KKAL_NOT_PLAN_PRICE) FROM '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').' kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 and `KKAL_KEDI_SECTION` =  "'.$section.'"
                  AND  kk.KKAL_IS_ELEMENT = 1
                 ),
                 (SELECT MAX(kk.KKAL_NOT_PLAN_PRICE) FROM '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').' kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                  AND  kk.KKAL_IS_ELEMENT = 1 
                 ) )  as `KKAL_NORMATIVS`

                 from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'  k
            where k.KKAL_KWOI_KODS = "'.$worker.'"
            and k.KKAL_VV_NUMBER =  "'.$contract.'"
            and  k.KKAL_NOT_PLAN_PRICE IS NOT NULL
            and k.KKAL_IR_AKTIVS = 1
            AND  k.KKAL_IS_ELEMENT = 1 ' . (($searchText == '')? '' : ' AND k.KKAL_NOSAUKUMS LIKE "%'.$searchText.'%"') .' 
            GROUP BY `KKAL_SHIFRS`
            order by `KKAL_SHIFRS` asc';    // and k.KKAL_KEDI_SECTION =  "'.$section.'"
           }
          }
          else
          {
            if($defect)
            {
                       $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`,      `KKAL_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_SECTION` =  "'.$section.'"
                and  `KKAL_PLAN_PRICE` IS NOT NULL
                and `KKAL_IR_AKTIVS` = 1 ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }
            else    // bojajums
            {
                     $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NOT_PLAN_PRICE` as `KKAL_NORMATIVS` from '.(($trase==1)?'`KL_KALKULACIJA_TRASE`':'`KL_KALKULACIJA`').'
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_SECTION` =  "'.$section.'"
                and  `KKAL_NOT_PLAN_PRICE` IS NOT NULL
                and `KKAL_IR_AKTIVS` = 1 ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }

          }

        }



	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

