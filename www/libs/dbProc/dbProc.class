    // -----------------------------------------------------------------------------
	// Atgriezh favorita ierakstus konkr�ta lietot�ja favor�ta,
    // kurie nav piesaist�ti akta materi�lam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeMatFavoritList($favoritId, $actId)
	{   //SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as
        $query = 'select `KMAT_ID`, `KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, `KMAT_DAUDZUMS`
            from `KL_MATERIALI`
            JOIN `FAVORITI` ON (FAVR_KATALOG_KODS = KMAT_KODS and FAVR_LTFV_ID = "'.dbLayer::quote_smart($favoritId).'")
            where `KMAT_KODS` not in
            (select `MATR_KODS` from `MATERIALI` where `MATR_RAKT_ID` = '.dbLayer::quote_smart($actId).')
            order by `KMAT_KODS` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh atrasto materi�la ierakslu
    // kura nav piesaist�ti akta materi�lam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeMatByCode($code = '', $actId, $title = '')
	{   //SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as
        // `KMAT_ID`, `KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, `KMAT_DAUDZUMS`
        $query = "select *
            from `KL_MATERIALI`
            where 1
            ".(($code != '') ? " AND `KMAT_KODS` = '".dbLayer::quote_smart($code)."' "  : "") ."
            ".(($title != '') ? " AND `KMAT_NOSAUKUMS` LIKE '%".dbLayer::quote_smart($title)."%' " : "" )."            and (`KMAT_KODS` not in
            (select `MATR_KODS` from `MATERIALI` where `MATR_RAKT_ID` = ".dbLayer::quote_smart($actId).")
             OR 1)";
        //echo $query;
	   	$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
        //print_r($result);
        return $result;
	}

    // -----------------------------------------------------------------------------
	// Saglabaa akta materi�la ierakstu.
    // V�rtibas tiek nemtas no kl_materiali tabula p�c materi�la koda
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveActMaterialRecord($actId, $ID, $amount = false, $price = false, $st = 0, $title = '', $mervieniba = '')
	{
        if($ID === false)
        {
            $query = 'insert into `MATERIALI`
                (`MATR_RAKT_ID`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`,`MATR_CENA`, `MATR_DAUDZUMS`, `MATR_IS_WORKER`)
            values ('.dbLayer::quote_smart($actId).',
                    "'.dbLayer::quote_smart($title).'",
                    "'.dbLayer::quote_smart($mervieniba).'",
                    '.dbLayer::quote_smart($price).' ,
                    '.dbLayer::quote_smart($amount).',
                    '.dbLayer::quote_smart($st).'
                    )' ;

        }
        elseif($amount === false && $price === false)
        {
            $query = 'insert into `MATERIALI`
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, `MATR_CENA`, `MATR_IS_WORKER`)
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`,'.dbLayer::quote_smart($st).'
                    from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
        elseif($price === false || $st == 1)
        {
           $query = 'insert into `MATERIALI`
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, `MATR_CENA`, `MATR_DAUDZUMS`, `MATR_IS_WORKER`)
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, `KMAT_CENA`, '.dbLayer::quote_smart($amount).', '.dbLayer::quote_smart($st).'
                    from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
        else
        {
           $query = 'insert into `MATERIALI`
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`, `MATR_CENA`, `MATR_DAUDZUMS`, `MATR_IS_WORKER`)
			select '.dbLayer::quote_smart($actId).',
                `KMAT_KODS`,`KMAT_NOSAUKUMS`, `KMAT_MERVIENIBA`, '.dbLayer::quote_smart($price).' , '.dbLayer::quote_smart($amount).', '.dbLayer::quote_smart($st).'
                    from `KL_MATERIALI`
                    where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'" ';
        }
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa akta materiala ierakstu.
    // Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function writeActMaterial($actId, $code, $title, $unit, $price, $amount, $total, $st = 0)
	{
	   	$query = 'insert into `MATERIALI`
                (`MATR_RAKT_ID`, `MATR_KODS`, `MATR_NOSAUKUMS`, `MATR_MERVIENIBA`,
                `MATR_CENA`, `MATR_DAUDZUMS`, `MATR_CENA_KOPA`, `MATR_IS_WORKER`)
                values ( '.dbLayer::quote_smart($actId).',
                "'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($unit).'",
                "'.dbLayer::quote_smart($price).'",
                "'.dbLayer::quote_smart($amount).'",
                "'.dbLayer::quote_smart($total).'",
                "'.dbLayer::quote_smart($st).'"
                )';

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh akta materialus. atgriezh visas p�c akta ID.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActsFreeMaterialList($acts)
	{
            $actString = "";
             if (is_array($acts) && count($acts) > 0)
        	{
        		foreach ($acts as $i => $act)
        		{
                     $actString .= "'". $i ."',";
                }
                $actString  = substr($actString, 0, -1);
            }
		    $query = "select MATR_KODS, MATR_NOSAUKUMS, MATR_MERVIENIBA, MATR_CENA,
                    SUM(MATR_DAUDZUMS) AS `MATR_DAUDZUMS`,
                    SUM(  MATR_CENA *   MATR_DAUDZUMS) AS `MATR_CENA_KOPA`
                from `MATERIALI`
                INNER JOIN `AKTI` ON (`RAKT_ID`  = `MATR_RAKT_ID`)
                WHERE `RAKT_ID` IN (".$actString.")
                AND `MATR_IS_WORKER` = 1
                AND `MATR_IS_WRITEDOFF` <> 1
                GROUP BY  MATR_KODS
                ORDER BY `MATR_KODS`";

                //ORDER BY `MATR_IS_WORKER` DESC

        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

