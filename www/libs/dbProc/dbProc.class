    function isComplectationForCategory($code) {
        $query = "SELECT COUNT(*) as cnt 
                FROM `kl_materialu_grupas`
                INNER JOIN `kl_komplektacijas` ON `KMTG_KATEGORIJAS_KODS` = `KMTK_KATEGORIJAS_KODS`
                WHERE `KMTG_KATEGORIJAS_KODS` = '".dbLayer::quote_smart($code)."'";
        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        return (($result[0]['cnt'] == 0 ) ? false : true);
    }

