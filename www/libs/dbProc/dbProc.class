     // -----------------------------------------------------------------------------
	// saglaba saskanotaja temp datus
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveHarmonized2($name,$surname, $dvArea, $position, $edArea)
	{


       $isActive = 1;
       $ed_id = '';
       $region = 'AA';
       $section = 'qqq';
       $pos = ' ';

       if(strlen($dvArea) == 5)
       {
         $sql1 = 'select `KEDI_ID` as `KODS`, `KEDI_REGIONS`,`KEDI_SECTION` as `SECTION`
                  from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` = "'.dbLayer::quote_smart($dvArea).'"';

       }
       else if(strlen($dvArea) == 4)
       {
         $sql1 = 'select DISTINCT "" as `KODS`, `KEDI_REGIONS`,`KEDI_SECTION` as `SECTION`
                  from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` LIKE "'.dbLayer::quote_smart($dvArea).'%"';

       }
       else
       {
             $sql1 = 'select DISTINCT "" as `KODS`, `KEDI_REGIONS`,"'.text::get('OPERATING_PART').'" as `SECTION`
                  from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` LIKE "'.dbLayer::quote_smart($dvArea).'%"';
       }

        $oSQL=new dbLayer();
        $result = $oSQL -> makeQuery($sql1);
		if (isset($result[0]))
		{
			$ed_id = $result[0]['KODS'];
            $region = $result[0]['KEDI_REGIONS'];
            $section = $result[0]['SECTION'];
		}

        // position

        $sql2 = 'select `KRFK_VERTIBA` from `KL_REF_KODI` WHERE `KRFK_NOSAUKUMS` = "POSITION" AND
                `KRFK_NOZIME` LIKE "'.dbLayer::quote_smart(trim($position)).'"';

       $oSQL=new dbLayer();
        $result = $oSQL -> makeQuery($sql2);
		if (isset($result[0]))
		{
			$pos = $result[0]['KRFK_VERTIBA'];

		}

       $sql = 'insert into `KL_SASKANOTAJI_TEMP`
						(`SLTT_VARDS`,`SLTT_UZVARDS`,`SLTT_KEDI_ID`,`SLTT_IR_AKTIVS`, `SLTT_REGIONS`, `SLTT_POSITION`,`SLTT_ED_IECIKNIS`, `SLTT_KEDI_SECTION`) values
						( "'.dbLayer::quote_smart($name).'",
						 "'.dbLayer::quote_smart($surname).'",
						 "'.dbLayer::quote_smart($ed_id).'",
						 "'.dbLayer::quote_smart($isActive).'",
						 "'.dbLayer::quote_smart($region).'",
                         "'.dbLayer::quote_smart($pos).'",
                         "'.dbLayer::quote_smart($edArea).'",
                         "'.dbLayer::quote_smart($section).'")'  ;

        $oSQL=new dbLayer();
		$res=$oSQL->makeQuery($sql);
        if ($res!==false)
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// nodzes saska�ot�ji sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function deleteHarmonizedTable($isMain = true)
	{
		$oSQL=new dbLayer();
        $tableName  = (($isMain)? 'KL_SASKANOTAJI' : 'KL_SASKANOTAJI_TEMP');
		return $oSQL->makeQuery('DROP TABLE IF EXISTS `'.$tableName.'`');
	}

    // -----------------------------------------------------------------------------
	// izveidot tmp saska�ot�ji sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function createHarmonizedTempTable()
	{
		$oSQL=new dbLayer();
        $sql =   'DROP TABLE IF EXISTS `KL_SASKANOTAJI_TEMP`';
        $oSQL->makeQuery($sql);
        $sql =   'CREATE TABLE IF NOT EXISTS `KL_SASKANOTAJI_TEMP` (
        `SLTT_ID` int(11) NOT NULL auto_increment,
        `SLTT_VARDS` varchar(30) collate utf8_latvian_ci NOT NULL default \'\',
        `SLTT_UZVARDS` varchar(30) collate utf8_latvian_ci NOT NULL default \'\',
        `SLTT_IR_AKTIVS` tinyint(1) NOT NULL default 1,
        `SLTT_KEDI_ID` int(11) default NULL,
        `SLTT_POSITION` varchar(100) collate utf8_latvian_ci NOT NULL,
        `SLTT_REGIONS` char(3) collate utf8_latvian_ci NOT NULL,
        `SLTT_KEDI_SECTION` varchar(250) collate utf8_latvian_ci NOT NULL,
        `SLTT_ED_IECIKNIS` varchar(250) collate utf8_latvian_ci NOT NULL default \'\',
        PRIMARY KEY  (`SLTT_ID`)
      ) ENGINE=MyISAM  DEFAULT CHARSET=utf8 COLLATE=utf8_latvian_ci AUTO_INCREMENT=1 ;';

		return $oSQL->makeQuery($sql);
	}

    // -----------------------------------------------------------------------------
	// parsaukt saska�ot�ji temp sql tabulu uz  KL_SASKANOTAJI
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function renameHarmonizedTable()
	{
		$oSQL=new dbLayer();
		return $oSQL->makeQuery('ALTER TABLE `KL_SASKANOTAJI_TEMP` RENAME `KL_SASKANOTAJI`');
	}


