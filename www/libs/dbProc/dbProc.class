	// -----------------------------------------------------------------------------
	// Atgriezh MMS darbaa(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false,
                            $showOnlyActiv = false)
	{
		if ($ID)
		{
			$query = 'select *, w.KWOI_NOSAUKUMS as `WORKER`
				from `KL_MMS_DARBI`
                LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KMSD_KWOI_KODS)
				where `KMSD_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
            }
            if($column == 'WORKER')
            {
                $column = 'w.KWOI_NOSAUKUMS';
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
            }
            if($orderColumn == 'WORKER')
            {
                $orderColumn = 'w.KWOI_NOSAUKUMS';
            }
            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            if($showOnlyActiv !== false)
            {
                $searchString .= ' and `KMSD_IR_PABEIGTS` =0 ';
            }
			$query = 'select *, w.KWOI_NOSAUKUMS as `WORKER`  from `KL_MMS_DARBI`
            LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KMSD_KWOI_KODS)
            where '.$searchString.'
            order by `'.dbLayer::quote_smart($orderColumn).'` '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh pabeigtus vai nepabeigtus MMS darbus.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkActivList($activ = true)
	{
            $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
			$query = 'select * from `KL_MMS_DARBI`
            where `KMSD_IR_PABEIGTS` = '.(($activ) ? 0 : 1).'
            order by `'.$column.'` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh pabeigtus vai nepabeigtus MMS darbus konkr�taja strukt�rvien�ba.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function getMMSWorkListByEd($edId, $trase = 0, $contract = false, $activ = true)
	{ 
            $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
			$query = 'select * from `KL_MMS_DARBI` d
            INNER JOIN `KL_ED_IECIRKNI` ed ON (d.KMSD_KEDI_KODS = ed.KEDI_KODS
                and ed.KEDI_ID = '.dbLayer::quote_smart($edId).')
            where d.KMSD_TRASE = '.$trase.
            (($contract == false)?'' : ' AND `KMSD_VV_NUMBER`="'.dbLayer::quote_smart($contract).'"'). '
            order by `'.$column.'` asc';

	   	$oSQL = new dbLayer;
//echo $query;
		return $oSQL -> makeQuery($query);


	}

    // -----------------------------------------------------------------------------
	// Atgriezh pabeigtus vai nepabeigtus MMS darbus konkr�taja strukt�rvien�ba.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function getMMSWorkListByWorker($worker, $trase = 0, $contract = false, $activ = true)
	{
            $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
			$query = 'select * from `KL_MMS_DARBI` d
            where d.KMSD_KWOI_KODS = "'.dbLayer::quote_smart($worker).'"
            and `KMSD_IR_PABEIGTS` = '.(($activ) ? 0 : 1).'
            and `KMSD_TRASE` = '.$trase.
            (($contract == false)?'' : ' AND `KMSD_VV_NUMBER`="'.dbLayer::quote_smart($contract).'"'). '
            order by `'.$column.'` asc';
         //echo $query;
	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}


