            where  e.KEDI_IR_AKTIVS = 1
            and k.KMSD_TRASE = '.$trase.
            (($contract == false) ? '' : ' AND `KMSD_VV_NUMBER` = "'.dbLayer::quote_smart($contract).'" ')
            .'and  k.KMSD_ID = "'.dbLayer::quote_smart($mms).'" ';
//        echo $query;
	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

