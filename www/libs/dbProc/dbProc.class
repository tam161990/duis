	// -----------------------------------------------------------------------------
	function getSearchCritery($userId)
	{
		$oSQL=new dbLayer();
		$sql = 'select * from `SEARCH_CRITERIA`
                where  user ='.dbLayer::quote_smart($userId).' order by searchDate desc limit 1';

		return $oSQL -> makeQuery($sql);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa mekleshanas rwzultatus.
    // ja ieraksts jau eksistee, jaizmaina tekosho ierakstu, citadi jaizveido jaunu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function replaceSearchResult($report, $userId,
                                $yearFrom = '',
                                $yearUntil = '',
                                $monthFrom = '',
                                $monthUntil = '',
                                $worker = '',
                                $edCode = '',
                                $edArea = '',
                                $voltage = '',
                                $ouner = '',
                                $type = '',
                                $isFinished = '',
                                $status1 = '',
                                $trLocation = '',
                                $object = '',
                                $isOtherPayment = '',
                                $overTime = '',
                                $code = '',
                                $favoritMaterial = '',
                                $favoritCalc = '',
                                $priority = '',
                                $objectVoltage = '',
                                $designation  = -1 ,
                                $section = '',
                                $contract = ''
                            )
	{

			$query = 'insert into `SEARCH_CRITERIA` (
                                `user`,
                                `yearFrom`,
                                `yearUntil`,
                                `monthFrom`,
                                `monthUntil`,
                                `worker`,
                                `edCode`,
                                `edArea`,
                                `voltage`,
                                `ouner`,
                                `type`,
                                `isFinished`,
                                `status1`,
                                `trLocation`,
                                `object`,
                                `isOtherPayment`,
                                `overTime`,
                                `code`,
                                `favoritMaterial`,
                                `favoritCalc`,
                                `priority`,
                                `objectVoltage`,
                                `designation` ,
                                `section`, `contract`, `report`, `searchDate`
                                )
			            values ("'.dbLayer::quote_smart($userId).'",
                                "'.dbLayer::quote_smart($yearFrom).'",
                                "'.dbLayer::quote_smart($yearUntil).'",
                                "'.dbLayer::quote_smart($monthFrom).'",
                                "'.dbLayer::quote_smart($monthUntil).'",

                                "'.dbLayer::quote_smart($worker).'",
                                "'.dbLayer::quote_smart($edCode).'",
                                "'.dbLayer::quote_smart($edArea).'",

                                "'.dbLayer::quote_smart($voltage).'",
                                "'.dbLayer::quote_smart($ouner).'",
                                "'.dbLayer::quote_smart($type).'",
                                "'.dbLayer::quote_smart($isFinished).'",
                                "'.dbLayer::quote_smart($status1).'",
                                "'.dbLayer::quote_smart($trLocation).'",
                                "'.dbLayer::quote_smart($object).'",
                                "'.dbLayer::quote_smart($isOtherPayment).'",
                                "'.dbLayer::quote_smart($overTime).'",
                                "'.dbLayer::quote_smart($code).'",
                                "'.dbLayer::quote_smart($favoritMaterial).'",
                                "'.dbLayer::quote_smart($favoritCalc).'",
                                "'.dbLayer::quote_smart($priority).'",
                                "'.dbLayer::quote_smart($objectVoltage).'",
                                "'.dbLayer::quote_smart($designation).'",
                                "'.dbLayer::quote_smart($section).'",
                                "'.dbLayer::quote_smart($contract).'",
                                "'.dbLayer::quote_smart($report).'",
                                now() )';
               //ON DUPLICATE KEY UPDATE
//                '.(($yearFrom !='')?'`yearFrom`="'.dbLayer::quote_smart($yearFrom).'"':'').'
//                '.(($yearUntil !='')?',`yearUntil`="'.dbLayer::quote_smart($yearUntil).'"':'').'
//                '.(($monthFrom !='')?',`monthFrom`="'.dbLayer::quote_smart($monthFrom).'"':'').'
//                '.(($monthUntil !='')?',`monthUntil`="'.dbLayer::quote_smart($monthUntil).'"':'').'
//                '.(($rcdRegion !='')?',`rcdRegion`="'.dbLayer::quote_smart($rcdRegion).'"':'').'
//                '.(($dvArea !='')?',`dvArea`="'.dbLayer::quote_smart($dvArea).'"':'').'
//                '.(($edRegion !='')?',`edRegion`="'.dbLayer::quote_smart($edRegion).'"':'').'
