	function getActMaterialList($ID)
	{
            // , SUBSTRING(`MATR_NOSAUKUMS`, 1, 25) as `MATR_NOSAUKUMS`
		    $query = "select *
                from `MATERIALI`
                WHERE `MATR_RAKT_ID` = ".dbLayer::quote_smart($ID)."

                ORDER BY `MATR_IS_WORKER` DESC";


		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

