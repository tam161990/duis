                "'.dbLayer::quote_smart($contract).'",
                "'.dbLayer::quote_smart($trase).'",
               "'.dbLayer::quote_smart($designation).'",
                "'.dbLayer::quote_smart($workTitle).'" ,
		"'.dbLayer::quote_smart($toidn).'" ,
		"'.dbLayer::quote_smart($toid).'" ,
                "'.dbLayer::quote_smart($z1).'",
                "'.dbLayer::quote_smart($z2).'",
                "'.dbLayer::quote_smart($z3).'",
                "'.dbLayer::quote_smart($z4).'",
                "'.dbLayer::quote_smart($z5).'",
                "'.dbLayer::quote_smart($z6).'",
                "'.dbLayer::quote_smart($z7).'",
                "'.dbLayer::quote_smart($z8).'",
                "'.dbLayer::quote_smart($z9).'",
                "'.dbLayer::quote_smart($v1).'",
                "'.dbLayer::quote_smart($v2).'",
                "'.dbLayer::quote_smart($v3).'",
                "'.dbLayer::quote_smart($v4).'",
                "'.dbLayer::quote_smart($v5).'",
                "'.dbLayer::quote_smart($v6).'",
                "'.dbLayer::quote_smart($v7).'",
                "'.dbLayer::quote_smart($v8).'",
                "'.dbLayer::quote_smart($v9).'",
                "'.dbLayer::quote_smart($v10).'",
                "'.dbLayer::quote_smart($v11).'"
                )';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

