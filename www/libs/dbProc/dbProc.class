	// Saglabaa spriegumu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveVoltage($ID, $code, $title, $isActive, $trase)
	{
		if ($ID)
		{
			$query = 'update `KL_SPRIEGUMS`
				set `KSRG_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KSRG_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'",
                    `KSRG_TRASE` = "'.dbLayer::quote_smart($trase).'"
				where `KSRG_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `KL_SPRIEGUMS`
                (`KSRG_KODS`, `KSRG_NOSAUKUMS`, `KSRG_IR_AKTIVS`, `KSRG_TRASE`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($isActive).'",
                "'.dbLayer::quote_smart($trase).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}



	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai spriegums ar doto  kodu
	// eksistee. Ja dots sprieguma ID, shii spriegumam netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function voltageWithCodeExists($code, $voltageId = false)
	{
		$query = 'select `KSRG_ID` from `KL_SPRIEGUMS`
            where `KSRG_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($voltageId)
		{
			$query .= ' and `KSRG_ID` != "'.dbLayer::quote_smart($voltageId).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KSRG_ID']);
	}

