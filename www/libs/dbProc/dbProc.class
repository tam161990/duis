	function getWorkOwnerNumber($Code, $section)
	{
		$query = 'select KCNT_VV_NUMBER as `NUMBER`
        from `KL_CONTRACT`
        where `KCNT_KWOI_KODS` = "'.dbLayer::quote_smart($Code).'"
        AND `KCNT_SECTION` = "'.dbLayer::quote_smart($section).'"';

		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
		if (isset($result[0]['NUMBER']))
		{
			return $result[0]['NUMBER'];
		}
		return false;
	}

	// Saska�o�anas status�: 
	// Poga Saska�ots 
 	// ja Starpakts checkbox = false, tad pogai saglab�jas funkcionalit�te un tabul� KL_MMS_DARBI laukam KMSD_NOSLEGUMA_AKTS v�rt�ba ierakst�s =true attiec�gajam MMS darbam 

	function finalizeMMS($actId, $finalize = 0)
	{
		$query = "UPDATE `KL_MMS_DARBI` SET `KMSD_NOSLEGUMA_AKTS` = ".dbLayer::quote_smart($finalize)." WHERE `KMSD_ID` = (SELECT `RAKT_MMS_KODS` FROM `AKTI` WHERE `RAKT_ID` = ".dbLayer::quote_smart($actId)." )";
		$oSQL = new dbLayer;
//echo $query;
		$result = $oSQL -> makeQuery($query);

		return ($result !== false); 	
	}

	function getFinalizeMMS($actId)
	{
		$query = "SELECT `KMSD_NOSLEGUMA_AKTS` FROM `KL_MMS_DARBI` WHERE `KMSD_ID` = (SELECT `RAKT_MMS_KODS` FROM `AKTI` WHERE `RAKT_ID` = ".dbLayer::quote_smart($actId)." )";
		$oSQL = new dbLayer;
//echo $query;
		$result = $oSQL -> makeQuery($query);

		if (isset($result[0]['KMSD_NOSLEGUMA_AKTS']))
		{
			return $result[0]['KMSD_NOSLEGUMA_AKTS'];
		}
		return false;
	}

	function setCalkulationStatuss($id, $trase, $aktivs)
	{
		$table = (($trase == 1) ? "KL_KALKULACIJA_TRASE" : "KL_KALKULACIJA");

		$query = "UPDATE " .$table. " SET `KKAL_IR_AKTIVS` = ".dbLayer::quote_smart($aktivs)."  
		WHERE `KKAL_ID` = ".dbLayer::quote_smart($id);

		$oSQL = new dbLayer;
		//echo $query;
		$result = $oSQL -> makeQuery($query);

		return ($result !== false); 	
	}






