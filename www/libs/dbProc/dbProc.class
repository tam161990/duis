    function CalcNornCodeExists($code, $Id = false)
	{
		$query = 'select `KKNO_ID` from `KL_KALKULACIJAS_NORMAS`
            where `KKNO_KKAL_SHIFRS` = "'.dbLayer::quote_smart($code).'"';
		if ($Id)
		{
			$query .= ' and `KKNO_ID` != "'.dbLayer::quote_smart($Id).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KKNO_ID']);
    }
    
    function saveCalcNormFromExcel($data){
        
        $oSQL=new dbLayer();
        
        $query = 'INSERT INTO `KL_KALKULACIJAS_NORMAS_TEMP` 
                    (
                        `KKNO_KKAL_SHIFRS`,
                        `KKNO_KKAL_NOSAUKUMS`,
                        `KKNO_NORM`
                    )
                    VALUES
                    (
                            "'.dbLayer::quote_smart($data[0]).'",
                            "'.dbLayer::quote_smart($data[1]).'",
                            "'.dbLayer::quote_smart(str_replace(',', '.', $data[2])).'"                            
                    ) ';
        
        return $oSQL->makeQuery($query);
    }

    
    // -----------------------------------------------------------------------------
	// izveidot tmp kalkul�cijas sql tabulu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function createCalcNormTempTable()
	{
		$oSQL=new dbLayer();
        $sql =   'DROP TABLE IF EXISTS `KL_KALKULACIJAS_NORMAS_TEMP`';
        $oSQL->makeQuery($sql);

        $sql =   'CREATE TABLE `KL_KALKULACIJAS_NORMAS_TEMP` (
            KKNO_ID INT(11) NOT NULL AUTO_INCREMENT,	
            KKNO_KKAL_SHIFRS CHAR(5) NOT NULL,
            KKNO_KKAL_NOSAUKUMS VARCHAR(150) NOT NULL,
            KKNO_NORM FLOAT(7,2),
            PRIMARY KEY (`KKNO_ID`),
	        UNIQUE INDEX `U_KKNO_KKAL_SHIFRS` (KKNO_KKAL_SHIFRS)
        )
        COLLATE=utf8_latvian_ci
        AUTO_INCREMENT=1
        ;';

		return $oSQL->makeQuery($sql);
	}

    // -----------------------------------------------------------------------------
	// parsaukt kalkul�cijas temp sql tabulu uz  KL_KALKULACIJA
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function renameCalcNormTable()
	{
        $oSQL=new dbLayer();
        $sql =   'DROP TABLE IF EXISTS `KL_KALKULACIJAS_NORMAS`';
        $oSQL->makeQuery($sql);
		return $oSQL->makeQuery('ALTER TABLE `KL_KALKULACIJAS_NORMAS_TEMP` RENAME `KL_KALKULACIJAS_NORMAS`');
    }

