	// Atgriezh pabeigtus vai nepabeigtus MMS darbus.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkCode($ID)
	{
           $query = 'select `KMSD_KODS` from `KL_MMS_DARBI`
            where `KMSD_ID` = '.dbLayer::quote_smart($ID);

	   	$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
        return isset($result[0]['KMSD_KODS']) ? $result[0]['KMSD_KODS'] : false;
	}

    
    // -----------------------------------------------------------------------------
	// Dzēst MMS darbus un saistītos tamme un aktu, kas nav uzsākts.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function deleteMMSWork($code)
	{
        $query = 'DELETE FROM `KL_MMS_DARBI` where `KMSD_KODS` = "'.dbLayer::quote_smart($code) .'"';

        $oDB = new dbLayer;
        $r = $oDB -> makeQuery($query);

        $query = 'SELECT `RAKT_ID` FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = "'.dbLayer::quote_smart($code).'"  
                    AND `RAKT_STATUS` IN ("'.STAT_AUTO.'")';
        $result = $oDB -> makeQuery($query);
        $actId = isset($result[0]['RAKT_ID']) ? $result[0]['RAKT_ID'] : false;

        if($actId !== false) {
            $result = dbProc::deleteAutoActWorks($actId);
            if($result !== false) { 
               $result= dbProc::deleteAutoActMaterial($actId);
            }            
            
            $query = 'UPDATE `AKTI` SET `RAKT_STATUS` = "'.STAT_DELETE.'" WHERE `RAKT_ID` = '.$actId.'';  
            $result = $oDB -> makeQuery($query);

            return ($result !== false);
        }       
        
        return ($r !== false);

    }

    // -----------------------------------------------------------------------------
	// Dzēst MMS darbas rindu un atjauno saistītos tamme ja akts nav apstiprināts.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function deleteMMSWorkRow($id, $code, $trase)
	{
        $query = 'DELETE FROM `KL_MMS_DARBI` where `KMSD_ID` = "'.dbLayer::quote_smart($id) .'"';

        $oDB = new dbLayer;
        $r = $oDB -> makeQuery($query);

        $query = 'SELECT `RAKT_ID` FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = "'.dbLayer::quote_smart($code).'"  
                    AND `RAKT_STATUS` IN ("'.STAT_AUTO.'")';
        $result = $oDB -> makeQuery($query);
        $actId = isset($result[0]['RAKT_ID']) ? $result[0]['RAKT_ID'] : false;

        if($actId !== false) {

            $result = dbProc::deleteAutoActWorks($actId);
            if($result !== false) { 
                $result = dbProc::deleteAutoActMaterial($actId);
            }
            if($result !== false) { 
                $result = dbProc::processAutoActWorks($actId, $code, $trase);
            }
            if($result !== false) { 
                $result = dbProc::processAutoActMaterial($actId, $code, $trase);
            }
            return ($result !== false);
        }       
        
        return ($r !== false);

	}


	// -----------------------------------------------------------------------------
	// Saglabaa MMS darbu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveMMSWork($ID, $kods,
                                $designation,
                                $worktitle,						
                                $proces_date,
                                $requirement_code,
                                $requirement,
                                $edAreaCode,
                                $worker,
                                $contract,
                                $priority,
                                $isEpla,
                                $toid,
                                $technic_object,
                                $network_element,
                                $network_element_code,
                                $quantity,
                                $line_count,
                                $mms_x,
                                $mms_y,
                                $voltage,
                                $object,
                                $sourceOfFounds,
                                $export_date,
                                $user)
	{
        $oDB = new dbLayer;
        $updateNeaded = false;
		$insertneeded = false;
        
		if ($ID)
		{
            $query = 'SELECT `RAKT_ID` FROM `AKTI` WHERE `RAKT_NUM_POSTFIX` = "'.dbLayer::quote_smart($kods).'"  
                    AND `RAKT_STATUS`  IN ("'.STAT_AUTO.'", "'.STAT_INSERT.'", "'.STAT_RETURN.'")';
            $result = $oDB -> makeQuery($query);
            
            $actId = isset($result[0]['RAKT_ID']) ? $result[0]['RAKT_ID'] : false;
            
            // ja akts eksistē, pārbaudam vai nevajag atjaunot tammes, un ja vajag, tad atjaunojam            
            if($actId !== false) {
                $query = 'SELECT `KMSD_DAUDZUMS`, `KMSD_VADU_SKAITS` FROM `KL_MMS_DARBI` WHERE `KMSD_ID` = "'.dbLayer::quote_smart($ID).'"';
                $result = $oDB -> makeQuery($query);

                if(isset($result[0]['KMSD_DAUDZUMS']) && isset($result[0]['KMSD_VADU_SKAITS']) &&
                   ($result[0]['KMSD_DAUDZUMS'] != $quantity || $result[0]['KMSD_VADU_SKAITS'] != $line_count)) 
                {
                    // update tammes
                    $updateNeaded = true;
                }
                $updateNeaded = true;
            }
			else {
                $insertneeded = true;                
			}

			$query = 'UPDATE  `KL_MMS_DARBI` SET 
                    `KMSD_KODS` = "'.dbLayer::quote_smart($kods).'",
                    `KMSD_OPERATIVAS_APZIM` = "'.dbLayer::quote_smart($designation).'",
                    `KMSD_WORK_TITLE` = "'.dbLayer::quote_smart($worktitle).'",
                    `KMSD_IZPILDES_DATUMS` = "'.dbLayer::parseDate($proces_date).'",
                    `KMSD_NOSACIJUMA_KODS` = "'.dbLayer::quote_smart($requirement_code).'",
                    `KMSD_NOSACIJUMS` = "'.dbLayer::quote_smart($requirement).'",
                    `KMSD_KEDI_KODS` = "'.dbLayer::quote_smart($edAreaCode).'",
                    `KMSD_IZPILDITAJA_KODS` = "'.dbLayer::quote_smart($worker).'",
                    `KMSD_VV_NUMURS` = "'.dbLayer::quote_smart($contract).'",
                    `KMSD_PRIORITATE` = "'.dbLayer::quote_smart($priority).'",
                    `KMSD_IR_EPLA` = "'.dbLayer::quote_smart($isEpla).'",
                    `KMSD_TO_ID` = "'.dbLayer::quote_smart($toid).'",
                    `KMSD_TEH_OBJEKTS` = "'.dbLayer::quote_smart($technic_object).'",
                    `KMSD_TIKLA_ELEMENTS` = "'.dbLayer::quote_smart($network_element).'",
                    `KMSD_TIKLA_ELEMENTA_KLASE` = "'.dbLayer::quote_smart($network_element_code).'",
                    `KMSD_DAUDZUMS` = "'.dbLayer::quote_smart($quantity).'",
                    `KMSD_VADU_SKAITS` = "'.dbLayer::quote_smart($line_count).'",
                    `KMSD_X` = "'.dbLayer::quote_smart($mms_x).'",
                    `KMSD_Y` = "'.dbLayer::quote_smart($mms_y).'",
                    `KMSD_KSRG_KODS` = "'.dbLayer::quote_smart($voltage).'",
                    `KMSD_KOBJ_KODS` = "'.dbLayer::quote_smart($object).'",
                    `KMSD_KFNA_KODS` = "'.dbLayer::quote_smart($sourceOfFounds).'",
                    `KMSD_EDITOR` = "'.dbLayer::quote_smart($user).'",
                    `KMSD_EDITED` = now()
                    where `KMSD_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($kods)
		{
            $insertneeded = true;
			$query = 'INSERT into `KL_MMS_DARBI`
                    (`KMSD_KODS`,
                    `KMSD_OPERATIVAS_APZIM`,
                    `KMSD_WORK_TITLE`,
                    `KMSD_IZPILDES_DATUMS`,
                    `KMSD_NOSACIJUMA_KODS`,
                    `KMSD_NOSACIJUMS`,
                    `KMSD_IZPILDITAJA_KODS`,
                    `KMSD_VV_NUMURS`,
                    `KMSD_KEDI_KODS`,
                    `KMSD_PRIORITATE`,
                    `KMSD_IR_EPLA`,
                    `KMSD_TO_ID`,
                    `KMSD_TEH_OBJEKTS`,
                    `KMSD_TIKLA_ELEMENTS`,
                    `KMSD_TIKLA_ELEMENTA_KLASE`,
                    `KMSD_DAUDZUMS`,
                    `KMSD_VADU_SKAITS`,
                    `KMSD_X`,
                    `KMSD_Y`,
                    `KMSD_KSRG_KODS`,
                    `KMSD_KOBJ_KODS`,
                    `KMSD_KFNA_KODS`,
                    `KMSD_EDITOR` )
			values
                ("'.dbLayer::quote_smart($kods).'",
                "'.dbLayer::quote_smart($designation).'",
                "'.dbLayer::quote_smart($worktitle).'",
                "'.dbLayer::parseDate($proces_date).'",
                "'.dbLayer::quote_smart($requirement_code).'",
                "'.dbLayer::quote_smart($requirement).'",
                "'.dbLayer::quote_smart($worker).'",
                "'.dbLayer::quote_smart($contract).'",
                "'.dbLayer::quote_smart($edAreaCode).'",
                "'.dbLayer::quote_smart($priority).'",
                "'.dbLayer::quote_smart($isEpla).'",
                "'.dbLayer::quote_smart($toid).'",
                "'.dbLayer::quote_smart($technic_object).'",
                "'.dbLayer::quote_smart($network_element).'",
                "'.dbLayer::quote_smart($network_element_code).'",
                "'.dbLayer::quote_smart($quantity).'",
                "'.dbLayer::quote_smart($line_count).'",
                "'.dbLayer::quote_smart($mms_x).'",
                "'.dbLayer::quote_smart($mms_y).'",
                "'.dbLayer::quote_smart($voltage).'",
                "'.dbLayer::quote_smart($object).'",
                "'.dbLayer::quote_smart($sourceOfFounds).'",
                "'.dbLayer::quote_smart($user).'")';
		}
        //echo $query;
		
        $r = $oDB -> makeQuery($query);
        
        if ($ID)
		{
			$query = 'UPDATE  `KL_MMS_DARBI` SET       
                    `KMSD_OPERATIVAS_APZIM` = "'.dbLayer::quote_smart($designation).'",              
                    `KMSD_WORK_TITLE` = "'.dbLayer::quote_smart($worktitle).'",
                    `KMSD_IZPILDES_DATUMS` = "'.dbLayer::parseDate($proces_date).'",                   
                    `KMSD_KEDI_KODS` = "'.dbLayer::quote_smart($edAreaCode).'",
                    `KMSD_IZPILDITAJA_KODS` = "'.dbLayer::quote_smart($worker).'",
                    `KMSD_VV_NUMURS` = "'.dbLayer::quote_smart($contract).'",
                    `KMSD_PRIORITATE` = "'.dbLayer::quote_smart($priority).'",
                    `KMSD_IR_EPLA` = "'.dbLayer::quote_smart($isEpla).'",    
                    `KMSD_TO_ID` = "'.dbLayer::quote_smart($toid).'",
                    `KMSD_TEH_OBJEKTS` = "'.dbLayer::quote_smart($technic_object).'",   
                    `KMSD_KSRG_KODS` = "'.dbLayer::quote_smart($voltage).'",
                    `KMSD_KOBJ_KODS` = "'.dbLayer::quote_smart($object).'",             
                    `KMSD_EDITOR` = "'.dbLayer::quote_smart($user).'",
                    `KMSD_EDITED` = now()                    
                    where `KMSD_KODS` = "'.dbLayer::quote_smart($kods).'"';
        }
        
        $oDB = new dbLayer;
        $r = $oDB -> makeQuery($query);
        
        
        // update tammes
        if($updateNeaded) {
            if($actId !== false) {

                $result = dbProc::deleteAutoActWorks($actId);
                if($result !== false) { 
                    $result = dbProc::deleteAutoActMaterial($actId);
                }
                if($result !== false) { 
                    $result = dbProc::processAutoActWorks($actId, $kods, $isEpla);
                }
                if($result !== false) { 
                    $result = dbProc::processAutoActMaterial($actId, $kods, $isEpla);
                }
                return ($result !== false);
            }       
        }
		if($insertneeded) {
            
			$result = dbProc::processAutoActs($user);
		}

		return ($result !== false);
    }

    
	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo MMS darbu skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMMSWorkCount($search = false, $column = false, $showOnlyActiv = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
        }
        if($column == 'WORKER')
            {
                $column = 'w.KWOI_NOSAUKUMS';
            }
        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        if($showOnlyActiv !== false)
        {
           $searchString .= ' and `KMSD_IR_PABEIGTS` =0 ';
        }
        $query =  'select count(`KMSD_ID`) as `RECORDCOUNT` from `KL_MMS_DARBI`
        LEFT JOIN `KL_WORK_OWNERS` w ON (w.KWOI_KODS = KMSD_IZPILDITAJA_KODS)
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
	}

    function is_mms_exists()
    {
        $query = 'SELECT * FROM `KL_MMS_DARBI`';
        
        $oDB = new dbLayer;
        $res = $oDB -> makeQuery($query);

        $mms_exists = false;
        if (is_array($res) && count($res)>0)
		{
			$mms_exists = true;
        }
        return $mms_exists;
    }

    
