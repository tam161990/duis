	function getMMSWorkActivList($activ = true)
	{
            $column = dbProc::getKlklDefaultColumn(KL_MMS_WORKS);
			$query = 'select * from `KL_MMS_DARBI`
            where `KMSD_IR_PABEIGTS` = '.(($activ) ? 0 : 1).'
            order by `'.$column.'` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

