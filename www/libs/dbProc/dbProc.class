                {
                    $statusString .= "'".$s."',";
                }
                $searcCriteria['status']  = substr($statusString, 0, -1);
             }
             
		    $query = "SELECT COUNT(1) as `ACT_COUNT` FROM (select 1
            from `AKTI` a
            LEFT JOIN `KL_REF_KODI` k ON (a.RAKT_STATUS = k.KRFK_VERTIBA )
            LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
            LEFT JOIN `KL_WORK_OWNERS` w ON (a.RAKT_KWOI_KODS = w.KWOI_KODS)
            LEFT JOIN `LIETOTAJI` l ON (a.RAKT_RLTT_ID = l.RLTT_ID)
            where   `RAKT_PROJECT` = '1' ";

            $userInfo = dbProc::getUserInfo(userAuthorization::getUserId());
      	    if(count($userInfo) >0 )
      	    {
      		    $user = $userInfo[0];
       	    }
            if(isset($searcCriteria['yearFrom']) && $searcCriteria['yearFrom'] != -1 )
            {
                $query .= " and a.RAKT_GADS = '".$searcCriteria['yearFrom']."' ";
            }            
            if(isset($searcCriteria['worker']) && $searcCriteria['worker'] != -1)
            {
                $query .= " and a.RAKT_KWOI_KODS = '".$searcCriteria['worker']."' ";
            }
            if(isset($searcCriteria['edCode']) && $searcCriteria['edCode'] != -1)
            {
                $query .= " and e.KEDI_KODS = ".$searcCriteria['edCode']." ";
            }
            if(isset($searcCriteria['ouner']) && $searcCriteria['ouner'] != -1)
            {
                $query .= " and a.RAKT_RLTT_ID = '".$searcCriteria['ouner']."' ";
            }
            if(isset($searcCriteria['status']) && $searcCriteria['status'] != -1)
            {
                $query .= " and a.RAKT_STATUS in  (".$searcCriteria['status'].") ";
            }
            $query .= " GROUP BY `RAKT_FULL_NUMBER`)q ";
        //echo $query;
		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);

		return isset($result[0]['ACT_COUNT']) ? $result[0]['ACT_COUNT'] : false;
	}


    // -----------------------------------------------------------------------------
	// Saglabaa statusa parejas ierakstu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveAuditRecord($actId, $userId, $status)
	{
	   	$query = 'insert into `AKTA_STATUSA_MAINA`
                (`AAUD_RAKT_ID`, `AAUD_RLTT_ID`, `AAUD_STATUS`, `AAUD_DATUMS`)
			values
                ("'.dbLayer::quote_smart($actId).'",
                "'.dbLayer::quote_smart($userId).'",
                "'.dbLayer::quote_smart($status).'",
                now())';
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh  akta nako�o numuru ED iecirk�a ietvaros.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getNextActNumber($EDarea, $trase = 0)
	{
		$oDB = new dbLayer;
        $query =  'select IFNULL(MAX(`RAKT_NUMURS`),0)+1 as `NUMURS` from `AKTI`
        where `RAKT_KEDI_ID` = "'.dbLayer::quote_smart($EDarea).'"
        AND `RAKT_TRASE` = "'.dbLayer::quote_smart($trase).'"  ';
		$result = $oDB -> makeQuery($query);
       	return $result[0]['NUMURS'];
	}

    // -----------------------------------------------------------------------------
	// Atgriezh  objekta nako�o numuru acta ietvaros.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getNextObjNumber($actId)
	{
		$oDB = new dbLayer;
        $query =  'select MAX(`RAKT_NUMURS_OBJEKTA`) as `NUMURS` from `AKTI`
        where `RAKT_KEDI_ID` = (select `RAKT_KEDI_ID` from `AKTI` where `RAKT_ID` = "'.dbLayer::quote_smart($actId).'")
        and `RAKT_NUMURS` = (select `RAKT_NUMURS` from `AKTI` where `RAKT_ID` = "'.dbLayer::quote_smart($actId).'")';
		$result = $oDB -> makeQuery($query);
       	return isset($result[0]['NUMURS']) ? $result[0]['NUMURS'] + 1 : 1;
	}

// DARBI
    // -----------------------------------------------------------------------------
	// Atgriezh akta darbus. atgriezh visas p�c akta ID.
	// Author: Tatjana Fedorkova
    // -----------------------------------------------------------------------------
        function getActWorkList($ID, $tame = false, $onlyNotApproved = false, $group_id = false, 
                                $project = false, $work_type_text = false)
	{
            $table_name = ($tame) ? 'TAME_DARBI' : 'DARBI';
            $column_name = ($tame) ? '`DRBI_DAUDZUMS_KOR`' : '`DRBI_DAUDZUMS`';
            $group_name = ($project) ? ',`KLDV_NOSAUKUMS`' : ',`KKNO_NORM`*`DRBI_DAUDZUMS` as WORK_NORM_SUM';
            $query = "select *, ".dbLayer::sqlParseDate('DRBI_PLAN_DATE') .", 
                    ".dbLayer::sqlParseDate('DRBI_APPROVE_DATE') .", ".dbLayer::sqlParseDate('DRBI_WORK_APROVE_DATE') .",
                    (SELECT DISTINCT TRIM(KKAL_APRAKSTS) FROM `KL_KALKULACIJA` WHERE KKAL_SHIFRS = DRBI_KKAL_SHIFRS
                    AND KKAL_VV_NUMBER = (SELECT `RAKT_VV_NUMBER` FROM `AKTI` WHERE `RAKT_ID` =  ".dbLayer::quote_smart($ID).") 
                    AND KKAL_IR_AKTIVS = 1  LIMIT 1 ) as KKAL_APRAKSTS ". $group_name."
                from " . $table_name . "
                ".(($project) ? 'INNER JOIN `kl_darba_veidi` ON `KLDV_ID` = `DRBI_WORK_TYPE_ID` ': '')."
                ".((!$project) ? 'LEFT JOIN `kl_kalkulacijas_normas` ON `KKNO_KKAL_SHIFRS` = `DRBI_KKAL_SHIFRS` ': '')."
                WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)."
                " . (($onlyNotApproved) ? " AND `DRBI_APPROVE_DATE` IS NULL " : "" ) ." 
                " . (($group_id !== false) ? " AND `DRBI_WORK_TYPE_ID` = ".dbLayer::quote_smart($group_id) : "" ) ."
                " . (($work_type_text !== false) ? (empty($work_type_text) ? " AND `DRBI_WORK_TYPE_TEXT` IS NULL " : " AND `DRBI_WORK_TYPE_TEXT` = '".dbLayer::quote_smart($work_type_text)."'" ) : "" ) ."
                AND ".$column_name." IS NOT NULL
                union
                select *, ".dbLayer::sqlParseDate('DRBI_PLAN_DATE') .", 
                ".dbLayer::sqlParseDate('DRBI_APPROVE_DATE') .", ".dbLayer::sqlParseDate('DRBI_WORK_APROVE_DATE') .",
                (SELECT DISTINCT TRIM(KKAL_APRAKSTS) FROM `KL_KALKULACIJA` WHERE KKAL_SHIFRS = DRBI_KKAL_SHIFRS
                AND KKAL_VV_NUMBER = (SELECT `RAKT_VV_NUMBER` FROM `AKTI` WHERE `RAKT_ID` =  ".dbLayer::quote_smart($ID).") 
                AND KKAL_IR_AKTIVS = 1  LIMIT 1 ) as KKAL_APRAKSTS ". $group_name."
                from " . $table_name . "
                ".(($project) ? 'INNER JOIN `kl_darba_veidi` ON `KLDV_ID` = `DRBI_WORK_TYPE_ID` ': '')."
                ".((!$project) ? 'LEFT JOIN `kl_kalkulacijas_normas` ON `KKNO_KKAL_SHIFRS` = `DRBI_KKAL_SHIFRS` ': '')."
                WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)."
                " . (($onlyNotApproved) ? " AND `DRBI_APPROVE_DATE` IS NULL " : "" ) ." 
                " . (($group_id !== false) ? " AND `DRBI_WORK_TYPE_ID` = ".dbLayer::quote_smart($group_id) : "" ) ."
                " . (($work_type_text !== false) ? (empty($work_type_text) ? " AND `DRBI_WORK_TYPE_TEXT` IS NULL " : " AND `DRBI_WORK_TYPE_TEXT` = '".dbLayer::quote_smart($work_type_text)."'" ) : "" ) ."
                AND ".$column_name." IS NULL
                ORDER BY  11, 1  ";

        	//echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

	// funkcija uzstada darba u nperson�la apstiprin��anas datums
    function setApproveDate($actId, $date) {
        $oSQL = new dbLayer;
        $r1 = false;
        $r2 = false;
        $query = 'UPDATE `DARBI` SET  `DRBI_WORK_APROVE_DATE`  = "' .$date .'" 
        WHERE `DRBI_RAKT_ID` = '.$actId .' AND `DRBI_WORK_APROVE_DATE` IS NULL';  		
        $r1 = $oSQL -> makeQuery($query);	
        $query = 'UPDATE `materiali` SET  `MATR_WORK_APROVE_DATE`  = "' .$date .'" 
        WHERE `MATR_RAKT_ID` = '.$actId .' AND `MATR_WORK_APROVE_DATE` IS NULL';  				
		$r2 = $oSQL -> makeQuery($query);	
        return ($r1 && $r2);
    }


	// funkcija apre�ina akta darbu summas p�e m�rvien�bas : m3, ha, km, gab
    function getActWorkSumms($ID, $tame = false)
	{
		 $table_name = ($tame) ? 'TAME_DARBI' : 'DARBI';
		
		$query = "SELECT SUM(m3) m3, SUM(ha) ha, SUM(km) km, SUM(gab) gab 
			FROM ( 
				SELECT SUM(DRBI_DAUDZUMS)  m3, 0 ha, 0 km, 0 gab FROM " . $table_name . " WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)." AND `DRBI_MERVIENIBA` = 'm3'
				UNION
				SELECT 0  m3, SUM(DRBI_DAUDZUMS) ha, 0 km, 0 gab FROM " . $table_name . " WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)." AND `DRBI_MERVIENIBA` = 'ha'
				UNION
				SELECT 0  me3, 0 ha, SUM(DRBI_DAUDZUMS) km, 0 gab FROM " . $table_name . " WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)." AND `DRBI_MERVIENIBA` = 'km'
				UNION 
				SELECT 0 m3, 0 ha, 0 km, SUM(DRBI_DAUDZUMS) gab FROM " . $table_name . " WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)." AND `DRBI_MERVIENIBA` = 'gab.'
			) x "; 

		//echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);

	}	

	
