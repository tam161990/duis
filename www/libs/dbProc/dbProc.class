    function GetChifSignature($edRegionId, $position, $x = 0)
    {

                  if($x == 0)
	  {
		   $sql = 'SELECT DISTINCT REGI_NOSAUKUMS AS nosaukums FROM `KL_SASKANOTAJI` s
		   INNER JOIN `KL_ED_IECIRKNI` i ON ( i.KEDI_REGIONS = s.SLTT_REGIONS )
		   INNER JOIN `KL_REGIONI` r ON ( r.REGI_KODS = s.SLTT_REGIONS )
		   WHERE i.KEDI_ID = "'.dbLayer::quote_smart($edRegionId).'"
		   AND s.SLTT_KEDI_ID IS NULL
		   AND s.SLTT_POSITION = "'.dbLayer::quote_smart($position).'"  ';
	   }
	   else
	   {
		   $sql = 'SELECT DISTINCT KRFK_NOZIME  AS nosaukums FROM `KL_SASKANOTAJI` s
		   INNER JOIN `KL_ED_IECIRKNI` i ON ( i.KEDI_REGIONS = s.SLTT_REGIONS )
		   INNER JOIN `KL_REGIONI` r ON ( r.REGI_KODS = s.SLTT_REGIONS )
		   INNER JOIN `KL_REF_KODI` k ON (k.KRFK_VERTIBA  = s.SLTT_POSITION)
		   WHERE i.KEDI_ID = "'.dbLayer::quote_smart($edRegionId).'"
		   AND s.SLTT_KEDI_ID IS NULL
		   AND s.SLTT_POSITION = "'.dbLayer::quote_smart($position).'"  ';
	   }
       	$oSQL=new dbLayer();
       	$result = $oSQL -> makeQuery($sql);
		if (isset($result[0]))
		{
			return $result[0]['nosaukums'];
		}
		return '';
    }

