	// -----------------------------------------------------------------------------
	// Atgriezh materi�la(-as). Ja dots ID, atdod to, ja ne - atgriezh visas.
	// Ja doti, njem veeraa nobiidi un daudzumu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false,
                            $showOnlyActiv = false
                            )
	{
		if ($ID)
		{
			$query = 'select *
				from `KL_MATERIALI`
                where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{
		    if($column === false)
            {
                  $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
            }
            if($orderColumn === false)
            {
                  $orderColumn = dbProc::getKlklDefaultColumn(KL_MATERIALS);
            }

            $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
            if($search === false || $search == '')
            {
                $searchString = '1 ';
            }
            if($showOnlyActiv !== false)
            {
                $searchString .= ' and `KMAT_IR_AKTIVS` =1 ';
            }
            //, SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as `KMAT_NOSAUKUMS`
			$query = 'select *
            from `KL_MATERIALI`
            where '.$searchString.'
            order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order).'';
			if (($offset !== false) && $limit)
			{
				$query .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
		}

		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

    // -----------------------------------------------------------------------------
	// Atgriezh aktivus vai neaktivus materi�lus.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialActivList($activ = true)
	{       // , SUBSTRING(`KMAT_NOSAUKUMS`, 1, 25) as `KMAT_NOSAUKUMS`
            $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
			$query = 'select *
            from `KL_MATERIALI`
            where `KMAT_IR_AKTIVS` = '.(($activ) ? 1 : 0).'
            order by `'.dbLayer::quote_smart($column).'` asc';

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
	}

	// -----------------------------------------------------------------------------
	// Saglabaa materi�lu. Ja dots ID, izmaina esosho ierakstu, ja ne -
	// izveido jaunu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveMaterial($ID, $code, $title, $price, $amount, $measure, $isActive, $isMain = true)
	{
	    $tableName  = (($isMain)? 'KL_MATERIALI' : 'KL_MATERIALI_TEMP');
		if ($ID)
		{
			$query = 'update `'.$tableName.'`
				set `KMAT_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KMAT_CENA` = "'.dbLayer::quote_smart($price).'",
                    `KMAT_DAUDZUMS` = "'.dbLayer::quote_smart($amount).'",
                    `KMAT_MERVIENIBA` = "'.dbLayer::quote_smart($measure).'",
                    `KMAT_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"
				where `KMAT_ID` = "'.dbLayer::quote_smart($ID).'"';

		}
		elseif ($title)
		{
			$query = 'insert into `'.$tableName.'`
                (`KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_CENA`, `KMAT_DAUDZUMS`, `KMAT_MERVIENIBA`, `KMAT_IR_AKTIVS`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($price).'",
                "'.dbLayer::quote_smart($amount).'",
                "'.dbLayer::quote_smart($measure).'",
                "'.dbLayer::quote_smart($isActive).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa materi�lu.
	// ja ieraksts jau eksistee, jaizmaina tekosho ierakstu, citadi jaizveido jaunu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function replaceMaterial($code, $title, $price, $measure, $isActive, $isMain = true)
	{
	    $tableName  = (($isMain)? 'KL_MATERIALI' : 'KL_MATERIALI_TEMP');

			$query = 'insert into `'.$tableName.'`
                (`KMAT_KODS`, `KMAT_NOSAUKUMS`, `KMAT_CENA`, `KMAT_MERVIENIBA`, `KMAT_IR_AKTIVS`)
			values
                ("'.dbLayer::quote_smart($code).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($price).'",
                "'.dbLayer::quote_smart($measure).'",
                "'.dbLayer::quote_smart($isActive).'")
                ON DUPLICATE KEY UPDATE
                `KMAT_NOSAUKUMS` = "'.dbLayer::quote_smart($title).'",
                    `KMAT_CENA` = "'.dbLayer::quote_smart($price).'",
                    `KMAT_MERVIENIBA` = "'.dbLayer::quote_smart($measure).'",
                    `KMAT_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"';

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}



	// -----------------------------------------------------------------------------
	// Atgriezh bool veertiibu, kas noraada, vai materi�ls doto kodu
	// eksistee. Ja dota materi�la ID, shii materi�lam netiek iekljauta
	// paarbaudee
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function materialWithCodeExists($code, $ID = false)
	{
		$query = 'select `KMAT_ID` from `KL_MATERIALI`
            where `KMAT_KODS` = "'.dbLayer::quote_smart($code).'"';
		if ($ID)
		{
			$query .= ' and `KMAT_ID` != "'.dbLayer::quote_smart($ID).'"';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['KMAT_ID']);
	}

	// -----------------------------------------------------------------------------
	// Atgriezh kopeejo materi�la skaitu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getMaterialCount($search = false, $column = false, $showOnlyActiv = false)
	{
		$oDB = new dbLayer;
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn(KL_MATERIALS);
        }

        $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
        if($search === false || $search == '')
        {
            $searchString = '1 ';
        }
        if($showOnlyActiv !== false)
        {
            $searchString .= ' and `KMAT_IR_AKTIVS` =1 ';
        }
        $query =  'select count(`KMAT_ID`) as `RECORDCOUNT` from `KL_MATERIALI`
        where '.$searchString;
		$result = $oDB -> makeQuery($query);

		return isset($result[0]['RECORDCOUNT']) ? $result[0]['RECORDCOUNT'] : false;
	}

