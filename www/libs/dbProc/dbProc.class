    // -----------------------------------------------------------------------------
	// Parbauda - vai lieotajam ir piesaist�ta loma
	// Ja jaa - atgriezh true, cita gadijuma - false
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isUserInRole($userId, $role)
	{
		$oSQL=new dbLayer();
		$q = 'select * from `LIETOTAJI`
					where '.
					' `RLTT_ID` = "'.dbLayer::quote_smart($userId).'"'.
					' and `RLTT_ROLE`   = "'.dbLayer::quote_smart($role).'"';
		
		$res=$oSQL->makeQuery($q);

		if (is_array($res) && count($res)==1)
		{
			return true;
		}

		return false;
	}
	// -----------------------------------------------------------------------------
	// Noraadiito lietotaaju vaardi un uzvaardi (sagatavoti izmantoshanai atskaitees)
	// -----------------------------------------------------------------------------
	function getUserNameSurnameList($aUserScope)
	{
		$cUserString=dbLayer::parseArray($aUserScope);
		$cQuery="SELECT RLTT_ID id,CONCAT(RLTT_VARDS,' ',RLTT_UZVARDS) nosaukums
            FROM LIETOTAJI "
			.(($cUserString)?" WHERE RLTT_ID IN ".$cUserString."":"")
			." ORDER BY RLTT_UZVARDS ASC, RLTT_VARDS ASC";
		$oSQL=new dbLayer();
		$aRes=$oSQL->makeQuery($cQuery);
		return (is_array($aRes)?$aRes:array());
	}

    // Atgriezh sprieguma nosaukumu
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getUserName($Id)
	{
		$query = 'select CONCAT(RLTT_VARDS, " ",RLTT_UZVARDS) as `NOSAUKUMS`
        from `LIETOTAJI`
        where `RLTT_ID` = "'.dbLayer::quote_smart($Id).'"';

		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
		if (isset($result[0]['NOSAUKUMS']))
		{
			return $result[0]['NOSAUKUMS'];
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh regiona sarakstu konkr�nam lietot�jam
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getRegionForUser($userId)
	{
        $cQuery="SELECT l.RLTT_REGIONS
        FROM LIETOTAJI l
        WHERE l.RLTT_ID ='".dbLayer::quote_smart($userId)."'";

		$oSQL=new dbLayer();
		$aRes=$oSQL->makeQuery($cQuery);
		return (is_array($aRes)?$aRes:array());
    }
        // -----------------------------------------------------------------------------
	// Atgriezh visas peec id
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getKrfkTextByName($krfkTitle)
	{
		$query = 'select KRFK_NOZIME nozime 	from `KL_REF_KODI`	where `KRFK_VERTIBA` = "'.dbLayer::quote_smart($krfkTitle).'"';

		$oSQL = new dbLayer;
		$result = $oSQL -> makeQuery($query);
		if (isset($result[0]))
		{
			return $result[0]['nozime'];
		}
		return false;
	}

 // =================================================
 // HARMONIZED
 // =================================================
 // -----------------------------------------------------------------------------
	// Get list of users
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

	function getHarmonizedList($ID = false, $offset = false, $limit = false,
                            $search =  false,
                            $column = false,
                            $order =  'ASC',
                            $orderColumn = false)
	{
	    $oSQL=new dbLayer();
      	if ($ID)
		{
			$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `POSITION`
    				from`KL_SASKANOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (SLTT_KEDI_ID  = k.KEDI_ID)
                  LEFT JOIN `KL_REF_KODI` l ON (SLTT_POSITION = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_POSITION.'" )
                  where `SLTT_ID` = "'.dbLayer::quote_smart($ID).'"';
		}
		else
		{

          if($orderColumn === false)
          {
             $orderColumn = dbProc::getKlklDefaultColumn( KL_HARMONIZED );
          }
          if($column == 'POSITION')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }

          if($orderColumn == 'POSITION')
          {
             $orderColumn = 'l.KRFK_NOZIME';
          }
          if($orderColumn == 'AREA')
          {
               $orderColumn = 'k.KEDI_NOSAUKUMS';
          }

          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
    		$sql = 'select *, k.KEDI_NOSAUKUMS as `AREA`, l.KRFK_NOZIME as `POSITION`
    				from `KL_SASKANOTAJI`
                  LEFT JOIN `KL_ED_IECIRKNI` k ON (SLTT_KEDI_ID = k.KEDI_ID)
                  LEFT JOIN `KL_REF_KODI` l ON (SLTT_POSITION = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_POSITION.'"  )
                    where '. $searchString .'
                    order by '.dbLayer::quote_smart($orderColumn).' '.dbLayer::quote_smart($order);
            if (($offset !== false) && $limit)
			{
				$sql .= ' limit '.
					($offset ? (int)$offset.', ' : '').
					(int)$limit;
			}
        }

		$res=$oSQL->makeQuery($sql);
		return $res;
	}

    // -----------------------------------------------------------------------------
	// Get total user count in the users table
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getHarmonizedCount($search = false, $column = false)
	{
		$oSQL=new dbLayer();
        if($column === false)
        {
           $column = dbProc::getKlklDefaultColumn( KL_HARMONIZED );
        }

          if($column == 'POSITION')
          {
             $column = 'l.KRFK_NOZIME';
          }
          if($column == 'AREA')
          {
               $column = 'k.KEDI_NOSAUKUMS';
          }
          $searchString = 'UPPER('.dbLayer::quote_smart($column).') REGEXP "('.dbLayer::quote_smart(text::toUpper($search)).')" ';
          if($search === false || $search == '')
          {
            $searchString = '1 ';
          }
		$sql = 'select count(`SLTT_ID`) as `amount` from`KL_SASKANOTAJI`
        LEFT JOIN `KL_ED_IECIRKNI` k ON (SLTT_KEDI_ID  = k.KEDI_ID)
        LEFT JOIN `KL_REF_KODI` l ON (SLTT_POSITION = l.KRFK_VERTIBA AND l.KRFK_NOSAUKUMS = "'.KRFK_POSITION.'"  )
        where '. $searchString ;
		$res=$oSQL->makeQuery($sql);

		if($res)
		{
			return $res[0]['amount'];
		}
		else
		{
			return false;
		}
	}

    // -----------------------------------------------------------------------------
	// Check is user with defined login name already exist
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function isHasHarmonized($name, $surname, $userId=false)
	{
		$oSQL=new dbLayer();
		$sql = 'select count(`SLTT_ID`) as `amount` from `KL_SASKANOTAJI`
			where `SLTT_VARDS`="'.dbLayer::quote_smart($name).'"
            AND `SLTT_UZVARDS`="'.dbLayer::quote_smart($surname).'" ';
		if($userId)
		{
			$sql .= 'and `SLTT_ID`<>"'.dbLayer::quote_smart($userId).'" ';
		}
		$res=$oSQL->makeQuery($sql);
		if (!empty($res[0]['amount']))
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// saglaba saskanotaja datus
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function saveHarmonized($userId, $name,$surname, $dvArea, $isActive,$region,$position,$edArea,$section = '')
	{
		$oSQL=new dbLayer();
		if ($userId==false)
		{
			$sql = 'insert into `KL_SASKANOTAJI`
						(`SLTT_VARDS`,`SLTT_UZVARDS`,`SLTT_KEDI_ID`,`SLTT_IR_AKTIVS`, `SLTT_REGIONS`, `SLTT_POSITION`,`SLTT_ED_IECIKNIS`, `SLTT_KEDI_SECTION`) values
						( "'.dbLayer::quote_smart($name).'",
						 "'.dbLayer::quote_smart($surname).'",
						 "'.dbLayer::quote_smart($dvArea).'",
						 "'.dbLayer::quote_smart($isActive).'",
						 "'.dbLayer::quote_smart($region).'",
                         "'.dbLayer::quote_smart($position).'",
                         "'.dbLayer::quote_smart($edArea).'",
                         "'.dbLayer::quote_smart($section).'")';

		}
		else
		{
			$sql = 'update `KL_SASKANOTAJI` set
						`SLTT_VARDS`="'.dbLayer::quote_smart($name).'",
						`SLTT_UZVARDS`="'.dbLayer::quote_smart($surname).'",
						`SLTT_KEDI_ID`="'.dbLayer::quote_smart($dvArea).'",
						`SLTT_IR_AKTIVS`="'.dbLayer::quote_smart($isActive).'",
						`SLTT_REGIONS`="'.dbLayer::quote_smart($region).'",
                        `SLTT_POSITION`="'.dbLayer::quote_smart($position).'",
                        `SLTT_ED_IECIKNIS`="'.dbLayer::quote_smart($edArea).'",
                        `SLTT_KEDI_SECTION` = "'.dbLayer::quote_smart($section).'"
                        where SLTT_ID="'.dbLayer::quote_smart($userId).'"';

		}

		$res=$oSQL->makeQuery($sql);

		if ($res!==false)
		{
			return true;
		}

		return false;
	}


    // dabonam meistara vardu/uzvardu
    function GetMasterName($edRegionId, $position)
    {

       $sql = 'SELECT CONCAT(SLTT_VARDS,\' \',SLTT_UZVARDS) nosaukums FROM `KL_SASKANOTAJI` s
       INNER JOIN `KL_ED_IECIRKNI` i ON ( i.KEDI_ID = s.SLTT_KEDI_ID)
       WHERE i.KEDI_ID = "'.dbLayer::quote_smart($edRegionId).'"
       AND s.SLTT_KEDI_ID IS NOT NULL AND s.SLTT_IR_AKTIVS = 1 
       AND s.SLTT_POSITION = "'.dbLayer::quote_smart($position).'"  ';

       	$oSQL=new dbLayer();
        $result = $oSQL -> makeQuery($sql);
		if (isset($result[0]))
		{
			return $result[0]['nosaukums'];
		}
		return '';
    }

