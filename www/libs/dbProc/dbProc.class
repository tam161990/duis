                            `KMSD_IZPILDITAJA_KODS` = "'.dbLayer::quote_smart($data[7]).'",
                            `KMSD_VV_NUMURS` = "'.dbLayer::quote_smart($data[8]).'",
                            `KMSD_KEDI_KODS` = "'.dbLayer::quote_smart($data[9]).'",
                            `KMSD_PRIORITATE` = "'.dbLayer::quote_smart($data[10]).'",
                            `KMSD_IR_EPLA` = "'.dbLayer::quote_smart($data[11]).'",
                            `KMSD_TO_ID` = "'.dbLayer::quote_smart($data[12]).'",
                            `KMSD_TEH_OBJEKTS` = "'.dbLayer::quote_smart($data[13]).'",
                            `KMSD_TIKLA_ELEMENTS` = "'.dbLayer::quote_smart($data[14]).'",
                            `KMSD_TIKLA_ELEMENTA_KLASE` = "'.dbLayer::quote_smart($data[15]).'",
                            `KMSD_DAUDZUMS` = "'.dbLayer::quote_smart($data[16]).'",
                            `KMSD_VADU_SKAITS` = "'.dbLayer::quote_smart($data[17]).'",
