//                '.(($sourceOfFounds !='')?',`sourceOfFounds`="'.dbLayer::quote_smart($sourceOfFounds).'"':'').'
//                '.(($voltage !='')?',`voltage`="'.dbLayer::quote_smart($voltage).'"':'').'
