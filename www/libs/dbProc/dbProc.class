    function checkAllInputFields($actId) {
        $query = "SELECT SUM(cnt_darbi + cnt_meriali) as cnt FROM (
                SELECT COUNT(*) as cnt_darbi, 0 as cnt_meriali
                FROM `darbi`
                WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($actId)."
                AND (DRBI_DAUDZUMS IS NULL OR DRBI_DAUDZUMS ='NULL')
                UNION
                SELECT 0 as cnt_darbi, COUNT(*) as cnt_meriali
                FROM `materiali`
                WHERE `MATR_RAKT_ID` = ".dbLayer::quote_smart($actId)."
                AND (MATR_DAUDZUMS IS NULL OR MATR_DAUDZUMS ='NULL')
                ) x";
        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        return (($result[0]['cnt'] == 0 ) ? true : false);
    }       
        
}

?>