		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// INSERT
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function insertMessage($string)
	{
        $oDB = new dbLayer;
        $part = explode("|", $string);
        $query = "DELETE FROM  `FMK_MESSAGES` WHERE code = '". dbLayer::quote_smart($part[0])."'";
        $result = $oDB -> makeQuery($query);

        $query = "INSERT INTO `FMK_MESSAGES` (`code`, `text`)
            VALUES ('".dbLayer::quote_smart($part[0])."', '".dbLayer::quote_smart($part[1])."')";
        $result = $oDB -> makeQuery($query);
        echo ($result !== false) ? "insert  OK" : "insert  NOT OK"  ;

        return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// CONTRACT
    // Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------

    function getDuContractNo($workerCode, $isTrase = -1, $isOnlyActive = false)
	{
       //   echo $workerCode; echo $isTrase;
		$oSQL=new dbLayer();
		$sql = 'select DISTINCT * from `KL_CONTRACT`
                where  `KCNT_KWOI_KODS` ="'.dbLayer::quote_smart($workerCode).'"
                '.(($isTrase == -1)? '' : ' AND `KCNT_IR_TRASE` = ' . dbLayer::quote_smart($isTrase)).'
                '.(($isOnlyActive)? ' AND `KCNT_IR_AKTIVS` = 1 ' : ' ').'';
       // echo $sql;
		return $oSQL -> makeQuery($sql);
	}

    function getAllContractNo($isTrase = -1, $isOnlyActive = false)
	{
       //   echo $workerCode; echo $isTrase;
		$oSQL=new dbLayer();
		$sql = 'select * from `KL_CONTRACT`
                where 1=1
                '.(($isTrase == -1)? '' : ' AND `KCNT_IR_TRASE` = ' . dbLayer::quote_smart($isTrase)).'
                '.(($isOnlyActive)? ' AND `KCNT_IR_AKTIVS` = 1 ' : ' ').'';
       // echo $sql;
		return $oSQL -> makeQuery($sql);
	}

    function isEqualContract($contractNo, $section, $isTrase)
	{
		$oSQL=new dbLayer();
		$sql = 'select COUNT(*) as CONTRACT from `KL_CONTRACT`
                where  `KCNT_VV_NUMBER` ="'.dbLayer::quote_smart($contractNo).'"
                AND `KCNT_SECTION` ="'.dbLayer::quote_smart($section).'"
                AND  `KCNT_IR_TRASE` = '.dbLayer::quote_smart($isTrase);
        $res = $oSQL->makeQuery($sql);
		if (isset($res[0]['CONTRACT']))
		{
			return (($res[0]['CONTRACT'] == 0 )? false : true);
		}
		return false;


	}

    function saveContractNo($workerCode, $oTrase, $oContractNo, $section, $id, $isActive)
	{
        $query = '';
		if ($id)
		{
			$query = 'update `KL_CONTRACT`
				set `KCNT_KWOI_KODS` = "'.dbLayer::quote_smart($workerCode).'",
                    `KCNT_VV_NUMBER` = "'.dbLayer::quote_smart($oContractNo).'",
                    `KCNT_SECTION` = "'.dbLayer::quote_smart($section).'",
                    `KCNT_IR_TRASE` = "'.dbLayer::quote_smart($oTrase).'",
                    `KCNT_IR_AKTIVS` = "'.dbLayer::quote_smart($isActive).'"
				where `KCNT_ID` = "'.dbLayer::quote_smart($id).'"';

		}
		elseif ($oContractNo)
		{
			$query = 'insert into  `KL_CONTRACT`
                (`KCNT_KWOI_KODS`, `KCNT_VV_NUMBER`, `KCNT_SECTION`, `KCNT_IR_TRASE`, `KCNT_IR_AKTIVS`)
			values
                (
                "'.dbLayer::quote_smart($workerCode).'",
                "'.dbLayer::quote_smart($oContractNo).'",
                "'.dbLayer::quote_smart($section).'",
                "'.dbLayer::quote_smart($oTrase).'",
                "'.dbLayer::quote_smart($isActive).'")';
		}

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    function deleteContractNo($id)
	{
		$oSQL=new dbLayer();
		return $oSQL->makeQuery('delete from `KL_CONTRACT` where KCNT_ID="'.dbLayer::quote_smart($id).'"');
	}

    function isContractRelations($id)
	{
        $sql = 'SELECT `KCNT_VV_NUMBER` as CNT_NUMBER
            from `KL_CONTRACT` where KCNT_ID="'.dbLayer::quote_smart($id).'"';

        $oSQL=new dbLayer();
        $res = $oSQL->makeQuery($sql);

		if (isset($res[0]['CNT_NUMBER']))
		{
			$CNT_NUMBER = $res[0]['CNT_NUMBER'];

            $sql = "select SUM(cont) as CONTRACT_COUNT from
                (
                 SELECT COUNT(*) as cont  FROM `KL_KALKULACIJA`
                 WHERE `KKAL_VV_NUMBER` = '" . $CNT_NUMBER ."'
                 UNION ALL
                 SELECT COUNT(*) as cont FROM `KL_KALKULACIJA_TRASE`
                 WHERE `KKAL_VV_NUMBER` = '" . $CNT_NUMBER ."'
                 UNION ALL
                 SELECT COUNT(*) as cont  FROM `AKTI`
                 WHERE `RAKT_VV_NUMBER` = '" . $CNT_NUMBER ."'
                 UNION ALL
                 SELECT COUNT(*) as cont  FROM `KL_MMS_DARBI`
                 WHERE `KMSD_VV_NUMBER` = '" . $CNT_NUMBER ."'
                 ) a ";
              $oSQL=new dbLayer();
              $res = $oSQL->makeQuery($sql);
        	  if (isset($res[0]['CONTRACT_COUNT']))
        	  {
        			return (($res[0]['CONTRACT_COUNT'] == 0 )? false : true);
        	  }
		}

		return false;


	}

    function getContractNoStr($workerCode, $oTrase)
    {
            $contractArray = dbProc::getDuContractNo($workerCode, $oTrase, true) ;
            $contractStr = '';

            if (is_array($contractArray) && count($contractArray)>0)
            {
                foreach ($contractArray as $row)
            	{
            		$contractStr .= $row['KCNT_SECTION'].': '.$row['KCNT_VV_NUMBER'] . '<br>';
            	}
            }
            return $contractStr;
    }

