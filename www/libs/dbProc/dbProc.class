    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cijas ierakstus konkr�ta kalkul�cija grupp�,
    // kurie nav piesaist�ti akta darbam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getFreeCalculationList($calcGroup, $actId, $trase = 0, $searchText = '')
	{
    	  $query = 'select e.KEDI_KODS as `SEC`, av.KAKV_IR_PLANS as `PLAN`, a.RAKT_KAKV_ID  as `TYPE` ,
          RAKT_KWOI_KODS as `WORKER`, RAKT_VV_NUMBER as `CONTRACT`
          FROM `AKTI` a
          LEFT JOIN `KL_AKTA_VEIDS` av ON (a.RAKT_KAKV_ID = av.KAKV_ID)
          LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
          WHERE a.RAKT_ID = ' . $actId;


        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        $section = $result[0]['SEC'];
        $plan = $result[0]['PLAN'];
        $stihija = (($result[0]['TYPE'] == ACT_TYPE_STIHIJA_ID || $result[0]['TYPE'] == ACT_TYPE_STIHIJA_TR_ID  ) ? true : false);
        $defect = (($result[0]['TYPE'] == ACT_TYPE_DEFECT_ID || $result[0]['TYPE'] == ACT_TYPE_DEFECT_TR_ID  ) ? true : false);

        $worker = $result[0]['WORKER'];
        $contract = $result[0]['CONTRACT'];
        if($plan == 1)
        {

            $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, 
            `KKAL_PLANA` as `KKAL_NORMATIVS`,  `KKAL_NEPLANA` AS `KKAL_NORMATIVS_NP` from `KL_KALKULACIJA`
            where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
            and `KKAL_KWOI_KODS` =  "'.$worker.'"
            and `KKAL_VV_NUMBER` =  "'.$contract.'"
            and `KKAL_KEDI_KODS` =  "'.$section.'"
            and  `KKAL_PLANA` IS NOT NULL
            and KKAL_TRASE = '.$trase.' 
            and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .'             
            order by `KKAL_SHIFRS` asc';

        }
        else
        {
          if($stihija)
          {
            if($trase==1)
            {
                 $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, 
                 `KKAL_NEPLANA` as `KKAL_NORMATIVS` 
                 from `KL_KALKULACIJA`
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_KODS` =  "'.$section.'"
              and  `KKAL_NEPLANA` IS NOT NULL
              and `KKAL_TRASE`  = '.$trase.'
              and `KKAL_IR_AKTIVS` = 1
              AND  KKAL_IS_ELEMENT = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }
            else
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`,

                 IFNULL(
                 (SELECT MAX(kk.KKAL_NEPLANA) 
                 FROM `KL_KALKULACIJA` kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 and kk.KKAL_KEDI_KODS =  "'.$section.'"
                  AND  kk.KKAL_IS_ELEMENT = 1
                  and kk.KKAL_TRASE  = '.$trase.'
                 ),
                 (SELECT MAX(kk.KKAL_NEPLANA) 
                 FROM `KL_KALKULACIJA` kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 AND  kk.KKAL_IS_ELEMENT = 1
                 and kk.KKAL_TRASE  = '.$trase.'
                 ) )  as `KKAL_NORMATIVS`

            from `KL_KALKULACIJA`  k
            where k.KKAL_GRUPAS_KODS = "'.dbLayer::quote_smart($calcGroup).'"
            and k.KKAL_KWOI_KODS = "'.$worker.'"
            and k.KKAL_VV_NUMBER =  "'.$contract.'"
            and k.KKAL_NEPLANA IS NOT NULL
            and k.KKAL_IR_AKTIVS = 1
            and k.KKAL_TRASE = '.$trase.'
            AND  k.KKAL_IS_ELEMENT = 1  ' . (($searchText == '')? '' : ' AND k.KKAL_NOSAUKUMS LIKE "%'.$searchText.'%"') .' 
            GROUP BY `KKAL_SHIFRS`            
            order by `KKAL_SHIFRS` asc';           // and k.KKAL_KEDI_KODS =  "'.$section.'"
           }
          }
          else
          {
            if($defect)
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NEPLANA` as `KKAL_NORMATIVS`
                from `KL_KALKULACIJA`
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_KODS` =  "'.$section.'"
              and  `KKAL_NEPLANA` IS NOT NULL
              and KKAL_TRASE = '.$trase.'
              and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }
            else     // defects
            {
                  $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NEPLANA` as `KKAL_NORMATIVS` 
                  from `KL_KALKULACIJA`
              where `KKAL_GRUPAS_KODS` = "'.dbLayer::quote_smart($calcGroup).'"
              and `KKAL_KWOI_KODS` =  "'.$worker.'"
              and `KKAL_VV_NUMBER` =  "'.$contract.'"
              and `KKAL_KEDI_KODS` =  "'.$section.'"
              and  `KKAL_NEPLANA` IS NOT NULL
              and KKAL_TRASE = '.$trase.'
              and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
              order by `KKAL_SHIFRS` asc';
            }

          }

        }
        // echo $query;

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    // -----------------------------------------------------------------------------
	// Atgriezh kalkulācijas ierakstus no akta tames,
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getEstimatedCalculation($actId, $searchText = '')
	{

            $oDB = new dbLayer;
            
            $query = 'select `DRBI_KKAL_ID` as `KKAL_ID`,`DRBI_KKAL_SHIFRS` as `KKAL_SHIFRS`, 
            `DRBI_KKAL_NOSAUKUMS` as `KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS` as `KKAL_NORMATIVS`
            from `tame_darbi`
            where `DRBI_RAKT_ID` = "'.dbLayer::quote_smart($actId).'"
            ' . (($searchText == '')? '' : ' AND `DRBI_KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .'             
            order by `DRBI_KKAL_SHIFRS` asc';

            
	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }

    // -----------------------------------------------------------------------------
	// Atgriezh kalkul�cijas ierakstus konkr�ta kalkul�cija grupp�,
    // kurie nav piesaist�ti akta darbam.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getAllCalculationList( $actId, $trase = 0, $searchText = '')
	{
    	  $query = 'select e.KEDI_KODS as `SEC`, av.KAKV_IR_PLANS as `PLAN`, a.RAKT_KAKV_ID  as `TYPE` ,
          RAKT_KWOI_KODS as `WORKER`, RAKT_VV_NUMBER as `CONTRACT`
          FROM `AKTI` a
          LEFT JOIN `KL_AKTA_VEIDS` av ON (a.RAKT_KAKV_ID = av.KAKV_ID)
          LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
          WHERE a.RAKT_ID = ' . $actId;


        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        $section = $result[0]['SEC'];
        $plan = $result[0]['PLAN'];
        $stihija = (($result[0]['TYPE'] == ACT_TYPE_STIHIJA_ID || $result[0]['TYPE'] == ACT_TYPE_STIHIJA_TR_ID  ) ? true : false);
        $defect = (($result[0]['TYPE'] == ACT_TYPE_DEFECT_ID || $result[0]['TYPE'] == ACT_TYPE_DEFECT_TR_ID  ) ? true : false);
        $worker = $result[0]['WORKER'];
        $contract = $result[0]['CONTRACT'];


        if($plan == 1)
        {

            $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_PLANA` as `KKAL_NORMATIVS` 
            from `KL_KALKULACIJA`
            where `KKAL_KWOI_KODS` = "'.$worker.'"
            and `KKAL_VV_NUMBER` =  "'.$contract.'"
            and `KKAL_KEDI_KODS` =  "'.$section.'"
            and  `KKAL_PLANA` IS NOT NULL 
            and KKAL_TRASE = '.$trase.'
            and `KKAL_IR_AKTIVS` = 1  ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                        order by `KKAL_SHIFRS` asc';

            
        }
        else
        {
          if($stihija)
          {
            if($trase == 1)
            {
              $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NEPLANA` as `KKAL_NORMATIVS` 
                from `KL_KALKULACIJA`
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_KODS` =  "'.$section.'"
                and  `KKAL_NEPLANA` IS NOT NULL
                and `KKAL_IR_AKTIVS` = 1
                and KKAL_TRASE = '.$trase.'
                AND  KKAL_IS_ELEMENT = 1   ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }
            else
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`,
                 IFNULL(
                 (SELECT MAX(kk.KKAL_NEPLANA) 
                 FROM `KL_KALKULACIJA` kk
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                 and kk.KKAL_KEDI_KODS =  "'.$section.'"
                  AND  kk.KKAL_IS_ELEMENT = 1
                  and kk.KKAL_TRASE  = '.$trase.'
                 ),
                 (SELECT MAX(kk.KKAL_NEPLANA) 
                 FROM `KL_KALKULACIJA`
                 WHERE kk.KKAL_GRUPAS_KODS =  k.KKAL_GRUPAS_KODS
                 AND kk.KKAL_SHIFRS = k.KKAL_SHIFRS
                 AND kk.KKAL_FIZ_RADIJUMS =  k.KKAL_FIZ_RADIJUMS
                 AND kk.KKAL_NOSAUKUMS =  k.KKAL_NOSAUKUMS
                 AND kk.KKAL_KWOI_KODS = "'.$worker.'"
                 and kk.KKAL_VV_NUMBER =  "'.$contract.'"
                  AND  kk.KKAL_IS_ELEMENT = 1 
                  and kk.KKAL_TRASE  = '.$trase.'
                 ) )  as `KKAL_NORMATIVS`

                 from `KL_KALKULACIJA` k
            where k.KKAL_KWOI_KODS = "'.$worker.'"
            and k.KKAL_VV_NUMBER =  "'.$contract.'"
            and  k.KKAL_NEPLANA IS NOT NULL
            and k.KKAL_IR_AKTIVS = 1
            and k.KKAL_TRASE  = '.$trase.'
            AND  k.KKAL_IS_ELEMENT = 1 ' . (($searchText == '')? '' : ' AND k.KKAL_NOSAUKUMS LIKE "%'.$searchText.'%"') .' 
            GROUP BY `KKAL_SHIFRS`
            order by `KKAL_SHIFRS` asc';    // and k.KKAL_KEDI_KODS =  "'.$section.'"
           }
          }
          else
          {
            if($defect)
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NEPLANA` as `KKAL_NORMATIVS` 
                from `KL_KALKULACIJA`
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_KODS` =  "'.$section.'"
                and  `KKAL_NEPLANA` IS NOT NULL
                and KKAL_TRASE  = '.$trase.'
                and `KKAL_IR_AKTIVS` = 1 ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }
            else    // bojajums
            {
                $query = 'select `KKAL_ID`,`KKAL_SHIFRS`, `KKAL_NOSAUKUMS`, `KKAL_NEPLANA` as `KKAL_NORMATIVS` 
                from `KL_KALKULACIJA`
                where `KKAL_KWOI_KODS` = "'.$worker.'"
                and `KKAL_VV_NUMBER` =  "'.$contract.'"
                and `KKAL_KEDI_KODS` =  "'.$section.'"
                and  `KKAL_NEPLANA` IS NOT NULL
                and KKAL_TRASE  = '.$trase.'
                and `KKAL_IR_AKTIVS` = 1 ' . (($searchText == '')? '' : ' AND `KKAL_NOSAUKUMS` LIKE "%'.$searchText.'%"') .' 
                order by `KKAL_SHIFRS` asc';
            }

          }

        }

        //echo $query;

	   	$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
        // -----------------------------------------------------------------------------
	// Saglabaa akta materi�la ierakstu.
    // V�rtibas tiek nemtas no kl_materiali tabula p�c materi�la koda
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    function saveActWorkFreeRecord($actId, $ID, $amount = false, $price = false, $tame = false, 
                                    $st = 0, 
                                    $title = '', 
                                    $mervieniba = '',
                                    $work_type = false,
                                    $work_type_text = false)
	{
        $table_name = ($tame) ? '`TAME_DARBI`' : '`DARBI`';

        if($ID === false)
        {
            $query = 'insert into '.$table_name.'
                (`DRBI_RAKT_ID`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_MERVIENIBA`,
                '.(($price !== false)? '`DRBI_KKAL_NORMATIVS`,': '').'                 
                `DRBI_DAUDZUMS`, 
                `DRBI_IS_WORKER`'.(($tame)? ', `DRBI_DAUDZUMS_KOR` ' : '' ).
                (($work_type!== false)? ', `DRBI_WORK_TYPE_ID` ' : '' ).
                (($work_type!== false)? ', `DRBI_WORK_TYPE_TEXT` ' : '' ).
                ')                
                values ('.dbLayer::quote_smart($actId).',
                    "'.dbLayer::quote_smart($title).'",
                    "'.dbLayer::quote_smart($mervieniba).'",
                    '.(($price !== false)? dbLayer::quote_smart($price).',': '').'  
                    '.dbLayer::quote_smart($amount).',
                    '.dbLayer::quote_smart($st).'
                    '.(($tame)? ','.dbLayer::quote_smart($amount) : '' ).
                    (($work_type!== false)? ','.dbLayer::quote_smart($work_type) : '"NULL"' ).
                    (($work_type!== false)? ',"'.dbLayer::quote_smart($work_type_text).'"' : '"NULL"' ).
                    ' )' ;

        }
       //echo $query;
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
	}

    // -----------------------------------------------------------------------------
	// Saglabaa akta darda ierakstu.
    // V�rtibas tiek nemtas no kalkul�cijas tabula p�c kalkul�cijas �ifra
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    
    function saveActWorkRecord($actId, $ID, $trase = 0, $tame = false, $plan_date = false)
	{
        $query = 'select e.KEDI_SECTION as `SEC`, av.KAKV_IR_PLANS as `PLAN`, a.RAKT_KAKV_ID  as `TYPE` ,
          RAKT_KWOI_KODS as `WORKER`, RAKT_VV_NUMBER as `CONTRACT`
          FROM `AKTI` a
          LEFT JOIN `KL_AKTA_VEIDS` av ON (a.RAKT_KAKV_ID = av.KAKV_ID)
          LEFT JOIN `KL_ED_IECIRKNI` e ON (a.RAKT_KEDI_ID = e.KEDI_ID)
          WHERE a.RAKT_ID = ' . $actId;

        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);

        $table_name = ($tame) ? '`TAME_DARBI`' : '`DARBI`';         

        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
		$section = $result[0]['SEC'];
        $plan = $result[0]['PLAN'];
        $stihija = (($result[0]['TYPE'] == ACT_TYPE_STIHIJA_ID  ) ? true : false);
        $defect = (($result[0]['TYPE'] == ACT_TYPE_DEFECT_ID  ) ? true : false);
        $worker = $result[0]['WORKER'];
        $contract = $result[0]['CONTRACT'];

         if($plan == 1)
         {
            $query = 'insert into '.$table_name.'
                (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`, 
                `DRBI_MERVIENIBA`, DRBI_PLAN_DATE)
			    select '.dbLayer::quote_smart($actId).',
                `KKAL_ID`, `KKAL_SHIFRS`,`KKAL_NOSAUKUMS`,
                `KKAL_PLANA`, `KKAL_MERVIENIBA`, 
                '.(($plan_date == false) ? ' now() ' : '"'.dbLayer::parseDate($plan_date).'"').'
                from `KL_KALKULACIJA`
                where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'" AND `KKAL_TRASE` = '. $trase;
         }
         else
         {
           if($stihija)
          {
             
                $query = 'insert into '.$table_name.'
                (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`,
                 `DRBI_MERVIENIBA`, DRBI_PLAN_DATE)
			    select '.dbLayer::quote_smart($actId).',
                `KKAL_ID`,`KKAL_SHIFRS`,`KKAL_NOSAUKUMS`,
                `KKAL_NEPLANA`, `KKAL_MERVIENIBA`,
                '.(($plan_date == false) ? ' now() ' : '"'.dbLayer::parseDate($plan_date).'"').'
                from `KL_KALKULACIJA`
                where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'" AND `KKAL_TRASE` = '. $trase;

          }
          else
          {
            if($defect)
            {
                  $query = 'insert into '.$table_name.'
                (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`, 
                `DRBI_MERVIENIBA`, DRBI_PLAN_DATE)
			select '.dbLayer::quote_smart($actId).',
                `KKAL_ID`,`KKAL_SHIFRS`,`KKAL_NOSAUKUMS`,
                `KKAL_NEPLANA`, `KKAL_MERVIENIBA`, 
                '.(($plan_date == false) ? ' now() ' : '"'.dbLayer::parseDate($plan_date).'"').'
                 from `KL_KALKULACIJA`
                 where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'" AND `KKAL_TRASE` = '. $trase;
            } // bojajums
            else
            {
                 $query = 'insert into '.$table_name.'
                (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`, 
                `DRBI_MERVIENIBA`, DRBI_PLAN_DATE)
			select '.dbLayer::quote_smart($actId).',
                `KKAL_ID`,`KKAL_SHIFRS`,`KKAL_NOSAUKUMS`,
                `KKAL_NEPLANA`, `KKAL_MERVIENIBA`,
                '.(($plan_date == false) ? ' now() ' : '"'.dbLayer::parseDate($plan_date).'"').'
                 from `KL_KALKULACIJA`
                    where `KKAL_ID` = "'.dbLayer::quote_smart($ID).'" AND `KKAL_TRASE` = '. $trase;
            }

          }
        }

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
    }
    
    // -----------------------------------------------------------------------------
	// Saglabaa akta darda ierakstu.
    // V�rtibas tiek nemtas no kalkul�cijas tabula p�c kalkul�cijas �ifra
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
    
    function saveProjectWorkRecord($actId, $ID, $work_type, $work_type_text)
	{
        $query = 'insert into `DARBI`
        (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`, 
        `DRBI_MERVIENIBA`, DRBI_PLAN_DATE, `DRBI_WORK_TYPE_ID`, `DRBI_WORK_TYPE_TEXT`)
        select '.dbLayer::quote_smart($actId).',
        `KKAL_ID`, `KKAL_SHIFRS`,`KKAL_NOSAUKUMS`,
        `KKAL_PLANA`, `KKAL_MERVIENIBA`, 
         now(), '.dbLayer::quote_smart($work_type).', "'.dbLayer::quote_smart($work_type_text).'"
        from `KL_KALKULACIJA`
        where `KKAL_ID` = '.dbLayer::quote_smart($ID).' ';

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return ($result !== false);
    }

    function isProjectWorkRecord($actId, $ID, $work_type, $work_type_text)
	{
        $query = 'SELECT COUNT(*) as cnt FROM `DARBI`
        WHERE `DRBI_RAKT_ID` = '.dbLayer::quote_smart($actId).'
        AND `DRBI_KKAL_ID` = '.dbLayer::quote_smart($ID).'
        AND  `DRBI_WORK_TYPE_ID` = '.dbLayer::quote_smart($work_type).'
        AND `DRBI_WORK_TYPE_TEXT` = "'.dbLayer::quote_smart($work_type_text).'" ';

		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);

		return (isset($result[0]['cnt']) && $result[0]['cnt'] > 0) ? true : false;
    }
    
    function getDefaultWork($actId) {
        $query = 'select CONCAT(DRBI_WORK_TYPE_ID, \'^\', NVL(DRBI_WORK_TYPE_TEXT, \'\')) AS DRBI_WORK_TYPE
            from `DARBI` 
            where `DRBI_RAKT_ID` = '.dbLayer::quote_smart($actId).'
            order by `DRBI_ID` desc
            limit 1';
        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);
        return isset($result[0]['DRBI_WORK_TYPE']) ? $result[0]['DRBI_WORK_TYPE'] : '';
    }

    
    // -----------------------------------------------------------------------------
	// Saglabaa akta darda ierakstu.
    // V�rtibas tiek nemtas no kalkul�cijas tabula p�c kalkul�cijas �ifra
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function writeActWork($actId, $kid, $chipher, $title, $standart = false, $amount, 
                            $total = false, $measure, $amount_kor = false, $edited = false, 
                            $plan_date = false, $day_total = false, $notes = false,
                            $st = 0, $work_type = false, 
                            $work_type_text = false, $export_type = false, $work_approve_date = false,
                            $import_no = false)
	{
        $amount = (empty($amount)) ? false : $amount;
	    if($amount_kor !== false) {
	   	    $query = 'insert into `TAME_DARBI`
                (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, `DRBI_KKAL_NORMATIVS`,
                `DRBI_DAUDZUMS`, `DRBI_DAUDZUMS_KOR`, `DRBI_CILVEKSTUNDAS`, `DRBI_MERVIENIBA`,
                `DRBI_APPROVE_DATE`, `DRBI_WORK_APROVE_DATE`,
                `DRBI_PLAN_DATE`, `DRBI_DAY_TOTAL`, `DRBI_PIEZIMES`, `DRBI_IS_WORKER`, 
                `DRBI_WORK_TYPE_ID`, `DRBI_WORK_TYPE_TEXT`, `DRBI_PROJECT_EXPORT`,
                `DRBI_IMPORT_NO` )
                values ( '.dbLayer::quote_smart($actId).',
				"'.dbLayer::quote_smart($kid).'",
                "'.dbLayer::quote_smart($chipher).'",
                "'.dbLayer::quote_smart($title).'",
                "'.dbLayer::quote_smart($standart).'",
                "'.dbLayer::quote_smart($amount).'",
                "'.dbLayer::quote_smart($amount_kor).'",
                "'.dbLayer::quote_smart($total).'",
                "'.dbLayer::quote_smart($measure).'",
                '.((!$edited) ? '"NULL",' : '"'.dbLayer::parseDate($edited).'",').'
				'.((!$work_approve_date) ? '"NULL",' : '"'.dbLayer::parseDate($work_approve_date).'",').'
                "'.DEFAULT_DATE.'",
                "'.dbLayer::quote_smart($day_total).'",
                '.((!$notes ) ? '"NULL"' : '"'.dbLayer::quote_smart($notes ).'"').',
                '.dbLayer::quote_smart($st).',
                '.(($work_type !== false) ? dbLayer::quote_smart($work_type) : '"NULL"').',
                '.(($work_type !== false) ? '"'.dbLayer::quote_smart($work_type_text).'"' : '"NULL"').',
                '.(($export_type !== false) ? '"'.dbLayer::quote_smart($export_type).'"' : '"NULL"').',
                '.(($import_no !== false) ? dbLayer::quote_smart($import_no) : '"NULL"').'
                )';
        } else {
            $query = 'insert into `DARBI`
                            (`DRBI_RAKT_ID`, `DRBI_KKAL_ID`, `DRBI_KKAL_SHIFRS`, `DRBI_KKAL_NOSAUKUMS`, 
                            `DRBI_KKAL_NORMATIVS`, `DRBI_DAUDZUMS`, `DRBI_CILVEKSTUNDAS`, `DRBI_MERVIENIBA`,
                            `DRBI_APPROVE_DATE`, `DRBI_WORK_APROVE_DATE`,
                            `DRBI_PLAN_DATE`, `DRBI_DAY_TOTAL`, `DRBI_PIEZIMES`, `DRBI_IS_WORKER`, 
                            `DRBI_WORK_TYPE_ID`, `DRBI_WORK_TYPE_TEXT`, `DRBI_PROJECT_EXPORT`,
                            `DRBI_IMPORT_NO`)
                            values ( '.dbLayer::quote_smart($actId).',
            				"'.dbLayer::quote_smart($kid).'",
                            "'.dbLayer::quote_smart($chipher).'",
                            "'.dbLayer::quote_smart($title).'",
                            '.((!$standart) ? '"NULL",' : '"'.dbLayer::quote_smart($standart).'",').'
                            '.((!$amount) ? '"NULL",' : '"'.dbLayer::quote_smart($amount).'",').'
							'.((!$total) ? '"NULL",' : '"'.dbLayer::quote_smart($total).'",').'
                            "'.dbLayer::quote_smart($measure).'",
                            '.((!$edited) ? '"NULL",' : '"'.dbLayer::parseDate($edited).'",').'
							'.((!$work_approve_date) ? '"NULL",' : '"'.dbLayer::parseDate($work_approve_date).'",').'
							'.((!$plan_date) ? '"'.DEFAULT_DATE.'",' : '"'.dbLayer::parseDate($plan_date).'",').'
							'.((!$day_total) ? '"NULL"' : '"'.dbLayer::quote_smart($day_total).'"').',
                            '.((!$notes ) ? '"NULL"' : '"'.dbLayer::quote_smart($notes ).'"').',
                            '.dbLayer::quote_smart($st).',
                            '.(($work_type !== false ) ? dbLayer::quote_smart($work_type ) : '"NULL"').',
                            '.(($work_type !== false) ? '"'.dbLayer::quote_smart($work_type_text).'"' : '"NULL"').',
                            '.(($export_type !== false) ? '"'.dbLayer::quote_smart($export_type).'"' : '"NULL"').',
                            '.(($import_no !== false) ? dbLayer::quote_smart($import_no) : '"NULL"').'
                            )';
        }
        //echo ($query);
		$oDB = new dbLayer;
		$result = $oDB -> makeQuery($query);
        return ($result !== false);
    }
    
    function updateWorkSumms($actId, $tame = false){

        $table_name = ($tame) ? '`TAME_DARBI`' : '`DARBI`';

        $query = "SELECT SUM(DRBI_CILVEKSTUNDAS) as CILVEKSTUNDAS, `DRBI_PLAN_DATE`
                    FROM ".$table_name." 
                    WHERE `DRBI_RAKT_ID` = " . dbLayer::quote_smart($actId) . "
                    GROUP BY `DRBI_PLAN_DATE`";

        $oDB = new dbLayer;
        $result = $oDB -> makeQuery($query);

        if ($result !== false)
        {
            foreach($result as $i => $row)
            {
                $query = 'UPDATE ' . $table_name .' SET `DRBI_DAY_TOTAL` = '.$row['CILVEKSTUNDAS'].'
                        WHERE `DRBI_RAKT_ID` = ' . dbLayer::quote_smart($actId) . '
                        AND  `DRBI_PLAN_DATE` = "' . $row['DRBI_PLAN_DATE']. '"';
                
                $result = $oDB -> makeQuery($query);
            }
        }

    }

    // -----------------------------------------------------------------------------
	// Atgriezh akta cilvekstundas kop�jo summu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActTotalWorkTime($ID)
	{

        $query = "select SUM(DRBI_CILVEKSTUNDAS) as `cvs` ,
        ".dbLayer::sqlParseDate('DRBI_PLAN_DATE') ."
        from `DARBI`
        WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)."
        GROUP BY DRBI_PLAN_DATE";

        $oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
        foreach ($result as $row)
        {
        $cvs[$row['DRBI_PLAN_DATE']] = array('cvs' => $row['cvs']);          
        }
        return isset($cvs) ? $cvs : array('cvs' => 0);
	}

    function isTotalWorkTimeEqualPersonalTime($ID)
	{

		    $query = "select IFNULL((select SUM(DRBI_CILVEKSTUNDAS) from `DARBI`
                WHERE `DRBI_RAKT_ID` = ".dbLayer::quote_smart($ID)."), 0) =
                IFNULL((select SUM(PRSN_PAMATSTUNDAS)  from `PERSONALS`
                WHERE `PRSN_RAKT_ID` = ".dbLayer::quote_smart($ID)."), 0) a";

		$oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
		return isset($result[0]['a']) ? $result[0]['a'] : 1;
	}

    // -----------------------------------------------------------------------------
	// Atgriezh akta cilvekstundas kop�jo summu.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActPersonalProportion($ID)
	{

		    $query = "select SUM(PRSN_PROPORCIJA) as `proportion` from `PERSONALS`
                WHERE `PRSN_RAKT_ID` = ".dbLayer::quote_smart($ID)."";

		$oSQL = new dbLayer;
        $result = $oSQL -> makeQuery($query);
		return isset($result[0]['proportion']) ? $result[0]['proportion'] : 0;
	}

    // MATERIALI
    // -----------------------------------------------------------------------------
	// Atgriezh akta materialus. atgriezh visas p�c akta ID.
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	function getActMaterialList($ID, $tame = false, $project = false, $onlyNotApproved = false)
    {
        $table_name = ($tame) ? '`TAME_MATERIALI`' : '`MATERIALI`';
        $column_name = ($tame) ? '`MATR_DAUDZUMS_KOR`' : '`MATR_DAUDZUMS`';
        $group_name = ($project) ? ',`KLDV_NOSAUKUMS`' : '';

        $query = "select *,	REPLACE(FORMAT(`MATR_CENA_KOPA`, 2), ',', '')	AS MATR_CENA_KOPA  ". $group_name.",
                CONCAT(MATR_WORK_TYPE_ID, '^', REPLACE(MATR_WORK_TYPE_TEXT, '\"', '\'')) as MATR_WORK_TYPE,
                ".dbLayer::sqlParseDate('MATR_APPROVE_DATE') .", ".dbLayer::sqlParseDate('MATR_WORK_APROVE_DATE') ."
                from " . $table_name . "
                ".(($project) ? 'INNER JOIN `kl_darba_veidi` ON `KLDV_ID` = `MATR_WORK_TYPE_ID` ': '')."
                WHERE `MATR_RAKT_ID` = ".$ID."
                AND ".$column_name." IS NOT NULL
                " . (($onlyNotApproved) ? " AND `MATR_APPROVE_DATE` IS NULL " : "" ) ." 
                union
                select *, FORMAT(0, 2) AS `MATR_CENA_KOPA` ". $group_name.",
                CONCAT(MATR_WORK_TYPE_ID, '^', REPLACE(MATR_WORK_TYPE_TEXT, '\"', '\'')) as MATR_WORK_TYPE,
                ".dbLayer::sqlParseDate('MATR_APPROVE_DATE') .",".dbLayer::sqlParseDate('MATR_WORK_APROVE_DATE') ."
                from " . $table_name . "
                ".(($project) ? 'INNER JOIN `kl_darba_veidi` ON `KLDV_ID` = `MATR_WORK_TYPE_ID` ': '')."
                WHERE `MATR_RAKT_ID` = ".$ID."
                AND ".$column_name." IS NULL 
                " . (($onlyNotApproved) ? " AND `MATR_APPROVE_DATE` IS NULL " : "" ) ." 
                ORDER BY `MATR_IS_WORKER` DESC, MATR_ID";
        //echo $query;
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    function getActEstimateMaterialList($ID)
    {        

		$query = "select *,	REPLACE(FORMAT(`MATR_CENA_KOPA`, 2), ',', '')	AS MATR_CENA_KOPA
                from `TAME_MATERIALI`
                inner join `kl_materiali` ON KMAT_KODS = MATR_KODS
                WHERE `MATR_RAKT_ID` = ".$ID."
                AND `MATR_DAUDZUMS_KOR` IS NOT NULL                
                ORDER BY `MATR_IS_WORKER` DESC";
        
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }
    
    function getProjectMaterialList($ID, $group_id = false, $type_text = false)
    {        

        $query = "select *
                from `MATERIALI`                
                WHERE `MATR_RAKT_ID` = ".$ID."
                " . (($group_id !== false) ? " AND `MATR_WORK_TYPE_ID` = ".dbLayer::quote_smart($group_id) : "" ) ." 
                " . (($type_text !== false) ? ((empty($type_text) || $type_text == 'NULL') ? " AND `MATR_WORK_TYPE_TEXT` = 'X' " : " AND `MATR_WORK_TYPE_TEXT` = '".dbLayer::quote_smart($type_text)."'" ) : "" ) ."           
                ORDER BY `MATR_IS_WORKER` DESC, `MATR_KODS`";
        
		$oSQL = new dbLayer;
		return $oSQL -> makeQuery($query);
    }

