    function saveHarmonizedFromCsv($data, $user){


        $isActive = 1;
        $ed_id = '';
        $region = 'AA';
        $section = 'qqq';
        $pos = ' ';
        
        $oSQL=new dbLayer();

        if(strlen($data[0]) == 5)
        {
          $sql1 = 'select `KEDI_ID` as `KODS`, `KEDI_REGIONS`,`KEDI_SECTION` as `SECTION`
                   from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` = "'.dbLayer::quote_smart($data[0]).'"';
 
        }
        else if(strlen($data[0]) == 4)
        {
          $sql1 = 'select DISTINCT "" as `KODS`, `KEDI_REGIONS`,`KEDI_SECTION` as `SECTION`
                   from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` LIKE "'.dbLayer::quote_smart($data[0]).'%"';
 
        }
        else
        {
              $sql1 = 'select DISTINCT "" as `KODS`, `KEDI_REGIONS`,"'.text::get('OPERATING_PART').'" as `SECTION`
                   from `KL_ED_IECIRKNI` WHERE `KEDI_KODS` LIKE "'.dbLayer::quote_smart($data[0]).'%"';
        } 
         
         $result = $oSQL -> makeQuery($sql1);
         if (isset($result[0]))
         {
             $ed_id = $result[0]['KODS'];
             $region = $result[0]['KEDI_REGIONS'];
             $section = $result[0]['SECTION'];
         }

         // position
        $sql2 = 'select `KRFK_VERTIBA` from `KL_REF_KODI` WHERE `KRFK_NOSAUKUMS` = "POSITION" AND
        `KRFK_NOZIME` LIKE "'.dbLayer::quote_smart(trim($data[3])).'"';
        
        $result = $oSQL -> makeQuery($sql2);
        if (isset($result[0]))
        {
            $pos = $result[0]['KRFK_VERTIBA'];

        }

        $sql = 'INSERT into `KL_SASKANOTAJI`
                        (`SLTT_VARDS`,
                        `SLTT_UZVARDS`,
                        `SLTT_KEDI_ID`,
                        `SLTT_REGIONS`, 
                        `SLTT_POSITION`,
                        `SLTT_ED_IECIKNIS`, 
                        `SLTT_KEDI_SECTION`,
                        `SLTT_CREATOR` )
                SELECT
                        "'.dbLayer::quote_smart($data[1]).'",
						 "'.dbLayer::quote_smart($data[2]).'",
						 "'.dbLayer::quote_smart($ed_id).'",
						 "'.dbLayer::quote_smart($region).'",
                         "'.dbLayer::quote_smart($pos).'",
                         "'.dbLayer::quote_smart($data[4]).'",
                         "'.dbLayer::quote_smart($section).'",
                         "'.dbLayer::quote_smart($user).'" FROM DUAL
                         WHERE NOT EXISTS(SELECT 1 FROM `KL_SASKANOTAJI` 
                         WHERE `SLTT_VARDS` = "'.dbLayer::quote_smart($data[1]).'"
                         AND `SLTT_UZVARDS` = "'.dbLayer::quote_smart($data[2]).'") 
                LIMIT 1';

		$res=$oSQL->makeQuery($sql);
        if ($res!==false)
		{
			return true;
		}
		return false;
    }

    
