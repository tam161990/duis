<?
class toExcel {	

function projectTammeExcel($actId, $userId, $action){
    // get info about voltage
    $actInfo = dbProc::getActInfo($actId);
    if(count($actInfo)>0)
    {
        $act = $actInfo[0];
    }
    
    $start_date = date('d.m.Y');
    $cacheMethod = PHPExcel_CachedObjectStorageFactory:: cache_to_phpTemp;
    $cacheSettings = array( 'memoryCacheSize ' => '8MB');
    PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);

    // Create new PHPExcel object
    $objPHPExcel = new PHPExcel();
	
	$sheet = $objPHPExcel->getActiveSheet();
    $sheet->setTitle('DUIS-worksheet');

    $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_PORTRAIT);
    $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);

    $sheet->getDefaultColumnDimension()->setWidth(15);
    $sheet->getDefaultRowDimension()->setRowHeight(15);

    $sheet->setShowGridlines(true);
    $sheet->setTitle('DUIS-worksheet');

    $sheet->getDefaultStyle()->getFont()->setName('Arial');
    $sheet->getDefaultStyle()->getFont()->setSize(9);

    $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);

    $sheet->getColumnDimension('B')->setWidth(55);
    $currentRow = 1; 
    
    $res=dbProc::getWorkTypeListByWork($actId);
    if (is_array($res))
    {
        foreach ($res as $group)
        {
            $styleArray = array(
                    'font'    => array(
                                    'bold'      => true,
                                    'italic' => false ,
                                    'size' => 9
                                    ),
                                    'alignment' => array(
                                        'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                                    ),
                                    'fill' => array(
                                        'type' => PHPExcel_Style_Fill::FILL_SOLID,
                                        'startcolor' => array(
                                            'argb' => 'EEEEEE',
                                        ),                                        
                                    ), 
                                    'borders' => array(
                                        'allborders' => array(
                                            'style' => PHPExcel_Style_Border::BORDER_THIN,
                                            'color' => array('rgb' => 'CCCCCC')
                                        )
                                    )                               
                    ); 
            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, $group['KLDV_NOSAUKUMS'] .' '. $group['DRBI_WORK_TYPE_TEXT']); 
            $currentRow ++; 

            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, text::get('WORK_COAST')); 
            $currentRow ++; 

            $aWorkDb=dbProc::getActWorkList($actId, false, false, $group['KLDV_ID'], true, $group['DRBI_WORK_TYPE_TEXT']);
            $data = array();
            foreach ($aWorkDb as $i => $row)
            {
                $sheet->setCellValueExplicit('A'.$currentRow, $row['DRBI_KKAL_SHIFRS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['DRBI_KKAL_NOSAUKUMS']); 
                $sheet->setCellValue('D'.$currentRow, $row['DRBI_MERVIENIBA']);
                $sheet->setCellValueExplicit('E'.$currentRow, $row['DRBI_DAUDZUMS'],PHPExcel_Cell_DataType::TYPE_NUMERIC);
                $notes = (isset($row['DRBI_PIEZIMES']) && $row['DRBI_PIEZIMES'] != 'NULL') ? $row['DRBI_PIEZIMES'] : '';
                $sheet->setCellValue('F'.$currentRow, $notes);
                $currentRow ++; 
            }

            $styleArray = array(
                'font'    => array(
                                'bold'      => true,
                                'italic' => false ,
                                'size' => 9
                                ),
                                'alignment' => array(
                                    'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                                ),
                                'fill' => array(
                                    'type' => PHPExcel_Style_Fill::FILL_SOLID,
                                    'startcolor' => array(
                                        'argb' => 'EEEEEE',
                                    ),                                        
                                ),
                                'borders' => array(
                                    'allborders' => array(
                                        'style' => PHPExcel_Style_Border::BORDER_THIN,
                                        'color' => array('rgb' => 'CCCCCC')
                                    )
                                )                                
                ); 
            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, text::get('MATERIAL_COAST')); 
            $currentRow ++; 

            $aMaterialDb=dbProc::getProjectMaterialList($actId, $group['KLDV_ID'],$group['DRBI_WORK_TYPE_TEXT']);
            $data = array();
            foreach ($aMaterialDb as $i => $row)
            {
                $nosaukums = $row['MATR_NOSAUKUMS'];
                $nosaukums .= (empty($row['MATR_CROSSECTION'])) ? '' : ' ['.$row['MATR_CROSSECTION'].']';
                $nosaukums .= (empty($row['MATR_COMPLECTATION'])) ? '' : ' ['.$row['MATR_COMPLECTATION'].']';
                $sheet->setCellValueExplicit('A'.$currentRow, $row['MATR_KODS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $nosaukums); 
                $sheet->setCellValue('D'.$currentRow, $row['MATR_MERVIENIBA']);
                $sheet->setCellValueExplicit('E'.$currentRow, $row['MATR_DAUDZUMS'],PHPExcel_Cell_DataType::TYPE_NUMERIC);
                $notes = (isset($row['MATR_PIEZIMES']) && $row['MATR_PIEZIMES'] != 'NULL') ? $row['MATR_PIEZIMES'] : '';
                $sheet->setCellValue('F'.$currentRow, $notes);
                $currentRow ++; 
            }
        }
    }
    
    $filename = $act['RAKT_NUM_POSTFIX'].(($action == OP_ESTIMATE)? '_nepabeigts' : '').'.'.EXCEL_FILE_EXTENTION;
    $res=dbProc::replaceExcelFile( $filename, $userId, $actId, EXCEL_FILE_MIMETYPE);                
    
    if ($res)
    {
        $idFile=dbLayer::getInsertId();
    }
    else
    {
        return false;				
    }
                
    if ($idFile!==false)
    {
        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007'); 
        $objWriter->setOffice2003Compatibility(true);
        $objWriter->save(PROJECT_FILES_STORE_PATH."/".$idFile);  
        						
    }
    return $idFile;
}

function projectExportExcel($actId, $userId){
    // get info about voltage
    $actInfo = dbProc::getActInfo($actId);
    if(count($actInfo)>0)
    {
        $act = $actInfo[0];
    }
    
    $start_date = date('d.m.Y');
    $cacheMethod = PHPExcel_CachedObjectStorageFactory:: cache_to_phpTemp;
    $cacheSettings = array( 'memoryCacheSize ' => '8MB');
    PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);

    // Create new PHPExcel object
    $objPHPExcel = new PHPExcel();
	
	$sheet = $objPHPExcel->getActiveSheet();
    $sheet->setTitle('DUIS-worksheet');

    $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_PORTRAIT);
    $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);

    $sheet->getDefaultColumnDimension()->setWidth(15);
    $sheet->getDefaultRowDimension()->setRowHeight(15);

    $sheet->setShowGridlines(true);
    $sheet->setTitle('DUIS-worksheet');

    $sheet->getDefaultStyle()->getFont()->setName('Arial');
    $sheet->getDefaultStyle()->getFont()->setSize(9);

    $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);

    $sheet->getColumnDimension('B')->setWidth(55);
    $currentRow = 1; 
    
    $res=dbProc::getWorkTypeListByWork($actId);
    if (is_array($res))
    {
        foreach ($res as $group)
        {
            $styleArray = array(
                    'font'    => array(
                                    'bold'      => true,
                                    'italic' => false ,
                                    'size' => 9
                                    ),
                                    'alignment' => array(
                                        'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                                    ),
                                    'fill' => array(
                                        'type' => PHPExcel_Style_Fill::FILL_SOLID,
                                        'startcolor' => array(
                                            'argb' => 'EEEEEE',
                                        ),                                        
                                    ), 
                                    'borders' => array(
                                        'allborders' => array(
                                            'style' => PHPExcel_Style_Border::BORDER_THIN,
                                            'color' => array('rgb' => 'CCCCCC')
                                        )
                                    )                               
                    ); 
            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, $group['KLDV_NOSAUKUMS'] .' '. $group['DRBI_WORK_TYPE_TEXT']); 
            $currentRow ++; 

            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, text::get('WORK_COAST')); 
            $currentRow ++; 

            $aWorkDb=dbProc::getActWorkList($actId, false, false, $group['KLDV_ID'], true, $group['DRBI_WORK_TYPE_TEXT']);
            $data = array();
            foreach ($aWorkDb as $i => $row)
            {
                $sheet->setCellValueExplicit('A'.$currentRow, $row['DRBI_KKAL_SHIFRS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['DRBI_KKAL_NOSAUKUMS']); 
                $sheet->setCellValue('C'.$currentRow, 
                (($row['DRBI_PROJECT_EXPORT'] == 'MAN' ) ? dbProc::getKrfkTextByName($row['DRBI_PROJECT_EXPORT']) : '')); 
                $sheet->setCellValue('D'.$currentRow, $row['DRBI_MERVIENIBA']);
                $sheet->setCellValueExplicit('E'.$currentRow, $row['DRBI_DAUDZUMS'],PHPExcel_Cell_DataType::TYPE_NUMERIC);
                $sheet->setCellValue('F'.$currentRow, 
                (($row['DRBI_PROJECT_EXPORT'] == 'ST_DELIVER' ) ? dbProc::getKrfkTextByName($row['DRBI_PROJECT_EXPORT']) : '')); 
                $currentRow ++; 
            }

            $styleArray = array(
                'font'    => array(
                                'bold'      => true,
                                'italic' => false ,
                                'size' => 9
                                ),
                                'alignment' => array(
                                    'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                                ),
                                'fill' => array(
                                    'type' => PHPExcel_Style_Fill::FILL_SOLID,
                                    'startcolor' => array(
                                        'argb' => 'EEEEEE',
                                    ),                                        
                                ),
                                'borders' => array(
                                    'allborders' => array(
                                        'style' => PHPExcel_Style_Border::BORDER_THIN,
                                        'color' => array('rgb' => 'CCCCCC')
                                    )
                                )                                
                ); 
            $sheet->getStyle('A'.$currentRow.':F'.$currentRow)->applyFromArray($styleArray);
            //$sheet->mergeCells('A'.$currentRow.':F'.$currentRow);
            $sheet->setCellValue('A'.$currentRow, text::get('MATERIAL_COAST')); 
            $currentRow ++; 

            $aMaterialDb=dbProc::getProjectMaterialList($actId, $group['KLDV_ID'],$group['DRBI_WORK_TYPE_TEXT']);
            $data = array();
            foreach ($aMaterialDb as $i => $row)
            {
                $sheet->setCellValueExplicit('A'.$currentRow, $row['MATR_KODS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['MATR_NOSAUKUMS']); 
                $sheet->setCellValue('C'.$currentRow, 
                (($row['MATR_PROJECT_EXPORT'] == 'MAN' ) ? dbProc::getKrfkTextByName($row['MATR_PROJECT_EXPORT']) : '')); 
                $sheet->setCellValue('D'.$currentRow, $row['MATR_MERVIENIBA']);
                $sheet->setCellValueExplicit('E'.$currentRow, $row['MATR_DAUDZUMS'],PHPExcel_Cell_DataType::TYPE_NUMERIC);
                $sheet->setCellValue('F'.$currentRow, 
                (($row['MATR_PROJECT_EXPORT'] == 'ST_DELIVER' ) ? dbProc::getKrfkTextByName($row['MATR_PROJECT_EXPORT']) : '')); 
                $currentRow ++; 
            }
        }
    }
    
    $filename = $act['RAKT_NUM_POSTFIX'].'.'.EXCEL_FILE_EXTENTION;
    $res=dbProc::replaceExcelFile( $filename, $userId, $actId, EXCEL_FILE_MIMETYPE);                
    
    if ($res)
    {
        $idFile=dbLayer::getInsertId();
    }
    else
    {
        return false;				
    }
                
    if ($idFile!==false)
    {
        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007'); 
        $objWriter->setOffice2003Compatibility(true);
        $objWriter->save(PROJECT_FILES_STORE_PATH."/".$idFile);  
        						
    }
    return $idFile;
}


function exportTameMaterial($actId, $userId, $type){
    // get info about voltage
    $actInfo = dbProc::getActInfo($actId);
    if(count($actInfo)>0)
    {
        $act = $actInfo[0];
    }
    
    $start_date = date('d.m.Y');
    $cacheMethod = PHPExcel_CachedObjectStorageFactory:: cache_to_phpTemp;
    $cacheSettings = array( 'memoryCacheSize ' => '8MB');
    PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);

     // Create new PHPExcel object
     $objPHPExcel = new PHPExcel();
	 
     $sheet = $objPHPExcel->getActiveSheet();
     $sheet->setTitle('DUIS-worksheet');

     $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_LANDSCAPE);
     $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);

     $sheet->getDefaultColumnDimension()->setWidth(15);
     $sheet->getDefaultRowDimension()->setRowHeight(15);

     $sheet->setShowGridlines(true);
     $sheet->setTitle('DUIS-worksheet');

     $sheet->getDefaultStyle()->getFont()->setName('Arial');
     $sheet->getDefaultStyle()->getFont()->setSize(9);

     $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);

     $sheet->getColumnDimension('A')->setWidth(35);
     $sheet->getColumnDimension('B')->setWidth(55);

     $currentRow = 1;

     $sheet->duplicateStyleArray(
        array(
       'font'    => array(
                       'bold'      => true,
                       'italic' => false ,
                       'size' => 9
                   ),
                   'alignment' => array(
                        'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT,
                   )
               ),  'A'.$currentRow.':A7' ); 
     
     

     $sheet->setCellValue('A'.$currentRow, text::get('NUMBER_SIMBOL').'. '.$act['NUMURS']);
     $sheet->setCellValue('B'.$currentRow, $act['WORK_TITLE']);
     $currentRow ++;

     $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_ACT_TYPE'));
     $sheet->setCellValue('B'.$currentRow, $act['TYPE']);
     $currentRow ++;
     $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_OBJECT'));
     $sheet->setCellValue('B'.$currentRow, $act['OBJECT']);
     $currentRow ++;
     $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_VOLTAGE'));
     $sheet->setCellValue('B'.$currentRow, $act['SPRIEGUMS']);
     $currentRow ++;
     $sheet->setCellValue('A'.$currentRow, text::get('EXPORT_MAIN_DESIGNATION'));
     $sheet->setCellValue('B'.$currentRow, $act['RAKT_OPERATIVAS_APZIM']);
     $currentRow ++;
     $sheet->setCellValue('A'.$currentRow, text::get('COMMENT'));
     $sheet->setCellValue('B'.$currentRow, $act['RAKT_PIEZIMES']);
     $currentRow ++;
     $sheet->setCellValue('A'.$currentRow, text::get('TO_ID'));
     $sheet->setCellValue('B'.$currentRow, $act['RAKT_TO_ID']);
     $currentRow ++;


     $currentRow ++;
     $currentRow ++;

     $sheet->duplicateStyleArray(
               array(
              'font'    => array(
                              'bold'      => true,
                              'italic' => false ,
                              'size' => 9
                          ),
                          'alignment' => array(
                              'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                          )
                      ),  'A'.$currentRow.':F'.$currentRow   ); 
        $sheet->setCellValue('A'.$currentRow, text::get('CODE'));
        $sheet->setCellValue('B'.$currentRow, text::get('NAME'));
        $sheet->setCellValue('C'.$currentRow, text::get('UNIT_OF_MEASURE'));
        $sheet->setCellValue('D'.$currentRow, text::get('AMOUNT'));
        $sheet->setCellValue('E'.$currentRow, text::get('PRICE'));
        $sheet->setCellValue('F'.$currentRow, text::get('PRICE_TOTAL'));
       
        $currentRow ++; 

        $aMaterialDb=dbProc::getActMaterialList($actId,  true );
        foreach ($aMaterialDb as $i=>$row)
        {							 
            $sheet->setCellValueExplicit('A'.$currentRow, $row['MATR_KODS'], PHPExcel_Cell_DataType::TYPE_STRING); 
            $sheet->setCellValue('B'.$currentRow, $row['MATR_NOSAUKUMS']); 
            $sheet->setCellValue('C'.$currentRow, $row['MATR_MERVIENIBA']);
            $sheet->setCellValueExplicit('D'.$currentRow, $row['MATR_DAUDZUMS_KOR'],PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
            $sheet->setCellValueExplicit('E'.$currentRow, number_format($row['MATR_CENA'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
            $sheet->setCellValueExplicit('F'.$currentRow, number_format($row['MATR_CENA_KOPA'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
            
            $currentRow ++; 
           
        }

        $currentRow ++;
        $sheet->setCellValue('A'.$currentRow, text::get('ACT_CREATER'));
        $sheet->setCellValue('B'.$currentRow, $act['AUTORS']);
        $currentRow ++;
        $sheet->setCellValue('A'.$currentRow, text::get('DATE'));
        $sheet->setCellValue('B'.$currentRow, date('d.m.Y'));
        $currentRow ++;
       
        $filename = 'Material_'.$act['RAKT_NUM_POSTFIX'].'_'.dtime::now().'.'.EXCEL_FILE_EXTENTION;
        $res=dbProc::replaceExcelFile( $filename, $userId, $actId, EXCEL_FILE_MIMETYPE);                
        
        if ($res)
        {
            $idFile=dbLayer::getInsertId();
        }
        else
        {
            return false;				
        }
                    
        if ($idFile!==false)
        {
            $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007'); 
            $objWriter->setOffice2003Compatibility(true);
            $objWriter->save(EXCEL_FILES_STORE_PATH."/".$idFile);  
                                    
        }
        return $idFile;

    }
	
	function exportTameWork($actId, $userId, $type){
        // get info about voltage
        $actInfo = dbProc::getActInfo($actId);
        if(count($actInfo)>0)
        {
            $act = $actInfo[0];
        }
        
        $start_date = date('d.m.Y');
        $cacheMethod = PHPExcel_CachedObjectStorageFactory:: cache_to_phpTemp;
        $cacheSettings = array( 'memoryCacheSize ' => '8MB');
        PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);
    
         // Create new PHPExcel object
         $objPHPExcel = new PHPExcel();
		 
         $sheet = $objPHPExcel->getActiveSheet();
         $sheet->setTitle('DUIS-worksheet');
    
         $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_LANDSCAPE);
         $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);
    
         $sheet->getDefaultColumnDimension()->setWidth(15);
         $sheet->getDefaultRowDimension()->setRowHeight(15);
    
         $sheet->setShowGridlines(true);
         $sheet->setTitle('DUIS-worksheet');
    
         $sheet->getDefaultStyle()->getFont()->setName('Arial');
         $sheet->getDefaultStyle()->getFont()->setSize(9);
    
         $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);
    
         $sheet->getColumnDimension('A')->setWidth(35);
         $sheet->getColumnDimension('B')->setWidth(55);
    
         $currentRow = 1;
    
         $sheet->duplicateStyleArray(
            array(
           'font'    => array(
                           'bold'      => true,
                           'italic' => false ,
                           'size' => 9
                       ),
                       'alignment' => array(
                            'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT,
                       )
                   ),  'A'.$currentRow.':A7' ); 
         
         
    
         $sheet->setCellValue('A'.$currentRow, text::get('NUMBER_SIMBOL').'. '.$act['NUMURS']);
         $sheet->setCellValue('B'.$currentRow, $act['WORK_TITLE']);
         $currentRow ++;
    
         $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_ACT_TYPE'));
         $sheet->setCellValue('B'.$currentRow, $act['TYPE']);
         $currentRow ++;
         $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_OBJECT'));
         $sheet->setCellValue('B'.$currentRow, $act['OBJECT']);
         $currentRow ++;
         $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_VOLTAGE'));
         $sheet->setCellValue('B'.$currentRow, $act['SPRIEGUMS']);
         $currentRow ++;
         $sheet->setCellValue('A'.$currentRow, text::get('EXPORT_MAIN_DESIGNATION'));
         $sheet->setCellValue('B'.$currentRow, $act['RAKT_OPERATIVAS_APZIM']);
         $currentRow ++;
         $sheet->setCellValue('A'.$currentRow, text::get('COMMENT'));
         $sheet->setCellValue('B'.$currentRow, $act['RAKT_PIEZIMES']);
         $currentRow ++;
         $sheet->setCellValue('A'.$currentRow, text::get('TO_ID'));
         $sheet->setCellValue('B'.$currentRow, $act['RAKT_TO_ID']);
         $currentRow ++;
    
    
         $currentRow ++;
         $currentRow ++;
    
         $sheet->duplicateStyleArray(
                   array(
                  'font'    => array(
                                  'bold'      => true,
                                  'italic' => false ,
                                  'size' => 9
                              ),
                              'alignment' => array(
                                  'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                              )
                          ),  'A'.$currentRow.':F'.$currentRow   ); 
            $sheet->setCellValue('A'.$currentRow, text::get('CHIPHER'));
            $sheet->setCellValue('B'.$currentRow, text::get('NAME'));
            $sheet->setCellValue('C'.$currentRow, text::get('UNIT_OF_MEASURE'));
            $sheet->setCellValue('D'.$currentRow, text::get('AMOUNT'));
            $sheet->setCellValue('E'.$currentRow, text::get('PRICE'));
            $sheet->setCellValue('F'.$currentRow, text::get('PRICE_TOTAL'));
           
            $currentRow ++; 
    
            $aWorkDb=dbProc::getActWorkList($actId,true);
            foreach ($aWorkDb as $i=>$row)
            {							 
                $sheet->setCellValueExplicit('A'.$currentRow, $row['DRBI_KKAL_SHIFRS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['DRBI_KKAL_NOSAUKUMS']); 
                $sheet->setCellValue('C'.$currentRow, $row['DRBI_MERVIENIBA']);
                $sheet->setCellValueExplicit('D'.$currentRow, $row['DRBI_DAUDZUMS_KOR'],PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('E'.$currentRow, number_format($row['DRBI_KKAL_NORMATIVS'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('F'.$currentRow, number_format($row['DRBI_CILVEKSTUNDAS'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                
                $currentRow ++; 
               
            }
    
            $currentRow ++;
            $sheet->setCellValue('A'.$currentRow, text::get('ACT_CREATER'));
            $sheet->setCellValue('B'.$currentRow, $act['AUTORS']);
            $currentRow ++;
            $sheet->setCellValue('A'.$currentRow, text::get('DATE'));
            $sheet->setCellValue('B'.$currentRow, date('d.m.Y'));
            $currentRow ++;
           
            $filename = 'Darbi_'.$act['RAKT_NUM_POSTFIX'].'_'.dtime::now().'.'.EXCEL_FILE_EXTENTION;
            $res=dbProc::replaceExcelFile( $filename, $userId, $actId, EXCEL_FILE_MIMETYPE);                
            
            if ($res)
            {
                $idFile=dbLayer::getInsertId();
            }
            else
            {
                return false;				
            }
                        
            if ($idFile!==false)
            {
                $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007'); 
                $objWriter->setOffice2003Compatibility(true);
                $objWriter->save(EXCEL_FILES_STORE_PATH."/".$idFile);  
                                        
            }
            return $idFile;
    
        }

        function exportTameAll($actId, $userId, $type){
            // get info about voltage
            $actInfo = dbProc::getActInfo($actId);
            if(count($actInfo)>0)
            {
                $act = $actInfo[0];
            }
            
            $start_date = date('d.m.Y');
            $cacheMethod = PHPExcel_CachedObjectStorageFactory:: cache_to_phpTemp;
            $cacheSettings = array( 'memoryCacheSize ' => '8MB');
            PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);
        
             // Create new PHPExcel object
             $objPHPExcel = new PHPExcel();
                          
             $sheet = $objPHPExcel->getActiveSheet();
             $sheet->setTitle('DUIS-worksheet');
        
             $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_LANDSCAPE);
             $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);
        
             $sheet->getDefaultColumnDimension()->setWidth(15);
             $sheet->getDefaultRowDimension()->setRowHeight(15);
        
             $sheet->setShowGridlines(true);
        
             $sheet->getDefaultStyle()->getFont()->setName('Arial');
             $sheet->getDefaultStyle()->getFont()->setSize(9);
        
             $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);
        
             $sheet->getColumnDimension('A')->setWidth(35);
             $sheet->getColumnDimension('B')->setWidth(55);
        
             $currentRow = 1;
        
             $sheet->duplicateStyleArray(
                array(
               'font'    => array(
                               'bold'      => true,
                               'italic' => false ,
                               'size' => 9
                           ),
                           'alignment' => array(
                                'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT,
                           )
                       ),  'A'.$currentRow.':A7' ); 
             
             
        
             $sheet->setCellValue('A'.$currentRow, text::get('NUMBER_SIMBOL').'. '.$act['NUMURS']);
             $sheet->setCellValue('B'.$currentRow, $act['WORK_TITLE']);
             $currentRow ++;
        
             $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_ACT_TYPE'));
             $sheet->setCellValue('B'.$currentRow, $act['TYPE']);
             $currentRow ++;
             $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_OBJECT'));
             $sheet->setCellValue('B'.$currentRow, $act['OBJECT']);
             $currentRow ++;
             $sheet->setCellValue('A'.$currentRow, text::get('SINGLE_VOLTAGE'));
             $sheet->setCellValue('B'.$currentRow, $act['SPRIEGUMS']);
             $currentRow ++;
             $sheet->setCellValue('A'.$currentRow, text::get('EXPORT_MAIN_DESIGNATION'));
             $sheet->setCellValue('B'.$currentRow, $act['RAKT_OPERATIVAS_APZIM']);
             $currentRow ++;
             $sheet->setCellValue('A'.$currentRow, text::get('COMMENT'));
             $sheet->setCellValue('B'.$currentRow, $act['RAKT_PIEZIMES']);
             $currentRow ++;
             $sheet->setCellValue('A'.$currentRow, text::get('TO_ID'));
             $sheet->setCellValue('B'.$currentRow, $act['RAKT_TO_ID']);
             $currentRow ++;
             $currentRow ++;

             $sheet->duplicateStyleArray(
                array(
               'font'    => array(
                               'bold'      => true,
                               'italic' => false ,
                               'size' => 9
                           ),
                           'alignment' => array(
                               'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                           )
                       ),  'A'.$currentRow.':F'.$currentRow   ); 
            $sheet->setCellValue('A'.$currentRow, text::get('CHIPHER'));
            $sheet->setCellValue('B'.$currentRow, text::get('NAME'));
            $sheet->setCellValue('C'.$currentRow, text::get('UNIT_OF_MEASURE'));
            $sheet->setCellValue('D'.$currentRow, text::get('AMOUNT'));
            $sheet->setCellValue('E'.$currentRow, text::get('PRICE'));
            $sheet->setCellValue('F'.$currentRow, text::get('PRICE_TOTAL'));
            
            $currentRow ++; 
    
            $aWorkDb=dbProc::getActWorkList($actId,true);
            foreach ($aWorkDb as $i=>$row)
            {							 
                $sheet->setCellValueExplicit('A'.$currentRow, $row['DRBI_KKAL_SHIFRS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['DRBI_KKAL_NOSAUKUMS']); 
                $sheet->setCellValue('C'.$currentRow, $row['DRBI_MERVIENIBA']);
                $sheet->setCellValueExplicit('D'.$currentRow, $row['DRBI_DAUDZUMS_KOR'],PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('E'.$currentRow, number_format($row['DRBI_KKAL_NORMATIVS'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('F'.$currentRow, number_format($row['DRBI_CILVEKSTUNDAS'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 				
                
                $currentRow ++; 
                
            }
             $currentRow ++;
        
             $sheet->duplicateStyleArray(
                       array(
                      'font'    => array(
                                      'bold'      => true,
                                      'italic' => false ,
                                      'size' => 9
                                  ),
                                  'alignment' => array(
                                      'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT,
                                  )
                              ),  'A'.$currentRow.':F'.$currentRow   ); 
            $sheet->setCellValue('A'.$currentRow, text::get('CODE'));
            $sheet->setCellValue('B'.$currentRow, text::get('NAME'));
            $sheet->setCellValue('C'.$currentRow, text::get('UNIT_OF_MEASURE'));
            $sheet->setCellValue('D'.$currentRow, text::get('AMOUNT'));
            $sheet->setCellValue('E'.$currentRow, text::get('PRICE'));
            $sheet->setCellValue('F'.$currentRow, text::get('PRICE_TOTAL'));
            
            $currentRow ++; 
    
            $aMaterialDb=dbProc::getActMaterialList($actId,  true );
            foreach ($aMaterialDb as $i=>$row)
            {							 
                $sheet->setCellValueExplicit('A'.$currentRow, $row['MATR_KODS'], PHPExcel_Cell_DataType::TYPE_STRING); 
                $sheet->setCellValue('B'.$currentRow, $row['MATR_NOSAUKUMS']); 
                $sheet->setCellValue('C'.$currentRow, $row['MATR_MERVIENIBA']);
                $sheet->setCellValueExplicit('D'.$currentRow, $row['MATR_DAUDZUMS_KOR'],PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('E'.$currentRow, number_format($row['MATR_CENA'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                $sheet->setCellValueExplicit('F'.$currentRow, number_format($row['MATR_CENA_KOPA'],2,'.',''),PHPExcel_Cell_DataType::TYPE_NUMERIC); 					
                
                $currentRow ++; 
                
            }
    
            $currentRow ++;
            $sheet->setCellValue('A'.$currentRow, text::get('ACT_CREATER'));
            $sheet->setCellValue('B'.$currentRow, $act['AUTORS']);
            $currentRow ++;
            $sheet->setCellValue('A'.$currentRow, text::get('DATE'));
            $sheet->setCellValue('B'.$currentRow, date('d.m.Y'));
            $currentRow ++;
            
            
            $filename = 'Darbi_Materiali'.$act['RAKT_NUM_POSTFIX'].'_'.dtime::now().'.'.EXCEL_FILE_EXTENTION;
            $res=dbProc::replaceExcelFile( $filename, $userId, $actId, EXCEL_FILE_MIMETYPE);                
            
            if ($res)
            {
                $idFile=dbLayer::getInsertId();
            }
            else
            {
                return false;				
            }
                        
            if ($idFile!==false)
            {
                $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007'); 
                $objWriter->setOffice2003Compatibility(true);
                $objWriter->save(EXCEL_FILES_STORE_PATH."/".$idFile);                                              
            }
            return $idFile;        
        }

    // -----------------------------------------------------------------------------
    // Export estimate file statistics to Excel
    // Returns: file ID on success, false on failure
    // -----------------------------------------------------------------------------
    function exportEstimateStatistics($estimateId, $userId, $actId)
    {
        // Get estimate file info
        $estimateInfo = dbProc::getEstimateFileInfo($estimateId);
        if ($estimateInfo === false)
        {
            return false;
        }
        
        // Get act info
        $actInfo = dbProc::getActInfo($actId);
        $act = array('NUMURS' => 'N/A', 'RAKT_FULL_NUMBER' => 'N/A');
        if (is_array($actInfo) && count($actInfo) > 0)
        {
            $act = $actInfo[0];
        }
        
        // Get estimate file details from database
        $estimateDetails = dbProc::getEstimateFileDetails($estimateId);
        
        // Generate Excel even if no details (empty file with headers)
        if (is_array($estimateDetails))
        {
            // Create new PHPExcel object
            $cacheMethod = PHPExcel_CachedObjectStorageFactory::cache_to_phpTemp;
            $cacheSettings = array('memoryCacheSize' => '8MB');
            PHPExcel_Settings::setCacheStorageMethod($cacheMethod, $cacheSettings);
            
            $objPHPExcel = new PHPExcel();
            $sheet = $objPHPExcel->getActiveSheet();
            $sheet->setTitle(text::get('ESTIMATE_STATISTICS'));
            
            $sheet->getPageSetup()->setOrientation(PHPExcel_Worksheet_PageSetup::ORIENTATION_LANDSCAPE);
            $sheet->getPageSetup()->setPaperSize(PHPExcel_Worksheet_PageSetup::PAPERSIZE_A4);
            
            $sheet->getDefaultColumnDimension()->setWidth(15);
            $sheet->getDefaultRowDimension()->setRowHeight(15);
            
            $sheet->setShowGridlines(true);
            
            $sheet->getDefaultStyle()->getFont()->setName('Arial');
            $sheet->getDefaultStyle()->getFont()->setSize(9);
            
            $sheet->getDefaultStyle()->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);
            
            // Set column widths
            $sheet->getColumnDimension('A')->setWidth(20); // Status
            $sheet->getColumnDimension('B')->setWidth(15); // Code
            $sheet->getColumnDimension('C')->setWidth(50); // Title
            
            $currentRow = 1;
            
            // Title row
            $sheet->setCellValue('A'.$currentRow, text::get('ESTIMATE_STATISTICS'));
            $sheet->getStyle('A'.$currentRow)->getFont()->setBold(true)->setSize(12);
            $currentRow++;
            
            // Info rows
            $sheet->setCellValue('A'.$currentRow, text::get('ACT_LABEL'));
            $sheet->setCellValue('B'.$currentRow, $act['NUMURS']);
            $sheet->getStyle('A'.$currentRow)->getFont()->setBold(true);
            $currentRow++;
            
            $sheet->setCellValue('A'.$currentRow, text::get('FILE_LABEL'));
            $sheet->setCellValue('B'.$currentRow, $estimateInfo['ESTM_NAME']);
            $sheet->getStyle('A'.$currentRow)->getFont()->setBold(true);
            $currentRow++;
            
            $sheet->setCellValue('A'.$currentRow, text::get('DATE_LABEL'));
            $sheet->setCellValue('B'.$currentRow, $estimateInfo['ESTM_DATE']);
            $sheet->getStyle('A'.$currentRow)->getFont()->setBold(true);
            $currentRow++;
            
            $currentRow++; // Empty row
            
            // Header row
            $headerStyle = array(
                'font' => array('bold' => true, 'size' => 9),
                'alignment' => array('horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_CENTER),
                'fill' => array(
                    'type' => PHPExcel_Style_Fill::FILL_SOLID,
                    'startcolor' => array('argb' => 'FFCCCCCC')
                ),
                'borders' => array(
                    'allborders' => array(
                        'style' => PHPExcel_Style_Border::BORDER_THIN
                    )
                )
            );
            
            $sheet->setCellValue('A'.$currentRow, text::get('STATUS'));
            $sheet->setCellValue('B'.$currentRow, text::get('CODE'));
            $sheet->setCellValue('C'.$currentRow, text::get('TITLE'));
            $sheet->getStyle('A'.$currentRow.':C'.$currentRow)->applyFromArray($headerStyle);
            $currentRow++;
            
            // Data rows from estimate_files_detales table
            $currentWorkType = '';
            
            if (count($estimateDetails) > 0)
            {
                foreach ($estimateDetails as $detail)
            {
                $workType = isset($detail['WORK_TYPE_NAME']) && !empty($detail['WORK_TYPE_NAME']) ? trim($detail['WORK_TYPE_NAME']) : text::get('NO_WORK_TYPE');
                $code = isset($detail['ESFD_CODE']) ? trim($detail['ESFD_CODE']) : '';
                $title = isset($detail['TITLE']) && !empty($detail['TITLE']) ? trim($detail['TITLE']) : text::get('NO_TITLE');
                $status = isset($detail['ESFD_STATUS']) ? $detail['ESFD_STATUS'] : 0;
                $type = isset($detail['ESFD_TYPE']) ? $detail['ESFD_TYPE'] : 0;
                
                // Show work type header when it changes
                if ($workType !== $currentWorkType)
                {
                    $currentWorkType = $workType;
                    
                    $workTypeStyle = array(
                        'font' => array('bold' => true, 'size' => 10, 'color' => array('rgb' => 'FFFFFF')),
                        'fill' => array(
                            'type' => PHPExcel_Style_Fill::FILL_SOLID,
                            'startcolor' => array('argb' => 'FF006CB7')
                        ),
                        'alignment' => array(
                            'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_LEFT
                        ),
                        'borders' => array(
                            'allborders' => array(
                                'style' => PHPExcel_Style_Border::BORDER_THIN,
                                'color' => array('rgb' => 'CCCCCC')
                            )
                        )
                    );
                    
                    $sheet->setCellValue('A'.$currentRow, $workType);
                    $sheet->mergeCells('A'.$currentRow.':C'.$currentRow);
                    $sheet->getStyle('A'.$currentRow)->applyFromArray($workTypeStyle);
                    $currentRow++;
                }
                
                // Determine status text based on ESFD_STATUS and ESFD_TYPE
                $statusText = '';
                $isWork = ($type == 1);
                $isMaterial = ($type == 2);
                
                switch ($status)
                {
                    case 1: // OK - saved
                        $statusText = '✓ ' . text::get('STATUS_SAVED');
                        break;
                    case 2: // Already exists
                        if ($isWork) {
                            $statusText = '⚠ ' . text::get('STATUS_WORK_EXISTS');
                        } else if ($isMaterial) {
                            $statusText = '⚠ ' . text::get('STATUS_MATERIAL_EXISTS');
                        } else {
                            $statusText = '⚠ ' . text::get('STATUS_EXISTS');
                        }
                        break;
                    case 3: // Not found in catalog
                        if ($isWork) {
                            $statusText = '✗ ' . text::get('STATUS_WORK_NOT_FOUND');
                        } else if ($isMaterial) {
                            $statusText = '✗ ' . text::get('STATUS_MATERIAL_NOT_FOUND');
                        } else {
                            $statusText = '✗ ' . text::get('STATUS_NOT_FOUND');
                        }
                        break;
                    case 4: // Amount not set
                        $statusText = '✗ ' . text::get('STATUS_AMOUNT_NOT_SET');
                        break;
                    default:
                        $statusText = '? ' . text::get('STATUS_UNKNOWN');
                        break;
                }
                
                // Write data row
                $sheet->setCellValue('A'.$currentRow, $statusText);
                $sheet->setCellValue('B'.$currentRow, $code);
                $sheet->setCellValue('C'.$currentRow, $title);
                
                // Apply cell styling with borders
                $dataStyle = array(
                    'borders' => array(
                        'allborders' => array(
                            'style' => PHPExcel_Style_Border::BORDER_THIN,
                            'color' => array('rgb' => 'CCCCCC')
                        )
                    )
                );
                $sheet->getStyle('A'.$currentRow.':C'.$currentRow)->applyFromArray($dataStyle);
                
                $currentRow++;
                }
            }
            else
            {
                // No data - add a message row
                $sheet->setCellValue('A'.$currentRow, text::get('NO_DATA'));
                $sheet->mergeCells('A'.$currentRow.':C'.$currentRow);
                $sheet->getStyle('A'.$currentRow)->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
                $sheet->getStyle('A'.$currentRow)->getFont()->setItalic(true);
            }
            
            // Save Excel file
            $fileName = 'Tames_statistika_' . $estimateId . '_' . dtime::now() . '.' . EXCEL_FILE_EXTENTION;
            $res = dbProc::replaceExcelFile($fileName, $userId, $actId, EXCEL_FILE_MIMETYPE);
            
            if ($res)
            {
                $idFile = dbLayer::getInsertId();
            }
            else
            {
                return false;
            }
            
            if ($idFile !== false)
            {
                $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007');
                $objWriter->setOffice2003Compatibility(true);
                $objWriter->save(PROJECT_FILES_STORE_PATH . "/" . $idFile);
            }
            return $idFile;
        }
        
        return false;
    }
}
?>
