		}
	}

	function isFrozen()
	{
		return $this->frozen;
	}

    function isValid()
	{
		$aGlobalErrors=session::get('glb_form_errors');
		$aFormElemErrors=session::get('form_elem_error');
		return (!(
				(is_array($aGlobalErrors)&&count($aGlobalErrors))
				||(is_array($this->aErrors)&&count($this->aErrors))
				||(isset($aFormElemErrors[$this->aForm['name']])
					&&count($aFormElemErrors[$this->aForm['name']]))
				));
	}

	function addErrorPerElem($cElementName,$cErrorMessage)
	{
		$aErrorTest=session::get('form_elem_error');
		if (!isset($aErrorTest[$this->aForm['name']])||
			!is_array($aErrorTest[$this->aForm['name']])||
			!in_array(array('elem'=>$cElementName,'msg'=>$cErrorMessage),$aErrorTest[$this->aForm['name']]))
		{
			$aErrorTest[$this->aForm['name']][]=array('elem'=>$cElementName,'msg'=>$cErrorMessage);
		}
		session::set('form_elem_error',$aErrorTest);
	}


	function addSuccessPerElem($cElementName,$cErrorMessage)
	{
		$aSuccessTest=session::get('form_elem_success');
		if (!isset($aSuccessTest[$this->aForm['name']])||
			!is_array($aSuccessTest[$this->aForm['name']])||
			!in_array(array('elem'=>$cElementName,'msg'=>$cErrorMessage),$aSuccessTest[$this->aForm['name']]))
		{
			$aSuccessTest[$this->aForm['name']][]=array('elem'=>$cElementName,'msg'=>$cErrorMessage);
		}
		session::set('form_elem_success',$aSuccessTest);
	}


	/**
	 * Initialize dynamic row
	 *
	 * Row will be prepended to the specified container node after triggering specified button Click event
	 *
	 * @param string $buttonId button DOM node id
	 * @param string $containerId container DOM node id
	 * @param integer $nextIndex index that will be used in next row field names. Ex: name="somename[$nextIndex]"
	 * @param array $fields fields to be included in dynamic row
	 * @return boolean operation status
	 */
	function addDynamicRowButton($buttonId, $containerId, $nextIndex, $fields)
	{
		if (is_array($fields) && !empty($fields))
		{
			$this->aDynamicRows[$buttonId] = array(
				'containerId' => $containerId,
				'nextIndex' => $nextIndex,
				'fields' => $fields
			);
			return true;
		}
		return false;
	}



}
?>