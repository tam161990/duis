<?php
/**
 * RBF Act Processor Class
 * 
 * Handles automatic processing of RBF acts and works:
 * - Processes pending acts from rbf_akti table
 * - Creates automatic RBF acts in AKTI table
 * - Processes work records from rbf_akta_darbi_tmp table
 * - Manages email notifications and audit records
 * 
 * @author AI Assistant
 * @version 1.0
 */

class RbfActProcessor
{
	// System user ID for automatic processes
	const SYSTEM_USER_ID = 197;
	
	// Processing statistics
	private $stats = array(
		'acts' => array(
			'total' => 0,
			'success' => 0,
			'error' => 0,
			'errors' => array()
		),
		'works' => array(
			'total' => 0,
			'inserted' => 0,
			'updated' => 0,
			'skipped' => 0,
			'error' => 0,
			'errors' => array()
		)
	);
	
	// -----------------------------------------------------------------------------
	// Process all pending RBF acts and works
	// Public entry point
	// -----------------------------------------------------------------------------
	public function process()
	{
		$this->logStart();
		
		// Step 1: Process acts
		$this->processActs();
		
		// Step 2: Process works
		$this->processWorks();
		
		// Final summary
		$this->logFinalSummary();
		
		return $this->stats;
	}
	
	// -----------------------------------------------------------------------------
	// Process pending acts from rbf_akti table
	// Private
	// -----------------------------------------------------------------------------
	private function processActs()
	{
		files::wh_log("");
		files::wh_log("========================================");
		files::wh_log("[START] Processing Acts from rbf_akti");
		files::wh_log("========================================");
		
		$pendingActs = dbProc::getPendingRbfAkts();
		
		if (!$pendingActs || count($pendingActs) == 0) {
			files::wh_log("[INFO] No pending acts to process");
			return;
		}
		
		$this->stats['acts']['total'] = count($pendingActs);
		files::wh_log("[INFO] Found {$this->stats['acts']['total']} pending act(s) to process");
		
		foreach ($pendingActs as $faktAct) {
			$this->processAct($faktAct);
		}
	}
	
	// -----------------------------------------------------------------------------
	// Process a single act
	// Private
	// -----------------------------------------------------------------------------
	private function processAct($faktAct)
	{
		$faktId = $faktAct['FAKT_ID'];
		$faktNumPostfix = $faktAct['FAKT_NUM_POSTFIX'];
		
		files::wh_log("");
		files::wh_log("--- Processing FAKT_ID: $faktId (Pasūtījuma ID: $faktNumPostfix) ---");
		
		// Validate act data
		$validation = $this->validateActData($faktAct);
		
		if (!$validation['valid']) {
			files::wh_log("[FAILED] FAKT_ID $faktId: Skipped due to validation errors");
			$this->stats['acts']['error']++;
			$this->stats['acts']['errors'] = array_merge(
				$this->stats['acts']['errors'], 
				$validation['errors']
			);
			return false;
		}
		
		// Create act in AKTI table
		$createdActId = $this->createAutomaticAct($faktAct, $validation['data']);
		
		if ($createdActId === false) {
			$error = "[ERROR] FAKT_ID $faktId: Failed to create act in AKTI table";
			files::wh_log($error);
			$this->stats['acts']['error']++;
			$this->stats['acts']['errors'][] = $error;
			return false;
		}

		// INSERT may report an id but row missing (rollback, replication, etc.) — do not mark rbf_akti processed
		if (!dbProc::verifyRbfAutomaticActInAkti($createdActId, $faktNumPostfix))
		{
			$error = "[ERROR] FAKT_ID $faktId: RAKT_ID $createdActId not found in AKTI "
				."with RAKT_NUM_POSTFIX \"$faktNumPostfix\" (RAKT_IS_RBF=1, RAKT_IS_AUTO=1). "
				."Skipping audit, email and FAKT_PROCESSED — will retry on next job run.";
			files::wh_log($error);
			$this->stats['acts']['error']++;
			$this->stats['acts']['errors'][] = $error;
			return false;
		}
		
		// Save audit records and send notification
		$this->processActPostCreation($createdActId, $faktId, $validation['warnings']);
		
		$this->stats['acts']['success']++;
		return true;
	}
	
	// -----------------------------------------------------------------------------
	// Validate act data
	// Returns: array with 'valid', 'data', 'errors', 'warnings'
	// Private
	// -----------------------------------------------------------------------------
	private function validateActData($faktAct)
	{
		$faktId = $faktAct['FAKT_ID'];
		$hasErrors = false;
		$errors = array();
		$warnings = array();
		$data = array();
		
		// 1. Validate required fields
		if (empty($faktAct['FAKT_NUM_POSTFIX'])) {
			$error = "[ERROR] FAKT_ID $faktId: FAKT_NUM_POSTFIX is empty";
			files::wh_log($error);
			$errors[] = $error;
			$hasErrors = true;
		}
		
		if (empty($faktAct['FAKT_WORK_TITLE'])) {
			$error = "[ERROR] FAKT_ID $faktId: FAKT_WORK_TITLE is empty";
			files::wh_log($error);
			$errors[] = $error;
			$hasErrors = true;
		}
		
		// 2. Validate employee code
		if (!dbProc::validateRbfEmployeeCode($faktAct['FAKT_KWOI_KODS'])) {
			$error = "[ERROR] FAKT_ID $faktId: FAKT_KWOI_KODS '{$faktAct['FAKT_KWOI_KODS']}' not found in kl_rbf_darbuznemeji.RBDU_KODS";
			files::wh_log($error);
			$errors[] = $error;
			$hasErrors = true;
		}
		
		// 3. Validate VV number for employee
		if (!dbProc::validateVVNumberForEmployee($faktAct['FAKT_VV_NUMBER'], $faktAct['FAKT_KWOI_KODS'])) {
			$error = "[ERROR] FAKT_ID $faktId: FAKT_VV_NUMBER '{$faktAct['FAKT_VV_NUMBER']}' not found for employee '{$faktAct['FAKT_KWOI_KODS']}' in kl_rbf_du_vv";
			files::wh_log($error);
			$errors[] = $error;
			$hasErrors = true;
		}
		
		// 4. Validate territory code for VV
		if (!dbProc::validateTerritoryForVV($faktAct['FAKT_RBTR_KODS'], $faktAct['FAKT_VV_NUMBER'])) {
			$error = "[ERROR] FAKT_ID $faktId: FAKT_RBTR_KODS '{$faktAct['FAKT_RBTR_KODS']}' not found for VV '{$faktAct['FAKT_VV_NUMBER']}' in kl_rbf_teritorijas";
			files::wh_log($error);
			$errors[] = $error;
			$hasErrors = true;
		}
		
		// 5. Find user ID by name and validate relationship to employee
		$data['authorId'] = $this->findAndValidateAuthor($faktAct, $warnings);
		
		// 6. Find act type ID by code
		$data['actTypeId'] = $this->findActType($faktAct, $warnings);
		
		// 7. Use territory code directly (no longer need to look up ID)
		// NOTE: RAKT_KEDI_ID now stores territory codes (RBTR_KODS or RBTR_DID_KODS), not IDs
		$data['departmentCode'] = $faktAct['FAKT_RBTR_KODS'];
		files::wh_log("[INFO] Using department code: '{$data['departmentCode']}'");
		
		return array(
			'valid' => !$hasErrors,
			'data' => $data,
			'errors' => $errors,
			'warnings' => $warnings
		);
	}
	
	// -----------------------------------------------------------------------------
	// Find and validate author (user)
	// Returns author ID (0 if not found/invalid)
	// Private
	// -----------------------------------------------------------------------------
	private function findAndValidateAuthor($faktAct, &$warnings)
	{
		$faktId = $faktAct['FAKT_ID'];
		$userInfo = dbProc::findUserByNameForEmployee($faktAct['FAKT_RLTT_TEXT'], $faktAct['FAKT_KWOI_KODS']);
		
		if ($userInfo === false) {
			$warning = "[ERROR] FAKT_ID $faktId: User '{$faktAct['FAKT_RLTT_TEXT']}' not found in LIETOTAJI. Setting RAKT_RLTT_ID = 0";
			files::wh_log($warning);
			$warnings[] = $warning;
			return 0;
		}
		
		$authorId = $userInfo['RLTT_ID'];
		
		// Check if user belongs to the employee
		if (!$userInfo['belongs_to_employee']) {
			$warning = "[ERROR] FAKT_ID $faktId: User '{$faktAct['FAKT_RLTT_TEXT']}' (ID: {$authorId}, KWOI: {$userInfo['RLTT_KWOI_KODS']}) is not related to employee '{$faktAct['FAKT_KWOI_KODS']}'. Setting RAKT_RLTT_ID = 0";
			files::wh_log($warning);
			$warnings[] = $warning;
			return 0;
		}
		
		files::wh_log("[INFO] Found user ID: $authorId for '{$faktAct['FAKT_RLTT_TEXT']}' (belongs to employee {$faktAct['FAKT_KWOI_KODS']})");
		return $authorId;
	}
	
	// -----------------------------------------------------------------------------
	// Find act type by code
	// Returns act type ID (0 if not found)
	// Private
	// -----------------------------------------------------------------------------
	private function findActType($faktAct, &$warnings)
	{
		$faktId = $faktAct['FAKT_ID'];
		$actTypeId = dbProc::findActTypeIdByCode($faktAct['FAKT_KAKV_KODS']);
		
		if ($actTypeId === false) {
			$warning = "[ERROR] FAKT_ID $faktId: Act type code '{$faktAct['FAKT_KAKV_KODS']}' not found in kl_akta_veids. Setting RAKT_KAKV_ID = 0";
			files::wh_log($warning);
			$warnings[] = $warning;
			return 0;
		}
		
		files::wh_log("[INFO] Found act type ID: $actTypeId for code '{$faktAct['FAKT_KAKV_KODS']}'");
		return $actTypeId;
	}
	
	// -----------------------------------------------------------------------------
	// Create automatic RBF act in AKTI table
	// Returns created act ID or false
	// Private
	// -----------------------------------------------------------------------------
	private function createAutomaticAct($faktAct, $validatedData)
	{
		files::wh_log("[INFO] Creating automatic act in AKTI table...");
		
		$createdActId = dbProc::createAutomaticRbfAct(
			$faktAct['FAKT_KWOI_KODS'],      // employeeCode
			$validatedData['authorId'],       // authorId (0 if not found)
			$faktAct['FAKT_VV_NUMBER'],       // vvNumber
			$validatedData['actTypeId'],      // actTypeId (0 if not found)
			$validatedData['departmentCode'], // departmentCode (RBTR_KODS or RBTR_DID_KODS)
			$faktAct['FAKT_NUM_POSTFIX'],     // orderId
			$faktAct['FAKT_WORK_TITLE'],      // workTitle
			$faktAct['FAKT_PIEZIMES'],        // notes
			$faktAct['FAKT_SIGNATURE'],       // signature (E/P/K) - optional
			STAT_INSERT                        // status (INSERT)
		);
		
		if ($createdActId !== false) {
			files::wh_log("[SUCCESS] Created RAKT_ID: $createdActId (RAKT_IS_AUTO=1, RAKT_IS_RBF=1)");
		}
		
		return $createdActId;
	}
	
	// -----------------------------------------------------------------------------
	// Process post-creation tasks: audit, email, mark as processed
	// Private
	// -----------------------------------------------------------------------------
	private function processActPostCreation($createdActId, $faktId, $warnings)
	{
		// Save audit records
		dbProc::setUserActionDate(self::SYSTEM_USER_ID, ACT_INSERT);
		dbProc::updateRbfActStatus($createdActId, STAT_INSERT, self::SYSTEM_USER_ID);
		files::wh_log("[INFO] Audit records saved for RAKT_ID: $createdActId (User: " . self::SYSTEM_USER_ID . ", Status: INSERT)");
		
		// Send email notification
		email::sendRbfActStatusChangeNotification($createdActId, null, STAT_INSERT, self::SYSTEM_USER_ID);
		files::wh_log("[INFO] Email notification sent for new act RAKT_ID: $createdActId");
		
		// Mark as processed
		$marked = dbProc::markRbfAktProcessed($faktId);
		if (!$marked) {
			files::wh_log("[WARNING] Failed to mark FAKT_ID $faktId as processed in rbf_akti table");
		} else {
			files::wh_log("[INFO] Marked FAKT_ID $faktId as processed (FAKT_PROCESSED=1)");
		}
		
		// Log warnings if any
		if (count($warnings) > 0) {
			files::wh_log("[NOTE] Act created with warnings:");
			foreach ($warnings as $warning) {
				files::wh_log("  " . $warning);
			}
			$this->stats['acts']['errors'] = array_merge($this->stats['acts']['errors'], $warnings);
		}
	}
	
	// -----------------------------------------------------------------------------
	// Process work records from rbf_akta_darbi_tmp
	// Private
	// -----------------------------------------------------------------------------
	private function processWorks()
	{
		files::wh_log("");
		files::wh_log("========================================");
		files::wh_log("[START] Processing Work Records from rbf_akta_darbi_tmp");
		files::wh_log("========================================");
		
		$workRecords = dbProc::getWorkRecordsFromTemp();
		
		if (!$workRecords || count($workRecords) == 0) {
			files::wh_log("[INFO] No work records to process in rbf_akta_darbi_tmp");
			return;
		}
		
		$this->stats['works']['total'] = count($workRecords);
		files::wh_log("[INFO] Found {$this->stats['works']['total']} work record(s) to process");
		
		// Group works by act (Order ID)
		$worksByAct = $this->groupWorksByAct($workRecords);
		
		// Process each group
		foreach ($worksByAct as $orderId => $works) {
			$this->processWorksForAct($orderId, $works);
		}
		
		// Work summary
		$this->logWorksSummary();
	}
	
	// -----------------------------------------------------------------------------
	// Group work records by act (Order ID)
	// Returns: array indexed by order ID
	// Private
	// -----------------------------------------------------------------------------
	private function groupWorksByAct($workRecords)
	{
		$worksByAct = array();
		foreach ($workRecords as $work) {
			$orderId = $work['FADR_NUM_POSTFIX'];
			if (!isset($worksByAct[$orderId])) {
				$worksByAct[$orderId] = array();
			}
			$worksByAct[$orderId][] = $work;
		}
		return $worksByAct;
	}
	
	// -----------------------------------------------------------------------------
	// Process works for a specific act
	// Private
	// -----------------------------------------------------------------------------
	private function processWorksForAct($orderId, $works)
	{
		files::wh_log("");
		files::wh_log("--- Processing Works for Order ID: $orderId ---");
		
		// Get act ID by Order ID
		$actInfo = dbProc::getActIdByPostfix($orderId);
		
		if ($actInfo === false) {
			$error = "[ERROR] Order ID '$orderId': Act not found in AKTI table (RAKT_NUM_POSTFIX). Skipping " . count($works) . " work(s).";
			files::wh_log($error);
			$this->stats['works']['errors'][] = $error;
			$this->stats['works']['error'] += count($works);
			return;
		}
		
		$raktId = $actInfo['RAKT_ID'];
		$raktFullNumber = $actInfo['RAKT_FULL_NUMBER'];
		files::wh_log("[INFO] Found Act: $raktFullNumber (RAKT_ID: $raktId)");
		
		// Process each work
		foreach ($works as $work) {
			$this->processWork($raktId, $raktFullNumber, $work);
		}
	}
	
	// -----------------------------------------------------------------------------
	// Process a single work record
	// Private
	// -----------------------------------------------------------------------------
	private function processWork($raktId, $raktFullNumber, $work)
	{
		$rbklShifrs = $work['FADR_RBKL_SHIFRS'];
	$mmsKods = $work['FADR_MMS_KODS'];
	$mmsTitle = $work['FADR_MMS_TITLE'];
	$status = $work['FADR_STATUS'];
	$planDate = $work['FADR_PLAN_DATE'];
	$norma = $work['FADR_NORMA'];
	$mervieniba = isset($work['FADR_MERVIENIBA']) ? $work['FADR_MERVIENIBA'] : null;
	$apjoms = isset($work['FADR_APJOMS']) ? $work['FADR_APJOMS'] : null;
	$cstNorma = isset($work['FADR_CST_NORMA']) ? $work['FADR_CST_NORMA'] : null;
	
	// Validate calculation code exists
	if (!dbProc::validateRbfCalculationCode($rbklShifrs)) {
		$error = "[ERROR] Act $raktFullNumber: Calculation code '$rbklShifrs' not found in kl_rbf_kalkulacija. Skipping work.";
		files::wh_log($error);
		$this->stats['works']['errors'][] = $error;
		$this->stats['works']['error']++;
		return;
	}
	
	// Check if work already exists
	$existingWork = dbProc::getExistingWork($raktId, $rbklShifrs, $mmsKods);
	
	if ($existingWork) {
		$this->handleExistingWork($existingWork, $raktFullNumber, $rbklShifrs, $mmsKods, $status, $planDate, $norma, $apjoms, $cstNorma);
	} else {
		$this->handleNewWork($raktId, $raktFullNumber, $rbklShifrs, $mmsKods, $mmsTitle, $status, $planDate, $norma, $mervieniba, $apjoms, $cstNorma);
	}
	}
	
	// -----------------------------------------------------------------------------
	// Handle existing work record
	// Private
	// -----------------------------------------------------------------------------
	private function handleExistingWork($existingWork, $raktFullNumber, $rbklShifrs, $mmsKods, $status, $planDate, $norma, $apjoms = null, $cstNorma = null)
	{
		if ($existingWork['RADR_IS_PROCESSED'] == 1) {
			// Already processed - skip
			files::wh_log("[SKIP] Act $raktFullNumber: Work (Calc: $rbklShifrs, MMS: $mmsKods) already processed (RADR_IS_PROCESSED=1)");
			$this->stats['works']['skipped']++;
		} else {
			// Not processed - update status, plan_date and RBF values
			$updated = dbProc::updateRbfWorkStatus($existingWork['RADR_ID'], $status, $planDate, $norma, $apjoms, $cstNorma);
			if ($updated) {
				files::wh_log("[UPDATE] Act $raktFullNumber: Work (Calc: $rbklShifrs, MMS: $mmsKods) - Updated status to '$status' and values (Norma: $norma)");
				$this->stats['works']['updated']++;
			} else {
				$error = "[ERROR] Act $raktFullNumber: Failed to update work (RADR_ID: {$existingWork['RADR_ID']})";
				files::wh_log($error);
				$this->stats['works']['errors'][] = $error;
				$this->stats['works']['error']++;
			}
		}
	}
	
	// -----------------------------------------------------------------------------
	// Handle new work record
	// Private
	// -----------------------------------------------------------------------------
	private function handleNewWork($raktId, $raktFullNumber, $rbklShifrs, $mmsKods, $mmsTitle, $status, $planDate, $norma, $mervieniba = null, $apjoms = null, $cstNorma = null)
	{
		$insertedId = dbProc::insertRbfWork($raktId, $rbklShifrs, $mmsKods, $mmsTitle, $status, $planDate, $norma, $mervieniba, $apjoms, $cstNorma);
		if ($insertedId) {
			files::wh_log("[INSERT] Act $raktFullNumber: New work added (RADR_ID: $insertedId, Calc: $rbklShifrs, MMS: $mmsKods, Norma: $norma)");
			$this->stats['works']['inserted']++;
		} else {
			$error = "[ERROR] Act $raktFullNumber: Failed to insert work (Calc: $rbklShifrs, MMS: $mmsKods)";
			files::wh_log($error);
			$this->stats['works']['errors'][] = $error;
			$this->stats['works']['error']++;
		}
	}
	
	// -----------------------------------------------------------------------------
	// Log start message
	// Private
	// -----------------------------------------------------------------------------
	private function logStart()
	{
		$startTime = date('Y-m-d H:i:s');
		files::wh_log("========================================");
		files::wh_log("[START] RBF Automatic Act Creation - $startTime");
		files::wh_log("========================================");
	}
	
	// -----------------------------------------------------------------------------
	// Log works processing summary
	// Private
	// -----------------------------------------------------------------------------
	private function logWorksSummary()
	{
		files::wh_log("");
		files::wh_log("========================================");
		files::wh_log("[SUMMARY] Work Records Processing");
		files::wh_log("========================================");
		files::wh_log("[INFO] Total work records: {$this->stats['works']['total']}");
		files::wh_log("[SUCCESS] Inserted: {$this->stats['works']['inserted']} work(s)");
		files::wh_log("[SUCCESS] Updated: {$this->stats['works']['updated']} work(s)");
		files::wh_log("[INFO] Skipped (already processed): {$this->stats['works']['skipped']} work(s)");
		files::wh_log("[ERROR] Failed: {$this->stats['works']['error']} work(s)");
		
		if (count($this->stats['works']['errors']) > 0) {
			files::wh_log("");
			files::wh_log("[WORK ERRORS] Details:");
			foreach ($this->stats['works']['errors'] as $error) {
				files::wh_log("  " . $error);
			}
		}
	}
	
	// -----------------------------------------------------------------------------
	// Log final summary
	// Private
	// -----------------------------------------------------------------------------
	private function logFinalSummary()
	{
		files::wh_log("");
		files::wh_log("========================================");
		files::wh_log("[FINAL SUMMARY] RBF Automatic Processing");
		files::wh_log("========================================");
		files::wh_log("[ACTS] Total pending: {$this->stats['acts']['total']}");
		files::wh_log("[ACTS] Successfully created: {$this->stats['acts']['success']} act(s)");
		files::wh_log("[ACTS] Failed: {$this->stats['acts']['error']} act(s)");
		
		if ($this->stats['works']['total'] > 0) {
			files::wh_log("[WORKS] Total records: {$this->stats['works']['total']}");
			files::wh_log("[WORKS] Inserted: {$this->stats['works']['inserted']} work(s)");
			files::wh_log("[WORKS] Updated: {$this->stats['works']['updated']} work(s)");
			files::wh_log("[WORKS] Skipped: {$this->stats['works']['skipped']} work(s)");
			files::wh_log("[WORKS] Failed: {$this->stats['works']['error']} work(s)");
		}
		
		// Log all errors/warnings
		$hasErrors = count($this->stats['acts']['errors']) > 0 || count($this->stats['works']['errors']) > 0;
		
		if ($hasErrors) {
			files::wh_log("");
			files::wh_log("[ALL ERRORS/WARNINGS] Details:");
			
			if (count($this->stats['acts']['errors']) > 0) {
				files::wh_log("  [ACT ERRORS]:");
				foreach ($this->stats['acts']['errors'] as $error) {
					files::wh_log("    " . $error);
				}
			}
			
			if (count($this->stats['works']['errors']) > 0) {
				files::wh_log("  [WORK ERRORS]:");
				foreach ($this->stats['works']['errors'] as $error) {
					files::wh_log("    " . $error);
				}
			}
		}
		
		$endTime = date('Y-m-d H:i:s');
		files::wh_log("");
		files::wh_log("[END] Process completed at $endTime");
		files::wh_log("========================================");
	}
	
	// -----------------------------------------------------------------------------
	// Get processing statistics
	// Public
	// -----------------------------------------------------------------------------
	public function getStats()
	{
		return $this->stats;
	}
	
	// -----------------------------------------------------------------------------
	// Check if processing had errors
	// Public
	// -----------------------------------------------------------------------------
	public function hasErrors()
	{
		return ($this->stats['acts']['error'] > 0 || $this->stats['works']['error'] > 0);
	}
}

?>

