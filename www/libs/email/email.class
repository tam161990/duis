<?
// Include SMTP mailer class
require_once(dirname(__FILE__).'/SmtpMailer.class');

class email
{

	// -----------------------------------------------------------------------------
	// on message statuss change define email text, get subscribers list and send email notification 
	// public
	// Author: Tatjana Fedorkova
	// -----------------------------------------------------------------------------
	
	function sendMsgStatusChangeNotification($messageId, $projectId, $actionId, $msgId, $msgType, $msgShortDescr, $msgDescr, $eventDescr=false, $changedEventId=false, $actionCode=false, $msgTypeCode=false)
	{
		// email subject
		$subject = text::latvianToLatin($msgType).' - '.text::latvianToLatin($msgShortDescr);

		// email body
		$body = '';

		// get project code
		$project = dbProc::getProjectInfo($projectId);
		if($project !== false)
		{	
			$projectCode = $project['RPRJ_KODS'];
		}

		$userInfo = dbProc::getUserInfo( userAuthorization::getUserId() );

		if (isset($userInfo[0]) && is_array($userInfo[0]) )
		{
			$userEmail=$userInfo[0]['RLTT_EPASTA_ADRESE'];
			$userInfo=$userInfo[0]['RLTT_VARDS'].' '.$userInfo[0]['RLTT_UZVARDS'];
		}
		else
		{
			$userEmail='';
			$userInfo='';
		}

		$msgTypeLabel=dbProc::getMessageState($actionCode);

		$body .= text::get('ID').': '.(isset($projectCode)?$projectCode:'').'-'.$msgId."\n\r";
		$body .= text::get('NOTIFICATION_ABOUT').': '.strftime("%d.%m.%Y %H:%M", time()).', '.$msgTypeLabel.', '.$userInfo."\n\r";;
		$body .= text::get('MESSAGE_DESCRIPTION').': '.$msgDescr."\n\r";
		$body .= (($eventDescr)? text::get('EVENT_DESCRIPTION').': '.$eventDescr:'');
												
		$subscribers = dbProc::getSubscribersList($projectId, $actionId, $changedEventId);

		if($msgTypeCode ==CHANGES_MSG || $msgTypeCode == PROBLEM_MSG )
		{
			$msgAuthInfo = dbProc::getMsgAuthInfoForRole($messageId, 'CONSULTANT');
			if($msgAuthInfo !== false)
			{	
				$userInfo = dbProc::getUserInfoForRole($projectId, 'CONSULTANT');
				if($userInfo !== false)
				{
					$y = ($subscribers !== false)? count($subscribers) : 0;

					foreach($userInfo as $Info)
					{
						$subscribers[$y]['RLTT_EPASTA_ADRESE']=$Info['RLTT_EPASTA_ADRESE'];
						$subscribers[$y]['RLTT_ID']=$Info['RLTT_ID'];
						$y++;
					}
				}
			}
		}


		if($subscribers !== false)
		{
			$isSend=array();
			$mailer = new SmtpMailer();
			
			foreach($subscribers as $user)
			{
				// ja e-pasts ir tuks, vai jau atsutijam vestuli uz so e-pastu, vai lietotajsa taisa si notikumu (tad vinam nevajag sutit vestuli)
				if(!empty($user['RLTT_EPASTA_ADRESE']) && !isset($isSend[$user['RLTT_EPASTA_ADRESE']]) && ($user['RLTT_ID']!=userAuthorization::getUserId()) )
				{ 
					$isSend[$user['RLTT_EPASTA_ADRESE']]=true;
					// Use SMTP mailer instead of mail()
					$mailer->send($user['RLTT_EPASTA_ADRESE'], $subject, $body, $userEmail, $userInfo);
				}
			}
		}
	}

	// -----------------------------------------------------------------------------
	// Send email notification when RBF act status changes
	// Public
	// -----------------------------------------------------------------------------
	function sendRbfActStatusChangeNotification($actId, $oldStatus, $newStatus, $userId = null)
	{
		// === LOG: Function entry ===
		files::wh_log("========================================");
		files::wh_log("[RBF EMAIL] Function called: sendRbfActStatusChangeNotification");
		files::wh_log("[RBF EMAIL] Parameters: actId=$actId, oldStatus=$oldStatus, newStatus=$newStatus, userId=$userId");
		files::wh_log("[RBF EMAIL] TEST_MODE: " . (defined('TEST_MODE') ? (TEST_MODE ? 'TRUE' : 'FALSE') : 'NOT DEFINED'));
		
		// Get act details from AKTI table
		files::wh_log("[RBF EMAIL] Step 1: Retrieving act details from AKTI table for actId=$actId");
		$act = dbProc::getRbfActInfo($actId);
		if ($act === false) {
			files::wh_log("[RBF EMAIL] ERROR: Failed to retrieve act details for actId=$actId from AKTI table");
			files::wh_log("[RBF EMAIL] Function exiting with FALSE");
			files::wh_log("========================================");
			return false;
		}
		files::wh_log("[RBF EMAIL] SUCCESS: Act details retrieved - RAKT_NUM_PILNS: " . ($act['RAKT_FULL_NUMBER'] ?? 'N/A'));
		files::wh_log("[RBF EMAIL] Act contractor code (RAKT_KWOI_KODS): " . ($act['RAKT_KWOI_KODS'] ?? 'N/A'));

		// Get contractor emails from kl_rbf_darbuznemeji
		files::wh_log("[RBF EMAIL] Step 2: Retrieving contractor emails for code: " . $act['RAKT_KWOI_KODS']);
		$contractorEmails = dbProc::getContractorEmails($act['RAKT_KWOI_KODS']);
		if (empty($contractorEmails)) {
			files::wh_log("[RBF EMAIL] WARNING: No contractor emails found for code: " . $act['RAKT_KWOI_KODS']);
			files::wh_log("[RBF EMAIL] Function exiting with FALSE (no recipients)");
			files::wh_log("========================================");
			return false; // No email addresses to send to
		}
		files::wh_log("[RBF EMAIL] SUCCESS: Found " . count($contractorEmails) . " contractor email(s): " . implode(', ', $contractorEmails));

		// Get user info (who made the change)
		files::wh_log("[RBF EMAIL] Step 3: Retrieving user info for userId=$userId");
		$userInfo = '';
		$userEmail = '';
		if ($userId !== null) {
			$user = dbProc::getUserInfo($userId);
			if (isset($user[0]) && is_array($user[0])) {
				$userInfo = $user[0]['RLTT_VARDS'].' '.$user[0]['RLTT_UZVARDS'];
				files::wh_log("[RBF EMAIL] User info: $userInfo ");
			} else {
				files::wh_log("[RBF EMAIL] WARNING: Could not retrieve user info for userId=$userId");
			}
		} else {
			files::wh_log("[RBF EMAIL] No userId provided (system action)");
		}

	// Get status labels
	files::wh_log("[RBF EMAIL] Step 4: Building email content");
	
	// getKrfkInfoByName returns array, extract KRFK_NOZIME field
	if ($oldStatus) {
		$oldStatusInfo = dbProc::getKrfkInfoByName($oldStatus);
		$oldStatusLabel = ($oldStatusInfo && isset($oldStatusInfo['KRFK_NOZIME'])) ? $oldStatusInfo['KRFK_NOZIME'] : $oldStatus;
	} else {
		$oldStatusLabel = text::get('RBF_EMAIL_NEW_ACT');
	}
	
	$newStatusInfo = dbProc::getKrfkInfoByName($newStatus);
	$newStatusLabel = ($newStatusInfo && isset($newStatusInfo['KRFK_NOZIME'])) ? $newStatusInfo['KRFK_NOZIME'] : $newStatus;
	
	files::wh_log("[RBF EMAIL] Status change: '$oldStatusLabel' → '$newStatusLabel'");

	// Build email subject
	$actNumber = $act['RAKT_FULL_NUMBER'];
	$subject = text::get('RBF_EMAIL_SUBJECT') . ' ' . $actNumber;
	files::wh_log("[RBF EMAIL] Email subject: $subject");

	// Build email body
	$body = text::get('RBF_EMAIL_GREETING') . "\n\n";
	$body .= text::get('RBF_EMAIL_ACT_NUMBER') . ': ' . $actNumber . "\n";
	$body .= text::get('RBF_EMAIL_ACT_TITLE') . ': ' . $act['RAKT_WORK_TITLE'] . "\n";
	
	// Construct author name from AUTHOR_NAME and AUTHOR_SURNAME
	$authorName = trim(($act['AUTHOR_NAME'] ?? '') . ' ' . ($act['AUTHOR_SURNAME'] ?? ''));
	if (!empty($authorName)) {
		$body .= text::get('RBF_EMAIL_ACT_AUTHOR') . ': ' . $authorName . "\n";
	}
	
	$body .= text::get('RBF_EMAIL_DATE') . ': ' . strftime("%d.%m.%Y %H:%M", time()) . "\n\n";
	
	if ($oldStatus) {
		$body .= text::get('RBF_EMAIL_STATUS_CHANGE') . ': ' . $oldStatusLabel . ' → ' . $newStatusLabel . "\n";
	} else {
		$body .= text::get('RBF_EMAIL_NEW_ACT_CREATED') . ': ' . $newStatusLabel . "\n";
	}
	
	if ($userInfo) {
		$body .= text::get('RBF_EMAIL_CHANGED_BY') . ': ' . $userInfo . "\n";
	}
	
	$body .= "\n" . text::get('RBF_EMAIL_FOOTER');
	files::wh_log("[RBF EMAIL] Email body length: " . strlen($body) . " characters");

	// Send email to all contractor addresses using SMTP
	files::wh_log("[RBF EMAIL] Step 5: Sending emails via SMTP");
	$sentEmails = array();
	$successCount = 0;
	$failureCount = 0;
	
	// Create SMTP mailer instance
	$mailer = new SmtpMailer();
	$mailer->setDebug(true); // Enable debug logging
	
	foreach ($contractorEmails as $email) {
		$email = trim($email);
		if (!empty($email) && !isset($sentEmails[$email])) {
			$sentEmails[$email] = true;
			files::wh_log("[RBF EMAIL] Attempting to send email to: $email");
			
			// Use SMTP mailer instead of mail()
			$from = $userEmail ? $userEmail : EMAIL_FROM;
			$fromName = $userInfo ? $userInfo : SMTP_FROM_NAME;
			$mailResult = $mailer->send($email, $subject, $body, $from, $fromName);
			
			if ($mailResult) {
				files::wh_log("[RBF EMAIL] SUCCESS: SMTP send returned TRUE for $email");
				$successCount++;
			} else {
				files::wh_log("[RBF EMAIL] FAILURE: SMTP send returned FALSE for $email");
				files::wh_log("[RBF EMAIL] Error: " . $mailer->getLastError());
				$failureCount++;
			}
		} else {
			if (empty($email)) {
				files::wh_log("[RBF EMAIL] SKIPPED: Empty email address");
			} else {
				files::wh_log("[RBF EMAIL] SKIPPED: Duplicate email address: $email");
			}
		}
	}

	files::wh_log("[RBF EMAIL] Summary: Successfully sent to $successCount recipient(s), failed for $failureCount");
	files::wh_log("[RBF EMAIL] Function exiting with TRUE");
	files::wh_log("========================================");
	
	return true;
	}

	
}
?>