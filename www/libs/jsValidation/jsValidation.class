<?


class jsValidation
{
	
	
	function getValidationFunctionName($formName)
	{
		return $formName.'ValidationScript';
	}

	function getStartHtml($formName)
	{
		ob_start();
		?>
	        <script>
		var errSpans = new Array();
		function <?=jsValidation::getValidationFunctionName($formName);?>()
		{
			var validate=true;
			var good_fields=false;
			var isMoveCursor=true;
			var msg;
			removeErrSpans();
			var errFlag = new Array();
		<?
		$output = ob_get_contents();
		ob_end_clean();
		return $output;
	}


	function getValidationHtml($formName='',$name,$type,$fieldName,$other='')
	{
		ob_start();
		?>
		function <?=$name;?>()
		{
		<?
		switch($type)
		{

			case 'ifonefilled':
				if (is_array($fieldName))
				{
					foreach ($fieldName as $name)
					{
						?>
						if (!<?=empty($formName)?'isEmptyField':'isEmptyFormField';?>('<?=$formName;?>','<?=$name;?>')) {return true;}
						<?
					}
				}
				else
				{
					?>
					if (!<?=empty($formName)?'isEmptyField':'isEmptyFormField';?>('<?=$formName;?>','<?=$fieldName;?>')) {return true;}
					<?
				}
				break;

			case 'ifequal':
				if (is_array($fieldName))
				{
					foreach ($fieldName as $name)
					{
						?>
						if (document.forms['<?=$formName;?>']['<?=$name;?>'].value=="<?=$other;?>") {return true;}
						<?
					}               
				}
				else
				{
					?>
					if (document.forms['<?=$formName;?>']['<?=$fieldName;?>'].value=="<?=$other;?>") {return true;}
					<?
				}
				break;
             case 'ifnotequal':
				if (is_array($fieldName))
				{
					foreach ($fieldName as $name)
					{
						?>
						if (!isEmptyFormField('<?=$formName;?>','<?=$fieldName;?>') && document.forms['<?=$formName;?>']['<?=$name;?>'].value!="<?=$other;?>") {return true;}
						<?
					}
				}
				else
				{
					?>
					if (!isEmptyFormField('<?=$formName;?>','<?=$fieldName;?>') && parseFloat(document.forms['<?=$formName;?>']['<?=$fieldName;?>'].value)!="<?=$other;?>") {return true;}
					<?
				}
				break;
			default:
				?>return true;<?
				break;
		}
		?>
			return false;
		}
		<?
		$output = ob_get_contents();
		ob_end_clean();
		return $output;
	}

