<?
 
class userAuthorization 
{

	// -----------------------------------------------------------------------------
	// login
	// -----------------------------------------------------------------------------
	static function login($login,$password)
	{
	        if (!empty($login) && !empty($password))
	        {
            $isLoginOk = false;
            $admins = explode(",", RCDIS_ADMIN_LIST);

            if(LDAP_AUTH_MODE && !in_array($login, $admins))
            {
                // chech user is in RCD DB
                if(dbProc::isHasActiveUserWithThisLogin($login))
                {
                    try
                    {
            		    $adldap = new adLDAP();

                    }
                    catch (adLDAPException $e) {
                        echo $e;
                        return false;
                    }

            		$isLoginOk = $adldap -> authenticate($login,$password);
                }
                else
                {
                  return false;
                }
            }
            else
            {
                $isLoginOk = dbProc::checkUserForLogin($login,$password);
            }

            if ($isLoginOk)
			{
				$rows=dbProc::getUserInfo(null,$login,null);

				if (count($rows)==1)
				{
					dbProc::setUserActionDate($rows[0]['RLTT_ID'], USER_AUTHEREISATION);
					$info = dbProc::getSystemInfo();
					
					if(count($info)>0 )
					{	
						$adminList = explode(",", trim($info[0]['SNFO_SUPERADMIN']));
						if (in_array(trim($rows[0]['RLTT_USER_NAME']), $adminList)) 
						{
							session::set('isSuperAdmin',1);
						}
					}
					session::set('isLogin',true);
					session::set('userId',$rows[0]['RLTT_ID']);
					session::set('login',$rows[0]['RLTT_USER_NAME']);
					session::set('isAdmin',$rows[0]['RLTT_IR_ADMINS']);
                    session::set('isTrase',$rows[0]['RLTT_IR_TRASE']);
                    
                    if($rows[0]['RLTT_KWOI_KODS'] != "")
					{
							session::set('workerCode',$rows[0]['RLTT_KWOI_KODS']);
							session::set('isContract', $rows[0]['RLTT_IR_LIGUMS'] );
							session::set('isLimitcard', $rows[0]['RLTT_IR_LIMITCARD'] );
							session::set('isPpaReport', $rows[0]['RLTT_IR_PPA'] );
							session::set('isRbfUser', $rows[0]['RLTT_IR_RBF'] );
					}
					else
					{
							session::set('isContract', 0);
							session::set('isLimitcard', 0);
							session::set('isPpaReport', 0);
							session::set('isRbfUser', 0);
					}
					return true;
				}
			}
		}
		session::del('isLogin');
		return false;
	}

    function loginAuto($login, $password)
	{
		if (!empty($login))
		{
            $isLoginOk = false;

            $isLoginOk = dbProc::checkUserForLogin($login,$password);

            if ($isLoginOk)
			{
				$rows=dbProc::getUserInfo(null,$login,null);

				if (count($rows)==1)
				{
					dbProc::setUserActionDate($rows[0]['RLTT_ID'], USER_AUTHEREISATION);
					$info = dbProc::getSystemInfo();
					
					if(count($info)>0 )
					{	
						$adminList = explode(",", trim($info[0]['SNFO_SUPERADMIN']));
						if (in_array(trim($rows[0]['RLTT_USER_NAME']), $adminList)) 
						{
							session::set('isSuperAdmin',1);
						}
					}
					session::set('isLogin',true);
					session::set('userId',$rows[0]['RLTT_ID']);
					session::set('login',$rows[0]['RLTT_USER_NAME']);
					session::set('isAdmin',$rows[0]['RLTT_IR_ADMINS']);
                    session::set('isTrase',$rows[0]['RLTT_IR_TRASE']);
					session::set('isContract',$rows[0]['RLTT_IR_LIGUMS']);
					session::set('isLimitcard',$rows[0]['RLTT_IR_LIMITCARD']);
					session::set('isPpaReport',$rows[0]['RLTT_IR_PPA']);
					session::set('isRbfUser',$rows[0]['RLTT_IR_RBF']);
					
                     if($rows[0]['RLTT_KWOI_KODS'] != "")
                        session::set('workerCode',$rows[0]['RLTT_KWOI_KODS']);
					return true;
				}
			}
		}
		session::del('isLogin');
		return false;
	}

	// -----------------------------------------------------------------------------
	// return user id
	// -----------------------------------------------------------------------------
	static function getUserId()
	{
		return session::get('userId');
	}

	// -----------------------------------------------------------------------------
	// return user login
	// -----------------------------------------------------------------------------
	static function getUserLogin()
	{
		return session::get('login');
	}

    // -----------------------------------------------------------------------------
	// return worker code
	// -----------------------------------------------------------------------------
	static function getWorker()
	{
		return session::get('workerCode');
	}

	// -----------------------------------------------------------------------------
	// is admin user?
	// -----------------------------------------------------------------------------
	static function isAdmin()
	{
		return session::get('isAdmin');
	}

	// -----------------------------------------------------------------------------
	// is super admin user?
	// -----------------------------------------------------------------------------
	static function isSuperAdmin()
	{
		return session::get('isSuperAdmin');
	}

	// -----------------------------------------------------------------------------
	// authorization status
	// -----------------------------------------------------------------------------
	static function isLogin()
	{
		return session::get('isLogin');
	}

    // -----------------------------------------------------------------------------
	// authorization status
	// -----------------------------------------------------------------------------
	static function isTrase()
	{
		return session::get('isTrase');
	}

    // -----------------------------------------------------------------------------
	// authorization status
	// -----------------------------------------------------------------------------
	static function isContract()
	{
		return session::get('isContract');
	}

	// -----------------------------------------------------------------------------
	// piekÄ¼uve sadaÄ¼ai LIMITKARTE
	// -----------------------------------------------------------------------------
	static function isLimitcard()
	{
		return session::get('isLimitcard');
	}

	// -----------------------------------------------------------------------------
	// piekÄ¼uve sadaÄ¼ai PPA
	// -----------------------------------------------------------------------------
	static function isPpaReport()
	{
		return session::get('isPpaReport');
	}

	// -----------------------------------------------------------------------------
	// isRbfUser
	// -----------------------------------------------------------------------------
	static function isRbfUser()
	{
		return session::get('isRbfUser');
	}

	// -----------------------------------------------------------------------------
	// logout
	// -----------------------------------------------------------------------------
	static function logout()
	{
		session::destroy();
	}

}





?>