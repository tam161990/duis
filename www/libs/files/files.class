<?


class files
{

	// -----------------------------------------------------------------------------
	// Ja fails ir noladets - atgriezh true
	// -----------------------------------------------------------------------------
	static function isUploadFile($fieldName)
	{
		if (isset($_FILES[$fieldName]) && empty($_FILES[$fieldName]['error']))
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// Ja fails ir pareiza datu tipa - atgriezh true
	// -----------------------------------------------------------------------------
	static function isUploadFileOfTYpe($fieldName, $type)
	{
		if (!isset($_FILES[$fieldName]['type']))
		{
			return false;
		}
		if ($_FILES[$fieldName]['type'] == $type)
		{
			return true;
		}
		return false;

	}

	// -----------------------------------------------------------------------------
	// Ja fails ir ar pareiza paplasinajumu - atgriezh true
	// -----------------------------------------------------------------------------
	static function isUploadFileOfExt($fieldName, $ext)
	{
		if (!isset($_FILES[$fieldName]['name'])) {
			return false;
		}
		$fileExt = strtolower(pathinfo($_FILES[$fieldName]['name'], PATHINFO_EXTENSION));
		return ($fileExt === strtolower($ext));
	}

	// -----------------------------------------------------------------------------
	// Check if uploaded file has valid extension for RBF attachments
	// -----------------------------------------------------------------------------
	static function isValidRbfFile($fieldName)
	{
		if (!isset($_FILES[$fieldName]['name']))
		{
			return false;
		}
		$allowedExtensions = array('docx', 'pdf', 'xls', 'xlsx', 'gif', 'jpeg', 'jpg', 'png');
		$filename = $_FILES[$fieldName]['name'];
		$ext = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
		
		return in_array($ext, $allowedExtensions);
	}

	// -----------------------------------------------------------------------------
	// nodzes failu no diska
	// -----------------------------------------------------------------------------
	static function eraseFileFromStore($idFile, $type = 'PDF')
	{

        if($type == "PDF")
        {
             return @unlink(FILES_STORE_PATH.'/'.$idFile);
        }
        elseif($type == "RBF")
        {
             return @unlink(RBF_FILES_STORE_PATH.'/'.$idFile);
        }
        else
        {
             return @unlink(PROJECT_FILES_STORE_PATH.'/'.$idFile);
        }
	}

    // -----------------------------------------------------------------------------
	// nodzes failu no diska
	// -----------------------------------------------------------------------------
	static function eraseFileFromStore2($File)
	{
		return @unlink($File);
	}

	// -----------------------------------------------------------------------------
	// nodzes failu no MySQL tabulu un no diska
	// -----------------------------------------------------------------------------
	static function deleteFile($idFile, $type = 'PDF')
	{
		$res=false;
        //echo  $idFile;
		if (is_numeric($idFile))
		{
			$res=dbProc::deleteFile($idFile, $type);
			if ($res)
			{
				$res=files::eraseFileFromStore($idFile, $type);
			}
		}
		return $res;
	}


	// -----------------------------------------------------------------------------
	// saglaba failu
	// -----------------------------------------------------------------------------
	static function saveFile($fieldName,$description=false,$userId,$messagesId,$idFile=false,$type=false)
	{
	        if (files::isUploadFile($fieldName))
	        {
	        	if (!empty($idFile))
	        	{
		        	$res=dbProc::replaceFile($_FILES[$fieldName]['name'], $userId, $messagesId, ($type ? $type : 'PDF'), $_FILES[$fieldName]['type'], $description);
		        	if (!$res)
		        	{
		        		return false;
		        	}
		        	files::eraseFileFromStore($idFile, ($type ? $type : 'PDF'));
	        	}
	        	else
	        	{
		        	$res=dbProc::replaceFile($_FILES[$fieldName]['name'], $userId, $messagesId, ($type ? $type : 'PDF'), $_FILES[$fieldName]['type'], $description);
		        	if ($res)
		        	{
		        		$idFile=dbLayer::getInsertId();
		        	}
		        	else
		        	{
		        		return false;
		        	}
		        	if ($idFile===false)
		        	{
		        		return false;
		        	}
	        	}
	        	$storePath = ($type == 'RBF') ? RBF_FILES_STORE_PATH : FILES_STORE_PATH;
	        	$res=@move_uploaded_file($_FILES[$fieldName]['tmp_name'],$storePath.'/'.$idFile);
	        	if ($res)
	        	{
	        		return $idFile;
	        	}
	        	else
	        	{
	        		dbProc::deleteFile($idFile);
	        	}
	        }
	        return false;
	}

    // -----------------------------------------------------------------------------
	// saglab�t failu disk�
	// -----------------------------------------------------------------------------
	static function saveFileToStore($fieldName)
	{
        if (files::isUploadFile($fieldName))
	    {
            $res=@move_uploaded_file($_FILES[$fieldName]['tmp_name'],FILES_STORE_PATH.'/'.IMPORT_FILES_STORE_NAME);
	        if ($res)
	        {
	           	return FILES_STORE_PATH.'/'.IMPORT_FILES_STORE_NAME;
	        }

        }
        return false;
	}


	// -----------------------------------------------------------------------------
	// atgriezh informaciju par failu
	// -----------------------------------------------------------------------------
	static function getFileInfo($idFile, $type)
	{
	        return dbProc::getFileInfo($idFile, $type);
	}


	// -----------------------------------------------------------------------------
	// suta failu klientam
	// -----------------------------------------------------------------------------
	static function sendFile($idFile, $isExit=true, $type = 'PDF')
	{
			
		$info=files::getFileInfo($idFile, $type);
		if ($info)
		{
			if($type == "PDF")
            {
                 $c=@file_get_contents(FILES_STORE_PATH.'/'.$idFile);
            }
            else if($type == "RBF")
            {
                 $c=@file_get_contents(RBF_FILES_STORE_PATH.'/'.$idFile);
            }
            else if($type == "EXCEL")
            {
                 $c=@file_get_contents(EXCEL_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "PEXCEL")
            {
                 $c=@file_get_contents(PROJECT_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "XML")
            {
				 $c=@file_get_contents(XML_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "JSON")
            {				
				 $c=@file_get_contents(JSON_FILES_STORE_PATH.'/'.$idFile);
            }
			
			if ($c)
			{
			    // Clean output buffers to prevent file corruption
				while (ob_get_level()) {
					ob_end_clean();
				}
				
				header('Content-Type: '.$info['META_INFO']);
				header('Content-Disposition: attachment; filename="'.$info['NOSAUKUMS'].'"');
				header('Content-Length: '.strlen($c));
				header('Cache-Control: max-age=0');
				header('Pragma: public');
                echo $c;
				if ($isExit)
				{
					exit();
				}
			}
		}
		return false;
	}


	static function wh_log($log_msg)
	{
		$log_filename = LOG_STORE_PATH;
		if (!file_exists($log_filename)) 
		{
			// create directory/folder uploads.
			mkdir($log_filename, 0777, true);
		}
		$log_file_data = $log_filename.'/log_' . date('d-M-Y') . '.log';
		// if you don't add `FILE_APPEND`, the file will be erased each time you add a log
		file_put_contents($log_file_data, $log_msg . "\n", FILE_APPEND);
	}

	// -----------------------------------------------------------------------------
	// GPS_FAILI: upload, delete, download (f.gps.s.0)
	// -----------------------------------------------------------------------------
	static function saveGpsFile($fieldName, $region = '')
	{
		if (!files::isUploadFile($fieldName))
		{
			return false;
		}

		$filename = $_FILES[$fieldName]['name'];
		$mime = isset($_FILES[$fieldName]['type']) ? $_FILES[$fieldName]['type'] : 'application/octet-stream';
		$res = dbProc::replaceGpsFile($filename, $region, $mime);
		if (!$res)
		{
			return false;
		}

		$idFile = dbLayer::getInsertId();
		if ($idFile === false || $idFile === '')
		{
			return false;
		}

		if (!file_exists(GPS_FILES_STORE_PATH))
		{
			mkdir(GPS_FILES_STORE_PATH, 0777, true);
		}

		$dest = GPS_FILES_STORE_PATH.'/'.$idFile;
		if (@move_uploaded_file($_FILES[$fieldName]['tmp_name'], $dest))
		{
			return $idFile;
		}

		dbProc::deleteGpsFile($idFile);
		@unlink($dest);

		return false;
	}

	static function deleteGpsFile($idFile)
	{
		if (!is_numeric($idFile))
		{
			return false;
		}

		if (dbProc::getGpsFileInfo($idFile) === false)
		{
			return false;
		}

		$res = dbProc::deleteGpsFile($idFile);
		if ($res)
		{
			@unlink(GPS_FILES_STORE_PATH.'/'.$idFile);
		}

		return $res;
	}

	static function sendGpsFile($idFile, $isExit = true)
	{
		$info = dbProc::getGpsFileInfo($idFile);
		if (!$info)
		{
			return false;
		}

		$c = @file_get_contents(GPS_FILES_STORE_PATH.'/'.$idFile);
		if ($c === false)
		{
			return false;
		}

		while (ob_get_level())
		{
			ob_end_clean();
		}

		$mime = !empty($info['GFLS_META_INFO']) ? $info['GFLS_META_INFO'] : 'application/octet-stream';
		header('Content-Type: '.$mime);
		header('Content-Disposition: attachment; filename="'.$info['GFLS_NOSAUKUMS'].'"');
		header('Content-Length: '.strlen($c));
		header('Cache-Control: max-age=0');
		header('Pragma: public');
		echo $c;
		if ($isExit)
		{
			exit();
		}

		return true;
	}

}