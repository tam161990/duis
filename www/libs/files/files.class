<?


class files
{

	// -----------------------------------------------------------------------------
	// Ja fails ir noladets - atgriezh true
	// -----------------------------------------------------------------------------
	function isUploadFile($fieldName)
	{
		if (isset($_FILES[$fieldName]) && empty($_FILES[$fieldName]['error']))
		{
			return true;
		}
		return false;
	}

    // -----------------------------------------------------------------------------
	// Ja fails ir pareiza datu tipa - atgriezh true
	// -----------------------------------------------------------------------------
	function isUploadFileOfTYpe($fieldName, $type)
	{
		if ($_FILES[$fieldName]['type'] == $type)
		{
			return true;
		}
		return false;

	}

	// -----------------------------------------------------------------------------
	// Ja fails ir ar pareiza paplasinajumu - atgriezh true
	// -----------------------------------------------------------------------------
	function isUploadFileOfExt($fieldName, $ext)
	{
		$filename = explode(".", $_FILES[$fieldName]['name']);
  		
		if ($filename[1] == $ext)
		{
			return true;
		}
		return false;

	}

	// -----------------------------------------------------------------------------
	// Check if uploaded file has valid extension for RBF attachments
	// -----------------------------------------------------------------------------
	function isValidRbfFile($fieldName)
	{
		$allowedExtensions = array('docx', 'pdf', 'xls', 'xlsx', 'gif', 'jpeg', 'jpg', 'png');
		$filename = $_FILES[$fieldName]['name'];
		$ext = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
		
		return in_array($ext, $allowedExtensions);
	}

	// -----------------------------------------------------------------------------
	// nodzes failu no diska
	// -----------------------------------------------------------------------------
	function eraseFileFromStore($idFile, $type = 'PDF')
	{

        if($type == "PDF")
        {
             return @unlink(FILES_STORE_PATH.'/'.$idFile);
        }
        elseif($type == "RBF")
        {
             return @unlink(RBF_FILES_STORE_PATH.'/'.$idFile);
        }
        else
        {
             return @unlink(PROJECT_FILES_STORE_PATH.'/'.$idFile);
        }
	}

    // -----------------------------------------------------------------------------
	// nodzes failu no diska
	// -----------------------------------------------------------------------------
	function eraseFileFromStore2($File)
	{
		return @unlink($File);
	}

	// -----------------------------------------------------------------------------
	// nodzes failu no MySQL tabulu un no diska
	// -----------------------------------------------------------------------------
	function deleteFile($idFile, $type = 'PDF')
	{
		$res=false;
        //echo  $idFile;
		if (is_numeric($idFile))
		{
			$res=dbProc::deleteFile($idFile, $type);
			if ($res)
			{
				$res=files::eraseFileFromStore($idFile, $type);
			}
		}
		return $res;
	}


	// -----------------------------------------------------------------------------
	// saglaba failu
	// -----------------------------------------------------------------------------
	function saveFile($fieldName,$description=false,$userId,$messagesId,$idFile=false,$type=false)
	{
	        if (files::isUploadFile($fieldName))
	        {
	        	if (!empty($idFile))
	        	{
		        	$res=dbProc::replaceFile($_FILES[$fieldName]['name'], $userId, $messagesId, ($type ? $type : 'PDF'), $_FILES[$fieldName]['type'], $description);
		        	if (!$res)
		        	{
		        		return false;
		        	}
		        	files::eraseFileFromStore($idFile, ($type ? $type : 'PDF'));
	        	}
	        	else
	        	{
		        	$res=dbProc::replaceFile($_FILES[$fieldName]['name'], $userId, $messagesId, ($type ? $type : 'PDF'), $_FILES[$fieldName]['type'], $description);
		        	if ($res)
		        	{
		        		$idFile=dbLayer::getInsertId();
		        	}
		        	else
		        	{
		        		return false;
		        	}
		        	if ($idFile===false)
		        	{
		        		return false;
		        	}
	        	}
	        	$storePath = ($type == 'RBF') ? RBF_FILES_STORE_PATH : FILES_STORE_PATH;
	        	$res=@move_uploaded_file($_FILES[$fieldName]['tmp_name'],$storePath.'/'.$idFile);
	        	if ($res)
	        	{
	        		return $idFile;
	        	}
	        	else
	        	{
	        		dbProc::deleteFile($idFile);
	        	}
	        }
	        return false;
	}

    // -----------------------------------------------------------------------------
	// saglab�t failu disk�
	// -----------------------------------------------------------------------------
	function saveFileToStore($fieldName)
	{
        if (files::isUploadFile($fieldName))
	    {
            $res=@move_uploaded_file($_FILES[$fieldName]['tmp_name'],FILES_STORE_PATH.'/'.IMPORT_FILES_STORE_NAME);
	        if ($res)
	        {
	           	return FILES_STORE_PATH.'/'.IMPORT_FILES_STORE_NAME;
	        }

        }
        return false;
	}


	// -----------------------------------------------------------------------------
	// atgriezh informaciju par failu
	// -----------------------------------------------------------------------------
	function getFileInfo($idFile, $type)
	{
	        return dbProc::getFileInfo($idFile, $type);
	}


	// -----------------------------------------------------------------------------
	// suta failu klientam
	// -----------------------------------------------------------------------------
	function sendFile($idFile, $isExit=true, $type = 'PDF')
	{
				
		$info=files::getFileInfo($idFile, $type);
		if ($info)
		{
			if($type == "PDF")
            {
                 $c=@file_get_contents(FILES_STORE_PATH.'/'.$idFile);
            }
            else if($type == "RBF")
            {
                 $c=@file_get_contents(RBF_FILES_STORE_PATH.'/'.$idFile);
            }
            else if($type == "EXCEL")
            {
                 $c=@file_get_contents(EXCEL_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "PEXCEL")
            {
                 $c=@file_get_contents(PROJECT_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "XML")
            {
				 $c=@file_get_contents(XML_FILES_STORE_PATH.'/'.$idFile);
			}
			else if($type == "JSON")
            {				
				 $c=@file_get_contents(JSON_FILES_STORE_PATH.'/'.$idFile);
            }
			
			if ($c)
			{
			    // Clean output buffers to prevent file corruption
				while (ob_get_level()) {
					ob_end_clean();
				}
				
				header('Content-Type: '.$info['META_INFO']);
				header('Content-Disposition: attachment; filename="'.$info['NOSAUKUMS'].'"');
				header('Content-Length: '.strlen($c));
				header('Cache-Control: max-age=0');
				header('Pragma: public');
                echo $c;
				if ($isExit)
				{
					exit();
				}
			}
		}
		return false;
	}


	function wh_log($log_msg)
	{
		$log_filename = LOG_STORE_PATH;
		if (!file_exists($log_filename)) 
		{
			// create directory/folder uploads.
			mkdir($log_filename, 0777, true);
		}
		$log_file_data = $log_filename.'/log_' . date('d-M-Y') . '.log';
		// if you don't add `FILE_APPEND`, the file will be erased each time you add a log
		file_put_contents($log_file_data, $log_msg . "\n", FILE_APPEND);
	} 





}

?>